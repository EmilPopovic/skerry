{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./tools/check)",
      "Bash(python3 tools/*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo test:*)",
      "Bash(cargo bench:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(ls:*)",
      "WebFetch(domain:wayland.freedesktop.org)",
      "WebFetch(domain:specifications.freedesktop.org)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:doc.rust-lang.org)"
    ],
    "deny": [
      "Bash(cargo publish:*)",
      "Bash(cargo add:*)",
      "Bash(git push:*)",
      "Read(./**/*.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/after-edit.sh \"$CLAUDE_FILE_PATHS\""
          }
        ]
      }
    ]
  }
}
