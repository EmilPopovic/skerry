@scenario("context-menu-pointer")
def context_menu_pointer(run: Run, fixture: Path) -> None:
    """A secondary click opens the menu, and takes the row it points at."""
    run.drive("sleep 500\nkey f12\nsleep 100\n")
    pointing = point_at(run, 2)
    wanted = pointing["hover_name"]
    run.drive("click right\nsleep 400\nkey f12\nsleep 150\n")
    opened = run.state()
    if int(opened["menu"]) < 5:
        raise Failure(f"a secondary click on a row opened {opened['menu']} rows")
    expect(opened, cursor=wanted, selected="1")
    if "file.trash" not in opened["menu_aim"]:
        raise Failure(f"the row menu has no Move to Trash: {opened['menu_aim']}")

    # A press that dismisses a menu dismisses it and nothing else: aimed at
    # another row, so a click that got through would move the cursor and say so.
    away = aim(
        run,
        opened,
        float(opened["name_x"]) + 30.0,
        float(opened["body_top"]) + float(opened["row_h"]) * 6.5,
    )
    run.drive(
        f"move {away[0]:.1f} {away[1]:.1f}\nsleep 150\nclick\nsleep 300\nkey f12\nsleep 150\n"
    )
    expect(run.state(), menu="0", cursor=wanted, selected="1")

    # And no menu over the sidebar, whose rows are a different directory from the
    # one every action on the background menu is about.
    if float(opened["sidebar_w"]) > 0.0:
        aside = aim(run, opened, float(opened["sidebar_w"]) / 2.0, float(opened["body_top"]) + 40.0)
        run.drive(
            f"move {aside[0]:.1f} {aside[1]:.1f}\n"
            "sleep 150\nclick right\nsleep 350\nkey f12\nsleep 150\n"
        )
        expect(run.state(), menu="0", cursor=wanted)


@scenario("mouse-only-trash-and-undo", fresh=True)
def mouse_only_trash_and_undo(run: Run, fixture: Path) -> None:
    """The whole promise, with no keyboard at all in the part that acts.

    Right-click a row, click Move to Trash; right-click the empty space, click
    Undo. F12 is the only key pressed, and it only asks the window what it
    thinks — a pointer has no way to ask.
    """
    run.drive("sleep 500\nkey f12\nsleep 100\n")
    pointing = point_at(run, 3)
    doomed = pointing["hover_name"]
    run.drive("click right\nsleep 400\nkey f12\nsleep 150\n")
    aimed = menu_aim(run, run.state(), "file.trash")
    run.drive(f"move {aimed[0]:.1f} {aimed[1]:.1f}\nsleep 200\nclick\nsleep 900\nkey f12\nsleep 200\n")
    trashed = run.state()
    expect(trashed, menu="0", rows="8", undo="true")
    if (fixture / doomed).exists():
        raise Failure(f"clicking Move to Trash left {doomed} where it was")

    # The empty space below the last row, where the background menu lives.
    below = float(trashed["body_top"]) + float(trashed["row_h"]) * (int(trashed["rows"]) + 1)
    if below >= float(trashed["body_top"]) + float(trashed["body_height"]):
        raise Failure("no empty space below the last row to click in")
    where = aim(run, trashed, float(trashed["name_x"]) + 40.0, below)
    run.drive(
        f"move {where[0]:.1f} {where[1]:.1f}\n"
        "sleep 150\nclick right\nsleep 400\nkey f12\nsleep 150\n"
    )
    background = run.state()
    if int(background["menu"]) < 9:
        raise Failure(f"the background menu has {background['menu']} rows")
    aimed = menu_aim(run, background, "edit.undo")
    run.drive(f"move {aimed[0]:.1f} {aimed[1]:.1f}\nsleep 200\nclick\nsleep 900\nkey f12\nsleep 200\n")
    undone = run.state()
    expect(undone, menu="0", rows="9", undo="false")
    if not (fixture / doomed).exists():
        raise Failure(f"clicking Undo did not put {doomed} back")


def menu_aim(run: Run, state: dict[str, str], command: str) -> tuple[float, float]:
    """Where to move the pointer to click one menu row, as the driver's percentages.

    The window reports the middle of every open row, so a test aims by command
    identifier and never by arithmetic over the menu's own constants — which it
    would have to copy, and which would then be a second copy to keep right.
    """
    for entry in state.get("menu_aim", "").split(","):
        name, _, point = entry.partition("@")
        if name == command:
            x, _, y = point.partition(":")
            return aim(run, state, float(x), float(y))
    raise Failure(f"{command} is not on the open menu: {state.get('menu_aim')!r}")


def palette_aim(run: Run, state: dict[str, str], command: str) -> tuple[float, float]:
    """Where to click one palette result, as the driver's percentages.

    The same trade `menu_aim` makes: the window reports the middle of every drawn
    row, so a test aims by command identifier rather than by arithmetic over the
    palette's own constants.
    """
    for entry in state.get("palette_aim", "").split(","):
        name, _, point = entry.partition("@")
        if name == command:
            x, _, y = point.partition(":")
            return aim(run, state, float(x), float(y))
    raise Failure(f"{command} is not on the open palette: {state.get('palette_aim')!r}")


@scenario("palette-by-keyboard")
def palette_by_keyboard(run: Run, fixture: Path) -> None:
    """Ctrl+Shift+P, type, arrow, Enter — and the command runs."""
    run.drive("sleep 500\nkey ctrl+shift+p\nsleep 300\nkey f12\nsleep 150\n")
    opened = run.state()
    if int(opened["palette"]) < 20:
        raise Failure(f"the palette opened with {opened['palette']} results")
    expect(opened, palette_query="")

    # Typing narrows it, and the highlight lands on something that can run.
    run.drive("text hid\nsleep 300\nkey f12\nsleep 150\n")
    narrowed = run.state()
    expect(narrowed, palette_query="hid")
    if int(narrowed["palette"]) >= int(opened["palette"]):
        raise Failure(f"typing did not narrow: {narrowed['palette']} of {opened['palette']}")
    if narrowed["palette_id"] != "view.hidden":
        raise Failure(f"`hid` highlighted {narrowed['palette_id']!r}")

    # Enter runs it, which is observable: dotfiles appear.
    before = int(opened["rows"])
    run.drive("key enter\nsleep 400\nkey f12\nsleep 150\n")
    after = run.state()
    expect(after, palette="-1", hidden="true")
    if int(after["rows"]) <= before:
        raise Failure(f"showing hidden files did not add rows: {before} then {after['rows']}")

    # And the same chord closes it again, rather than needing Escape.
    run.drive("key ctrl+shift+p\nsleep 250\nkey ctrl+shift+p\nsleep 250\nkey f12\nsleep 150\n")
    expect(run.state(), palette="-1")


@scenario("palette-by-pointer")
def palette_by_pointer(run: Run, fixture: Path) -> None:
    """Opened from the background menu, and a result clicked. No keys at all.

    Except `F12`, which is how a scenario reads any state, and the type-ahead the
    other palette scenario covers — the point here is that a pointer alone can
    reach a command that has no button.
    """
    run.drive("sleep 500\nkey f12\nsleep 100\n")
    start = run.state()
    # A secondary click on empty space below the rows opens the background menu.
    empty = aim(
        run,
        start,
        float(start["name_x"]) + 30.0,
        float(start["body_top"]) + float(start["body_height"]) - 20.0,
    )
    run.drive(
        f"move {empty[0]:.1f} {empty[1]:.1f}\nsleep 150\nclick right\nsleep 400\n"
        "key f12\nsleep 150\n"
    )
    menu = run.state()
    if "view.palette" not in menu["menu_aim"]:
        raise Failure(f"the background menu has no palette row: {menu['menu_aim']}")

    at = menu_aim(run, menu, "view.palette")
    run.drive(f"move {at[0]:.1f} {at[1]:.1f}\nsleep 150\nclick\nsleep 400\nkey f12\nsleep 150\n")
    opened = run.state()
    if int(opened["palette"]) < 20:
        raise Failure(f"clicking the menu row opened {opened['palette']} results")

    # A result past the eleventh, reached with the wheel — which is the whole of
    # why the palette takes the wheel: with fifty commands and eleven rows drawn,
    # a pointer with no keyboard could otherwise reach only the first eleven.
    #
    # The move and the scroll go in one script: each `drive` is a fresh process
    # with a fresh virtual pointer, and a pointer that has never moved has no
    # position for the compositor to route an axis event by.
    over = palette_aim(run, opened, "go.open")
    scrolled = opened
    for _ in range(8):
        if "view.hidden" in scrolled["palette_aim"]:
            break
