@scenario("a-field-selects-text-and-ctrl-a-does-not-select-files", fresh=True)
def field_selection(run: Run, fixture: Path) -> None:
    """Shift+arrows extend, Ctrl+A takes the name, and neither touches the list.

    `Ctrl+A` is the one chord where a field and the listing genuinely disagree, and
    the registry settles it by scope — so this is the scenario that would fail if
    the scope ever stopped being consulted.
    """
    run.drive("sleep 700\nkey f12\nsleep 150\n")
    run.drive("text file-1.txt\nsleep 400\nkey f2\nsleep 300\nkey f12\nsleep 150\n")
    opened = run.state()
    expect(opened, naming="file-1.txt", selected="1")

    # Ctrl+A takes the whole name, not every file: one keystroke then replaces it.
    run.drive("key ctrl+a\nsleep 250\ntext x\nsleep 300\nkey f12\nsleep 150\n")
    took = run.state()
    expect(took, naming="x")
    if int(took["selected"]) != 1:
        raise Failure(f"Ctrl+A in a field selected {took['selected']} files")

    # Shift+Left three times over `file-2.txt` selects `txt`, and one keystroke
    # replaces all three of them.
    run.drive("key escape\nsleep 300\ntext file-2.txt\nsleep 400\nkey f2\nsleep 300\n")
    run.drive(
        "key end\nsleep 150\nkey shift+left\nkey shift+left\nkey shift+left\n"
        "sleep 250\ntext Z\nsleep 300\nkey f12\nsleep 150\n"
    )
    expect(run.state(), naming="file-2.Z")

    run.drive("key escape\nsleep 250\n")

    # **The filter is deliberately not a field.** It is a `String` with no caret
    # and no selection, so `Ctrl+A` while filtering selects the rows that matched
    # — which is what filtering is for, and the boundary the scope draws.
    run.drive("key ctrl+f\nsleep 300\ntext file\nsleep 500\nkey f12\nsleep 150\n")
    filtering = run.state()
    expect(filtering, filtering="true", filter="file")
    matched = int(filtering["rows"])
    if matched < 2:
        raise Failure(f"the filter matched {matched} rows, which proves nothing")
    run.drive("key ctrl+a\nsleep 300\nkey f12\nsleep 150\n")
    expect(run.state(), selected=str(matched), filtering="true")
    run.drive("key escape\nsleep 250\n")


