@scenario("a-taken-name-is-a-question-not-a-guess", fresh=True)
def a_taken_name_asks(run: Run, fixture: Path) -> None:
    """Paste onto a name that is taken, and the queue stops and asks.

    Two files with the same name in two folders, so the second paste has a real
    choice to make. What this covers is the whole shape: the queue stops rather
    than guessing, `Replace` keeps the displaced file rather than destroying it,
    and one `Ctrl+Z` walks back both halves of that.
    """
    (fixture / "alpha" / "file-1.txt").write_text("the one arriving")
    listed(run)

    # Copy `alpha/file-1.txt`, then paste it over the one in `beta`.
    run.drive("text alpha\nsleep 500\nkey enter\nsleep 900\n")
    listed(run)
    run.drive("text file-1.txt\nsleep 400\nkey ctrl+c\nsleep 400\nkey f12\nsleep 200\n")
    expect(run.state(), cursor="file-1.txt")
    run.drive("key alt+up\nsleep 900\n")
    listed(run)
    run.drive("text beta\nsleep 500\nkey enter\nsleep 900\n")
    listed(run)
    (fixture / "beta" / "file-1.txt").write_text("the one there")
    run.drive("key f5\nsleep 600\n")
    listed(run)

    run.drive("key ctrl+v\nsleep 1200\nkey f12\nsleep 300\n")
    asked = run.state()
    expect(asked, asking="true", answer="clash.replace")
    if asked["clash"] != "file-1.txt":
        raise Failure(f"the question is about {asked['clash']!r}")
    # Nothing has happened yet: a question that had already acted would be a
    # notification with buttons on it.
    if (fixture / "beta" / "file-1.txt").read_text() != "the one there":
        raise Failure("the paste went ahead without waiting for an answer")

    # Down twice and back once, so the wrap and the highlight are both exercised.
    run.drive("key down\nkey down\nkey up\nsleep 250\nkey f12\nsleep 200\n")
    expect(run.state(), answer="clash.keep_both")
    run.drive("key up\nsleep 250\nkey f12\nsleep 200\n")
    expect(run.state(), answer="clash.replace")

    run.drive("key enter\nsleep 1500\nkey f12\nsleep 400\n")
