    back = run.state()
    expect(back, tab="0", path=start["path"])
    run.drive("key ctrl+tab\nsleep 400\nkey f12\nsleep 200\n")
    if run.state()["path"] != str(fixture / "alpha"):
        raise Failure("Ctrl+Tab did not come back to the second tab")

    run.drive("key ctrl+w\nsleep 500\nkey f12\nsleep 200\n")
    closed = run.state()
    expect(closed, tabs="1", path=start["path"])
    if float(closed["body_top"]) != float(start["body_top"]):
        raise Failure("the list moved when a tab closed")

    run.drive("key ctrl+shift+t\nsleep 900\nkey f12\nsleep 200\n")
    reopened = run.state()
    expect(reopened, tabs="2")
    if reopened["path"] != str(fixture / "alpha"):
        raise Failure(f"the reopened tab is showing {reopened['path']}")


@scenario("open-in-a-new-tab-from-the-menu")
def open_in_a_new_tab(run: Run, fixture: Path) -> None:
    """A folder's menu puts it in a tab and leaves the view where it was.

    That is the whole point of the command — three folders queued up without
    going to any of them — so what this asserts is where the view *stayed*, and
    then that three of them arrive in the order they were listed in. Both routes
    are covered because they have different targets: the pointer's is the row
    under it, and the keyboard's is the selection.
    """
    listed(run)
    start = run.state()
    expect(start, tabs="1")

    onto = point_at(run, 0)
    if onto["hover_name"] != "alpha":
        raise Failure(f"row 0 is {onto['hover_name']!r}, wanted the alpha folder")
    run.drive("click right\nsleep 400\nkey f12\nsleep 200\n")
    opened = run.state()
    # Behind the Open in row, which is dimmed exactly when everything it opens
    # onto is — so over a folder it is offered, and the tab is a row of its
    # submenu.
    if "menu.open_in" in opened["menu_dim"]:
        raise Failure("Open in is dimmed over a folder")
    aimed = submenu_aim(run, opened, "menu.open_in", "go.open_new_tab")
    run.drive(
        f"move {aimed[0]:.1f} {aimed[1]:.1f}\nsleep 200\nclick\nsleep 900\nkey f12\nsleep 300\n"
    )
    behind = run.state()
    expect(behind, menu="0", tabs="2", tab="0", path=start["path"])

    run.drive("key ctrl+tab\nsleep 500\n")
    if listed(run)["path"] != str(fixture / "alpha"):
        raise Failure(f"the new tab is showing {run.state()['path']}")
    run.drive("key ctrl+w\nsleep 500\n")
    listed(run)

    # A file has nothing to open in a tab, and the row says so rather than
    # vanishing: the menu is the same shape every time it opens.
    onto = point_at(run, 3)
    if not onto["hover_name"].startswith("file-"):
        raise Failure(f"row 3 is {onto['hover_name']!r}, wanted a file")
    run.drive("click right\nsleep 400\nkey f12\nsleep 200\n")
    if "menu.open_in" not in run.state()["menu_dim"]:
        raise Failure("Open in a new tab is offered over a file")
    run.drive("key escape\nsleep 300\n")

    # Three folders at once. Inserted at a fixed point rather than a walking one,
    # they arrived in the strip backwards.
    run.drive("key home\nsleep 200\nkey shift+down\nkey shift+down\nsleep 250\nkey f12\nsleep 200\n")
    three = run.state()
    expect(three, selected="3", tabs="1")
    run.drive("key ctrl+enter\nsleep 900\nkey f12\nsleep 300\n")
    expect(run.state(), tabs="4", tab="0", path=start["path"])
    for folder in ("alpha", "beta", "gamma"):
        run.drive("key ctrl+tab\nsleep 500\n")
        if listed(run)["path"] != str(fixture / folder):
            raise Failure(f"the tabs are out of order: wanted {folder}, got {run.state()['path']}")


@scenario("open-a-folder-into-a-pane-beside-and-below")
