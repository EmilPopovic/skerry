    start = run.state()
    expect(start, path_entry="")
    crumbs = int(start["crumbs"])
    if crumbs < 2:
        raise Failure("this fixture has no breadcrumbs to sit beside")

    # Well right of the last crumb and left of the hint, at the strip's height.
    left, top, width, height = (float(value) for value in start["path_field"].split(","))
    empty = aim(run, start, left + width * 0.75, top + height / 2.0)
    run.drive(f"move {empty[0]:.2f} {empty[1]:.2f}\nsleep 200\nclick\nsleep 400\n")
    run.drive("key f12\nsleep 150\n")
    opened = run.state()
    if opened["path_entry"] != opened["path"]:
        raise Failure(f"the click opened {opened['path_entry']!r} for {opened['path']!r}")

