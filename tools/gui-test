@scenario("the-carried-card-follows-the-pointer", fresh=True)
def the_card_follows(run: Run, fixture: Path) -> None:
    """Every motion redraws while files are carried, not only a target change.

    The card is drawn at the pointer, so a frame marked dirty only when the
    *target* changes is a card that jumps from one folder row to the next
    instead of following the hand — which is what it did.

    **Counted in frames, because that is the difference.** Nothing else can see
    it: the pointer's position is reported whether a frame was drawn or not, and
    a golden frame cannot hold motion. So this moves over ground whose target
    never changes, with no `F12` inside the burst to draw frames of its own, and
    counts what the window drew.
    """
    del fixture
    listed(run)
    run.drive("text file-1.txt\nsleep 400\nkey f12\nsleep 200\n")
    chosen = run.state()
    held = point_at(run, int(chosen["cursor_row"]))
    from_point = aim(run, held, name_x(held), row_y(held, int(chosen["cursor_row"])))
    # Empty space low in the pane the drag started in: no folder row under it,
    # and its own pane takes no drop — so nothing about the target changes as the
    # pointer moves around down there.
    body = [float(part) for part in held["pane_body"].split(",")[0].split(":")]
    low = aim(run, held, body[0] + body[2] / 2.0, body[1] + body[3] - 30.0)
    lower = aim(run, held, body[0] + body[2] / 2.0 - 60.0, body[1] + body[3] - 12.0)

    run.drive(
        f"move {from_point[0]:.1f} {from_point[1]:.1f}\nsleep 200\npress\nsleep 150\n"
        + creep(from_point, low)
        + "sleep 300\nkey f12\nsleep 200\n"
    )
    before = run.state()
    expect(before, dragging="true", carrying="file-1.txt", drop_row="-1", drop_whole="0")
    drawn = int(before["frames"])

    run.drive(creep(low, lower, steps=8) + creep(lower, low, steps=8) + "key f12\nsleep 250\n")
    after = run.state()
    # The target is the same as it was, which is what makes the count mean
    # something: no frame here was asked for by anything changing.
    expect(after, dragging="true", drop_row="-1", drop_whole="0")
    moved = int(after["frames"]) - drawn
    # Sixteen motions. Half of that is well clear of the one or two frames the
    # `F12` itself draws, which is all this counted before the card followed.
    if moved < 8:
        raise Failure(f"sixteen motions drew {moved} frames, so the card is not following")
    run.drive("release\nsleep 600\n")


PEER = ROOT / "tools" / "gtk-drag-peer"


class Peer:
    """A GTK application on the same display, for the interop scenarios.

    **Somebody else's toolkit, in another process.** GTK is a banned dependency
    (rule 9) and stays banned — but what is under test here *is* interop with
    GTK, and a peer that can be driven from a script is worth more than one that
    has to be clicked. Spike D made the same trade for the clipboard.

    Not Nautilus, for a reason Spike D recorded: driving a file manager's own
    view means guessing where it drew an icon, and its X11 half failed exactly
    there. This peer is one big target at a known place, so a failure is about
    the protocol and not about somebody else's layout.
    """

    def __init__(self, work: Path, *arguments: str):
        if not PEER.is_file():
            raise Skipped("tools/gtk-drag-peer is missing")
        self.log = work / f"peer-{arguments[0]}.log"
        backend = "x11" if isinstance(SERVER, X11Server) else "wayland"
        # Placed away from the window under test where nothing else will place
        # it. A bare X server has no window manager, so two windows would both
        # map at the origin and the drag would begin and end in the same one.
        at = ["--at", "1150,120"] if backend == "x11" else []
        self.process = subprocess.Popen(
            [str(PEER), arguments[0], *at, *arguments[1:]],
            env=dict(with_server(), GDK_BACKEND=backend),
            stdout=self.log.open("w"),
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
        deadline = time.time() + PATIENCE
        while time.time() < deadline:
            if self.said("ready"):
                return
            if self.process.poll() is not None:
                raise Skipped(f"the GTK peer would not start: {self.output()[:200]}")
            time.sleep(0.1)
        raise Failure("the GTK peer never became ready")

    def yield_focus(self, run: Run) -> None:
        """Gives the keyboard back to the window under test, and checks it took.

        A compositor focuses what it has just mapped, so without this every key a
        scenario sends after starting a peer goes to the peer. Asked and then
        **verified**, because a focus request is asynchronous and a scenario that
        assumed it had landed failed later, on a state dump that never arrived,
        with a message about the window rather than about the focus.

        **The verification has to be of a *new* answer.** It used to be
        `run.state()` under a `suppress`, which reads the last line in the log —
        a line every scenario already has by the time it starts a peer. It could
        not raise, so it returned on the first attempt with the keyboard still on
        the peer, and this loop had never once gone round twice.
        """
        for _ in range(10):
            SERVER.focus("dev.skerry.Skerry")
            run.drive("sleep 200\n", answering=False)
            if run.answered(settle=200) is not None:
                return
        raise Failure("the window under test would not take the keyboard back")

    def output(self) -> str:
        return self.log.read_text() if self.log.exists() else ""

    def said(self, word: str) -> bool:
        return any(line.startswith(word) for line in self.output().splitlines())

    def wait_for(self, word: str, seconds: float = 6.0) -> str:
        """Waits for a line, and returns everything the peer has said."""
        deadline = time.time() + seconds
        while time.time() < deadline:
            if self.said(word):
                return self.output()
            time.sleep(0.15)
        raise Failure(f"the peer never said {word!r}; it said {self.output()!r}")

    def box(self) -> tuple[int, int, int, int]:
        return SERVER.box_of("gtk-drag-peer")

    def close(self) -> None:
        if self.process.poll() is None:
            with contextlib.suppress(ProcessLookupError):
                os.killpg(os.getpgid(self.process.pid), signal.SIGTERM)


def drag_between(
    run: Run,
    start: tuple[float, float],
    end: tuple[float, float],
    steps: int = 8,
    pace: int = 150,
) -> None:
    """A drag from one window to another, **paced**.

    `skerry-drive`'s own `drag` sends press, eight motions and release with
    nothing between them, which is right for a rubber band inside one window and
    wrong across two: the peer answers every position, and a gesture that outruns
    its replies is released before it has been accepted. Measured — the first
    attempt at this produced two `motion` lines from GTK and no drop at all.
    """
    script = [f"move {start[0]:.1f} {start[1]:.1f}", "sleep 300", "press", "sleep 200"]
    for step in range(1, steps + 1):
        across = start[0] + (end[0] - start[0]) * step / steps
        down = start[1] + (end[1] - start[1]) * step / steps
        script += [f"move {across:.1f} {down:.1f}", f"sleep {pace}"]
    script += ["sleep 500", "release", "sleep 1500"]
    run.drive("\n".join(script) + "\n")


def middle_of(run: Run, box: tuple[int, int, int, int]) -> tuple[float, float]:
    """The centre of a window, as the percentages the driver takes."""
    left, top, width, height = box
    across, down = SERVER.output_size()
    return ((left + width / 2) / across * 100.0, (top + height / 2) / down * 100.0)


@scenario("a-paste-takes-what-another-application-copied", fresh=True)
def paste_from_a_peer(run: Run, fixture: Path) -> None:
    """`x-special/gnome-copied-files` from somebody else, copy verb and cut verb.

    **The cut half is the one worth having.** Every other clipboard type names
    files and nothing else, so a cut that arrives as one of those is pasted as a
    copy and quietly leaves the original where it was — half of what was asked,
    with nothing to say so. This type is the only one carrying the verb, and the
    rule is that a peer's verb beats our own idea of what is on the clipboard.

    **`wl-copy` owns the selection, not this window**, because a window asked
    what it thinks it published is a test of nothing. That is the same bargain
    `clipboard()` makes in the other direction, and it is why this skips where
    `wl-copy` is absent — which is the X11 half, where no third-party clipboard
    writer is a given on a machine.

    What this does *not* verify is Nautilus's own bytes: the format below is the
    documented one, composed here. PyGObject cannot offer custom clipboard
    targets at all — `Gtk.Clipboard.set_with_data` and `set_with_owner` are both
    unbound — so the GTK peer that covers drag-and-drop cannot cover this, and
    the round trip against a real GNOME application stays owed.
    """
    owning = SERVER.copy_command("x-special/gnome-copied-files")
    if owning is None:
        raise Skipped("no third-party clipboard writer for this display server")

    # **Waited for, because the window is already listing this directory.** The
    # folder arrives by inotify rather than in the first read, and type-ahead
    # cannot match a row that has not been delivered yet. This used to work by
    # accident: `listed` stalled five seconds on a miscounted report, which was
    # long enough for the watch to fire, and the scenario failed the moment that
    # stall was fixed.
    rows = int(listed(run)["rows"])
    (fixture / "target").mkdir()
    until(run, rows=str(rows + 1))
    run.drive("text target\nkey enter\n")
    until(run, path=str(fixture / "target"), loading="false")

    for verb, name, moves in (("copy", "file-1.txt", False), ("cut", "file-2.txt", True)):
        source = fixture / name
        offered = f"{verb}\nfile://{source}".encode()
        owner = subprocess.Popen(
            owning,
            stdin=subprocess.PIPE,
            env=with_server(),
            start_new_session=True,
        )
        try:
            owner.stdin.write(offered)
            owner.stdin.close()
            # The offer has to be up before the paste asks for it, and `wl-copy`
            # takes the selection a moment after it is spawned.
            until(run, path=str(fixture / "target"))
            run.drive("key ctrl+v\n")
            settled(run)
            if not (fixture / "target" / name).is_file():
                raise Failure(f"a {verb} from another application did not paste {name}")
            if source.exists() is moves:
                raise Failure(
                    f"a {verb} left the original "
                    + ("behind" if moves else "nowhere")
                    + f": {name}"
                )
        finally:
            owner.terminate()
            with contextlib.suppress(subprocess.TimeoutExpired):
                owner.wait(timeout=5)

    # And `Ctrl+Z` walks back the one that moved, which is the half that would
    # otherwise be a peer's cut turning into a deletion nothing can undo.
    run.drive("key ctrl+z\n")
    settled(run)
    if not (fixture / "file-2.txt").is_file():
        raise Failure("undo did not bring back what a peer's cut moved")


@scenario("a-drag-out-lands-in-another-application", fresh=True)
def a_drag_out_lands(run: Run, fixture: Path) -> None:
    """A file dragged out of this window arrives in a GTK application.

    The whole outgoing path, against somebody else's implementation: the source
    is claimed, the types are offered, the peer asks for `text/uri-list` and the
    bytes travel through the selection machinery — `INCR` and all — before the
    peer reports what it received. "The peer read the data" is Spike D's
    criterion and it is the right one: whether the peer then does something
    useful with a `.txt` is the peer's business.
    """
    peer = Peer(run.work, "target")
    try:
        peer.yield_focus(run)
        run.drive("sleep 600\ntext file-1.txt\nsleep 400\nkey f12\nsleep 200\n")
        chosen = run.state()
        if chosen["cursor"] != "file-1.txt":
            raise Failure(f"the cursor is on {chosen['cursor']!r}")
        row = int(chosen["cursor_row"])
        held = point_at(run, row)
        from_point = aim(run, held, name_x(held), row_y(held, row))
        drag_between(run, from_point, middle_of(run, peer.box()))

        said = peer.wait_for("dropped")
        if "file-1.txt" not in said:
            raise Failure(f"the peer received {said!r}")
    finally:
        peer.close()


@scenario("a-drag-in-from-another-application-lands", fresh=True)
def a_drag_in_lands(run: Run, fixture: Path) -> None:
    """A file dragged in from a GTK application arrives in this folder.

    **A copy, always.** A peer that asked for a move removes its own original;
    doing it here would delete somebody else's file on a confirmation this
    program cannot get — Spike D measured the negotiated action reported zero
    times across every pairing.
    """
    outside = run.work / "outside"
    outside.mkdir(exist_ok=True)
    carried = outside / "from-the-peer.txt"
    carried.write_text("dragged in")

    peer = Peer(run.work, "source", f"file://{carried}")
    try:
        peer.yield_focus(run)
        run.drive("sleep 600\nkey f12\nsleep 200\n")
        before = run.state()
        # **The empty space below the last row**, which is the case the folder
        # under the pointer does not cover: files from elsewhere belong in the
        # directory being shown, and requiring a folder would refuse most of the
        # window. Dropping *on* a folder puts them in it, which the assertion
        # below would not be able to tell from this one.
        empty = float(before["body_top"]) + float(before["row_h"]) * (int(before["rows"]) + 1)
        if empty >= float(before["body_top"]) + float(before["body_height"]):
            raise Failure("no empty space below the last row to drop into")
        into = aim(run, before, name_x(before), empty)
        drag_between(run, middle_of(run, peer.box()), into, steps=14, pace=220)

        # **The file first, then the protocol's courtesy.** `XdndFinished` is sent
        # after the drop has been *acted* on, so waiting for it before waiting for
        # the file was waiting for the second half of a job with a six-second
        # budget. Measured: **two failures in eight runs** before this, on this
        # commit and on the one before it — so the sweeps had been passing on luck.
        #
        # **What used to fail about one run in eight was the peer.** GTK queues
        # the `SelectionNotify` while `drag-data-get` runs and writes it when its
        # main loop next comes round; with no window manager and no further input
        # there was no next time, so the window slept — correctly — waiting for
        # bytes nobody had sent. `ss -x` on both processes showed zero queued in
        # either direction, which is the reading that finally said so;
        # `gtk-drag-peer` now flushes on an idle source, which reduced nothing
        # measurable and is kept because it is right anyway. Three rounds of
        # hypotheses about *this* program are in
        # [12-measurement.md](../docs/12-measurement.md), and every one of them
        # was about the wrong process. The dump below stays, because it is what
        # made the difference visible.
        peer.wait_for("asked for text/uri-list")
        landed = False
        # **Twenty seconds, and the number is the peer's.** GTK's handler has run
        # by this line — that is what the wait above is — and the
        # `SelectionNotify` that answers it is still, about one drag in ten,
        # **9.6 seconds** behind it, measured with a timestamp either side of the
        # wire and with `ss -x` showing zero queued bytes on both processes for
        # the whole of the gap. Nothing had been sent, this window was correctly
        # asleep, and the file lands the moment the reply does. Fifty flushes at
        # 20 ms from inside the peer's handler changed the rate not at all.
        #
        # So the budget here is a budget for somebody else's toolkit, and eight
        # seconds was a guess at it. Twenty is a ceiling rather than an
        # expectation: what actually removed the flake is the keystroke in the
        # loop below. See
        # [12-measurement.md](../docs/12-measurement.md#nine-point-six-seconds-that-were-never-ours).
        deadline = time.time() + 20.0
        while time.time() < deadline:
            if (fixture / carried.name).exists():
                landed = True
                break
            # **Polled with an `F12`, and the keystroke is the point.**
            # Measured, twenty runs each: waiting on the directory alone fails
            # 2 in 20 and the reply lands 9.6 s late; waiting on it while
            # sending this window a key fails **0 in 20**. The reply arrives when
            # this window is given an event and not before, with nothing queued
            # on either socket in the meantime — see the section this comment's
            # sibling links to. Where that lives between GTK and `Xvfb` is not
            # settled, and this is not a fix for it.
            #
            # It is the honest condition to test under. A window on a real
            # desktop is never event-starved: a compositor, a window manager and
            # a pointer that a hand is resting on send it something several times
            # a second. A bare `Xvfb` with no window manager and a virtual
            # pointer parked where the drop left it sends nothing at all, and
            # that quiet is the artefact, not the drag.
            run.drive("key f12\nsleep 120\n", answering=False)
        if not landed:
            # **What the window thought, not just what the directory holds.** The
            # peer has been asked for the data by this point, so a file that never
            # arrives is one of three things — the transfer, the operation queue,
            # or a drop that was refused — and which of them it was is the whole
            # of what a rare failure has to say for itself. The listing is taken
            # *before* the window is touched, because touching it is what unsticks
            # the drop and the first version of this message read as though the
            # file had been there all along.
            held = sorted(p.name for p in fixture.iterdir())
            # **What every thread is waiting on, read out of `/proc`.** No
            # perturbation at all, which matters here: an `eprintln!` in the frame
            # loop hides this defect, so anything that touches the process is a
            # measurement of something else.
            # **And what is waiting on the display socket.** If the peer's
            # answer is sitting in this process's receive queue while its main
            # thread sleeps in `poll`, the bug is ours; if the queue is empty,
            # nothing has been sent to us and the wait is correct. Read out of
            # `/proc`, which costs the process under test nothing.
            print(f"        window sockets {socket_queue(run.process.pid)}", flush=True)
            # **And the peer's**, because an empty queue on both sides means the
            # answer was never written by the application that owes it.
            print(f"        peer sockets   {socket_queue(peer.process.pid)}", flush=True)
            for task in sorted(Path(f"/proc/{run.process.pid}/task").iterdir()):
                try:
                    name = (task / "comm").read_text().strip()
                    wchan = (task / "wchan").read_text().strip()
                    call = (task / "syscall").read_text().strip().split()
                except OSError:
                    continue
                print(f"        thread {task.name} {name} wchan={wchan} syscall={call[:4]}",
                      flush=True)
            run.drive("key f12\nsleep 200\n")
            said = run.state()
            raise Failure(
                f"nothing landed in 20s: {held}; "
                f"drag_in={said['drag_in']} selections={said['selections']} "
                f"drops={said['drops']} "
                f"busy={said['busy']} queue={said['queue']} "
                f"undo={said['undo']} jobs={said['jobs']} notice={said['notice']!r}; "
                f"it is there now: {(fixture / carried.name).exists()}"
            )
        peer.wait_for("drag ended")
        # The peer's original stays: a drag in is a copy.
        if not carried.is_file():
            raise Failure("the drag deleted the peer's original")
    finally:
        peer.close()


def row_under_point(state: dict[str, str], percent_y: float, run: Run) -> int | None:
    """Which list row is under a point given as the driver's percentage.

    So a scenario can check that the thing it is covering is really there: an
    assertion about what does *not* light up is worth nothing if nothing was
    going to.
    """
    _, top, _, height = SERVER.window_box()
    _, down = SERVER.output_size()
    del run
    logical_y = percent_y / 100.0 * down - top
    body_top, row_h = float(state["body_top"]), float(state["row_h"])
    if logical_y < body_top:
        return None
    row = int((logical_y - body_top) // row_h)
    return row if row < int(state["rows"]) else None


def crumb_row_aim(run: Run, state: dict[str, str], name: str) -> tuple[float, float]:
    """Where to click a row of the open sibling menu, by the directory it names."""
    for entry in state.get("crumb_menu_aim", "").split(","):
        row, _, point = entry.partition("@")
        if row == name:
            x, _, y = point.partition(":")
            return aim(run, state, float(x), float(y))
    raise Failure(f"no menu row called {name!r}: {state.get('crumb_menu_aim')!r}")


def tool_aim(run: Run, state: dict[str, str], index: int) -> tuple[float, float]:
    """The middle of one of the four navigation buttons, in the focused pane's bar.

    **Not an offset into the window any more.** The buttons moved into the pane,
    under its tab strip, so both coordinates come from where the frame put that
    pane's bar rather than from the window's top-left corner.
    """
    width = float(state["tool_w"])
    if width <= 0.0:
        raise Failure("the navigation buttons were shed at this window size")
    x = float(state["tools_x"]) + width * (index + 0.5)
    y = float(state["bar_y"]) + float(state["bar_h"]) / 2.0
    return aim(run, state, x, y)


def separator_aim(run: Run, state: dict[str, str], depth: int) -> tuple[float, float]:
    """Where to click the breadcrumb separator after component `depth`.

    The window reports the middle of every drawn one, so a scenario aims by depth
    and never by arithmetic over the path bar's own constants — which it would
    have to copy, and which would then be a second copy to keep right.
    """
    for entry in state.get("separator_aim", "").split(","):
        name, _, point = entry.partition("@")
        if name == str(depth):
            x, _, y = point.partition(":")
            return aim(run, state, float(x), float(y))
    raise Failure(f"no separator at depth {depth}: {state.get('separator_aim')!r}")


@scenario("a-separator-lists-the-siblings-beside-it", fresh=True)
def a_separator_lists_siblings(run: Run, fixture: Path) -> None:
    """The chevron between two components opens what is between them.

    **The whole point of a Windows 11 path bar.** A separator sits between two
    components, so the directories inside the one on its left are the *siblings*
    of the one on its right — which is the list a person wants when they are
    three levels deep and meant to be in the folder next door. It turns "up, up,
    down, down" into one press and one click, at any depth.

    The listing happens on a job: rule 1 gives the UI thread no filesystem
    syscalls, and a separator over a hung mount is the case that rule is for. So
    the menu is asked for and opens when the answer lands, which is why this
    waits for it rather than asserting on the next frame.
    """
    (fixture / "alpha" / "sideways").mkdir()
    run.drive("sleep 500\ntext alpha\nsleep 400\nkey enter\nsleep 700\nkey f12\nsleep 200\n")
    inside = run.state()
    if not inside["path"].endswith("/alpha"):
        raise Failure(f"did not get into alpha: {inside['path']}")
    deep = int(inside["crumbs"])

    # The separator *before* the leaf: its left neighbour is the fixture, so its
    # list is the leaf's own siblings.
    where = separator_aim(run, inside, deep - 2)
    run.drive(f"move {where[0]:.1f} {where[1]:.1f}\nsleep 200\nclick\nsleep 900\nkey f12\nsleep 300\n")
    opened = run.state()
    if int(opened["crumb_menu"]) < 3:
        raise Failure(f"the menu holds {opened['crumb_menu']} rows, wanted the fixture's folders")
    expect(opened, crumb_menu_depth=str(deep - 2))
    # It opens on the component the path already goes through, so the keyboard
    # starts from where the person is rather than from the top of an alphabet.
    expect(opened, crumb_menu_active="alpha")

    # And down to a sibling, then Enter, and that is where we are. One key per
    # drive: two sent together race the frame that processes the first.
    run.drive("key down\nsleep 300\nkey f12\nsleep 300\n")
    moved = run.state()
    if moved["crumb_menu_active"] == "alpha":
        raise Failure("Down did not move off the current component")
    chosen = moved["crumb_menu_active"]
    run.drive("key enter\nsleep 900\nkey f12\nsleep 300\n")
    landed = run.state()
    if landed["path"] != str(fixture / chosen):
        raise Failure(f"chose {chosen!r} and landed in {landed['path']}")
    expect(landed, crumb_menu="-1")


@scenario("the-last-separator-lists-what-is-inside-here", fresh=True)
def the_last_separator_lists_children(run: Run, fixture: Path) -> None:
    """The chevron after the last component lists the children of here.

    It has no right-hand neighbour, so its list is what is inside the current
    directory — a way into a subdirectory without leaving, and the one that saves
    the most steps.
    """
    run.drive("sleep 500\nkey f12\nsleep 200\n")
    start = run.state()
    deep = int(start["crumbs"])

    # Over a breadcrumb first, so something *is* lit when the menu opens — the
    # pointer reaches a chevron by crossing the component beside it, and a
    # component left lit under the panel is the same false promise as a row.
    crumb = aim(run, start, float(start["parent_crumb_x"]), float(start["parent_crumb_y"]))
    run.drive(f"move {crumb[0]:.1f} {crumb[1]:.1f}\nsleep 250\nkey f12\nsleep 200\n")
    if run.state()["crumb_hover"] == "-1":
        raise Failure("the breadcrumb did not light, so nothing is being covered")

    where = separator_aim(run, start, deep - 1)
    run.drive(f"move {where[0]:.1f} {where[1]:.1f}\nsleep 200\nclick\nsleep 900\nkey f12\nsleep 300\n")
    opened = run.state()
    expect(opened, crumb_menu_depth=str(deep - 1))
    if int(opened["crumb_menu"]) != 3:
        raise Failure(f"the menu holds {opened['crumb_menu']} rows, wanted the three folders")
    # Nothing below the last component is on the path, so nothing is marked and
    # nothing is selected until a key or the pointer says so.
    expect(opened, crumb_menu_active="")

    # One key per drive, and asserted between: a `Down` and an `Enter` sent
    # together race the frame that processes the first, and an `Enter` that
    # arrives with nothing highlighted does nothing at all.
    # **Nothing under the panel lights up.** The menu hangs over the list, and a
    # row lighting up behind it reads as a click that will land there — which it
    # will not: a press outside this menu closes it and does nothing else.
    #
    # `gamma` and not `alpha`: the first menu row sits above the list's first,
    # so hovering it would prove nothing whichever way the code went. The row
    # chosen here is checked below to be over a real one.
    over = crumb_row_aim(run, opened, "gamma")
    covered = row_under_point(opened, over[1], run)
    if covered is None:
        raise Failure("the menu row chosen does not cover a list row, so this proves nothing")
    run.drive(f"move {over[0]:.1f} {over[1]:.1f}\nsleep 300\nkey f12\nsleep 250\n")
    expect(run.state(), crumb_menu_active="gamma", hover="-1", hover_name="", crumb_hover="-1")

    run.drive("key down\nsleep 300\nkey f12\nsleep 300\n")
    chosen = run.state()["crumb_menu_active"]
    if not chosen:
        raise Failure("Down highlighted nothing")
    run.drive("key enter\nsleep 900\nkey f12\nsleep 300\n")
    landed = run.state()
    if landed["path"] != str(fixture / chosen):
        raise Failure(f"chose {chosen!r} and landed in {landed['path']}")
    if Path(landed["path"]).parent != fixture:
        raise Failure(f"landed in {landed['path']}, wanted a child of the fixture")

    # Escape closes it without going anywhere.
    where = separator_aim(run, landed, int(landed["crumbs"]) - 1)
    run.drive(f"move {where[0]:.1f} {where[1]:.1f}\nsleep 200\nclick\nsleep 900\nkey escape\nsleep 300\nkey f12\nsleep 200\n")
    expect(run.state(), crumb_menu="-1", path=landed["path"])


def scan_sidebar(run: Run, state: dict[str, str], label: str) -> tuple[float, float]:
    """Where the sidebar row called `label` is, found by hovering down it.

    A row's y depends on how many section headings came before it, which is known
    where it is drawn and nowhere else — so the harness looks rather than
    calculates, the same way `point_at` does for a list row.
    """
    width = float(state["sidebar_w"])
    if width <= 0.0:
        raise Failure("the sidebar is closed or was shed at this window size")
    step = 6.0
    logical_y = float(state["sidebar_top"]) + step
    height = float(state["logical"].split("x")[1])
    while logical_y < height:
        x, y = aim(run, state, width / 2.0, logical_y)
        run.drive(f"move {x:.2f} {y:.2f}\nsleep 70\nkey f12\nsleep 70\n")
        if run.state()["place_name"] == label:
            return x, y
        logical_y += step
    raise Failure(f"no sidebar row called {label!r}")


@scenario("path-entry")
def path_entry(run: Run, fixture: Path) -> None:
    """Ctrl+L, a path, Enter — and the pointer can reach it too.

    Three routes into one field: the chord, a click that places the caret, and
    the context menu, because the promise is that every command has both halves.
    """
    run.drive("sleep 500\nkey ctrl+l\nsleep 250\nkey f12\nsleep 150\n")
    opened = run.state()
    expect(opened, path_entry=str(fixture))

    # Ctrl+U clears it, and a relative name is taken from where you are.
    run.drive("key ctrl+u\ntext alpha\nsleep 200\nkey f12\nsleep 150\n")
    expect(run.state(), path_entry="alpha")
    run.drive("key enter\nsleep 800\nkey f12\nsleep 200\n")
    expect(run.state(), path="" + str(fixture / "alpha"), path_entry="")

    # Escape puts the breadcrumbs back and goes nowhere.
    run.drive("key ctrl+l\nsleep 200\nkey ctrl+u\ntext /etc\nsleep 150\nkey escape\nsleep 250\nkey f12\nsleep 200\n")
    expect(run.state(), path=str(fixture / "alpha"), path_entry="")

    # And `~` is this user's home, which is the one expansion the field does.
    run.drive("key ctrl+l\nsleep 200\nkey ctrl+u\ntext ~\nsleep 150\nkey f12\nsleep 150\n")
    typed = run.state()
    if typed["path_entry"] != "~":
        raise Skipped(f"this keymap cannot type a tilde: {typed['path_entry']!r}")
    run.drive("key enter\nsleep 900\nkey f12\nsleep 200\n")
    expect(run.state(), path=os.environ.get("HOME", ""))


@scenario("path-entry-by-pointer")
def path_entry_by_pointer(run: Run, fixture: Path) -> None:
    """The menu opens the field, and a click inside it moves the caret."""
    run.drive("sleep 500\nkey f12\nsleep 100\n")
    start = run.state()
    # The empty space below the last row, where the background menu lives.
    below = float(start["body_top"]) + float(start["row_h"]) * (int(start["rows"]) + 1)
    if below >= float(start["body_top"]) + float(start["body_height"]):
        raise Failure("no empty space below the last row to click in")
    where = aim(run, start, 300.0, below)
    run.drive(
        f"move {where[0]:.1f} {where[1]:.1f}\n"
        "sleep 150\nclick right\nsleep 400\nkey f12\nsleep 150\n"
    )
    opened = run.state()
    # **`menu_aim` scrolls to find it**, because the background menu is taller than
    # the window and has been since it was written — the `context-menu` golden
    # frame exists partly to show the arrow that says there is more. Every row
    # added to it pushes the tail further off, and this row is now past the end.
    aimed = menu_aim(run, opened, "view.path_entry")
    run.drive(f"move {aimed[0]:.1f} {aimed[1]:.1f}\nsleep 200\nclick\nsleep 400\nkey f12\nsleep 200\n")
    field = run.state()
    expect(field, menu="0", path_entry=str(fixture))

    # A click a third of the way along the text puts the caret there rather than
    # committing, and a click outside puts the breadcrumbs back.
    # Aimed at the box the window reports rather than at a number: 60 logical
    # pixels is left of the field's own left edge at 125, and it only ever worked
    # because a click there happened to land on nothing. Under a bare X server the
    # window draws its own frame, that same point is on the title bar, and the
    # press went to the frame instead.
    box = [float(value) for value in field["path_field"].split(",")]
    inside = aim(run, field, box[0] + box[2] / 3.0, box[1] + box[3] / 2.0)
    run.drive(f"move {inside[0]:.1f} {inside[1]:.1f}\nsleep 150\nclick\nsleep 250\nkey f12\nsleep 150\n")
    expect(run.state(), path_entry=str(fixture), path=str(fixture))
    run.drive("key ctrl+u\nsleep 150\nkey f12\nsleep 150\n")
    clipped = run.state()["path_entry"]
    if clipped == str(fixture) or not str(fixture).endswith(clipped):
        raise Failure(f"the click did not move the caret: cleared to {clipped!r}")

    away = aim(run, field, 300.0, float(field["body_top"]) + 40.0)
    run.drive(f"move {away[0]:.1f} {away[1]:.1f}\nsleep 150\nclick\nsleep 250\nkey f12\nsleep 150\n")
    expect(run.state(), path_entry="", path=str(fixture))


@scenario("path-completion-is-a-list-and-not-a-mode", fresh=True)
def path_completion(run: Run, fixture: Path) -> None:
    """Tab finishes a path, and the list never becomes a second keyboard.

    **The gate for the two flags.** `completing` is what is on offer and
    `completion_chosen` is which row the keyboard is on, and the whole of row 9
    is that those are different questions: the list can be up with the keyboard
    still in the field, an arrow moves it into the list, and typing a character
    brings it straight back. One flag for both makes the list a mode, and rule 2
    names the field that was already caught in one.

    **The names arrive from a job**, which is why every assertion here is a poll
    rather than a read: the `readdir` is on the pool because rule 1 gives the UI
    thread no filesystem syscalls, so the list appears a frame or more after the
    key that asked for it.

    **A fixture of its own**, because the shared one is called `fixture` and a
    sweep leaves `fixture-<scenario>` beside it: a field holding `…/fixture` then
    has real completions, and the first assertion below would be about the
    harness's directory names rather than about the list.
    """
    run.drive("sleep 500\nkey ctrl+l\nsleep 250\nkey f12\nsleep 150\n")
    opened = run.state()
    # A complete name is not a list: `Ctrl+L` opens holding the whole path, and a
    # panel repeating its last component back would cover the rows underneath.
    expect(opened, path_entry=str(fixture), completing="")

    # A separator asks what is inside, and three folders answer.
    run.drive("text /\nsleep 200\n")
    until(run, completing="alpha,beta,gamma", completion_chosen="-1")

    # One character narrows it, and the keyboard is still in the field.
    run.drive("text a\nsleep 200\n")
    until(run, completing="alpha", completion_chosen="-1")

    # Tab finishes the one match, leaves the separator that asks for the level
    # under it, and the list is that level.
    run.drive("key tab\nsleep 250\n")
    until(run, path_entry=f"{fixture / 'alpha'}/", completing="nested")

    # The two flags, in both directions.
    run.drive("key down\nsleep 200\n")
    until(run, completion_chosen="0", completing="nested")
    run.drive("text n\nsleep 200\n")
    until(run, completion_chosen="-1", completing="nested")

    # Enter on a chosen row writes that name and goes nowhere: the field is still
    # open and the pane has not moved.
    run.drive("key down\nsleep 200\n")
    until(run, completion_chosen="0")
    run.drive("key enter\nsleep 250\n")
    until(run, path_entry=f"{fixture / 'alpha' / 'nested'}/", path=str(fixture))

    # And one Escape takes the field and the list together — no second press owed.
    run.drive("key escape\nsleep 250\n")
    until(run, path_entry="", completing="", path=str(fixture))


@scenario("middle-click-opens-a-tab-and-pastes-the-primary-selection")
def middle_click(run: Run, fixture: Path) -> None:
    """Row 10's two halves, both of them registry commands rather than branches.

    Over a row the middle button is `go.open_new_tab`, on the row it is *on*; in
    a field it is `field.paste_primary`, which is what X11 named PRIMARY and
    Wayland kept. The second half also proves the publishing side: a pointer
    selection in a field has to reach PRIMARY, or the paste has nothing to find.
    """
    run.drive("sleep 500\nkey f12\nsleep 150\n")
    start = run.state()
    expect(start, tabs="1")

    onto = point_at(run, 0)
    if onto["hover_name"] != "alpha":
        raise Failure(f"row 0 is {onto['hover_name']!r}, wanted the alpha folder")
    run.drive("click middle\nsleep 700\n")
    # Behind, the way a browser opens one: the tab exists and the keyboard has
    # not moved to it.
    opened = until(run, tabs="2", tab="0")
    expect(opened, path=str(fixture))
    run.drive("key ctrl+shift+tab\nsleep 300\n")
    until(run, tab="1", path=str(fixture / "alpha"))
    run.drive("key ctrl+w\nsleep 400\n")
    until(run, tabs="1", path=str(fixture))

    # The field half. A drag across the whole box selects the path, which is the
    # gesture that publishes it; End drops the selection and leaves the caret at
    # the end, so what arrives can only have come from the selection.
    run.drive("key ctrl+l\nsleep 400\nkey f12\nsleep 150\n")
    field = run.state()
    if not field["path_entry"]:
        raise Failure("Ctrl+L opened no path field")
    left, top, width, height = (float(value) for value in field["path_field"].split(","))
    middle = top + height / 2.0
    start_at = aim(run, field, left + 4, middle)
    end_at = aim(run, field, left + width * 0.95, middle)
    run.drive(
        f"move {start_at[0]:.2f} {start_at[1]:.2f}\nsleep 200\n"
        f"drag {start_at[0]:.2f} {start_at[1]:.2f} {end_at[0]:.2f} {end_at[1]:.2f}\n"
        "sleep 300\nkey f12\nsleep 200\n"
    )
    if run.state()["path_selected"] != field["path_entry"]:
        raise Failure("the drag selected none of the path, so nothing was published")

    inside = aim(run, field, left + width * 0.5, middle)
    run.drive(
        f"key end\nsleep 200\nmove {inside[0]:.2f} {inside[1]:.2f}\nsleep 200\n"
        "click middle\nsleep 500\n"
    )
    until(run, path_entry=f"{fixture}{fixture}")
    run.drive("key escape\nsleep 250\n")
    until(run, path_entry="", path=str(fixture))


@scenario("two-fields-never-open-at-once", fresh=True)
def two_fields_never_open_at_once(run: Run, fixture: Path) -> None:
    """A caret in two places at once is a keyboard nobody can predict.

    **A field is left before another opens, and a keystroke cannot swap them.**
    That used to be the other way round: `Ctrl+L` inside a rename field committed
    the rename and opened the path bar, so a stray chord renamed a file to whatever
    had been typed so far. A field now rejects what does not apply to it, and the
    invariant holds because the second field never opens at all.

    The filter is the exception and stays one: it is a `String` with no caret, not
    a field, so a chord still reaches its command from inside it.
    """
    run.drive("sleep 500\nkey down\nkey f2\nsleep 300\nkey f12\nsleep 150\n")
    naming = run.state()
    original = naming["naming"]
    if not original:
        raise Failure("F2 opened no field")

    # A chord that would open another field does nothing at all, and — the part
    # that matters — does not rename anything on the way.
    run.drive("key home\ntext two-\nsleep 150\nkey ctrl+l\nsleep 800\nkey f12\nsleep 200\n")
    held = run.state()
    expect(held, naming=f"two-{original}", path_entry="")
    if (fixture / f"two-{original}").exists():
        raise Failure("Ctrl+L committed a half-typed rename as a side effect")

    # Leaving it first is what opens the other one.
    run.drive("key escape\nsleep 250\nkey ctrl+l\nsleep 400\nkey f12\nsleep 200\n")
    swapped = run.state()
    expect(swapped, naming="", path_entry=str(fixture))
    if (fixture / f"two-{original}").exists():
        raise Failure("Escape committed the rename rather than abandoning it")

    # And the same in the other direction: the path field rejects Ctrl+F.
    run.drive("key ctrl+f\nsleep 300\nkey f12\nsleep 150\n")
    expect(run.state(), filtering="false", path_entry=str(fixture))

    # A secondary click in the field leaves it open and opens no menu at all.
    field_box = [float(value) for value in swapped["path_field"].split(",")]
    inside = aim(run, swapped, field_box[0] + field_box[2] / 3.0, field_box[1] + field_box[3] / 2.0)
    run.drive(
        f"move {inside[0]:.1f} {inside[1]:.1f}\n"
        "sleep 150\nclick right\nsleep 400\nkey f12\nsleep 200\n"
    )
    expect(run.state(), menu="0", path_entry=str(fixture))

    # The filter is not a field, so a chord still reaches its command from inside
    # it — and opening a field takes the keyboard off the filter box without
    # putting back the rows it hid. See a-filter-outlives-the-field-that-typed-it.
    run.drive("key escape\nsleep 200\nkey ctrl+f\ntext al\nsleep 300\nkey f12\nsleep 150\n")
    expect(run.state(), filtering="true", path_entry="", filter="al")
    run.drive("key ctrl+l\nsleep 300\nkey f12\nsleep 150\n")
    expect(run.state(), filtering="false", filter="al", path_entry=str(fixture))

    # Escape leaves the path bar, and a second drops the filter it never touched.
    run.drive("key escape\nsleep 250\nkey escape\nsleep 300\nkey f12\nsleep 150\n")
    expect(run.state(), filter="", path_entry="")

    run.drive("key ctrl+f\nsleep 250\nkey f2\nsleep 300\nkey f12\n")
    run.drive("sleep 150\n")
    named = run.state()
    if not named["naming"]:
        raise Failure(f"F2 from the filter opened no field: {named}")
    expect(named, filtering="false")

    # Navigating closes whatever is open: a field belongs to the directory it was
    # opened in, and its subject is in that one. `Alt ↑` is a window-and-listing
    # command, so it is one of the ones a field rejects — hence the Escape first.
    run.drive("key escape\nsleep 200\nkey alt+up\nsleep 800\nkey f12\nsleep 200\n")
    left = run.state()
    expect(left, path_entry="", naming="", filtering="false")
    if left["path"] == str(fixture):
        raise Failure("Alt+Up went nowhere, so nothing was proved")


@scenario("everything-in-an-awkward-order", fresh=True)
def everything_in_an_awkward_order(run: Run, fixture: Path) -> None:
    """Every new surface, opened over every other one, and nothing may die.

    Not an assertion about behaviour — the scenarios above make those. This is
    the pass that says the combinations nobody designed for do not crash, hang
    or leave two fields with a caret in them, which is the class of defect a
    person finds in the first ten minutes and a per-feature test never does.
    """
    run.drive(
        "sleep 500\n"
        "key ctrl+l\nkey shift+f10\nsleep 200\n"      # menu over the path field
        "key escape\nkey escape\nsleep 150\n"
        "key ctrl+f\ntext al\nkey shift+f10\nsleep 200\n"   # menu over the filter
        "key escape\nkey escape\nsleep 150\n"
        "key ctrl+shift+n\nsleep 700\n"                # a folder, then abandon the name
        "key escape\nsleep 200\n"
        "key f2\nkey ctrl+l\nsleep 500\n"             # rename, then the path bar
        "key escape\nsleep 200\n"
        "key ctrl+z\nsleep 700\n"                      # take the folder back
        "key f1\nkey shift+f10\nsleep 200\n"          # a menu over the keyboard list
        "key escape\nkey f1\nsleep 150\n"
        "key end\nkey delete\nsleep 700\n"            # trash and redo
        "key ctrl+z\nsleep 700\nkey ctrl+shift+z\nsleep 700\n"
        "key ctrl+z\nsleep 700\n"
        "key f12\nsleep 300\n"
    )
    end = run.state()
    if run.process.poll() is not None:
        raise Failure(f"the window died: {run.err.read_text()[-400:]}")
    # Everything closed, nothing owed, and the directory back as it started.
    expect(end, naming="", path_entry="", menu="0", filtering="false", busy="false")
    expect(end, path=str(fixture), rows="9", undo="false")
    if sorted(p.name for p in fixture.iterdir()) != sorted(
        ["alpha", "beta", "gamma", ".hidden"] + [f"file-{index}.txt" for index in range(1, 7)]
    ):
        raise Failure(f"the directory did not come back: {sorted(p.name for p in fixture.iterdir())}")


@scenario("sidebar-places")
def sidebar_places(run: Run, fixture: Path) -> None:
    """The list of places is there, one row is where you are, and a click goes.

    What is in it comes from this machine — `user-dirs.dirs`, GTK's `bookmarks`
    and `/proc/self/mountinfo` — so the assertions are about the shape rather
    than the contents: Home is always there, and clicking it lands in `$HOME`.
    """
    run.drive("sleep 800\nkey f12\nsleep 200\n")
    state = run.state()
    if int(state["places"]) < 2:
        raise Failure(f"only {state['places']} places; the job that reads them found nothing")
    if float(state["sidebar_w"]) <= 0.0:
        raise Failure("the sidebar is not open")

    scan_sidebar(run, state, "Home")
    # **And nothing in the list is hovered.** The sidebar is at the same height
    # as every row, so a hit test told only a `y` lit the row beside the place
    # the pointer was actually over.
    expect(run.state(), hover="-1", hover_name="")

    run.drive("click\nsleep 900\nkey f12\nsleep 200\n")
    expect(run.state(), path=os.environ["HOME"])


# `unshare -Urm` maps this user to root in a namespace of its own, which is the
# only way a test can mount anything: the mount is invisible outside it and gone
# when the process is.
MOUNT_WRAPPER = """
"$0" "$@" &
child=$!
waited=0
while [ ! -e "$SKERRY_MOUNT_TRIGGER" ] && [ "$waited" -lt 400 ]; do
    sleep 0.05
    waited=$((waited + 1))
done
mount -t tmpfs none "$SKERRY_MOUNT_TARGET" && echo mounted >"$SKERRY_MOUNT_TRIGGER.done"
wait "$child"
"""


@scenario("a-mount-reaches-the-sidebar")
def a_mount_reaches_the_sidebar(run: Run, fixture: Path) -> None:
    """`/proc/self/mountinfo` is polled, so plugging a disk in is not a restart.

    A `tmpfs` is the only filesystem a test can mount without being root, and a
    `tmpfs` is deliberately not something the sidebar shows — so what this
    asserts is that the notification arrived and the sections were read again,
    which is every part of the path except the row.
    """
    work = run.log.parent
    trigger = work / "mount-trigger"
    target = work / "mount-target"
    target.mkdir(exist_ok=True)
    trigger.unlink(missing_ok=True)
    run.close()

    own = Run(
        run.display,
        work,
        fixture,
        [],
        run.instance,
        {"SKERRY_MOUNT_TRIGGER": str(trigger), "SKERRY_MOUNT_TARGET": str(target)},
        ["unshare", "-Urm", "sh", "-c", MOUNT_WRAPPER],
    )
    try:
        own.drive("sleep 700\nkey f12\nsleep 200\n")
        before = own.state()
        if int(before["places_loaded"]) < 1:
            raise Failure("the sidebar never loaded at all")

        trigger.write_text("go")
        deadline = time.time() + 8
        while time.time() < deadline and not (work / "mount-trigger.done").exists():
            time.sleep(0.1)
        if not (work / "mount-trigger.done").exists():
            raise Skipped("this kernel would not let an unprivileged namespace mount a tmpfs")

        own.drive("sleep 600\nkey f12\nsleep 200\n")
        after = own.state()
        if int(after["places_loaded"]) <= int(before["places_loaded"]):
            raise Failure(
                f"a mount did not reach the sidebar: loaded "
                f"{before['places_loaded']} then {after['places_loaded']}"
            )
        # And the rows did not change, because a tmpfs is not a volume.
        expect(after, places=before["places"])
    finally:
        own.close()


@scenario("sidebar-toggle")
def sidebar_toggle(run: Run, fixture: Path) -> None:
    """`F9` closes it and gives the width to the list, and again brings it back.

    The list's own left edge has to move with it, or the rows draw under the
    sidebar — which is why this asserts on `name_x` and not only on the width.
    """
    run.drive("sleep 500\nkey f12\nsleep 200\n")
    open_state = run.state()
    if float(open_state["sidebar_w"]) <= 0.0:
        raise Failure("the sidebar did not start open")

    run.drive("key f9\nsleep 400\nkey f12\nsleep 200\n")
    closed = run.state()
    if float(closed["sidebar_w"]) != 0.0:
        raise Failure(f"the sidebar is {closed['sidebar_w']} wide after F9")
    if float(closed["name_x"]) >= float(open_state["name_x"]):
        raise Failure("the name column did not move into the freed width")

    run.drive("key f9\nsleep 400\nkey f12\nsleep 200\n")
    again = run.state()
    expect(again, sidebar_w=open_state["sidebar_w"], name_x=open_state["name_x"])


def place_logical(state: dict[str, str], index: int) -> tuple[float, float]:
    """The middle of the sidebar row at `index`, in the window's own pixels.

    From `place_aim`, which the window reports one point per drawn row: a row's
    `y` depends on how many section headings came before it, and duplicating that
    arithmetic here is how the harness and the window come to disagree.
    """
    points = [it for it in state["place_aim"].split(",") if it]
    if index >= len(points):
        raise Failure(f"no sidebar row {index}; there are {len(points)}")
    across, down = (float(value) for value in points[index].split(":"))
    return across, down


def place_point(run: Run, state: dict[str, str], index: int) -> tuple[float, float]:
    """Where to click the sidebar row at `index`, as the driver's percentages."""
    return aim(run, state, *place_logical(state, index))


def hover_place(run: Run, index: int) -> dict[str, str]:
    """Puts the pointer on sidebar row `index` and checks it landed there.

    **Checked, because the conversion has two moving parts.** A point comes out
    of the frame's own rectangle, and turning it into the driver's percentages
    needs the window's box from the compositor and its logical size from the
    state — so a window that was retiled between the two reads gives a point
    that is arithmetic on two different windows. Measured: one Wayland sweep in
    several, this landed in the *list* and the secondary click opened its
    forty-row menu, and the failure read as a place menu with the wrong number
    of rows.

    `place_hover` is the window saying which row the pointer is actually over,
    which is the same check `point_at` does for a listing's rows and for the same
    reason.
    """
    start = run.state()
    for attempt in range(6):
        # **Nudged, the same way `point_at` is.** What is left once the geometry
        # is right is a sub-pixel disagreement, and a retry that aims at the same
        # point cannot recover it — measured, four identical attempts in a row
        # all landing on nothing.
        nudge = 0.0 if attempt == 0 else float(start["row_h"]) / 2 * attempt
        offset = nudge * (1 if attempt % 2 else -1)
        across, down = place_logical(start, index)
        at = aim(run, start, across, down + offset)
        run.drive(f"move {at[0]:.2f} {at[1]:.2f}\nsleep 150\nkey f12\nsleep 150\n")
        landed = run.state()
        if landed.get("place_hover") == str(index):
            return landed
    raise Failure(
        f"the pointer would not settle on sidebar row {index}: "
        f"hover={run.state().get('place_hover')!r}"
    )


@scenario("a-screen-reader-can-read-the-window", fresh=True)
def a_screen_reader_can_read_the_window(run: Run, fixture: Path) -> None:
    """**The accessibility tree, read by somebody else's D-Bus client.**

    [ADR 0026](../docs/adr/0026-at-spi-is-a-tree-we-publish-on-the-bus-we-already-speak.md)
    publishes an AT-SPI tree, and a tree nothing has read is a claim. So: a bus
    of this scenario's own, `tools/a11y-registry` standing in for
    `at-spi2-registryd` — an application that cannot `Embed` does not start its
    thread, and the machine's own registry is the desktop's, which a test may not
    disturb — and then **`gdbus`** asks the questions.

    `gdbus` and not our own client, for the reason the clipboard scenarios use
    `wl-paste`: a tree checked with the marshaller that wrote it agrees with
    itself and with nobody else. This is the only test that has ever read one of
    this program's D-Bus replies with a foreign implementation, and the first
    thing it found was an array aligned to eight bytes where the specification
    says four — a bug a year old that every previous message had hidden by
    starting at offset zero.
    """
    if not shutil.which("dbus-daemon"):
        raise Skipped("no dbus-daemon on this machine")
    if not shutil.which("gdbus"):
        raise Skipped("no gdbus to read the tree with — glib's own client")
    registry = ROOT / "target" / "release" / "a11y-registry"
    if not registry.is_file():
        raise Skipped("tools/a11y-registry is not built")

    home = run.log.parent / "a11y"
    home.mkdir(parents=True, exist_ok=True)
    bus = PrivateBus(home)
    started = subprocess.Popen(
        [str(registry), "--address", bus.address, "--for", "120"],
        stdout=subprocess.PIPE,
        text=True,
    )
    try:
        assert started.stdout is not None
        if started.stdout.readline().strip() != "registry ready":
            raise Failure("the stand-in registry did not take its name")

        place = {
            "AT_SPI_BUS_ADDRESS": bus.address,
            "DBUS_SESSION_BUS_ADDRESS": bus.address,
            "XDG_STATE_HOME": str(home / "state"),
            "XDG_CONFIG_HOME": str(home / "config"),
        }
        window = Run(run.display, run.log.parent, fixture, [], run.instance, place)
        try:
            window.drive("sleep 900\nkey f12\nsleep 200\n")
            said = window.state()
            if said["a11y"] == "off":
                raise Failure("the window found no accessibility bus to publish on")
            if int(said["a11y"]) < 4:
                raise Failure(f"the tree has {said['a11y']} nodes, which is not a window")

            # Which connection the window is: the registry printed it when the
            # window embedded itself, which is the registration under test.
            embedded = started.stdout.readline().split()
            if len(embedded) != 3 or embedded[0] != "embedded":
                raise Failure(f"the window never registered: {embedded!r}")
            peer = embedded[1]

            def ask(path: str, method: str, *arguments: str) -> str:
                answer = subprocess.run(
                    ["gdbus", "call", "--address", bus.address, "--dest", peer,
                     "--object-path", path, "--method", method, *arguments],
                    capture_output=True, text=True, timeout=20,
                )
                if answer.returncode != 0:
                    raise Failure(f"{method} on {path}: {answer.stderr.strip()}")
                return answer.stdout.strip()

            root = "/org/a11y/atspi/accessible/root"
            name = ask(root, "org.freedesktop.DBus.Properties.Get",
                       "org.a11y.atspi.Accessible", "Name")
            if "Skerry" not in name:
                raise Failure(f"the application is called {name}")
            if "application" not in ask(root, "org.a11y.atspi.Accessible.GetRoleName"):
                raise Failure("the root is not an application")

            # Down to a row, by walking rather than by guessing a path: what is
            # under test is that the tree *joins up*, which a fixed path would
            # not notice losing.
            frame = paths_in(ask(root, "org.a11y.atspi.Accessible.GetChildren"))
            if len(frame) != 1:
                raise Failure(f"the application has {len(frame)} children, wanted one frame")
            inside = paths_in(ask(frame[0], "org.a11y.atspi.Accessible.GetChildren"))
            rows: list[str] = []
            for child in inside:
                if "list" == ask(child, "org.a11y.atspi.Accessible.GetRoleName").strip("(),' "):
                    found = paths_in(ask(child, "org.a11y.atspi.Accessible.GetChildren"))
                    if any("file-1.txt" in ask(it, "org.freedesktop.DBus.Properties.Get",
                                               "org.a11y.atspi.Accessible", "Name")
                           for it in found):
                        rows = found
                        break
            if not rows:
                raise Failure("no list in the window holds the fixture's rows")

            named = [ask(it, "org.freedesktop.DBus.Properties.Get",
                         "org.a11y.atspi.Accessible", "Name") for it in rows]
            if not any("file-1.txt" in it for it in named):
                raise Failure(f"the rows are {named}")
            for row in rows:
                if "list item" not in ask(row, "org.a11y.atspi.Accessible.GetRoleName"):
                    raise Failure(f"{row} is not a list item")
                extents = ask(row, "org.a11y.atspi.Component.GetExtents", "0")
                numbers = [int(it) for it in re.findall(r"-?\d+", extents)]
                if len(numbers) != 4 or numbers[2] <= 0 or numbers[3] <= 0:
                    raise Failure(f"{row} has no extents: {extents}")

            # **And the tree follows the keyboard.** A row that is announced once
            # and never again is a tree; being told is what makes it usable.
            before = focused_row(ask, rows)
            window.drive("key down\nsleep 400\n")
            after = focused_row(ask, rows)
            if before == after:
                raise Failure(f"the focused row is still {after} after Down")

            # **A submenu is a menu inside its owner's item**, not more rows of
            # the parent: a reader that announced an application as a sibling of
            # Properties would be describing a menu nobody drew. Open with, because
            # it is the one row that opens over any entry — and its rows are
            # whatever this machine has, so only their role is asserted.
            window.drive("key shift+f10\nsleep 300\n")
            for _ in range(4):
                window.drive("key down\nsleep 120\nkey f12\nsleep 150\n")
                if window.state().get("menu_id") == "menu.open_with":
                    break
            else:
                raise Failure("the arrows never reached the Open with row")
            window.drive("key right\nsleep 500\n")

            def role_of(path: str) -> str:
                return ask(path, "org.a11y.atspi.Accessible.GetRoleName").strip("(),' ")

            menus = [it for it in paths_in(ask(frame[0], "org.a11y.atspi.Accessible.GetChildren"))
                     if role_of(it) == "menu"]
            if len(menus) != 1:
                raise Failure(f"the frame holds {len(menus)} menus with one open")
            items = paths_in(ask(menus[0], "org.a11y.atspi.Accessible.GetChildren"))
            nested = [(it, inner) for it in items
                      for inner in paths_in(ask(it, "org.a11y.atspi.Accessible.GetChildren"))
                      if role_of(inner) == "menu"]
            if len(nested) != 1:
                raise Failure(f"{len(nested)} menu items hold a menu, wanted the open one")
            owner, inner = nested[0]
            owner_name = ask(owner, "org.freedesktop.DBus.Properties.Get",
                             "org.a11y.atspi.Accessible", "Name")
            if "Open with" not in owner_name:
                raise Failure(f"the submenu hangs off {owner_name}")
            inner_rows = paths_in(ask(inner, "org.a11y.atspi.Accessible.GetChildren"))
            if not inner_rows or any(role_of(it) != "menu item" for it in inner_rows):
                raise Failure(f"the Open with submenu reads as {len(inner_rows)} nodes")
            window.drive("key escape\nsleep 150\nkey escape\nsleep 200\n")
        finally:
            window.close()
    finally:
        started.terminate()
        bus.stop()


def socket_queue(pid: int) -> str:
    """Unread bytes on every unix socket this process holds, as `fd:bytes`.

    **The whole question, when a window appears to be ignoring something sent to
    it.** The display connection is one of these sockets: bytes waiting in its
    receive queue while the main thread sleeps in `poll` would mean the wake-up
    is ours to explain, and an empty queue means nothing has been sent and the
    sleep is correct. `ss` reads it out of the kernel; `/proc/net/unix` does not
    carry the queue lengths.
    """
    if not shutil.which("ss"):
        return "no ss on this machine"
    listed = subprocess.run(["ss", "-x", "-H", "-p"], capture_output=True, text=True)
    found = []
    for line in listed.stdout.splitlines():
        if f"pid={pid}," not in line:
            continue
        fields = line.split()
        if len(fields) < 4:
            continue
        for fd in re.findall(rf"pid={pid},fd=(\d+)", line):
            found.append(f"fd{fd}:recv={fields[2]},send={fields[3]}")
    return " ".join(found) or "no sockets found"


def paths_in(answer: str) -> list[str]:
    """Every object path in a `gdbus` answer, in the order it printed them."""
    return re.findall(r"'(/org/a11y/atspi/accessible/[^']+)'", answer)


def focused_row(ask, rows: list[str]) -> str | None:
    """Which of `rows` reports the `focused` state bit — position 12."""
    for row in rows:
        state = ask(row, "org.a11y.atspi.Accessible.GetState")
        low = re.search(r"uint32 (\d+)", state)
        if low and int(low.group(1)) & (1 << 12):
            return row
    return None


def own_config(run: Run, label: str) -> dict:
    """An environment whose config directory is this scenario's own.

    **Required of anything that pins.** A pin is a line in
    `$XDG_CONFIG_HOME/gtk-3.0/bookmarks`, which is the file Nautilus, Thunar and
    Nemo read — so a scenario that wrote to the real one would put a temporary
    fixture into the sidebar of every file manager on the machine running the
    suite, and leave it there.

    **And its own data directory, on the same filesystem as the fixture.** The
    Trash lives under `$XDG_DATA_HOME`, and the specification puts a file on
    another filesystem somewhere else entirely or refuses the move — so a
    scenario that left this pointing at the real home either wrote into the trash
    of whoever ran the suite or, because the fixtures are on tmpfs and a home
    usually is not, silently trashed nothing at all and failed as *the row is
    still there*. Measured: exactly that, in the first run of
    `asking-before-the-trash-is-a-setting`.
    """
    home = run.log.parent / f"config-{label}"
    home.mkdir(parents=True, exist_ok=True)
    return {
        "XDG_CONFIG_HOME": str(home),
        "XDG_STATE_HOME": str(run.log.parent / f"state-{label}"),
        "XDG_DATA_HOME": str(run.log.parent / f"data-{label}"),
    }


def a_desktops_recents(entries: list[tuple[Path, str, bool]]) -> str:
    """A `recently-used.xbel` in the shape GLib writes, naming `entries`.

    Each is a path, its type and whether it is private. The paths are fixture
    paths, which spell the same as their URIs: nothing in them needs escaping.
    """
    stamp = "2020-01-01T00:00:00.000000Z"
    bookmarks = "".join(
        f'  <bookmark href="file://{path}" added="{stamp}" modified="{stamp}" visited="{stamp}">\n'
        f'    <info><metadata owner="http://freedesktop.org">'
        f'<mime:mime-type type="{mime}"/><bookmark:applications>'
        f'<bookmark:application name="probe" exec="&apos;probe %u&apos;" modified="{stamp}" count="1"/>'
        f"</bookmark:applications>{'<bookmark:private/>' if private else ''}</metadata></info>\n"
        "  </bookmark>\n"
        for path, mime, private in entries
    )
    return (
        '<?xml version="1.0" encoding="UTF-8"?>\n'
        '<xbel version="1.0"\n'
        '      xmlns:bookmark="http://www.freedesktop.org/standards/desktop-bookmarks"\n'
        '      xmlns:mime="http://www.freedesktop.org/standards/shared-mime-info"\n>\n'
        f"{bookmarks}</xbel>\n"
    )


@scenario("recent-files-are-both-lists-and-survive-kill-9", fresh=True)
def recent_files(run: Run, fixture: Path) -> None:
    """Rule 6 names recents, and ADR 0043 says there are two lists read as one.

    Three windows over one data home. The first opens a file — through a probe
    application, so the launch is real and does nothing — and the Recent view
    then holds it and the one entry the desktop's file lists that is neither
    private nor a folder. The second comes back after `kill -9` with the same
    two, which is rule 6, and forgets the desktop's entry. The third, after
    another `kill -9`, still does not show it: a forgotten entry is a tombstone
    in *our* file, because a union over two stores would bring it back on the
    next read. And the desktop's file is exactly what it was, because it is read
    and never written.
    """
    run.close()
    place = own_config(run, "recent")
    data = Path(place["XDG_DATA_HOME"])
    (data / "applications").mkdir(parents=True, exist_ok=True)
    (data / "applications" / "skerry-probe.desktop").write_text(
        "[Desktop Entry]\nType=Application\nName=Probe\nExec=true %f\nMimeType=text/plain;\n"
    )
    place["XDG_DATA_DIRS"] = str(data)
    Path(place["XDG_CONFIG_HOME"], "mimeapps.list").write_text(
        "[Default Applications]\ntext/plain=skerry-probe.desktop\n"
    )
    mine, theirs, private = fixture / "opened.txt", fixture / "theirs.txt", fixture / "private.txt"
    for file in (mine, theirs, private):
        file.write_text(file.name)
    shared = data / "recently-used.xbel"
    shared.write_text(
        a_desktops_recents(
            [(theirs, "text/plain", False), (private, "text/plain", True), (fixture, "inode/directory", False)]
        )
    )
    written_by_the_desktop = shared.read_bytes()
    ours = Path(place["XDG_STATE_HOME"]) / "skerry" / "recents"

    def recent_view(window: Run, rows: str) -> dict[str, str]:
        window.drive("key ctrl+alt+h\nsleep 600\nkey f12\nsleep 200\n")
        return until(window, results="Recent files", rows=rows)

    first = Run(run.display, run.log.parent, fixture, [], run.instance, place)
    try:
        listed(first)
        first.drive("text opened\nsleep 400\nkey enter\nsleep 900\nkey f12\nsleep 200\n")
        holds(first, lambda it: "Probe" in it.get("notice", ""), "the file to open with the probe")
        deadline = time.time() + WAITING
        while time.time() < deadline and not (ours.is_file() and "opened.txt" in ours.read_text()):
            time.sleep(0.1)
        if not ours.is_file() or f"file://{mine}" not in ours.read_text():
            raise Failure(f"opening a file recorded nothing in {ours}")
        recent_view(first, "2")
        first.kill()
    finally:
        first.close()

    second = Run(run.display, run.log.parent, fixture, [], run.instance, place)
    try:
        listed(second)
        recent_view(second, "2")
        second.drive("text theirs\nsleep 400\nkey f12\nsleep 200\n")
        until(second, cursor="theirs.txt")
        second.drive("key alt+delete\nsleep 700\nkey f12\nsleep 200\n")
        until(second, results="Recent files", rows="1")
        second.kill()
    finally:
        second.close()

    third = Run(run.display, run.log.parent, fixture, [], run.instance, place)
    try:
        listed(third)
        left = recent_view(third, "1")
        if left.get("cursor") != "opened.txt":
            raise Failure(f"the list that survived holds {left.get('cursor')!r}, not opened.txt")
    finally:
        third.close()
    if shared.read_bytes() != written_by_the_desktop:
        raise Failure("the desktop's recently-used.xbel was written, and it is only ever read")
    if not theirs.is_file():
        raise Failure("forgetting a recent file removed the file")


@scenario("pinning-a-folder-keeps-it-through-kill-9", fresh=True)
def pinning_a_folder(run: Run, fixture: Path) -> None:
    """Rule 6, at the signal it names: `kill -9` does not lose a bookmark.

    A pin is not on the undo stack — ADR 0021 — so what makes it reversible is
    that it is written the moment it is made and that Unpin is one press away.
    Both halves are here, and so is the file itself: the bytes on disk are
    asserted, because the promise is interoperation with every other file manager
    and a window that merely *believes* it pinned something keeps that promise to
    nobody.
    """
    run.close()
    place = own_config(run, "pin")
    bookmarks = Path(place["XDG_CONFIG_HOME"]) / "gtk-3.0" / "bookmarks"

    own = Run(run.display, run.log.parent, fixture / "alpha", [], run.instance, place)
    try:
        listed(own)
        own.drive("key f12\nsleep 150\n")
        expect(own.state(), pinned="", pinned_at="-1")
        own.drive("key ctrl+b\nsleep 500\nkey f12\nsleep 200\n")
        pinned = until(own, pinned="alpha")
        if int(pinned["pinned_at"]) < 1:
            raise Failure(f"the pinned rows start at {pinned['pinned_at']}, so above the places")
        if not bookmarks.is_file():
            raise Failure(f"nothing was written to {bookmarks}")
        text = bookmarks.read_text()
        if text != f"file://{fixture / 'alpha'}\n":
            raise Failure(f"the file holds {text!r}")
        own.kill()
    finally:
        own.close()

    # It comes back because the *file* holds it, not because a session was
    # written: the same directory, opened by a second process after the first was
    # killed rather than closed.
    back = Run(run.display, run.log.parent, fixture / "alpha", [], run.instance, place)
    try:
        listed(back)
        back.drive("key f12\nsleep 200\n")
        until(back, pinned="alpha")
        # And the way back out, which is the inverse rule 3 would have wanted a
        # stack for.
        back.drive("key ctrl+shift+b\nsleep 500\nkey f12\nsleep 200\n")
        until(back, pinned="")
        if bookmarks.read_text() != "":
            raise Failure(f"unpinning left {bookmarks.read_text()!r}")

        # **And a folder somebody can see, from its own menu.** The pane stands
        # in the fixture and the row is `alpha`, so a Pin that acted on the
        # folder being *shown* would put the fixture on the list — which is what
        # this asserts against, and what the command used to do.
        back.drive("key backspace\nsleep 800\n")
        until(back, path=str(fixture))
        row = point_at(back, 0)
        expect(row, hover_name="alpha")
        back.drive("click right\nsleep 400\nkey f12\nsleep 200\n")
        opened = holds(back, lambda it: bool(it.get("menu_aim")), "a menu with drawn rows")
        if "place.pin" not in opened["menu_aim"]:
            raise Failure(f"a folder's menu has no Pin: {opened['menu_aim']!r}")
        if "place.pin" in opened["menu_dim"]:
            raise Failure("Pin is dimmed over a folder that is not on the list")
        aimed = menu_aim(back, opened, "place.pin")
        back.drive(f"move {aimed[0]:.2f} {aimed[1]:.2f}\nclick left\nsleep 600\nkey f12\nsleep 200\n")
        landed = until(back, pinned="alpha")
        expect(landed, path=str(fixture))
        if bookmarks.read_text() != f"file://{fixture / 'alpha'}\n":
            raise Failure(f"the file holds {bookmarks.read_text()!r}")

        # A file's row falls back to the folder on screen, which is the only
        # thing "this folder" can mean there — and the fixture is not pinned yet.
        file_row = point_at(back, 3)
        if file_row["hover_name"].startswith(("alpha", "beta", "gamma")):
            raise Failure(f"row 3 is {file_row['hover_name']!r}, wanted a file")
        back.drive("click right\nsleep 400\nkey f12\nsleep 200\n")
        over_file = holds(back, lambda it: bool(it.get("menu_aim")), "a menu with drawn rows")
        aimed = menu_aim(back, over_file, "place.pin")
        back.drive(f"move {aimed[0]:.2f} {aimed[1]:.2f}\nclick left\nsleep 600\nkey f12\nsleep 200\n")
        until(back, pinned=f"alpha,{fixture.name}")
    finally:
        back.close()


def settings_of(state: dict[str, str]) -> dict[str, tuple[str, str]]:
    """The settings panel's rows, as `name -> (value, where it came from)`."""
    rows = {}
    for field in state.get("settings", "").split(" ")[0].split(","):
        if "=" not in field:
            continue
        name, rest = field.split("=", 1)
        value, _, source = rest.partition("/")
        rows[name] = (value, source)
    return rows


def settings_open(run: Run) -> dict[str, str]:
    """Opens the settings panel and returns the state with it up."""
    run.drive("key ctrl+,\nsleep 400\nkey f12\nsleep 250\n")
    return holds(run, lambda it: bool(settings_of(it)), "the settings panel")


def a_control(run: Run, state: dict[str, str], row: int, which: str) -> tuple[float, float]:
    """The middle of one control the panel drew, as the driver's percentages.

    From the rectangle the *frame* recorded and never recomputed here — see
    [12-measurement.md](../docs/12-measurement.md#a-test-that-aims-at-the-hit-box-agrees-with-the-bug).
    """
    for field in state.get("settings_aim", "").split(","):
        parts = field.split(":")
        if len(parts) == 4 and int(parts[0]) == row and parts[1] == which:
            return aim(run, state, float(parts[2]), float(parts[3]))
    raise Failure(f"no {which} control on row {row}: {state.get('settings_aim')!r}")


@scenario("a-setting-is-a-line-in-the-file-and-the-window-can-change-it", fresh=True)
def a_setting_is_a_line_and_the_window_can_change_it(run: Run, fixture: Path) -> None:
    """**ADR 0027's precedence rule, end to end, across three processes.**

    The file says what a *fresh* window does; the session says what *this* window
    was last left doing and wins — but only for a setting the window itself
    changed. The three claims that rule makes are three restarts:

    * a line in the file is what the window starts as, and the panel says so;
    * a value the window changed survives `kill -9` and outranks the file;
    * a value the window never touched **follows the file when the file moves**,
      which is the half a session-always-wins design silently loses.

    Its own `XDG_CONFIG_HOME` and `XDG_STATE_HOME`, because both files are real
    ones: without it this would edit the config of whoever ran the suite.
    """
    run.close()
    place = own_config(run, "settings")
    config = Path(place["XDG_CONFIG_HOME"]) / "skerry" / "config"
    config.parent.mkdir(parents=True, exist_ok=True)
    config.write_text("theme = light\nhidden = on\nsidebar_width = 300\n")

    own = Run(run.display, run.log.parent, fixture, [], run.instance, place)
    try:
        listed(own)
        rows = settings_of(settings_open(own))
        for name, want in [
            ("theme", ("light", "file")),
            ("hidden", ("on", "file")),
            ("sidebar_width", ("300", "file")),
            ("view", ("details", "default")),
            ("confirm_trash", ("off", "default")),
        ]:
            if rows.get(name) != want:
                raise Failure(f"{name} is {rows.get(name)}, not {want} — the file was not read")

        # The keyboard half: the highlight starts on Theme and `→` is its true
        # position, which for a theme is dark.
        own.drive("key right\nsleep 300\nkey f12\nsleep 200\n")
        changed = settings_of(holds(own, lambda it: settings_of(it).get("theme", ("", ""))[0] == "dark", "a dark theme"))
        if changed["theme"] != ("dark", "window"):
            raise Failure(f"theme is {changed['theme']}, not changed by the window")
        if changed["hidden"] != ("on", "file"):
            raise Failure(f"changing the theme moved hidden to {changed['hidden']}")
        # **Long enough for the session's own floor.** `SESSION_FLOOR` is two
        # seconds and a `kill -9` inside it loses the write — which is the file's
        # design and not a defect: a scroll changes sixty times a second and none
        # of those is a reason to write a file. Rule 6 is about what a person set
        # up a moment ago, not a moment before that.
        session = Path(place["XDG_STATE_HOME"]) / "skerry" / "session"
        deadline = time.time() + PATIENCE
        while time.time() < deadline:
            written = session.read_text() if session.is_file() else ""
            if "theme dark" in written and "touched" in written:
                break
            time.sleep(0.2)
        else:
            raise Failure(f"the session never recorded the change: {session} holds {written!r}")
        own.kill()
    finally:
        own.close()

    # Second process, same file. The theme the window changed comes back; the
    # three it did not are still the file's.
    back = Run(run.display, run.log.parent, fixture, [], run.instance, place)
    try:
        listed(back)
        rows = settings_of(settings_open(back))
        if rows.get("theme") != ("dark", "window"):
            raise Failure(f"the window's own theme did not survive: {rows.get('theme')}")
        if rows.get("sidebar_width") != ("300", "file"):
            raise Failure(f"the file's width did not survive: {rows.get('sidebar_width')}")
        back.close()
    finally:
        back.close()

    # Third process, an edited file. The width follows it because nothing in the
    # window has ever touched that setting; the theme does not, because something
    # has.
    config.write_text("theme = light\nhidden = on\nsidebar_width = 200\n")
    moved = Run(run.display, run.log.parent, fixture, [], run.instance, place)
    try:
        listed(moved)
        rows = settings_of(settings_open(moved))
        if rows.get("sidebar_width") != ("200", "file"):
            raise Failure(
                f"the width is {rows.get('sidebar_width')} — a setting the window never "
                f"changed has stopped following the file"
            )
        if rows.get("theme") != ("dark", "window"):
            raise Failure(f"the file overrode a setting the window had changed: {rows.get('theme')}")
    finally:
        moved.close()


@scenario("every-settings-row-answers-a-pointer", fresh=True)
def every_settings_row_answers_a_pointer(run: Run, fixture: Path) -> None:
    """Rule 5's other half, for the newest surface in the program.

    Every control the panel draws is a rectangle the *frame* recorded, and this
    presses them: the two words of a switch mean their own word rather than "the
    other one", and the number's two steps move it by twenty each way.

    **A press on the word that is already lit does nothing**, which is the
    difference between a switch and a toggle and the reason the two halves are
    separate rectangles — a control that flipped whatever it was told cannot be
    used twice.
    """
    run.close()
    place = own_config(run, "settings-pointer")
    own = Run(run.display, run.log.parent, fixture, [], run.instance, place)
    try:
        listed(own)
        state = settings_open(own)
        rows = settings_of(state)
        if rows.get("theme") != ("dark", "default"):
            raise Failure(f"a fresh window is {rows.get('theme')}, not dark by default")

        # The word that is already lit, twice: nothing moves.
        dark = a_control(own, state, 0, "yes")
        own.drive(f"move {dark[0]:.2f} {dark[1]:.2f}\nclick left\nsleep 300\n")
        own.drive(f"click left\nsleep 300\nkey f12\nsleep 200\n")
        still = settings_of(own.state())
        if still.get("theme") != ("dark", "window"):
            raise Failure(f"two presses on Dark left {still.get('theme')}")

        # And the other word, once.
        state = own.state()
        light = a_control(own, state, 0, "no")
        own.drive(f"move {light[0]:.2f} {light[1]:.2f}\nclick left\nsleep 400\nkey f12\nsleep 200\n")
        after = settings_of(holds(own, lambda it: settings_of(it).get("theme", ("", ""))[0] == "light", "a light theme"))
        if after["theme"] != ("light", "window"):
            raise Failure(f"a press on Light left {after['theme']}")

        # The number, both ways. Twenty each press — `settings::WIDTH_STEP`.
        state = own.state()
        was = int(settings_of(state)["sidebar_width"][0])
        wider = a_control(own, state, 3, "yes")
        own.drive(f"move {wider[0]:.2f} {wider[1]:.2f}\nclick left\nsleep 350\nkey f12\nsleep 200\n")
        grew = settings_of(holds(own, lambda it: settings_of(it).get("sidebar_width", ("0",))[0] != str(was), "a wider list"))
        if int(grew["sidebar_width"][0]) != was + 20:
            raise Failure(f"the width went from {was} to {grew['sidebar_width'][0]}, not {was + 20}")
        state = own.state()
        narrower = a_control(own, state, 3, "no")
        own.drive(f"move {narrower[0]:.2f} {narrower[1]:.2f}\nclick left\nsleep 350\nkey f12\nsleep 200\n")
        shrank = settings_of(holds(own, lambda it: settings_of(it).get("sidebar_width", ("0",))[0] == str(was), "the width back"))
        if int(shrank["sidebar_width"][0]) != was:
            raise Failure(f"the width came back to {shrank['sidebar_width'][0]}, not {was}")

        # The choice, both ways — ADR 0042's seventh setting, and the first that
        # is neither a truth nor a number. A fresh window is on `desktop`; one
        # step is `marks`, and one back is `desktop` again.
        state = own.state()
        if settings_of(state).get("icons") != ("desktop", "default"):
            raise Failure(f"a fresh window is {settings_of(state).get('icons')}, not the desktop's")
        onward = a_control(own, state, 6, "yes")
        own.drive(f"move {onward[0]:.2f} {onward[1]:.2f}\nclick left\nsleep 350\nkey f12\nsleep 200\n")
        stepped = settings_of(holds(own, lambda it: settings_of(it).get("icons", ("desktop",))[0] != "desktop", "a stepped choice"))
        if stepped["icons"] != ("marks", "window"):
            raise Failure(f"one step from the desktop is {stepped['icons']}, not our own marks")
        # And the state the window resolved to, which under `marks` is nothing
        # parsed, nothing held and the lookup never called.
        expect(own.state(), icons="ours")
        state = own.state()
        backward = a_control(own, state, 6, "no")
        own.drive(f"move {backward[0]:.2f} {backward[1]:.2f}\nclick left\nsleep 350\nkey f12\nsleep 200\n")
        home = settings_of(holds(own, lambda it: settings_of(it).get("icons", ("marks",))[0] != "marks", "the choice back"))
        if home["icons"] != ("desktop", "window"):
            raise Failure(f"one step back is {home['icons']}, not the desktop's")

        # Escape is the way out, and the panel goes.
        own.drive("key escape\nsleep 300\nkey f12\nsleep 200\n")
        gone = holds(own, lambda it: not settings_of(it), "the panel closed")
        expect(gone, settings="")
    finally:
        own.close()


def install_a_theme(place: dict, name: str, sizes: tuple[int, ...] = (16, 32, 48)) -> Path:
    """A theme of our own under this scenario's `XDG_DATA_HOME`.

    **A fixture rather than whatever the machine has installed.** Adwaita is on
    the development box and may not be on a runner, and a gate that passes by
    being skipped is decoration — `docs/12-measurement.md`. The files are SVG
    because an SVG is text: a scenario can write one, and `skerry-thumbnailer`
    decodes it through the same path a real theme's would take.
    """
    root = Path(place["XDG_DATA_HOME"]) / "icons" / name
    groups = "".join(
        f"\n[{size}x{size}/places]\nSize={size}\nType=Fixed\n"
        f"\n[{size}x{size}/mimetypes]\nSize={size}\nType=Fixed\n"
        for size in sizes
    )
    listed = ",".join(f"{s}x{s}/places,{s}x{s}/mimetypes" for s in sizes)
    root.mkdir(parents=True, exist_ok=True)
    (root / "index.theme").write_text(f"[Icon Theme]\nName={name}\nDirectories={listed}\n{groups}")
    for size in sizes:
        for folder, icon, colour in [
            ("places", "folder", "#c04040"),
            ("mimetypes", "text-x-generic", "#40a0c0"),
        ]:
            at = root / f"{size}x{size}" / folder
            at.mkdir(parents=True, exist_ok=True)
            (at / f"{icon}.svg").write_text(
                f'<svg xmlns="http://www.w3.org/2000/svg" width="{size}" height="{size}">'
                f'<rect width="{size}" height="{size}" rx="{size // 6}" fill="{colour}"/></svg>'
            )
    return root


@scenario("a-mark-comes-from-the-source-the-setting-names", fresh=True)
def a_mark_comes_from_the_source_the_setting_names(run: Run, fixture: Path) -> None:
    """[ADR 0042](docs/adr/0042-where-a-mark-comes-from-is-a-setting-and-an-icon-is-a-band-in-its-own-atlas.md),
    over all three of its sources.

    **`marks` and a failed theme are different states, and this is where that is
    worth something.** Under `marks` nothing parses an `index.theme`, nothing is
    held and the lookup is never called — so the icon atlas is empty, and the
    emptiness is the assertion. Under a theme that could not be loaded the marks
    are drawn too, and the window says a different sentence about why: a machine
    with a broken theme must not look like one whose owner chose the marks.

    The third source is a theme this scenario installs, because a gate that
    passes by being skipped on a machine with no theme is decoration.
    """
    run.close()
    place = own_config(run, "icons")
    config = Path(place["XDG_CONFIG_HOME"]) / "skerry" / "config"
    config.parent.mkdir(parents=True, exist_ok=True)
    install_a_theme(place, "skerry-fixture")

    # One: our own marks. Nothing is parsed and nothing reaches the GPU.
    config.write_text("icons = marks\n")
    own = Run(run.display, run.log.parent, fixture, [], run.instance, place)
    try:
        listed(own)
        state = holds(own, lambda it: it.get("icons") == "ours", "our own marks")
        expect(state, icons="ours", icon_slots="0:0")
    finally:
        own.close()

    # Two: a theme nothing declares. The marks are drawn, and the window says
    # something different about why — which is the state ADR 0042 requires to be
    # reachable from different code than the one above.
    config.write_text("icons = no-such-theme-is-installed\n")
    absent = Run(run.display, run.log.parent, fixture, [], run.instance, place)
    try:
        listed(absent)
        state = holds(
            absent,
            lambda it: it.get("icons", "").startswith("failed:"),
            "a theme that could not be had",
        )
        expect(state, icons="failed:no-such-theme-is-installed:unknown", icon_slots="0:0")
    finally:
        absent.close()

    # Three: the theme this scenario installed. It loads, and a mark reaches the
    # atlas — which is the half a state dump alone cannot claim, because the
    # count comes from `sk-gpu` after the child answered.
    config.write_text("icons = skerry-fixture\n")
    themed = Run(run.display, run.log.parent, fixture, [], run.instance, place)
    try:
        listed(themed)
        state = holds(
            themed,
            lambda it: it.get("icons", "").startswith("ready:skerry-fixture:"),
            "the installed theme",
        )
        # The count is the whole chain, `hicolor` included — which the
        # specification requires to be in it whether or not anything names it.
        if int(state["icons"].rsplit(":", 1)[1]) < 2:
            raise Failure(f"the theme holds {state['icons']}, not even its own two names")
        landed = holds(
            themed,
            lambda it: int(it.get("icon_slots", "0:0").split(":")[0]) > 0,
            "an icon on the GPU",
        )
        held = int(landed["icon_slots"].split(":")[0])
        if held > 8:
            raise Failure(f"{held} icons for two names — the key is not the file and the band")

        # **And a column view's other columns.** They are listings of their own,
        # so an icon reaching the pane's rows says nothing about them; under a
        # theme every column draws it, or one view of a listing disagrees with
        # the other two about what a file looks like — rule 8.
        themed.drive("text alpha\nsleep 400\nkey enter\nsleep 900\nkey ctrl+3\nsleep 600\nkey f12\nsleep 200\n")
        holds(
            themed,
            lambda it: int(it.get("trail_icons", "0")) > 0,
            "the column view's other columns to draw the theme's icons",
        )
    finally:
        themed.close()


@scenario("asking-before-the-trash-is-a-setting", fresh=True)
def asking_before_the_trash_is_a_setting(run: Run, fixture: Path) -> None:
    """The one setting that changes what an action *does*, in both positions.

    **Off by default, because rule 3 is the safety net**: every trash is one
    `Ctrl+Z`, so a confirmation for something reversible is friction rather than
    protection. It is a setting because a person who wants it is not wrong — ADR
    0027 — and this asserts both positions, which is the only way to tell a
    setting that works from a panel that draws a switch.

    The question is the panel a permanent deletion already draws, so what matters
    here is the difference: it starts on Cancel, Cancel keeps the file, a second
    `Delete` answers it, and what it did is on the undo stack — which is the
    whole reason asking was optional in the first place.
    """
    run.close()
    place = own_config(run, "confirm-trash")
    own = Run(run.display, run.log.parent, fixture, [], run.instance, place)
    try:
        rows = int(listed(own)["rows"])

        # Off: the row goes, with no question at all.
        own.drive("key end\nsleep 250\nkey delete\nsleep 1200\nkey f12\nsleep 250\n")
        gone = until(own, rows=str(rows - 1))
        expect(gone, erasing="0")
        own.drive("key ctrl+z\nsleep 1200\nkey f12\nsleep 250\n")
        until(own, rows=str(rows))

        # On, from the panel — the sixth row, pressed rather than typed.
        state = settings_open(own)
        if settings_of(state).get("confirm_trash") != ("off", "default"):
            raise Failure(f"a fresh window is {settings_of(state).get('confirm_trash')}")
        yes = a_control(own, state, 5, "yes")
        own.drive(f"move {yes[0]:.2f} {yes[1]:.2f}\nclick left\nsleep 400\nkey f12\nsleep 250\n")
        turned = holds(
            own, lambda it: settings_of(it).get("confirm_trash", ("",))[0] == "on", "asking"
        )
        if settings_of(turned)["confirm_trash"] != ("on", "window"):
            raise Failure(f"the row reads {settings_of(turned)['confirm_trash']}")
        own.drive("key escape\nsleep 400\nkey f12\nsleep 250\n")
        holds(own, lambda it: not settings_of(it), "the panel closed")

        # And now the same keystroke asks instead.
        own.drive("key end\nsleep 250\nkey delete\nsleep 700\nkey f12\nsleep 250\n")
        asked = holds(own, lambda it: it.get("erasing") != "0", "the question")
        expect(asked, erasing_on="cancel", rows=str(rows))

        # Cancel keeps the file, which is the half a question exists for.
        own.drive("key escape\nsleep 400\nkey f12\nsleep 250\n")
        kept = holds(own, lambda it: it.get("erasing") == "0", "the question dismissed")
        expect(kept, rows=str(rows))

        # Asking again and answering it moves the file — and `Ctrl+Z` walks it
        # back, which a permanent deletion's question cannot offer.
        own.drive("key delete\nsleep 700\nkey delete\nsleep 1200\nkey f12\nsleep 250\n")
        trashed = until(own, rows=str(rows - 1))
        expect(trashed, erasing="0", undo="true")
        own.drive("key ctrl+z\nsleep 1200\nkey f12\nsleep 250\n")
        until(own, rows=str(rows))
    finally:
        own.close()


@scenario("a-volume-offers-mount-only-where-it-means-something")
def a_volume_offers_mount_where_it_means_something(run: Run, fixture: Path) -> None:
    """**[ADR 0030](../docs/adr/0030-a-volume-is-a-device-udev-described-and-mounting-it-is-one-udisks2-call.md)'s
    three commands, and the half of them that can be asserted on any machine.**

    A USB stick is hardware, and a scenario cannot plug one in — so what is
    checked here is everything that is *not* the disk: that Mount, Unmount and
    Eject are on a place's own menu, that all three are dimmed over a row they
    mean nothing for, and that the sidebar says of every volume whether anything
    has mounted it.

    **Dimmed rather than absent**, which is the rule every menu here follows: a
    menu that changes shape by row is a menu whose rows move under a hand. Over
    Home — a place, not a volume — none of the three can do anything, and the
    menu says so by drawing them and greying them.

    The row a *mounted* volume produces is asserted here; the row an unmounted
    one produces is in the golden frames, where `sidebar::sample` can put one on
    screen without anybody owning the disk.
    """
    run.drive("sleep 500\nkey f12\nsleep 150\n")
    start = run.state()
    # Every machine that runs this has a root filesystem, and it is a volume.
    if "volumes" not in start or not start["volumes"]:
        raise Failure("the sidebar reported no volumes at all")
    told = dict(
        field.split(":", 1) for field in start["volumes"].split(",") if ":" in field
    )
    if not any(state == "yes" for state in told.values()):
        raise Failure(f"nothing is mounted, on a machine that booted: {start['volumes']!r}")
    for name, state in told.items():
        if state not in ("yes", "no"):
            raise Failure(f"{name} is {state!r}, which is neither mounted nor not")

    # Home, which is row 0 of the first section in every arrangement, and is a
    # place rather than a disk.
    hover_place(run, 0)
    run.drive("click right\nsleep 400\nkey f12\nsleep 200\n")
    over_home = holds(run, lambda it: bool(it.get("menu_aim")), "a menu with drawn rows")
    for command in ("volume.mount", "volume.unmount", "volume.eject"):
        if command not in over_home["menu_dim"]:
            raise Failure(
                f"{command} is offered over a place that is not a disk: "
                f"dim={over_home['menu_dim']!r}"
            )
    run.drive("key escape\nsleep 250\n")


@scenario("a-well-known-place-cannot-be-unpinned", fresh=True)
def a_default_place_is_not_unpinnable(run: Run, fixture: Path) -> None:
    """The defaults are the machine's and the pins are yours.

    A secondary click on a sidebar row opens the place's own menu — three rows,
    all three about *that* row, which is the target `open_menu` used to say the
    registry had no shape for. Over Home every one of them is dimmed; over a pin
    they are not. Dimmed rather than absent, so the menu is the same shape every
    time it opens.
    """
    run.close()
    place = own_config(run, "unpin")
    own = Run(run.display, run.log.parent, fixture / "alpha", [], run.instance, place)
    try:
        listed(own)
        own.drive("key ctrl+b\nsleep 500\nkey f12\nsleep 200\n")
        state = until(own, pinned="alpha")

        # Home, which is row 0 of the first section in every arrangement — and
        # the pointer is checked onto it before the click, because a click that
        # missed the sidebar opens the list's own menu and reads as this one
        # having the wrong number of rows.
        hover_place(own, 0)
        own.drive("click right\nsleep 400\nkey f12\nsleep 200\n")
        over_home = holds(own, lambda it: bool(it.get("menu_aim")), "a menu with drawn rows")
        # Seven since ADR 0030 put Mount, Unmount and Eject on this menu, and
        # eight since Empty the Trash joined them.
        expect(over_home, menu="8")
        # Open is the fourth row and is *not* dimmed: every row of the sidebar is
        # a directory and every one of them opens. What Home has no business
        # offering is the three that change the list.
        if "place.expand" in over_home["menu_dim"]:
            raise Failure(f"Open is dimmed over Home: {over_home['menu_dim']!r}")
        for wanted in ("place.unpin", "place.raise", "place.lower", "trash.empty"):
            if wanted not in over_home["menu_dim"]:
                raise Failure(f"{wanted} is not dimmed over Home: {over_home['menu_dim']!r}")
        if "file.new_folder" in over_home["menu_aim"]:
            raise Failure("a place's menu offered the list's own actions")

        own.drive("key escape\nsleep 250\n")
        at = place_point(own, state, int(state["pinned_at"]))
        own.drive(
            f"move {at[0]:.2f} {at[1]:.2f}\nsleep 150\n"
            f"click right\nsleep 400\nkey f12\nsleep 200\n"
        )
        over_pin = holds(own, lambda it: bool(it.get("menu_aim")), "a menu with drawn rows")
        expect(over_pin, place_menu="alpha")
        if "place.unpin" in over_pin["menu_dim"]:
            raise Failure(f"Unpin is dimmed over a pin: {over_pin['menu_dim']!r}")

        # And the row runs the command against the place the menu was opened
        # over, which is the whole of what the target is for.
        aimed = menu_aim(own, over_pin, "place.unpin")
        own.drive(f"move {aimed[0]:.2f} {aimed[1]:.2f}\nclick left\nsleep 600\nkey f12\nsleep 200\n")
        until(own, pinned="")
    finally:
        own.close()


@scenario("the-sidebars-divider-drags-and-is-remembered", fresh=True)
def the_sidebar_divider(run: Run, fixture: Path) -> None:
    """M2's resizable divider, and rule 6 over the width it sets.

    The band is four logical pixels either side of the line the sidebar draws at
    its right edge, so the first assertion is that the window *reports* being on
    it — a drag that missed the band would move the pointer and change nothing,
    which reads exactly like a divider that does not work.
    """
    run.close()
    place = own_config(run, "divider")
    own = Run(run.display, run.log.parent, fixture, [], run.instance, place)
    dragged = {}
    try:
        listed(own)
        own.drive("key f12\nsleep 150\n")
        before = own.state()
        width = float(before["sidebar_w"])
        if width <= 0.0:
            raise Failure("the sidebar is closed")
        middle = float(before["body_top"]) + 120.0
        on_it = aim(own, before, width, middle)
        own.drive(f"move {on_it[0]:.2f} {on_it[1]:.2f}\nsleep 200\nkey f12\nsleep 150\n")
        expect(own.state(), aside_grabbed="true", pointer="divider-h")

        wider = aim(own, before, width + 90.0, middle)
        own.drive(
            f"press left\nsleep 150\n"
            f"move {wider[0]:.2f} {wider[1]:.2f}\nsleep 250\n"
            f"release left\nsleep 250\nkey f12\nsleep 200\n"
        )
        dragged = holds(
            own,
            lambda it: abs(float(it["sidebar_w"]) - width) > 40.0,
            "a sidebar the drag widened",
        )
        # The list moved with it, or the rows are drawn under the sidebar.
        if float(dragged["name_x"]) <= float(before["name_x"]):
            raise Failure("the name column did not move with the divider")
        # Long enough for the session floor to have let a write through, then
        # killed outright rather than closed: a clean exit writes the file on its
        # way out, and rule 6's stated failure is a hard kill.
        own.drive("sleep 2500\nkey f12\nsleep 200\n")
        own.kill()
    finally:
        own.close()

    back = Run(run.display, run.log.parent, None, [], run.instance, place)
    try:
        listed(back)
        back.drive("key f12\nsleep 200\n")
        # **Within a logical pixel, not equal to it.** The file holds whole
        # pixels, the way the `columns` line does, and a pointer lands on a
        # fraction of one — so 310.1 comes back as 310, which is the width
        # somebody dragged to and not a width that was lost.
        came_back = float(back.state()["sidebar_w"])
        if abs(came_back - float(dragged["sidebar_w"])) > 1.0:
            raise Failure(f"came back {came_back} wide, was {dragged['sidebar_w']}")
    finally:
        back.close()


@scenario("a-pinned-place-is-dragged-into-a-different-order", fresh=True)
def reordering_the_pins(run: Run, fixture: Path) -> None:
    """M2's drag-to-reorder, and the keyboard's half of it.

    The order on screen is the order of the lines in the file, so this asserts the
    file as well: a reorder that only moved rows would come back in the old order
    on the next start, and one that rewrote the file wrongly would take somebody
    else's bookmark with it.
    """
    run.close()
    place = own_config(run, "reorder")
    bookmarks = Path(place["XDG_CONFIG_HOME"]) / "gtk-3.0" / "bookmarks"
    own = Run(run.display, run.log.parent, fixture / "alpha", [], run.instance, place)
    try:
        listed(own)
        own.drive("key ctrl+b\nsleep 500\n")
        until(own, pinned="alpha")

        # A second pin, from the other folder — typed into the path bar, because
        # `beta` is not under `alpha`.
        own.drive("key ctrl+l\nsleep 200\nkey ctrl+u\n")
        own.drive(f"text {fixture / 'beta'}\nsleep 150\nkey enter\nsleep 700\n")
        until(own, path=str(fixture / "beta"))
        own.drive("key ctrl+b\nsleep 500\nkey f12\nsleep 200\n")
        two = until(own, pinned="alpha,beta")

        first = int(two["pinned_at"])
        from_at = place_point(own, two, first)
        # **Past the middle of the row below**, which is where the gap is. Each
        # row's own midline is the boundary, so a drop on the *centre* of the next
        # row names the gap above it — which is the position the dragged row is
        # already in, and is deliberately not a move.
        across, above = place_logical(two, first)
        _, centre = place_logical(two, first + 1)
        below = aim(own, two, across, centre + (centre - above) * 0.6)
        own.drive(
            f"move {from_at[0]:.2f} {from_at[1]:.2f}\nsleep 150\n"
            f"press left\nsleep 150\n"
            f"move {below[0]:.2f} {below[1]:.2f}\nsleep 250\n"
            f"release left\nsleep 600\nkey f12\nsleep 200\n"
        )
        until(own, pinned="beta,alpha")
        wanted = f"file://{fixture / 'beta'}\nfile://{fixture / 'alpha'}\n"
        if bookmarks.read_text() != wanted:
            raise Failure(f"the file holds {bookmarks.read_text()!r}")

        # **The press that started the drag also opened the row**, which is what
        # dragging a tab does, so the pane is standing in `alpha` — and that is
        # what the keyboard's half then acts on.
        expect(own.state(), path=str(fixture / "alpha"))

        # And back again with the keyboard, which ends in the same command the
        # drag does. `alpha` is last now, so it is the raise that moves it.
        own.drive("key ctrl+shift+up\nsleep 600\nkey f12\nsleep 200\n")
        until(own, pinned="alpha,beta")
    finally:
        own.close()


@scenario("a-search-covers-one-folder-or-every-disk", fresh=True)
def the_search_scope(run: Run, fixture: Path) -> None:
    """`Ctrl+Alt+F` widens the same panel to every local filesystem.

    ADR 0022: the roots are the sidebar's own Volumes — the allow-list of
    filesystem types that already decides what a person would call a place — so
    what this asserts is that there is at least one, that the walk leaves the
    folder the other scope is confined to, and that switching keeps what has been
    typed. Widening a search that has found nothing is the commonest thing a
    person does next, and retyping the query to do it is the cost of not having
    it.

    **Not that a particular file is found.** A complete answer over this machine's
    root filesystem is 8,559 ms over 6,901,145 entries without an index — the
    number in ADR 0022 — so a scenario that waited for one would be waiting for
    the machine it runs on. The entries looked at are the observable: the fixture
    holds nine, and a scope that has scanned thousands is a scope that is not the
    fixture.
    """
    listed(run)
    run.drive("key ctrl+shift+f\nsleep 300\ntext zzz-nothing-is-called-this\nsleep 600\n")
    here = until(run, searching="true", search_scope="here")
    expect(here, search_roots="1", search_hits="0")

    # Widened, with the query still in the field.
    run.drive("key ctrl+alt+f\nsleep 400\nkey f12\nsleep 200\n")
    wide = until(run, search_scope="everywhere")
    expect(wide, search_query="zzz-nothing-is-called-this")
    if int(wide["search_roots"]) < 1:
        raise Failure("the whole machine is no roots at all")
    walked = holds(
        run,
        lambda it: int(it.get("search_scanned", "0")) > 5000,
        "a walk that left the folder it started in",
    )
    if walked["search_scope"] != "everywhere":
        raise Failure("the scope changed under the walk")

    # And back, by pointer this time: the switcher runs the same command the
    # chord does. `scope_aim` names each button, so this cannot depend on which
    # one is drawn first.
    aims = dict(it.split("@") for it in walked["scope_aim"].split(",") if it)
    if set(aims) != {"here", "everywhere"}:
        raise Failure(f"the switcher drew {sorted(aims)}")
    across, down = (float(value) for value in aims["here"].split(":"))
    at = aim(run, walked, across, down)
    run.drive(f"move {at[0]:.2f} {at[1]:.2f}\nsleep 150\nclick left\nsleep 400\nkey f12\nsleep 200\n")
    back = until(run, search_scope="here")
    expect(back, search_query="zzz-nothing-is-called-this", search_roots="1")

    # The chord for the scope you are already in closes the panel, which is what
    # it has always done.
    run.drive("key ctrl+shift+f\nsleep 300\nkey f12\nsleep 200\n")
    expect(run.state(), searching="false")


@scenario("a-place-opens-in-the-sidebar-and-stays-open", fresh=True)
def the_sidebar_tree(run: Run, fixture: Path) -> None:
    """M2's last sidebar item: a place shows what is under it.

    Three claims. The twisty opens the row rather than navigating to it — which is
    what every tree control on the desktop does, and the difference between
    looking inside a folder and going there. A row under a place is a row: it is
    indented, it can be opened in turn, and pressing it goes. And the shape
    survives `kill -9`, because rule 6 is about the layout and an open tree is
    part of it.

    The fixture is pinned first, so the place being opened is one this scenario
    put there rather than whatever `user-dirs.dirs` says about the machine.
    """
    run.close()
    place = own_config(run, "tree")
    own = Run(run.display, run.log.parent, fixture, [], run.instance, place)
    try:
        listed(own)
        own.drive("key ctrl+b\nsleep 500\nkey f12\nsleep 200\n")
        # A fresh fixture's own name, which is the scenario's: `fresh=True` gives
        # it a directory of its own so that pinning one does not put another
        # scenario's fixture on the list.
        state = until(own, pinned=fixture.name)
        pinned_row = int(state["pinned_at"])
        where = own.state()["path"]

        # The twisty, not the row.
        twisties = [it for it in state["twisty_aim"].split(",") if it]
        across, down = (float(value) for value in twisties[pinned_row].split(":"))
        at = aim(own, state, across, down)
        own.drive(f"move {at[0]:.2f} {at[1]:.2f}\nsleep 150\nclick left\nsleep 600\nkey f12\nsleep 250\n")
        opened = holds(
            own,
            lambda it: "1" in it.get("place_depths", "").split(","),
            "a row indented under a place",
        )
        expect(opened, path=where)
        depths = opened["place_depths"].split(",")
        if depths[pinned_row] != "0+":
            raise Failure(f"the place is not marked open: {opened['place_depths']!r}")
        if depths.count("1") < 2:
            raise Failure(f"the fixture's two folders are not under it: {depths}")

        # A row under it goes where it points, which is the whole of what a tree
        # row is for. The rows are in the listing's own order, so the first of
        # them is `alpha` — asserted through the row the pointer is over rather
        # than assumed, because a tree in readdir order would pass either way.
        child = place_point(own, opened, pinned_row + 1)
        own.drive(f"move {child[0]:.2f} {child[1]:.2f}\nsleep 150\nkey f12\nsleep 150\n")
        expect(own.state(), place_name="alpha")
        own.drive("click left\nsleep 800\nkey f12\nsleep 200\n")
        went = until(own, path=str(fixture / "alpha"))
        if went["place_depths"].split(",")[pinned_row] != "0+":
            raise Failure("navigating closed the tree")

        own.drive("sleep 2500\nkey f12\nsleep 200\n")
        own.kill()
    finally:
        own.close()

    back = Run(run.display, run.log.parent, None, [], run.instance, place)
    try:
        listed(back)
        back.drive("key f12\nsleep 300\n")
        # The read of what is under it is a job, so the rows arrive a moment
        # after the shape does.
        holds(
            back,
            lambda it: "1" in it.get("place_depths", "").split(","),
            "a tree that came back open",
        )
    finally:
        back.close()

    # And the keyboard's half of the same command: standing in a place that is
    # open, `Ctrl+Shift+E` closes it. No path on the command line, because a path
    # named there is an explicit request and the saved layout stays saved — which
    # includes the tree.
    again = Run(run.display, run.log.parent, None, [], run.instance, place)
    try:
        listed(again)
        again.drive("key f12\nsleep 200\n")
        holds(again, lambda it: "1" in it.get("place_depths", "").split(","), "an open tree")
        # The session came back standing in the folder the tree row opened, so
        # the parent is the place the chord is about.
        again.drive("key backspace\nsleep 700\n")
        # **The place the chord is about is the folder the pane is in**, and the
        # tree's shape is asserted before it rather than assumed: a target that
        # followed the *cursor* instead — which is what pinning's does, and what
        # one careless edit gave both of them — opened the row the cursor was on
        # and left the place open. This is the assertion that failed six times out
        # of six. Counted rather than compared to a string, because how many
        # well-known directories a machine has is that machine's business.
        standing = until(again, path=str(fixture))
        shape = standing["place_depths"].split(",")
        opens = [at for at, depth in enumerate(shape) if depth == "0+"]
        if len(opens) != 1 or shape.count("1") != 3 or "1+" in shape:
            raise Failure(f"the tree is not one open place with three rows under it: {shape}")
        again.drive("key ctrl+shift+e\nsleep 500\nkey f12\nsleep 200\n")
        shut = holds(
            again,
            lambda it: "1" not in it.get("place_depths", "").split(","),
            "a tree the chord closed",
        )
        if "0+" in shut["place_depths"].split(","):
            raise Failure(f"a row is still marked open: {shut['place_depths']!r}")
    finally:
        again.close()


@scenario("a-folder-keeps-the-colour-it-was-given", fresh=True)
def colour_a_folder(run: Run, fixture: Path) -> None:
    """A folder's mark takes the colour somebody chose, and keeps it.

    Three claims. The row menu offers the seven and they act on the row it opened
    over — not on the folder being shown, which is what the fallback for Pin does
    and what a colour must not. The record survives `kill -9`, because it is a
    per-folder decision and rule 6 says those come back. And it is **not
    inherited**: colouring `alpha` leaves `alpha/nested` alone, which is the one
    way this record differs from every other in that file.
    """
    run.close()
    state_home = run.log.parent / "state-colour"
    place = {"XDG_STATE_HOME": str(state_home)}
    own = Run(run.display, run.log.parent, fixture, [], run.instance, place)
    try:
        listed(own)
        row = point_at(own, 0)
        expect(row, hover_name="alpha")
        own.drive("click right\nsleep 400\nkey f12\nsleep 200\n")
        opened = holds(own, lambda it: bool(it.get("menu_aim")), "a menu with drawn rows")
        # **`submenu_dim` and not `submenu_aim`.** The colours are behind one row
        # of the menu, and `submenu_dim` lists every row of the submenu whatever
        # is drawn, so it answers both halves at once: Remove the colour is
        # *there*, and it is dimmed, because a folder with no colour has nothing
        # to take away. (The parent's own `menu_aim` lists only the rows that are
        # *drawn*, and a folder's menu did not fit the nested compositor's
        # shorter tile, so an assertion against it failed three times in three
        # on Wayland while passing on X11 — the trap `palette-by-pointer` names
        # above.)
        colours = open_submenu(own, opened, "menu.colour")
        if "view.colour_none" not in colours["submenu_dim"]:
            raise Failure(
                f"Remove the colour is not dimmed and there: {colours['submenu_dim']!r}"
            )

        # And the row that is clicked is reached through the helper that scrolls,
        # which is the only thing that can say a row nobody has drawn is
        # reachable at all.
        aimed = submenu_aim(own, opened, "menu.colour", "view.colour_red")
        own.drive(f"move {aimed[0]:.2f} {aimed[1]:.2f}\nclick left\nsleep 500\nkey f12\nsleep 200\n")
        until(own, coloured="alpha:red")

        # Into `alpha`: what is under it is not red, because a colour is one
        # folder's and never its children's.
        own.drive("key enter\nsleep 900\nkey f12\nsleep 200\n")
        inside = until(own, path=str(fixture / "alpha"))
        expect(inside, coloured="")
        own.drive("key backspace\nsleep 900\nsleep 2000\nkey f12\nsleep 200\n")
        until(own, coloured="alpha:red")
        own.kill()
    finally:
        own.close()

    back = Run(run.display, run.log.parent, fixture, [], run.instance, place)
    try:
        listed(back)
        back.drive("key f12\nsleep 200\n")
        until(back, coloured="alpha:red")

        # And taking it away is the same menu, one row down.
        row = point_at(back, 0)
        expect(row, hover_name="alpha")
        back.drive("click right\nsleep 400\nkey f12\nsleep 200\n")
        opened = holds(back, lambda it: bool(it.get("menu_aim")), "a menu with drawn rows")
        colours = open_submenu(back, opened, "menu.colour")
        if "view.colour_none" in colours["submenu_dim"]:
            raise Failure("Remove the colour is dimmed on a folder that has one")
        aimed = submenu_aim(back, opened, "menu.colour", "view.colour_none")
        back.drive(f"move {aimed[0]:.2f} {aimed[1]:.2f}\nclick left\nsleep 500\nkey f12\nsleep 200\n")
        until(back, coloured="")
    finally:
        back.close()


@scenario("a-text-preview-is-an-editor-when-it-is-asked-to-be", fresh=True)
def edit_a_text_preview(run: Run, fixture: Path) -> None:
    """`Ctrl+E` turns the preview into an editor; what is typed reaches the file.

    Four claims. Typing does nothing until edit mode is on — `Space` closes the
    panel, which is what it does for a reader. Once it is on, the same panel takes
    characters and the caret moves with them. Leaving edit mode writes the file,
    because a question with an answer that loses work is worse than a save the
    undo stack can take back. And `Ctrl+Z` takes it back, which is
    [rule 3](../docs/03-principles.md#3-everything-is-reversible) — an edit is a
    mutation like any other and it is one entry on the one stack.
    """
    note = fixture / "note.txt"
    note.write_text("one\ntwo\n")
    # **Waited for, because the window may already have read the folder.** The
    # fixture is made before the run starts and this file is written after it, so
    # the row arrives with the watcher rather than with the first listing — and a
    # type-ahead for a row that is not there yet moves nothing, which is what
    # failed in a full sweep and passed alone.
    listed(run)
    until(run, rows="10")

    # Onto the file, and **waited for** rather than slept at: the type-ahead is
    # what moves the cursor, and a `Space` pressed before it lands opens a look at
    # whatever the cursor was on — which under a full sweep was a folder, and the
    # failure read as "never a text preview".
    run.drive("text note\nsleep 300\nkey f12\nsleep 150\n")
    until(run, cursor="note.txt")
    run.drive("key space\nsleep 700\nkey f12\nsleep 250\n")
    opened = holds(run, lambda it: it["looking"].endswith(":text"), "a text preview")
    expect(opened, look_editing="false")

    # **Reading first.** A letter typed at a reader is not an edit: `x` is
    # type-ahead over the listing behind the panel, and the file is untouched.
    run.drive("text x\nsleep 300\nkey f12\nsleep 200\n")
    expect(run.state(), look_editing="false")
    if note.read_text() != "one\ntwo\n":
        raise Failure(f"a keystroke reached the file before edit mode: {note.read_text()!r}")

    run.drive("key ctrl+e\nsleep 300\nkey f12\nsleep 200\n")
    editing = until(run, look_editing="true")
    expect(editing, look_caret="0:0")

    # A character, a newline, and the caret keeping up.
    run.drive("text Z\nsleep 200\nkey f12\nsleep 150\n")
    expect(run.state(), look_caret="0:1")
    run.drive("key enter\nsleep 200\nkey f12\nsleep 150\n")
    expect(run.state(), look_caret="1:0")
    # **`Space` is a space now.** The key that opens and closes a quick look is
    # the one that proves edit mode takes the keyboard.
    run.drive("text  \nsleep 200\nkey f12\nsleep 200\n")
    still = run.state()
    expect(still, look_editing="true")
    if not still["looking"].endswith(":text"):
        raise Failure("Space closed the panel instead of typing a space")

    # **The Discard button is drawn while there is something to discard**, which
    # is what makes the way out that writes nothing findable with a pointer: rule
    # 4, and the reason it is not left to a chord.
    if "discard@" not in run.state()["look_aim"]:
        raise Failure(f"no Discard button while unsaved: {run.state()['look_aim']!r}")

    # `Ctrl+E` leaves edit mode and writes what was typed.
    run.drive("key ctrl+e\nsleep 600\nkey f12\nsleep 300\n")
    saved = until(run, look_editing="false")
    if not saved["looking"].endswith(":text"):
        raise Failure(f"leaving edit mode closed the panel as well: {saved['looking']!r}")
    deadline = time.time() + WAITING
    while time.time() < deadline and note.read_text() == "one\ntwo\n":
        time.sleep(0.1)
    written = note.read_text()
    if not written.startswith("Z\n"):
        raise Failure(f"the file holds {written!r}")

    # **And `Escape` throws an edit away.** Every other way out saves — which is
    # what makes not asking safe — so the answer to "actually, never mind" has to
    # exist, and it is the key that means that everywhere else in this program.
    settled(run)
    run.drive("key ctrl+e\nsleep 400\ntext QQQ\nsleep 300\nkey f12\nsleep 200\n")
    typed = until(run, look_editing="true", look_unsaved="true")
    if typed["look_caret"] == "0:0":
        raise Failure("the three characters did not reach the buffer")
    run.drive("key escape\nsleep 500\nkey f12\nsleep 300\n")
    gone = until(run, look_editing="false", look_unsaved="false")
    if "QQQ" in gone.get("notice", ""):
        raise Failure("the notice quotes the discarded text rather than saying what happened")
    if not gone.get("notice"):
        raise Failure("a discard said nothing at all")
    settled(run)
    if note.read_text() != written:
        raise Failure(f"Escape wrote {note.read_text()!r} over {written!r}")

    # **Nothing under the panel hovers.** It covers most of the window, and the
    # chrome and the sidebar beneath it went on lighting up under a pointer that
    # was reading a file — offering clicks that only close the panel.
    run.drive("key ctrl+e\nsleep 300\n")
    over_places = place_point(run, run.state(), 0)
    run.drive(f"move {over_places[0]:.2f} {over_places[1]:.2f}\nsleep 300\nkey f12\nsleep 200\n")
    under = run.state()
    expect(under, place_name="", hover_name="")

    # And it is one entry on the one stack, so Ctrl+Z puts the file back.
    settled(run)
    run.drive("key escape\nsleep 300\nkey escape\nsleep 300\nkey ctrl+z\nsleep 900\n")
    deadline = time.time() + WAITING
    while time.time() < deadline and note.read_text() != "one\ntwo\n":
        time.sleep(0.1)
    if note.read_text() != "one\ntwo\n":
        raise Failure(f"the undo left {note.read_text()!r}")


def one_page_pdf(text: str) -> bytes:
    """A one-page PDF whose only content is `text`, in Helvetica at 24 points.

    **Written by hand so it needs no tool to generate**, the same bargain the
    three-page one inside `arrows-walk-the-look-and-a-pdfs-pages` makes — and a
    real one, so `pdftotext` finds real words in it with real boxes.
    """
    # **Eighteen points, and the caller keeps the line short.** At 24 the
    # fixture's own sentence ran past the 420-point page and poppler dropped the
    # last character out of the text layer — a layer that was right about a page
    # whose text was clipped, which read as a decoder losing a letter.
    body = f"BT /F1 18 Tf 40 500 Td ({text}) Tj ET".encode()
    objects = [
        b"<< /Type /Catalog /Pages 2 0 R >>",
        b"<< /Type /Pages /Kids [3 0 R] /Count 1 >>",
        b"<< /Type /Page /Parent 2 0 R /MediaBox [0 0 420 595] "
        b"/Resources << /Font << /F1 5 0 R >> >> /Contents 4 0 R >>",
        b"<< /Length " + str(len(body)).encode() + b" >>\nstream\n" + body + b"\nendstream",
        b"<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>",
    ]
    out = bytearray(b"%PDF-1.4\n")
    offsets = []
    for number, obj in enumerate(objects, start=1):
        offsets.append(len(out))
        out += str(number).encode() + b" 0 obj\n" + obj + b"\nendobj\n"
    start = len(out)
    out += b"xref\n0 " + str(len(objects) + 1).encode() + b"\n0000000000 65535 f \n"
    for offset in offsets:
        out += f"{offset:010d} 00000 n \n".encode()
    out += (
        b"trailer\n<< /Size "
        + str(len(objects) + 1).encode()
        + b" /Root 1 0 R >>\nstartxref\n"
        + str(start).encode()
        + b"\n%%EOF\n"
    )
    return bytes(out)


def page_words(path: Path) -> tuple[float, float, list[tuple[float, float, float, float, str]]]:
    """The page's size and its word boxes, straight from `pdftotext`.

    **The scenario aims by the tool's own answer**, not by arithmetic of its own:
    what is under test is whether the window puts the highlight where the words
    are, so the harness has to know where the words are from the same place the
    window's child got them — and then map through the rectangle the window
    *reports* it drew the page into.
    """
    done = subprocess.run(
        ["pdftotext", "-bbox-layout", "-f", "1", "-l", "1", str(path), "-"],
        capture_output=True,
        text=True,
        timeout=20,
        check=False,
    )
    if done.returncode != 0:
        raise Failure(f"pdftotext failed: {done.stderr.strip()[:200]}")
    page = re.search(r'<page width="([\d.]+)" height="([\d.]+)"', done.stdout)
    if not page:
        raise Failure("pdftotext named no page")
    words = [
        (float(a), float(b), float(c), float(d), text)
        for a, b, c, d, text in re.findall(
            r'<word xMin="([\d.]+)" yMin="([\d.]+)" xMax="([\d.]+)" yMax="([\d.]+)">([^<]*)</word>',
            done.stdout,
        )
    ]
    return float(page.group(1)), float(page.group(2)), words


@scenario("the-keymap-is-a-file-that-can-be-edited", fresh=True)
def the_keymap_is_a_file(run: Run, fixture: Path) -> None:
    """`Ctrl Alt ,` writes the keymap out, and a line in it rebinds a chord.

    **[ADR 0025](../docs/adr/0025-the-config-file-is-the-keymap-written-out.md)
    end to end.** The unit tests say the file round-trips; only a window can say
    that a chord edited in it is the chord the program answers to — which is the
    whole feature, and it spans a restart because the file is read once at
    startup.

    **The chord moved**, because
    [ADR 0027](../docs/adr/0027-a-setting-is-a-line-in-the-config-and-the-session-remembers-what-the-window-changed.md)
    gave `Ctrl ,` to the settings panel — where writing the keymap is a row, so
    the thing somebody learned that chord for is one press away and is now
    visible to everybody who never knew it.

    Its own `XDG_CONFIG_HOME`, like anything that pins: the file this writes is
    the one a person running the suite keeps their own keymap in.
    """
    run.close()
    place = own_config(run, "keymap")
    home = Path(place["XDG_CONFIG_HOME"])
    written = home / "skerry" / "config"

    first = Run(run.display, run.log.parent, fixture, [], run.instance, place)
    try:
        listed(first)
        # **The program does not write it behind you**, so there is nothing there
        # until somebody asks.
        if written.exists():
            raise Failure(f"{written} was written without being asked for")
        first.drive("key ctrl+alt+,\nsleep 600\nkey f12\nsleep 200\n")
        said = holds(first, lambda it: bool(it.get("notice")), "a notice about the keymap")
        if str(written) not in said["notice"]:
            raise Failure(f"the notice reads {said['notice']!r}")
        if not written.is_file():
            raise Failure(f"nothing at {written}")
        text = written.read_text()
        # Every command, because a file with three lines teaches three commands.
        if text.count("\n") < 60 or "view.hidden" not in text:
            raise Failure(f"the file holds {text.count(chr(10))} lines")

        # And a second ask does not overwrite what somebody may have edited.
        first.drive("key ctrl+alt+,\nsleep 500\nkey f12\nsleep 200\n")
        again = holds(first, lambda it: "already" in it.get("notice", ""), "a refusal to overwrite")
        assert again is not None
    finally:
        first.close()

    # Rebind *Show hidden files* from `Ctrl H` to `F7`, and **check the file says
    # nothing else has it**: a chord another command holds is refused, which is
    # right, and a scenario that picked one would be testing the refusal while
    # claiming to test the rebind.
    if "f7" in written.read_text():
        raise Failure("f7 is bound to something already; pick another key for this")
    edited = [
        "view.hidden = f7" if line.startswith("view.hidden ") else line
        for line in written.read_text().splitlines()
    ]
    written.write_text("\n".join(edited) + "\n")

    back = Run(run.display, run.log.parent, fixture, [], run.instance, place)
    try:
        listed(back)
        expect(back.state(), hidden="false")
        # The old chord is gone, because a line replaces rather than adds — which
        # is how "get rid of this binding" is answerable at all.
        back.drive("key ctrl+h\nsleep 400\nkey f12\nsleep 200\n")
        expect(back.state(), hidden="false")
        # And the new one works.
        back.drive("key f7\nsleep 400\nkey f12\nsleep 200\n")
        until(back, hidden="true")
    finally:
        back.close()


@scenario("a-pages-words-are-selected-and-copied", fresh=True)
def select_a_page(run: Run, fixture: Path) -> None:
    """A PDF page's text selects with a drag and copies — [ADR 0024](../docs/adr/0024-a-page-arrives-with-its-words.md).

    The panel has always selected and copied the text of a *text file*, and over a
    page the same three commands were drawn dimmed: the page is pixels. Now the
    reply carries the renderer's own word boxes beside them.

    Four claims, and the third is the one only a scenario reaches:

    * the layer arrives with the page, so `Ctrl+A` selects words rather than the
      files behind the panel;
    * `Ctrl+C` puts exactly those words on the clipboard, read by a separate
      client — the window's own report would pass with the selection never taken;
    * **a drag across one word selects that word**, aimed by mapping the tool's
      own box through the rectangle the window reports it drew the page into,
      which is the transform from points to pixels under test;
    * and a press on the margin puts the selection away, because a press outside
      text does that everywhere else in this program.
    """
    if not (shutil.which("pdftoppm") or shutil.which("mutool")):
        raise Skipped("no pdftoppm or mutool, so there is no page to select on")
    if not shutil.which("pdftotext"):
        raise Skipped("no pdftotext, so a page has no words — the documented degradation")

    sentence = "Selectable words on a page"
    paper = fixture / "paper.pdf"
    paper.write_bytes(one_page_pdf(sentence))
    listed(run)
    until(run, rows="10")
    run.drive("text paper\nsleep 300\nkey f12\nsleep 150\n")
    until(run, cursor="paper.pdf")
    run.drive("key space\nsleep 900\nkey f12\nsleep 300\n")
    # The layer arriving is the assertion: a page with no words reports zero, and
    # that is what a machine without `pdftotext` and a scan both look like.
    opened = holds(run, lambda it: int(it["look_words"] or 0) > 0, "a page with words on it")
    if int(opened["look_words"]) != len(sentence.split()):
        raise Failure(f"the page holds {opened['look_words']} words, not {len(sentence.split())}")

    # `Ctrl+A` selects the page's words and not the files behind the panel.
    files = int(opened["selected"])
    run.drive("key ctrl+a\nsleep 300\nkey f12\nsleep 200\n")
    whole = holds(run, lambda it: bool(it["look_picked"]), "a selection over the page")
    if sentence not in whole["look_picked"]:
        raise Failure(f"Ctrl+A selected {whole['look_picked']!r}")
    if int(whole["selected"]) != files:
        raise Failure("Ctrl+A over a page changed the file selection behind it")

    run.drive("key ctrl+c\nsleep 400\n")
    held = clipboard(run)
    if held != sentence:
        raise Failure(f"the clipboard holds {held!r}")

    # **A drag across the first word**, aimed through the box the tool gives and
    # the rectangle the window says it drew the page into. The longest word on
    # the line, and inset a tenth of its width at each end: a character is a
    # tenth of it, so the two ends round to its first and last rather than to a
    # boundary a pixel of pointer rounding can fall the wrong side of.
    across, down, words = page_words(paper)
    box = [float(value) for value in whole["look_page_box"].split(":")]
    third = words[0]
    at = lambda x, y: aim(  # noqa: E731
        run,
        whole,
        box[0] + x * box[2] / across,
        box[1] + y * box[3] / down,
    )
    middle = (third[1] + third[3]) / 2.0
    inset = (third[2] - third[0]) / 10.0
    from_at = at(third[0] + inset, middle)
    to_at = at(third[2] - inset, middle)
    run.drive(
        f"drag {from_at[0]:.2f} {from_at[1]:.2f} {to_at[0]:.2f} {to_at[1]:.2f}\n"
        "sleep 400\nkey f12\nsleep 200\n"
    )
    dragged = holds(run, lambda it: it["look_picked"] != whole["look_picked"], "a shorter selection")
    # **The middle of the word, exactly.** A tenth of a ten-character word is one
    # character, so a drag inset a tenth at each end selects the eight between —
    # which is the character interpolation asserted as a string rather than as a
    # pixel: a word box divided by its character count is what puts the caret
    # inside a word at all, and the boundary is four pixels from where this aimed.
    wanted = third[4][1:-1]
    if dragged["look_picked"] != wanted:
        raise Failure(
            f"a drag through {third[4]!r} selected {dragged['look_picked']!r}, wanted {wanted!r}: "
            f"box={whole['look_page_box']} page={across}x{down} word={third} "
            f"from={from_at} to={to_at} pointer={dragged['pointer_at']}"
        )

    # A press on the paper, well below the line, puts it away — and on a page
    # that fits the panel it does nothing else, because there is nothing to pan.
    margin = at(across / 2.0, down - 20.0)
    run.drive(f"move {margin[0]:.2f} {margin[1]:.2f}\nclick left\nsleep 300\nkey f12\nsleep 200\n")
    until(run, look_picked="")


@scenario("a-pages-words-are-found-and-a-double-click-takes-one", fresh=True)
def find_on_a_page(run: Run, fixture: Path) -> None:
    """`Ctrl+F` searches the page in front of you; a double click takes a word.

    **This page, and the bar says so.** Searching a document means a child round
    trip per page — the layer arrives with the pixels — so what is searched is
    what is on screen, which is a smaller promise than a viewer's and an honest
    one. `Enter` walks the matches and wraps; `Escape` puts the bar away.

    The double click is the other half of what a text view owes: a word box is
    already the unit the layer carries, so the first click of the pair selects a
    character and the second takes the word around it.
    """
    if not (shutil.which("pdftoppm") or shutil.which("mutool")):
        raise Skipped("no pdftoppm or mutool, so there is no page to search")
    if not shutil.which("pdftotext"):
        raise Skipped("no pdftotext, so a page has no words — the documented degradation")

    paper = fixture / "paper.pdf"
    paper.write_bytes(one_page_pdf("Find the word word twice here"))
    listed(run)
    until(run, rows="10")
    run.drive("text paper\nsleep 300\nkey f12\nsleep 150\n")
    until(run, cursor="paper.pdf")
    run.drive("key space\nsleep 900\nkey f12\nsleep 300\n")
    holds(run, lambda it: int(it["look_words"] or 0) > 0, "a page with words on it")

    # **`Ctrl+F`, which over a listing filters the rows.** With a page in front of
    # you the rows are behind a panel and the thing to search is the page, which
    # is what `Scope::Look` is for.
    run.drive("key ctrl+f\nsleep 400\nkey f12\nsleep 200\n")
    opened = run.state()
    if opened["look_found"] == "none":
        raise Failure(f"Ctrl+F did not open the find bar: last_key={opened['last_key']}")
    run.drive("text word\nsleep 400\nkey f12\nsleep 200\n")
    typed = run.state()
    if typed["look_query"] != "word":
        raise Failure(f"the field holds {typed['look_query']!r}, found {typed['look_found']}")
    found = holds(run, lambda it: it["look_picked"] == "word", "the first match selected")
    expect(found, look_found="1/2")

    # `Enter` walks them and wraps at the end, which is what a find bar does.
    run.drive("key enter\nsleep 300\nkey f12\nsleep 200\n")
    expect(until(run, look_found="2/2"), look_picked="word")
    run.drive("key enter\nsleep 300\nkey f12\nsleep 200\n")
    until(run, look_found="1/2")

    # A query nobody can find says so and selects nothing.
    run.drive("text zzz\nsleep 400\nkey f12\nsleep 200\n")
    empty = until(run, look_found="0/0")
    expect(empty, look_picked="")

    # `Escape` puts the bar away, and the panel stays open — the second `Escape`
    # is the one that closes a look.
    run.drive("key escape\nsleep 300\nkey f12\nsleep 200\n")
    shut = until(run, look_found="none")
    if not shut["looking"].endswith(":page"):
        raise Failure(f"Escape closed the panel as well: {shut['looking']!r}")

    # **And a double click takes the word under it**, aimed through the box the
    # tool gives and the rectangle the window reports it drew the page into.
    across, down, words = page_words(paper)
    box = [float(value) for value in shut["look_page_box"].split(":")]
    third = words[2]
    at = aim(
        run,
        shut,
        box[0] + (third[0] + third[2]) / 2.0 * box[2] / across,
        box[1] + (third[1] + third[3]) / 2.0 * box[3] / down,
    )
    # `double` rather than two clicks: the window counts them from the display
    # server's own timing, and two `click`s a script apart are two single clicks.
    run.drive(f"move {at[0]:.2f} {at[1]:.2f}\nsleep 200\ndouble\nsleep 400\n")
    run.drive("key f12\nsleep 200\n")
    picked = until(run, look_picked=third[4])
    assert picked is not None


@scenario("a-picture-zooms-under-the-pointer-and-drags", fresh=True)
def zoom_a_picture(run: Run, fixture: Path) -> None:
    """`Ctrl` and the wheel magnify the picture; a drag pans it; `Ctrl 0` undoes it.

    **A pinch takes the same path.** `sk-plat` turns `zwp_pointer_gestures_v1`
    into `Event::Pinched` steps and the window sends a step to the picture before
    it sends one to the list; X11 has no touchpad gestures at all, which is why
    `Ctrl` and the wheel exists and is what a scenario can drive on both servers.

    What it asserts beyond the number: a zoom about the pointer *moves* the
    picture, because the point under the pointer has to stay where it is, and a
    pan is clamped so the picture's edge never comes inside the panel.
    """
    picture = fixture / "wide.png"
    # A picture bigger than the panel, so there is something to clip and somewhere
    # to pan — written by hand, because Pillow is the golden tool's dependency and
    # not this one's, and a checkerboard is four lines of arithmetic.
    import struct
    import zlib

    def chunk(tag: bytes, body: bytes) -> bytes:
        return struct.pack(">I", len(body)) + tag + body + struct.pack(">I", zlib.crc32(tag + body))

    rows = b"".join(
        b"\x00" + bytes(
            value
            for x in range(900)
            for value in ((240, 90, 40) if (x // 60 + y // 60) % 2 == 0 else (30, 40, 90))
        )
        for y in range(700)
    )
    picture.write_bytes(
        b"\x89PNG\r\n\x1a\n"
        + chunk(b"IHDR", struct.pack(">IIBBBBB", 900, 700, 8, 2, 0, 0, 0))
        + chunk(b"IDAT", zlib.compress(rows))
        + chunk(b"IEND", b"")
    )

    listed(run)
    until(run, rows="10")
    run.drive("text wide\nsleep 300\nkey f12\nsleep 150\n")
    until(run, cursor="wide.png")
    run.drive("key space\nsleep 900\nkey f12\nsleep 250\n")
    opened = holds(run, lambda it: it["looking"].endswith(":picture"), "a picture preview")
    expect(opened, look_zoom="1.00", look_pan="0:0")

    # **The pointer above and left of the window's middle**, which is inside the
    # panel and off its centre — so a zoom about that point has to move the
    # picture, and an assertion about the number alone would pass either way.
    across, down = (float(value) for value in opened["logical"].split("x"))
    corner = aim(run, opened, across * 0.35, down * 0.35)
    middle = aim(run, opened, across / 2.0, down / 2.0)
    run.drive(f"move {corner[0]:.2f} {corner[1]:.2f}\nsleep 200\n")
    run.drive("scroll -1 ctrl\nsleep 250\nscroll -1 ctrl\nsleep 300\nkey f12\nsleep 200\n")
    zoomed = holds(run, lambda it: float(it["look_zoom"]) > 1.2, "a magnified picture")
    if zoomed["look_pan"] == "0:0":
        raise Failure("the zoom grew from the middle rather than from under the pointer")

    # A drag pans it, and the pan is clamped: the picture's edge cannot be
    # dragged inside the panel however far the gesture goes.
    before = zoomed["look_pan"]
    run.drive(
        f"drag {middle[0]:.2f} {middle[1]:.2f} {corner[0]:.2f} {corner[1]:.2f}\n"
        "sleep 400\nkey f12\nsleep 200\n"
    )
    dragged = holds(run, lambda it: it["look_pan"] != before, "the picture to have been dragged")
    panned = [float(value) for value in dragged["look_pan"].split(":")]
    if abs(panned[0]) > across or abs(panned[1]) > down:
        raise Failure(f"the pan was not clamped: {dragged['look_pan']}")

    # And `Ctrl 0` — the chord that resets the *list's* zoom when no picture is up
    # — puts it back, which is rule 2: one command, and what it acts on is what is
    # in front of the person.
    run.drive("key ctrl+0\nsleep 300\nkey f12\nsleep 200\n")
    until(run, look_zoom="1.00", look_pan="0:0")


@scenario("an-animation-plays-in-the-preview-and-can-be-stepped", fresh=True)
def animated_gif(run: Run, fixture: Path) -> None:
    """A GIF plays on its own, pauses on a step, and starts again on the button.

    **The one thing in this window that changes while the hands are still.** The
    frame loop sleeps on descriptors and never on a timer — rule 1 — so an
    animation is a wake-up with an owner, and the owner is the panel: it says when
    it wants one, and says nothing the moment it is paused. Which is what makes
    the `no-cpu-when-idle` scenario still true with a GIF on screen and stopped.
    """
    try:
        from PIL import Image
    except ImportError as missing:
        raise Skipped("Pillow is not installed, and the fixture is a real GIF") from missing

    # Six frames, an eighth of a second each, whose only content is which frame
    # it is: a scenario about frames does not need a picture.
    frames = []
    for step in range(6):
        frame = Image.new("P", (40, 40), 0)
        frame.putpalette([0, 0, 0, 255, 255, 255])
        pixels = frame.load()
        for y in range(40):
            for x in range(40):
                pixels[x, y] = 1 if x // 7 == step else 0
        frames.append(frame)
    frames[0].save(
        fixture / "loop.gif",
        save_all=True,
        append_images=frames[1:],
        duration=120,
        loop=0,
    )

    listed(run)
    until(run, rows="10")
    run.drive("text loop\nsleep 300\nkey f12\nsleep 150\n")
    until(run, cursor="loop.gif")
    run.drive("key space\nsleep 900\nkey f12\nsleep 250\n")
    # The count comes from the child, so this is also the assertion that the
    # decoder walked the blocks and found six frames.
    opened = holds(
        run,
        lambda it: it["look_page"].endswith("/6"),
        "a six-frame animation",
    )
    expect(opened, look_playing="true")

    # **It advances with nothing touching it.** Six frames at 120 ms is 720 ms a
    # loop, so a second of waiting has to have moved — and the poll is what waits,
    # because a machine under load takes longer to get there.
    moved = holds(
        run,
        lambda it: it["look_page"] not in ("none", opened["look_page"]),
        "the frame to advance on its own",
    )
    assert moved is not None

    # A frame arrow steps and stops it: somebody stepping has said which frame
    # they want, and an animation that carried on would take it away from them.
    run.drive("key down\nsleep 200\nkey f12\nsleep 200\n")
    stopped = until(run, look_playing="false")
    at = stopped["look_page"]
    run.drive("sleep 700\nkey f12\nsleep 200\n")
    expect(run.state(), look_page=at)

    # And the play control starts it again, with the pointer alone.
    aim = look_aim(run, "play")
    run.drive(f"move {aim[0]:.2f} {aim[1]:.2f}\nclick left\nsleep 300\nkey f12\nsleep 200\n")
    until(run, look_playing="true")
    holds(
        run,
        lambda it: it["look_page"] not in ("none", at),
        "the frame to advance again once it was played",
    )


@scenario("a-long-line-wraps-and-is-edited-where-it-wrapped", fresh=True)
def wrapped_line(run: Run, fixture: Path) -> None:
    """A line wider than the panel is cut into rows, and the rows are editable.

    The defect: a long line was elided with `…` at the panel's right edge, and
    what was past it could be neither read, clicked in, nor typed over — the caret
    could only reach it by counting `→` presses. Wrapping makes the *row* the unit
    of drawing, of clicking and of `Up`/`Down`, which is what an editor with soft
    wrap does everywhere.
    """
    note = fixture / "wide.txt"
    # One line, four hundred characters, no newline in it: this is the shape that
    # elided. Words rather than one run of letters, because the wrap breaks at a
    # space where it can and a scenario that used `zzzz…` would only test the
    # hard cut.
    note.write_text(" ".join(f"word{index:03}" for index in range(50)))
    listed(run)
    until(run, rows="10")
    run.drive("text wide\nsleep 300\nkey f12\nsleep 150\n")
    until(run, cursor="wide.txt")
    run.drive("key space\nsleep 700\nkey f12\nsleep 250\n")
    opened = holds(run, lambda it: it["looking"].endswith(":text"), "a text preview")
    rows = int(opened["look_rows"])
    if rows < 3:
        raise Failure(f"a 400-character line took {rows} rows: it was not wrapped")

    # `Down` on a wrapped line stays on that line and moves along it, which is
    # the whole difference between a row and a line.
    run.drive("key ctrl+e\nsleep 400\nkey f12\nsleep 200\n")
    until(run, look_editing="true", look_caret="0:0")
    run.drive("key down\nsleep 250\nkey f12\nsleep 200\n")
    down = run.state()
    line, byte = down["look_caret"].split(":")
    if line != "0" or int(byte) == 0:
        raise Failure(f"Down left the caret at {down['look_caret']} instead of along line 0")

    # And what is typed there lands where the caret is, not at the line's end.
    run.drive("key end\nsleep 200\ntext !\nsleep 300\nkey ctrl+s\nsleep 600\n")
    deadline = time.time() + WAITING
    while time.time() < deadline and "!" not in note.read_text():
        time.sleep(0.1)
    written = note.read_text()
    if "!" not in written:
        raise Failure("nothing was written to the wrapped line")
    if written.rstrip("\n").endswith("!"):
        raise Failure("the character landed at the end of the line, not at the caret")


@scenario("a-colour-covers-every-folder-that-is-selected", fresh=True)
def colour_a_selection(run: Run, fixture: Path) -> None:
    """Three folders selected, one menu, three coloured marks.

    [Rule 8](../docs/03-principles.md) is one selection, and every command that
    acts on entries acts on all of it — colouring six folders one at a time is six
    menus for one decision. A secondary click *inside* the selection keeps it,
    which is what makes the menu the pointer's way to do this.
    """
    state_home = run.log.parent / "state-colours"
    place = {"XDG_STATE_HOME": str(state_home)}
    run.close()
    own = Run(run.display, run.log.parent, fixture, [], run.instance, place)
    try:
        listed(own)
        own.drive("key down\nsleep 200\nkey shift+down\nkey shift+down\nsleep 300\n")
        own.drive("key f12\nsleep 200\n")
        chosen = until(own, selected="3")

        # The menu opens over a row that is already selected, so the selection
        # survives the press — the claim this scenario turns on.
        row = point_at(own, 0)
        expect(row, hover_name="alpha")
        own.drive("click right\nsleep 400\nkey f12\nsleep 200\n")
        opened = holds(own, lambda it: bool(it.get("menu_aim")), "a menu with drawn rows")
        expect(opened, selected="3")
        aimed = submenu_aim(own, opened, "menu.colour", "view.colour_blue")
        own.drive(f"move {aimed[0]:.2f} {aimed[1]:.2f}\nclick left\nsleep 500\nkey f12\nsleep 200\n")
        coloured = until(own, coloured="alpha:blue,beta:blue,gamma:blue")
        assert coloured is not None and chosen is not None

        # And taking them away is the same one decision. Pointed at the row
        # again first: the pointer is where the menu row was, which is over the
        # list's background once the menu has gone — and a secondary click there
        # opens the *background* menu, which has no colours on it.
        point_at(own, 0)
        own.drive("click right\nsleep 400\nkey f12\nsleep 200\n")
        opened = holds(own, lambda it: bool(it.get("menu_aim")), "a menu with drawn rows")
        aimed = submenu_aim(own, opened, "menu.colour", "view.colour_none")
        own.drive(f"move {aimed[0]:.2f} {aimed[1]:.2f}\nclick left\nsleep 500\nkey f12\nsleep 200\n")
        until(own, coloured="")
    finally:
        own.close()


@scenario("navigation-buttons")
def navigation_buttons(run: Run, fixture: Path) -> None:
    """Back, forward, parent and reload, clicked rather than pressed.

    Each dispatches the command its chord does, so what is checked is that the
    button and the key are the same action — and that a dimmed one does nothing,
    which is the half a `run` without an `enabled` check would get wrong.
    """
    run.drive("sleep 400\nkey f12\nsleep 200\n")
    state = run.state()
    if float(state["tool_w"]) <= 0.0:
        raise Failure("the navigation buttons were shed at this window size")
    at = {
        name: tool_aim(run, state, index)
        for index, name in enumerate(("back", "forward", "parent", "reload"))
    }

    def point(name: str) -> dict[str, str]:
        x, y = at[name]
        run.drive(f"move {x:.2f} {y:.2f}\nsleep 180\nkey f12\nsleep 150\n")
        found = run.state()
        if found["tool_hover"] != name:
            raise Failure(f"aimed at {name} and hit {found['tool_hover']!r}")
        return found

    # Back has nowhere to go from the directory the window opened on, so a click
    # on it must do nothing at all.
    point("back")
    run.drive("click\nsleep 400\nkey f12\nsleep 200\n")
    expect(run.state(), path=str(fixture))

    # Into `alpha` with the keyboard, out with the Back button.
    run.drive("key down\nkey enter\nsleep 600\nkey f12\nsleep 200\n")
    expect(run.state(), path=str(fixture / "alpha"))
    point("back")
    run.drive("click\nsleep 600\nkey f12\nsleep 200\n")
    expect(run.state(), path=str(fixture))

    # Which is what makes Forward live. Going *up* would not: up is a fresh
    # navigation and ends the forward branch, the same as it does in a browser.
    point("forward")
    run.drive("click\nsleep 600\nkey f12\nsleep 200\n")
    expect(run.state(), path=str(fixture / "alpha"))

    # And the parent button climbs out again.
    point("parent")
    run.drive("click\nsleep 600\nkey f12\nsleep 200\n")
    expect(run.state(), path=str(fixture))

    # And reload re-reads without moving.
    point("reload")
    run.drive("click\nsleep 800\nkey f12\nsleep 200\n")
    state = run.state()
    expect(state, path=str(fixture), loading="false")
    if int(state["rows"]) != 9:
        raise Failure(f"{state['rows']} rows after a reload, wanted 9")


@scenario("breadcrumb-navigation")
def breadcrumb_navigation(run: Run, fixture: Path) -> None:
    """Clicking a path component goes there, and hovering says which.

    The regions come from the frame that drew them, because the width of a
    breadcrumb is the shaped width of a directory name and is known nowhere
    else. This walks two levels down and clicks its way back up one.
    """
    listed(run)
    # Into `alpha`, so there is a parent worth clicking.
    run.drive("key down\nkey enter\n")
    state = until(run, path=str(fixture / "alpha"), rows="2")
    deep = int(state["crumbs"])
    if deep < 3:
        raise Failure(f"only {deep} path components under {state['path']}")

    # **The hover check and the click go in one script.** Every `drive` call is a
    # fresh process, so splitting them leaves a gap of a process spawn in which a
    # late resize can re-flow the breadcrumbs — and then the click lands on the
    # crumb *beside* the one the hover just confirmed, which is what a full sweep
    # under load produced: it went to the grandparent.
    x, y = aim(run, state, float(state["parent_crumb_x"]), float(state["parent_crumb_y"]))
    run.drive(f"move {x:.2f} {y:.2f}\nsleep 250\nkey f12\nsleep 150\nclick\nsleep 200\n")
    hovered = run.states()[-1]["crumb_hover"]
    if hovered != str(deep - 2):
        raise Failure(f"the parent component reads as crumb {hovered}, wanted {deep - 2}")
