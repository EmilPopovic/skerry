@scenario("no-cpu-when-idle")
def no_cpu_when_idle(run: Run, fixture: Path) -> None:
    run.drive("sleep 1500\n")  # let the folder walks finish
    ticks = lambda: sum(
        int(value) for value in Path(f"/proc/{run.process.pid}/stat").read_text().split()[13:15]
    )
    before = ticks()
    time.sleep(3.0)
    after = ticks()
    if after != before:
        raise Failure(f"an idle window used {after - before} ticks of CPU")


# --------------------------------------------------------------------------


def main(argv: list[str]) -> int:
    wanted = [a for a in argv[1:] if not a.startswith("--")]
    keep = "--keep" in argv

    for binary in (SKERRY, DRIVE):
        if not binary.is_file():
            print(f"missing {binary}; run `cargo build --release` first")
            return 2

    work = Path(tempfile.mkdtemp(prefix="skerry-gui-"))
    compositor = None
    passed, failed = 0, []
    try:
        compositor, display, instance = start_compositor(work)
        print(f"nested compositor on {display}")
        fixture = make_fixture(work)

        for name, function in SCENARIOS.items():
            if wanted and not any(needle in name for needle in wanted):
                continue
            run = None
            try:
                run = Run(display, work, fixture, [], instance)
                function(run, fixture)
                print(f"  ok    {name}")
                passed += 1
            except Skipped as why:
                print(f"  skip  {name}: {why}")
            except Failure as problem:
                print(f"  FAIL  {name}: {problem}")
                failed.append(name)
            finally:
                if run is not None:
                    run.close()
    except Failure as problem:
        print(f"fixture: {problem}")
        return 1
    finally:
        stop_compositor(compositor, work / "hypr.conf")
        if keep:
            print(f"left behind: {work}")
        else:
            shutil.rmtree(work, ignore_errors=True)

    print(f"\n{passed} passed, {len(failed)} failed")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
