def clipboard(run: Run, mime: str = "text/plain;charset=utf-8") -> str:
    """What the clipboard holds, read by a **separate client**.

    Never the window's own report: the point of a clipboard is that another
    application can read it, and a scenario that asked the window what it thinks
    it offered would pass with the selection never taken.

    `wl-paste` is that other application on Wayland. On X11 it is
    `skerry-drive --paste`, because neither `xclip` nor `xsel` is a given on a
    machine and the driver already speaks X11 — one binary the repository
    controls beats a package the reader has to be told to install.
    """
    del run
    command = SERVER.paste_command(mime)
    if command is None:
        raise Skipped("no clipboard reader for this display server")
    done = subprocess.run(command, env=with_server(), capture_output=True, timeout=15)
    if done.returncode != 0:
        raise Failure(f"the clipboard reader refused: {done.stderr.decode().strip()}")
    return done.stdout.decode("utf-8", "replace")


def make_fixture(root: Path, name: str = "fixture") -> Path:
    fixture = root / name
    shutil.rmtree(fixture, ignore_errors=True)
    for folder in ("alpha", "beta", "gamma"):
        (fixture / folder).mkdir(parents=True)
        (fixture / folder / "inner.txt").write_text("x" * 10)
    (fixture / "alpha" / "nested").mkdir()
    (fixture / "alpha" / "nested" / "deep.txt").write_text("y" * 20)
    for index in range(1, 7):
        (fixture / f"file-{index}.txt").write_text("z" * (index * 100))
    (fixture / ".hidden").write_text("secret")
    return fixture


SCENARIOS = {}

# The fewest scenarios this file is allowed to register.
#
# A ratchet, and it is here because a scripted edit deleted two of them by
# slicing between one `@scenario` and the next — which is silent except for the
# count in the summary, and the count is only noticed by somebody who remembers
# what it was. Removing a scenario on purpose means lowering this in the same
# commit, which is where the argument for removing it belongs.
FEWEST_SCENARIOS = 80


def scenario(name, fresh: bool = False):
    """Registers a scenario.

    `fresh` gives it a fixture of its own and an `XDG_DATA_HOME` of its own —
    both required of anything that changes the directory it is looking at, since
    every other scenario counts the rows in the shared one, and since the Trash
    a test fills must not be the Trash the person running it has.
    """

    def register(function):
        function.fresh = fresh
        SCENARIOS[name] = function
        return function

    return register


