@scenario("an-input-method-composes-into-a-field")
def input_method(run: Run, fixture: Path) -> None:
    """A real input method types into the rename field.

    **Wayland only.** `text-input-v3` is the protocol a Chinese, Japanese or
    Korean input method reaches a client through, and X11's equivalent is XIM,
    which is not written — the window reports the capability absent there.

    The peer is `skerry-drive --ime`, which speaks `zwp_input_method_v2`: it
    waits for the window to *enable* its text input, shows a preedit, holds it,
    then commits. Without a peer this whole path is a conversation with nobody,
    and a client that dropped every event would look exactly like one that works.
    """
    if SERVER.driver_flag() != "--wayland":
        raise Skipped("text-input-v3 is Wayland's; X11 reports the capability absent")

    run.drive("sleep 500\nkey down\nsleep 200\nkey f2\nsleep 500\nkey f12\nsleep 200\n")
    naming = run.state()
    if not naming["naming"]:
        raise Failure("the rename field did not open")

    # **Its output goes to a file, not a pipe.** A `peek` on a pipe blocks, and
    # the first version of this hung the whole suite for ten minutes reading the
    # peer's stderr to explain a failure.
    said = run.log.parent / "ime.err"
    with said.open("wb") as errors:
        peer = subprocess.Popen(
            [str(DRIVE), "--ime", "にほん", "日本", "900"],
            env=with_server(),
            stdout=subprocess.DEVNULL,
            stderr=errors,
        )
    try:
        # While the preedit is held: shown, and *not* part of the name.
        run.drive("sleep 500\nkey f12\nsleep 200\n")
        composing = run.state()
        if composing["composing"] != "にほん":
            raise Failure(f"composing is {composing['composing']!r}")
        if "にほん" in composing["naming"]:
            raise Failure("the preedit was typed into the name before it was committed")

        # **Resized while the method is composing.** The caret's rectangle
        # changes, so the window sends a new one and commits mid-conversation —
        # and what is asserted below is that the commit still lands. It does
        # *not* reach the serial-mismatch branch: that needs the compositor to
        # answer a stale commit, which nothing here can arrange, and the branch
        # follows the specification rather than a test.
        run.make_floating()
        SERVER.resize(900, 600)

        # And after the commit: in the name, and no longer composing.
        peer.wait(timeout=10)
        run.drive("sleep 400\nkey f12\nsleep 200\n")
        committed = run.state()
        expect(committed, composing="")
        if "日本" not in committed["naming"]:
            raise Failure(f"the name reads {committed['naming']!r}")
    finally:
        if peer.poll() is None:
            peer.kill()
        peer.wait(timeout=5)
        if peer.returncode not in (0, -9) and said.exists():
            raise Failure(f"the input method refused: {said.read_text().strip()[:200]}")


@scenario("a-permanent-delete-asks-in-a-panel", fresh=True)
def permanent_delete(run: Run, fixture: Path) -> None:
    """`Shift+Delete` asks a question, and only an answer deletes anything.

    Rule 3 calls permanent deletion "an explicit, differently-shaped action" and
    leaves it off the undo stack. The shape used to be a sentence in the status
    strip, in the same dim grey as the row count, armed for exactly as long as
    that sentence stayed up — so **anything else replacing the notice silently
    withdrew the offer**, which the old version of this scenario asserted as
    though it were the feature. The wait below is what that could not survive.
    """
    listed(run)
    run.drive("key end\n")
    chosen = until(run, selected="1")["cursor"]
    if not chosen:
        raise Failure("nothing is selected to delete")
    doomed = fixture / chosen

    run.drive("key shift+delete\n")
    asked = until(run, erasing="1")
    # Cancel is the one the keyboard starts on: the answer a hand arrives at by
    # reflex has to be the safe one.
    expect(asked, erasing_on="cancel")
    if not doomed.exists():
        raise Failure("asking deleted it")

    # **Six seconds**, which is half again the old notice window. The question is
    # still there, and still the same question.
    run.drive("sleep 6000\n")
    expect(until(run, erasing="1"), erasing_on="cancel")

    run.drive("key escape\n")
    until(run, erasing="0")
    if not doomed.exists():
        raise Failure("cancelling deleted it")

    # Twice in a row is the keyboard's fast path, and the second press is the
    # answer rather than a repeat of the question.
    run.drive("key shift+delete\nkey shift+delete\n")
    state = settled(run)
    if doomed.exists():
        raise Failure(
            f"answering left {doomed.name} behind: erasing={state.get('erasing')} "
            f"on={state.get('erasing_on')} busy={state.get('busy')} "
            f"queue={state.get('queue')} cursor={state.get('cursor')!r}"
        )
    expect(state, erasing="0")

    # And it is not on the undo stack: `Ctrl+Z` must not claim to bring it back.
    run.drive("key ctrl+z\n")
    settled(run)
    if doomed.exists():
        raise Failure("undo brought back a permanent delete")


@scenario("a-panel-blocks-the-hover-under-it", fresh=True)
def panels_block_hover(run: Run, fixture: Path) -> None:
    """A row under a panel does not light up as the pointer crosses it.

    **A highlight tracking a pointer that is reading something else**, on rows a
    click cannot reach: the panel takes the press, so the row lighting up is not
    a row anything would happen to. Every panel records its rectangle for this; a
    drag card deliberately does not, because a drag has to see the rows under it.

    **One point, two states**, which is what makes this able to fail. The first
    version aimed forty pixels above a button and landed past the last row, where
    nothing hovers with the bug or without it — so it passed against the defect it
    was written for. The point below is proven to be over a row by hovering it
    *after* the panel closes; if it were not, this would fail there instead.
    """
    # **Enough rows to reach the middle of the window.** A panel is centred and
    # the shared fixture is nine rows in a thousand-pixel window, so the panel
    # lands entirely below the last row — over nothing, where the hover is `-1`
    # with the bug and without it.
    for index in range(40):
        (fixture / f"filler-{index:02}.txt").write_text("x")
    listed(run)
    run.drive("key f5\n")
    until(run, loading="false", rows="49")
    # Everything, so the question lists six names and an "and N more" — a panel
    # tall enough that its top edge is over the rows rather than over the empty
    # space below them, which is where a short one lands in a small fixture.
    run.drive("key ctrl+a\n")
    chosen = until(run, loading="false")
    if int(chosen["selected"]) < 6:
        raise Failure(f"only {chosen['selected']} selected, too few for a tall panel")
    run.drive("key shift+delete\n")
    asked = until(run, erasing=chosen["selected"])

    x, y, _, _ = (float(part) for part in asked["panel_area"].split(":"))
    inside = aim(run, asked, x + 40.0, y + 12.0)
    run.drive(f"move {inside[0]:.1f} {inside[1]:.1f}\nsleep 200\nkey f12\nsleep 150\n")
    under = run.state()
    if under["hover"] != "-1":
        raise Failure(f"row {under['hover']} lit up under the panel: {under['hover_name']!r}")

    run.drive("key escape\n")
    until(run, erasing="0")
    # The same point, with the panel gone. This has to hover something, or the
    # assertion above was about a point with no row under it.
    #
    # **Away and back**, because a `move` to where the pointer already is sends
    # no motion at all — so the hover would still be the one from under the panel
    # and this check would agree with itself.
    elsewhere = aim(run, asked, x + 40.0, y - 80.0)
    run.drive(
        f"move {elsewhere[0]:.1f} {elsewhere[1]:.1f}\nsleep 120\n"
        f"move {inside[0]:.1f} {inside[1]:.1f}\nsleep 200\nkey f12\nsleep 150\n"
    )
    after = run.state()
    if after["hover"] == "-1":
        raise Failure("that point has no row under it, so the check above proved nothing")


@scenario("the-delete-question-answers-to-a-pointer", fresh=True)
def permanent_delete_by_pointer(run: Run, fixture: Path) -> None:
    """Both answers are real targets, and Cancel is one of them.

    A question a pointer can only agree with is not a question. This clicks
    Cancel first, on purpose: the button that does nothing is the one worth
    proving, because a panel whose Cancel does not work deletes files.
    """
    listed(run)
    run.drive("key end\n")
    chosen = until(run, selected="1")["cursor"]
    doomed = fixture / chosen

    def aim_at(state, index):
        points = [it for it in state.get("erase_aim", "").split(",") if it]
        if len(points) != 2:
            raise Failure(f"the question drew {len(points)} buttons, wanted two")
        x, _, y = points[index].partition(":")
        return aim(run, state, float(x), float(y))

    run.drive("key shift+delete\n")
    cancel = aim_at(until(run, erasing="1"), 0)
    run.drive(f"move {cancel[0]:.1f} {cancel[1]:.1f}\nsleep 150\nclick\n")
    until(run, erasing="0")
    if not doomed.exists():
        raise Failure("clicking Cancel deleted it")

    run.drive("key shift+delete\n")
    delete = aim_at(until(run, erasing="1"), 1)
    run.drive(f"move {delete[0]:.1f} {delete[1]:.1f}\nsleep 150\nclick\n")
    settled(run)
    if doomed.exists():
        raise Failure("clicking Delete left it behind")


@scenario("duplicate-copies-beside-the-original", fresh=True)
def duplicate(run: Run, fixture: Path) -> None:
    """`Ctrl+D` copies under a free name rather than refusing a taken one.

    The same rule pasting into the folder you copied from follows, which is what
    made the refusal worth removing: a copy renames and a move refuses.
    """
    run.drive("sleep 500\nkey f12\nsleep 200\n")
    start = run.state()
    rows = int(start["rows"])

    # Onto a file rather than a folder, so the copy is one `copy_file`.
    run.drive("key end\nsleep 300\nkey f12\nsleep 200\n")
    chosen = run.state()["cursor"]
    run.drive("key ctrl+d\nsleep 1200\nkey f12\nsleep 400\n")
    after = run.state()
    if int(after["rows"]) != rows + 1:
        raise Failure(f"{after['rows']} rows, wanted {rows + 1}")
    stem, _, extension = chosen.partition(".")
    wanted = f"{stem} (copy)" + (f".{extension}" if extension else "")
    if not (fixture / wanted).exists():
        made = sorted(p.name for p in fixture.iterdir())
        raise Failure(f"no {wanted!r} beside it: {made}")

    # And it is one undo entry, not one per byte.
    run.drive("key ctrl+z\nsleep 1200\nkey f12\nsleep 400\n")
    if (fixture / wanted).exists():
        raise Failure("undo left the copy behind")


@scenario("the-list-zooms-and-comes-back-exactly")
def zoom(run: Run, fixture: Path) -> None:
    """`Ctrl +` and `Ctrl -` resize the rows; `Ctrl 0` puts them back exactly.

    **Exactly** is the assertion worth making: the steps are a table rather than
    a repeated multiplication, so eight steps out and eight back is the size it
    started at and not a pixel off. A factor would drift, and the drift is
    invisible until somebody measures it.
    """
    run.drive("sleep 500\nkey f12\nsleep 200\n")
    start = run.state()
    base = float(start["row_h"])

    run.drive("key ctrl+=\nsleep 300\nkey f12\nsleep 200\n")
    bigger = run.state()
    if float(bigger["row_h"]) <= base:
        raise Failure(f"rows are {bigger['row_h']}, wanted taller than {base}")
    # The list gets fewer rows on screen, which is what a zoom is for.
    if float(bigger["body_height"]) > float(start["body_height"]) + 1.0:
        raise Failure("the list grew instead of the rows")

    run.drive("key ctrl+minus\nsleep 300\nkey ctrl+minus\nsleep 300\nkey f12\nsleep 200\n")
    smaller = run.state()
    if float(smaller["row_h"]) >= base:
        raise Failure(f"rows are {smaller['row_h']}, wanted shorter than {base}")

    run.drive("key ctrl+0\nsleep 300\nkey f12\nsleep 200\n")
    if float(run.state()["row_h"]) != base:
        raise Failure(f"back at {run.state()['row_h']}, started at {base}")

    # Every step out, then every step back: the ends clamp rather than wrap, and
    # the round trip lands on the same number it left.
    run.drive("key ctrl+=\n" * 9 + "sleep 400\nkey f12\nsleep 200\n")
    largest = float(run.state()["row_h"])
    run.drive("key ctrl+minus\n" * 9 + "sleep 400\nkey f12\nsleep 200\n")
    smallest = float(run.state()["row_h"])
    run.drive("key ctrl+=\n" * 9 + "sleep 400\nkey f12\nsleep 200\n")
    if float(run.state()["row_h"]) != largest:
        raise Failure(f"the round trip landed on {run.state()['row_h']}, not {largest}")
    if smallest >= base or largest <= base:
        raise Failure(f"the ends are {smallest} and {largest} around {base}")


@scenario("the-frame-is-at-the-compositors-scale")
def first_frame_scale(run: Run, fixture: Path) -> None:
    """What the program scales by is what the display server asked for.

    **Run this with `--scale=1.25`.** At scale 1 it cannot fail, which is most of
    what it is here to say: `120` is also what a program that never read the
    scale at all would report, so the assertion only has teeth on a fractional
    output. It is the assertion the 1×1 pre-map probe in docs/08-roadmap.md
    exists to satisfy — a compositor that sends the scale only after the first
    buffer is attached would fail it.

    Two mechanisms, one assertion. On Wayland the scale is
    `wp_fractional_scale_v1`; on X11 there is no such protocol and it is
    `Xft.dpi` in the root window's resource database, which is where every X11
    desktop states one. `--scale` writes it there rather than forcing the
    program's hand, so what is under test is the reading and not the override.
    """
    run.drive("sleep 700\nkey f12\nsleep 150\n")
    state = run.state()
    scale = output_scale(run)
    wanted = round(scale * 120)
    if int(state["scale_120"]) != wanted:
        raise Failure(f"the compositor is at {scale} and the program scales by {state['scale_120']}/120")
    # And the frame that matters: the first one. A compositor that sends the
    # scale only after the first buffer is attached would have this at 120 with
    # the one above already right — one frame at the wrong size.
    if int(state["first_frame_scale_120"]) != wanted:
        raise Failure(
            f"the compositor is at {scale}, the first frame was drawn at "
            f"{int(state['first_frame_scale_120']) / 120}"
        )


@scenario("window-close-command")
def window_close_command(run: Run, fixture: Path) -> None:
    """`Ctrl+W` closes the window, and it is the same action as the button.

    Rule 2: every action is one entry in one registry. A title-bar button only a
    pointer can reach is an action outside it — invisible to the keyboard
    overlay, unbindable, and unfindable by the palette when there is one.
    """
    run.drive("sleep 400\nkey ctrl+w\nsleep 500\n")
    code = run.process.wait(timeout=10)
    if code < 0:
        raise Failure(f"Ctrl+W killed it with signal {-code}")
    if code != 0:
        raise Failure(f"Ctrl+W exited {code}: {run.err.read_text()[-300:]}")


@scenario("own-frame-maximize")
def own_frame_maximize(run: Run, fixture: Path) -> None:
    """The maximise button is where the layout says it is, and works.

    **The state cannot be asserted under this compositor.** Hyprland sends
    `maximized` together with all four `tiled` flags for a floating 320x240
    window, and ignores `unset_maximized` for a tiled one — so what it reports is
    neither what the window looks like nor what was asked for. That is recorded
    in docs/06-portability.md as a compositor difference, not worked around here.

    What this does cover is the half that is ours: the button is where
    `Layout::compute_with` put it, hit-testing finds it, and the request goes out
    without the window dying — which is the whole path from a pixel to
    `xdg_toplevel.set_maximized`.
    """
    run.close()
    own = Run(run.display, run.log.parent, fixture, ["--own-frame"], run.instance)
    try:
        own.drive("sleep 400\nkey f12\nsleep 200\n")
        state = own.state()
        expect(state, frame="own")

        # One button width to the left of the close button's centre. The width
        # comes from the close button's own offset from the right edge, so the
        # test does not carry a copy of the metric it is testing.
        button_width = (float(state["logical"].split("x")[0]) - float(state["close_x"])) * 2.0
        maximize_x = float(state["close_x"]) - button_width
        x, y = aim(own, state, maximize_x, float(state["title_h"]) / 2.0)
        own.drive(f"move {x:.2f} {y:.2f}\nsleep 200\nkey f12\nsleep 200\n")
        if own.state()["frame_hover"] != "maximize":
            raise Failure(f"aimed at maximise and hit {own.state()['frame_hover']!r}")

        own.drive("click\nsleep 600\nclick\nsleep 600\nkey f12\nsleep 200\n")
        if own.process.poll() is not None:
            raise Failure(f"maximising killed the window: {own.err.read_text()[-300:]}")
        expect(own.state(), frame="own", frame_hover="maximize")
    finally:
        own.close()


@scenario("clean-close")
def clean_close(run: Run, fixture: Path) -> None:
    run.drive("sleep 800\n")
    code = run.ask_to_close()
    if code < 0:
        raise Failure(f"closing the window killed it with signal {-code}")
    if code != 0:
        raise Failure(f"closing the window exited {code}: {run.err.read_text()[-300:]}")


@scenario("no-cpu-when-idle")
def no_cpu_when_idle(run: Run, fixture: Path) -> None:
    """Rule 1's gate: a window nobody is touching uses no CPU at all.

    **Waited for, not slept through.** The folder totals are recursive walks on
    the job pool, and one tick of CPU is a walk that had not finished when the
    measurement started — which a `sleep 1500` calls idle on a quiet machine and
    does not on a busy one. The window reports how many walks are running, so
    this asks.

    **Every kind of walk, not the two it started with.** An index build is a
    third, and it is two walks: the build and the counting pass beside it that
    the progress bar's denominator comes from. Nothing in this scenario asks for
    one, so this is a guard against a later scenario or a later default rather
    than against today — the gate has to name what would make it wrong, because
    a tick of CPU says nothing about which walk produced it.
    """
    quiet = lambda it: (
        it.get("sizes", "").endswith("/0")
        and it.get("loading") == "false"
        and it.get("indexing") == "0"
        and it.get("busy") == "false"
    )
    for _ in range(40):
        run.drive("key f12\nsleep 150\n")
        state = run.state()
        if quiet(state):
            break
    else:
        raise Failure(f"the window never went quiet: {run.state()}")
    ticks = lambda: sum(
        int(value) for value in Path(f"/proc/{run.process.pid}/stat").read_text().split()[13:15]
    )
    # **CPU is only a violation if nothing was drawn for it.** The premise here is
    # that nothing happens to this window for three seconds, and in a compositor
    # that has mapped and unmapped a hundred windows that is occasionally false —
    # measured, one sweep in four or five, always exactly one tick. A window that
    # is handed an event and draws a frame for it is behaving correctly and is
    # not idle, so that measurement is void rather than failing.
    #
    # The distinction is the whole invariant: **a loop on a timer burns CPU in
    # every window and draws nothing**, which this now says in as many words,
    # and a stray event burns it in one window and draws a frame. `frames` is
    # what tells them apart, and an `F12` on its own does not move it.
    drawn = int(state["frames"])
    for _ in range(3):
        before = ticks()
        time.sleep(3.0)
        spent = ticks() - before
        after = run.answered()
        # **One, because the `F12` that reads this draws one.** Measured, not
        # assumed: the first version of this counted any movement as an event
        # and so could never reach the branch below, which made the whole
        # discriminator dead code and the gate a plain three-window retry.
        moved = (int(after["frames"]) - drawn - 1) if after else 0
        if spent == 0:
            return
        if moved <= 0:
            raise Failure(f"an idle window used {spent} ticks of CPU and drew nothing for them")
        drawn = int(after["frames"])
    raise Failure("the window kept drawing unasked; it was never idle long enough to measure")


