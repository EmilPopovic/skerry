        raise Failure(
            f"the list moved when a tab opened: {start['body_top']} then {two['body_top']}"
        )

    # The new tab navigates on its own; the first one stays where it was.
    run.drive("key ctrl+l\nsleep 250\nkey ctrl+u\n")
