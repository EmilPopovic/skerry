def clipboard(run: Run, mime: str = "text/plain;charset=utf-8") -> str:
    """What the clipboard holds, read by a **separate client**.

    Never the window's own report: the point of a clipboard is that another
    application can read it, and a scenario that asked the window what it thinks
    it offered would pass with the selection never taken.

    `wl-paste` is that other application on Wayland. On X11 it is
    `skerry-drive --paste`, because neither `xclip` nor `xsel` is a given on a
    machine and the driver already speaks X11 — one binary the repository
    controls beats a package the reader has to be told to install.
    """
    del run
    command = SERVER.paste_command(mime)
    if command is None:
        raise Skipped("no clipboard reader for this display server")
    done = subprocess.run(command, env=with_server(), capture_output=True, timeout=15)
    if done.returncode != 0:
        raise Failure(f"the clipboard reader refused: {done.stderr.decode().strip()}")
    return done.stdout.decode("utf-8", "replace")


class OutOfTime(BaseException):
    """A scenario that overran its budget.

    **`BaseException`, and that is the whole design.** The first version raised
    `Failure`, which scenarios and helpers legitimately catch — `yield_focus`
    suppresses one on purpose — so a budget that expired inside such a block was
    swallowed, and `signal.setitimer` is one-shot, so it never fired again. The
    scenario it was supposed to stop then ran for **1,869 seconds** against a
    180-second ceiling and took the rest of the sweep's budget with it. Nothing
    in this file may catch this by accident, so it descends from the one thing
    `except Exception` does not cover.
    """


@contextlib.contextmanager
def a_budget(seconds: float):
    """Fails a scenario that runs longer than `seconds` instead of hanging.

    **A stuck scenario used to be a stuck sweep.** Every wait in here is bounded
    now, which is the real fix — but "every" is a claim about code that keeps
    being written, and this is the one that does not depend on the next wait
    remembering. `SIGALRM` lands inside whatever `subprocess.run` or `sleep` the
    scenario is in and comes out as an ordinary failure, so the sweep reports the
    name and carries on to the next one.

    Single-threaded on purpose: `signal.setitimer` only interrupts the main
    thread, and this runner has no other.
    """
    def rang(_signum, _frame):
        raise OutOfTime(f"took longer than {seconds:.0f}s, which is a hang and not a wait")

    previous = signal.signal(signal.SIGALRM, rang)
    # **Repeating, not one-shot.** Belt as well as braces: if anything ever does
    # swallow one of these, the next arrives five seconds later rather than never.
    signal.setitimer(signal.ITIMER_REAL, seconds, 5.0)
    try:
        yield
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous)


def announce(name: str) -> None:
    """Says which scenario is running, before it is known how it went.

    A sweep that prints only verdicts is a terminal with nothing in it for
    however long the slow one takes, and "nothing is happening" and "this one is
    stuck" look identical. On a terminal the line is overwritten by the verdict;
    in a log it stays, which is where knowing the name matters most.
    """
    end = "\r" if sys.stdout.isatty() else "\n"
    print(f"  ..    {name}", end=end, flush=True)


def verdict(line: str, began: float) -> None:
    # Padded past the announcement it overwrites on a terminal, and timed: a
    # scenario that has quietly grown to forty seconds is a defect nobody would
    # otherwise read, and the sweep's own budget is stated in the same unit.
    print(f"{line}  {time.time() - began:.1f}s".ljust(74))


def make_fixture(root: Path, name: str = "fixture") -> Path:
    fixture = root / name
    shutil.rmtree(fixture, ignore_errors=True)
    for folder in ("alpha", "beta", "gamma"):
        (fixture / folder).mkdir(parents=True)
        (fixture / folder / "inner.txt").write_text("x" * 10)
    (fixture / "alpha" / "nested").mkdir()
    (fixture / "alpha" / "nested" / "deep.txt").write_text("y" * 20)
    for index in range(1, 7):
        (fixture / f"file-{index}.txt").write_text("z" * (index * 100))
    (fixture / ".hidden").write_text("secret")
    return fixture


SCENARIOS = {}

# The fewest scenarios this file is allowed to register.
#
# A ratchet, and it is here because a scripted edit deleted two of them by
# slicing between one `@scenario` and the next — which is silent except for the
# count in the summary, and the count is only noticed by somebody who remembers
# what it was. Removing a scenario on purpose means lowering this in the same
# commit, which is where the argument for removing it belongs.
FEWEST_SCENARIOS = 152


def scenario(name, fresh: bool = False, bus: bool = False):
    """Registers a scenario.

    `fresh` gives it a fixture of its own and an `XDG_DATA_HOME` of its own —
    both required of anything that changes the directory it is looking at, since
    every other scenario counts the rows in the shared one, and since the Trash
    a test fills must not be the Trash the person running it has.

    **Also required of anything that changes what is *remembered* about that
    directory.** `XDG_STATE_HOME` is shared by the whole sweep, so a scenario that
    sorts, groups or switches the view mode writes a record against the path it is
    standing in — and every later scenario over that path, and every folder under
    it through the ancestor inheritance, opens with it. A grouping recorded on the
    shared fixture gave `alpha` and `beta` a heading, and the three scenarios that
    click a row by arithmetic over `row_h` clicked one row too far. A fresh fixture
    fixes it because the record is keyed by a path nobody else opens.

    `bus` gives it a session bus of its own — a `dbus-daemon` started for that
    scenario and killed with it — which is what a scenario about
    `org.freedesktop.FileManager1` or about a second instance handing over needs,
    and what nothing else may have: see `with_server`.
    """

    def register(function):
        function.fresh = fresh
        function.bus = bus
        SCENARIOS[name] = function
        return function

    return register


@scenario("keyboard-cursor")
def keyboard_cursor(run: Run, fixture: Path) -> None:
    # Three answers out of one script, read by position, after a sleep that
    # guessed at the first read: under a full sweep only one of the three had been
    # printed and the unpacking raised `ValueError` — a crash rather than a
    # failure, which used to take the rest of the sweep with it.
    expect(listed(run), rows="9", cursor="", selected="0")
    run.drive("key down\nkey down\n")
    expect(until(run, cursor="beta"), selected="1")
    run.drive("key up\n")
    expect(until(run, cursor="alpha"), selected="1")


@scenario("keyboard-navigate")
def keyboard_navigate(run: Run, fixture: Path) -> None:
    listed(run)
    run.drive("key down\nkey enter\n")
    # Both, not the path alone: the path changes when the navigation is *asked
    # for* and the rows arrive when the read lands, so waiting on the path is
    # waiting for the wrong half.
    until(run, path=str(fixture / "alpha"), rows="2")
    run.drive("key backspace\n")
    # The cursor is put back on the folder you came out of when the *names* land,
