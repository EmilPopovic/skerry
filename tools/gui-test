@scenario("a-split-is-two-panes-that-move-apart")
def splits(run: Run, fixture: Path) -> None:
    """F3 splits, F6 moves the keyboard, and the divider moves the boundary.

    The two halves start equal, and a drag of the divider makes one of them
    wider and the other narrower by the same amount — which is the assertion
    that a ratio is being applied rather than a rectangle being guessed.
    """
    run.drive("sleep 500\nkey f3\nsleep 800\nkey f12\nsleep 200\n")
    split = run.state()
    expect(split, panes="2", pane_focus="1")
    sizes = split["pane_sizes"].split(",")
    widths = [float(size.split("x")[0]) for size in sizes]
    if abs(widths[0] - widths[1]) > 2.0:
        raise Failure(f"the halves are {widths}, wanted equal")

    # The keyboard is on the new half; F6 brings it back to the first.
    run.drive("key f6\nsleep 300\nkey f12\nsleep 200\n")
    expect(run.state(), pane_focus="0", panes="2")

    where = divider_aim(run, split)
    run.drive(f"move {where[0]:.1f} {where[1]:.1f}\nsleep 300\nkey f12\nsleep 200\n")
    expect(run.state(), pointer="divider-h")

    # A fixed point well left of the divider, in one press-move-release.
    # **Not an offset from `name_x`:** that is the *focused* pane's name column,
    # which after a split is the right-hand half — so the first version of this
    # aimed to the right of the divider and asserted that it had moved left.
    target = aim(run, split, 200.0, float(split["body_top"]) + 60.0)
    run.drive(
        f"move {where[0]:.1f} {where[1]:.1f}\nsleep 150\npress\nsleep 150\n"
        f"move {target[0]:.1f} {target[1]:.1f}\nsleep 250\nrelease\nsleep 300\nkey f12\nsleep 200\n"
    )
    moved = run.state()
    after = [float(size.split("x")[0]) for size in moved["pane_sizes"].split(",")]
    if after[0] >= widths[0] - 20.0:
        raise Failure(f"the divider did not move: {widths} then {after}")
    if abs((after[0] + after[1]) - (widths[0] + widths[1])) > 8.0:
        raise Failure(f"the two halves stopped filling the window: {after}")

    run.drive("key ctrl+f3\nsleep 500\nkey f12\nsleep 200\n")
    expect(run.state(), panes="1")


@scenario("a-pane-bar-belongs-to-its-own-pane")
def a_pane_bar_belongs_to_its_own_pane(run: Run, fixture: Path) -> None:
    """Two panes, two path bars, and a button in one acts on the pane it is in.

    **The half a golden frame cannot see.** The frame proves each bar draws its
    own pane's path; only a click proves the press routes there. F3 leaves the
    keyboard in the *new* half, so the button pressed here is in the half that
    does not have it — which is exactly where a press that acted on the focused
    pane instead would be wrong and invisible.

    Aimed from the rectangle the frame reports for that leaf, because `bar_y` and
    `tools_x` answer about the focused pane and would put this click in the other
    half. The buttons start at the bar's own left edge, so the third one is two
    and a half widths in — arithmetic over a metric rather than over shaped text,
    which is what makes this a reliable target where the far end of a bar full of
    breadcrumbs is not.
    """
    run.drive("sleep 500\nkey f3\nsleep 800\nkey f12\nsleep 300\n")
    split = run.state()
    expect(split, panes="2", pane_focus="1")
    width = float(split["tool_w"])
    if width <= 0.0:
        raise Skipped("the halves of this window are too narrow for their buttons")

    x, y, _, height = (float(part) for part in split["pane_bar"].split(",")[0].split(":"))
    where = aim(run, split, x + width * 2.5, y + height / 2.0)
    run.drive(
        f"move {where[0]:.1f} {where[1]:.1f}\n"
        "sleep 250\nkey f12\nsleep 150\nclick\nsleep 250\n"
    )
    hovered = run.states()[-1]["tool_hover"]
    if hovered != "parent":
        raise Failure(f"aimed at the first pane's Parent button and hit {hovered!r}")

    moved = until(run, pane_focus="0", panes="2")
    # The half that was clicked went up; the half that had the keyboard did not.
    wanted = f"{fixture.parent.name},{fixture.name}"
    if moved["pane_paths"] != wanted:
        raise Failure(f"the panes hold {moved['pane_paths']!r}, wanted {wanted!r}")


@scenario("each-pane-watches-its-own-directory", fresh=True)
def per_pane_watch(run: Run, fixture: Path) -> None:
    """A change in one pane's directory reaches *that* pane, unfocused or not.

    The reason the watcher holds a set rather than one directory. **The
    assertion is about the pane that does not have the keyboard**: with a single
    watch the focused pane is live either way, so a test that only looks at the
    focused one passes with the old design and proves nothing.
    """
    run.drive("sleep 500\nkey f3\nsleep 800\n")
    # The new half goes into the subdirectory; the first stays here.
    run.drive("key ctrl+l\nsleep 250\nkey ctrl+u\n")
    run.drive(f"text {fixture / 'alpha'}\nkey enter\nsleep 200\n")
    # Waited for rather than slept through: a row count read before the read
    # lands is zero, and every assertion below is against that zero.
    state = listed(run)
    expect(state, panes="2")
    if state["pane_paths"] != f"{fixture.name},alpha":
        raise Failure(f"the two panes are showing {state['pane_paths']!r}")
    rows_alpha = int(state["rows"])

    run.drive("key f6\nsleep 400\n")
    here = listed(run)
    expect(here, pane_focus="0")
    rows_here = int(here["rows"])
    run.drive("key f6\nsleep 400\nkey f12\nsleep 200\n")
    expect(run.state(), pane_focus="1")

    # A file in the directory of the pane that does *not* have the keyboard.
    # Nothing is pressed: the frame arrives because the watcher woke the loop.
    (fixture / "arrived.txt").write_text("x")
    run.drive("sleep 900\nkey f12\nsleep 300\n")
    expect(run.state(), rows=str(rows_alpha))

    run.drive("key f6\nsleep 500\nkey f12\nsleep 300\n")
    unfocused = run.state()
    if int(unfocused["rows"]) != rows_here + 1:
        raise Failure(
            f"the unfocused pane is stale: {unfocused['rows']} rows, wanted {rows_here + 1}"
        )

    # And the other way round, so neither pane is live only by accident.
    (fixture / "alpha" / "arrived.txt").write_text("x")
    run.drive("sleep 900\nkey f6\nsleep 500\nkey f12\nsleep 300\n")
    if int(run.state()["rows"]) != rows_alpha + 1:
        raise Failure("the other pane did not see its own directory change")


@scenario("open-with-lists-what-this-machine-would-open-it-with")
def open_with(run: Run, fixture: Path) -> None:
    """`Ctrl+Shift+O` lists the applications, and Enter starts one.

    **Its own XDG data directory**, holding one `.desktop` file and one
    `mimeapps.list` that points at it. The real list is whatever the machine
    running this happens to have installed, which is a different list on a
    developer's laptop and on a runner — so the test installs the answer it is
    asserting about, and the thing it launches is `true`.
    """
    run.close()
    own_data = run.log.parent / "one-handler"
    applications = own_data / "applications"
    applications.mkdir(parents=True, exist_ok=True)
    (applications / "skerry-probe.desktop").write_text(
        "[Desktop Entry]\nType=Application\nName=Probe\nExec=true %f\n"
        "MimeType=text/plain;\n"
    )
    (applications / "mimeapps.list").write_text(
        "[Default Applications]\ntext/plain=skerry-probe.desktop\n"
        "[Added Associations]\ntext/plain=skerry-probe.desktop\n"
    )
    own = Run(
        run.display,
        run.log.parent,
        fixture,
        [],
        run.instance,
        {"XDG_DATA_HOME": str(own_data), "XDG_DATA_DIRS": str(own_data)},
    )
    try:
        own.drive("sleep 600\nkey f12\nsleep 200\n")
        # Onto a `.txt`, which is the type the installed handler claims.
        pointing = point_at(own, 3)
        if not pointing["hover_name"].endswith(".txt"):
            raise Failure(f"row 3 is {pointing['hover_name']!r}, which is not a document")
        own.drive("click\nsleep 300\nkey ctrl+shift+o\nsleep 900\nkey f12\nsleep 300\n")
        listed = own.state()
        if listed["openers"] != "1":
            raise Failure(
                f"the list holds {listed['openers']} rows and says {listed['opener']!r}"
            )
        expect(listed, opener="Probe")

        # Enter launches it and closes the list. `true` exits at once, which is
        # what makes this safe to run inside a test server.
        own.drive("key enter\nsleep 700\nkey f12\nsleep 300\n")
        after = own.state()
        expect(after, openers="0")
        if "Probe" not in after.get("notice", ""):
            raise Failure(f"the notice reads {after.get('notice')!r}")

        # And the same list is the row menu's Open with submenu: its rows are
        # what the job found, named by their `.desktop` ids, and choosing one
        # starts it the way Enter in the panel did. The job starts when the row
        # opens, so the submenu says `Reading…` first and then holds the answer.
        point_at(own, 3)
        own.drive("click right\nsleep 400\nkey f12\nsleep 200\n")
        opened = holds(own, lambda it: bool(it.get("menu_aim")), "a menu with drawn rows")
        open_submenu(own, opened, "menu.open_with")
        ready = holds(
            own,
            lambda it: "skerry-probe.desktop" in it.get("submenu_aim", ""),
            "the Open with submenu to list the installed handler",
        )
        aimed = aim_in_panel(own, ready, "skerry-probe.desktop", "submenu")
        own.drive(
            f"move {aimed[0]:.2f} {aimed[1]:.2f}\nclick left\nsleep 700\nkey f12\nsleep 300\n"
        )
        chosen = until(own, menu="0")
        if "Probe" not in chosen.get("notice", ""):
            raise Failure(f"the notice after the submenu reads {chosen.get('notice')!r}")
    finally:
        own.close()


@scenario("always-open-with-writes-one-line-of-mimeapps-list")
def always_open_with(run: Run, fixture: Path) -> None:
    """`Ctrl+Alt+O` and Open with's last row both write the association and open nothing.

    **Its own `XDG_CONFIG_HOME`, and that is not a convenience.** The file this
    writes is `$XDG_CONFIG_HOME/mimeapps.list`, so a scenario that let the default
    stand would rewrite the default applications of whoever ran the suite. The
    directory is seeded with a line about another type and a comment, because
    preserving what somebody else wrote is the property the whole module exists
    for.
    """
    run.close()
    own_data = run.log.parent / "always-handler"
    applications = own_data / "applications"
    applications.mkdir(parents=True, exist_ok=True)
    (applications / "skerry-probe.desktop").write_text(
        "[Desktop Entry]\nType=Application\nName=Probe\nExec=true %f\n"
        "MimeType=text/plain;\n"
    )
    (applications / "mimeapps.list").write_text(
        "[Added Associations]\ntext/plain=skerry-probe.desktop\n"
    )
    own_config = run.log.parent / "always-config"
    own_config.mkdir(parents=True, exist_ok=True)
    seed = "# somebody else's note\n[Default Applications]\ntext/html=firefox.desktop\n"
    associations = own_config / "mimeapps.list"
    associations.write_text(seed)

