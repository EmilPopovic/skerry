@scenario("the-list-zooms-and-comes-back-exactly")
def zoom(run: Run, fixture: Path) -> None:
    """`Ctrl +` and `Ctrl -` resize the rows; `Ctrl 0` puts them back exactly.

    **Exactly** is the assertion worth making: the steps are a table rather than
    a repeated multiplication, so eight steps out and eight back is the size it
    started at and not a pixel off. A factor would drift, and the drift is
    invisible until somebody measures it.
    """
    run.drive("sleep 500\nkey f12\nsleep 200\n")
    start = run.state()
    base = float(start["row_h"])

    run.drive("key ctrl+=\nsleep 300\nkey f12\nsleep 200\n")
    bigger = run.state()
    if float(bigger["row_h"]) <= base:
        raise Failure(f"rows are {bigger['row_h']}, wanted taller than {base}")
    # The list gets fewer rows on screen, which is what a zoom is for.
    if float(bigger["body_height"]) > float(start["body_height"]) + 1.0:
        raise Failure("the list grew instead of the rows")

    run.drive("key ctrl+minus\nsleep 300\nkey ctrl+minus\nsleep 300\nkey f12\nsleep 200\n")
    smaller = run.state()
    if float(smaller["row_h"]) >= base:
        raise Failure(f"rows are {smaller['row_h']}, wanted shorter than {base}")

    run.drive("key ctrl+0\nsleep 300\nkey f12\nsleep 200\n")
    if float(run.state()["row_h"]) != base:
        raise Failure(f"back at {run.state()['row_h']}, started at {base}")

    # Every step out, then every step back: the ends clamp rather than wrap, and
    # the round trip lands on the same number it left.
    run.drive("key ctrl+=\n" * 9 + "sleep 400\nkey f12\nsleep 200\n")
    largest = float(run.state()["row_h"])
    run.drive("key ctrl+minus\n" * 9 + "sleep 400\nkey f12\nsleep 200\n")
    smallest = float(run.state()["row_h"])
    run.drive("key ctrl+=\n" * 9 + "sleep 400\nkey f12\nsleep 200\n")
    if float(run.state()["row_h"]) != largest:
        raise Failure(f"the round trip landed on {run.state()['row_h']}, not {largest}")
    if smallest >= base or largest <= base:
        raise Failure(f"the ends are {smallest} and {largest} around {base}")


@scenario("the-frame-is-at-the-compositors-scale")
def first_frame_scale(run: Run, fixture: Path) -> None:
    """What the program scales by is what the display server asked for.

    **Run this with `--scale=1.25`.** At scale 1 it cannot fail, which is most of
    what it is here to say: `120` is also what a program that never read the
    scale at all would report, so the assertion only has teeth on a fractional
    output. It is the assertion the 1×1 pre-map probe in docs/08-roadmap.md
    exists to satisfy — a compositor that sends the scale only after the first
    buffer is attached would fail it.

    Two mechanisms, one assertion. On Wayland the scale is
    `wp_fractional_scale_v1`; on X11 there is no such protocol and it is
    `Xft.dpi` in the root window's resource database, which is where every X11
    desktop states one. `--scale` writes it there rather than forcing the
    program's hand, so what is under test is the reading and not the override.
    """
    run.drive("sleep 700\nkey f12\nsleep 150\n")
    state = run.state()
    scale = output_scale(run)
    wanted = round(scale * 120)
    if int(state["scale_120"]) != wanted:
        raise Failure(f"the compositor is at {scale} and the program scales by {state['scale_120']}/120")
    # And the frame that matters: the first one. A compositor that sends the
    # scale only after the first buffer is attached would have this at 120 with
    # the one above already right — one frame at the wrong size.
    if int(state["first_frame_scale_120"]) != wanted:
        raise Failure(
            f"the compositor is at {scale}, the first frame was drawn at "
            f"{int(state['first_frame_scale_120']) / 120}"
        )


@scenario("window-close-command")
def window_close_command(run: Run, fixture: Path) -> None:
    """`Ctrl+W` closes the window, and it is the same action as the button.

    Rule 2: every action is one entry in one registry. A title-bar button only a
    pointer can reach is an action outside it — invisible to the keyboard
    overlay, unbindable, and unfindable by the palette when there is one.
    """
    run.drive("sleep 400\nkey ctrl+w\nsleep 500\n")
    code = run.process.wait(timeout=10)
    if code < 0:
        raise Failure(f"Ctrl+W killed it with signal {-code}")
    if code != 0:
        raise Failure(f"Ctrl+W exited {code}: {run.err.read_text()[-300:]}")


@scenario("own-frame-maximize")
def own_frame_maximize(run: Run, fixture: Path) -> None:
    """The maximise button is where the layout says it is, and works.

    **The state cannot be asserted under this compositor.** Hyprland sends
    `maximized` together with all four `tiled` flags for a floating 320x240
    window, and ignores `unset_maximized` for a tiled one — so what it reports is
    neither what the window looks like nor what was asked for. That is recorded
    in docs/06-portability.md as a compositor difference, not worked around here.

    What this does cover is the half that is ours: the button is where
    `Layout::compute_with` put it, hit-testing finds it, and the request goes out
    without the window dying — which is the whole path from a pixel to
    `xdg_toplevel.set_maximized`.
    """
    run.close()
    own = Run(run.display, run.log.parent, fixture, ["--own-frame"], run.instance)
    try:
        own.drive("sleep 400\nkey f12\nsleep 200\n")
        state = own.state()
        expect(state, frame="own")

        # One button width to the left of the close button's centre. The width
        # comes from the close button's own offset from the right edge, so the
        # test does not carry a copy of the metric it is testing.
        button_width = (float(state["logical"].split("x")[0]) - float(state["close_x"])) * 2.0
        maximize_x = float(state["close_x"]) - button_width
        x, y = aim(own, state, maximize_x, float(state["body_top"]) / 4.0)
        own.drive(f"move {x:.2f} {y:.2f}\nsleep 200\nkey f12\nsleep 200\n")
        if own.state()["frame_hover"] != "maximize":
            raise Failure(f"aimed at maximise and hit {own.state()['frame_hover']!r}")

        own.drive("click\nsleep 600\nclick\nsleep 600\nkey f12\nsleep 200\n")
        if own.process.poll() is not None:
            raise Failure(f"maximising killed the window: {own.err.read_text()[-300:]}")
        expect(own.state(), frame="own", frame_hover="maximize")
    finally:
        own.close()


@scenario("clean-close")
def clean_close(run: Run, fixture: Path) -> None:
    run.drive("sleep 800\n")
    code = run.ask_to_close()
    if code < 0:
        raise Failure(f"closing the window killed it with signal {-code}")
    if code != 0:
        raise Failure(f"closing the window exited {code}: {run.err.read_text()[-300:]}")


@scenario("no-cpu-when-idle")
def no_cpu_when_idle(run: Run, fixture: Path) -> None:
    run.drive("sleep 1500\n")  # let the folder walks finish
    ticks = lambda: sum(
        int(value) for value in Path(f"/proc/{run.process.pid}/stat").read_text().split()[13:15]
    )
    before = ticks()
    time.sleep(3.0)
    after = ticks()
    if after != before:
        raise Failure(f"an idle window used {after - before} ticks of CPU")


# --------------------------------------------------------------------------


def main(argv: list[str]) -> int:
    wanted = [a for a in argv[1:] if not a.startswith("--")]
    keep = "--keep" in argv
    x11 = "--x11" in argv
    scale = "1"
    for argument in argv[1:]:
        if argument.startswith("--scale="):
            scale = argument.removeprefix("--scale=")

    for binary in (SKERRY, DRIVE):
        if not binary.is_file():
            print(f"missing {binary}; run `cargo build --release` first")
            return 2

    # A needle that names nothing used to select nothing and exit 0, so a renamed
    # scenario left every invocation that asked for it by name green while running
    # none of it. It cost me ten minutes believing a filter test had passed.
    if unmatched := [n for n in wanted if not any(n in name for name in SCENARIOS)]:
        print(f"no scenario matches {', '.join(repr(n) for n in unmatched)}")
        return 2

    if len(SCENARIOS) < FEWEST_SCENARIOS:
        print(
            f"{len(SCENARIOS)} scenarios registered, against {FEWEST_SCENARIOS} recorded. "
            "One has been deleted; lower FEWEST_SCENARIOS if that was deliberate."
        )
        return 2

    work = Path(tempfile.mkdtemp(prefix="skerry-gui-"))
    passed, failed = 0, []
    global SERVER
    SERVER = X11Server() if x11 else WaylandServer()
    try:
        SERVER.start(work, scale)
        display = SERVER.display
        instance = getattr(SERVER, "instance", "")
        kind = "Xvfb" if x11 else "nested compositor"
        print(f"{kind} on {display} at scale {scale}")
        fixture = make_fixture(work)

        for name, function in SCENARIOS.items():
            if wanted and not any(needle in name for needle in wanted):
                continue
            run = None
            try:
                own = getattr(function, "fresh", False)
                path = make_fixture(work, f"fixture-{name}") if own else fixture
                data = work / "data" / name
                environment = {"XDG_DATA_HOME": str(data)} if own else None
                run = Run(display, work, path, [], instance, environment)
                function(run, path)
                print(f"  ok    {name}")
                passed += 1
            except Skipped as why:
                print(f"  skip  {name}: {why}")
            except Failure as problem:
                print(f"  FAIL  {name}: {problem}")
                failed.append(name)
            finally:
                if run is not None:
                    run.close()
    except Failure as problem:
        print(f"fixture: {problem}")
        return 1
    finally:
        SERVER.stop()
        if keep:
            print(f"left behind: {work}")
        else:
            shutil.rmtree(work, ignore_errors=True)

    print(f"\n{passed} passed, {len(failed)} failed")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
