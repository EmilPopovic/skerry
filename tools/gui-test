    expect(split, panes="2", pane_focus="1", tabs="2")

    tab = tab_aim(run, split, 1)
    x, y, width, height = (float(it) for it in split["pane_body"].split(",")[0].split(":"))
    middle = aim(run, split, x + width / 2.0, y + height / 2.0)
