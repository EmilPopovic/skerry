@scenario("emptying-the-trash-asks-and-ctrl-z-says-it-was-emptied", fresh=True)
def emptying_the_trash(run: Run, fixture: Path) -> None:
    """`Ctrl+Shift+Delete` asks, and afterwards `Ctrl+Z` says the Trash was emptied.

    **The second half is row 4's real content.** The stack still holds the
    trash that put the file there, and after an empty its way back is gone — so
    the undo has to say so, rather than fail about a path inside the Trash
    nobody has looked at, and rather than do nothing at all.

    Its own data home, so the Trash emptied is this scenario's and not the one
    belonging to whoever runs the suite.
    """
    run.close()
    place = own_config(run, "empty")
    files = Path(place["XDG_DATA_HOME"]) / "Trash" / "files"
    doomed = fixture / "receipt.txt"
    doomed.write_text("kept for tax")
    own = Run(run.display, run.log.parent, fixture, [], run.instance, place)
    try:
        listed(own)
        own.drive("text receipt\nsleep 400\nkey delete\n")
        until(own, undo="true", trash_held="1")
        if doomed.exists():
            raise Failure("Move to Trash left the file where it was")

        own.drive("key ctrl+shift+delete\n")
        expect(until(own, erasing="1"), erasing_on="cancel")
        if not any(files.iterdir()):
            raise Failure("asking emptied the Trash")
        own.drive("key escape\n")
        until(own, erasing="0")
        if not any(files.iterdir()):
            raise Failure("cancelling emptied the Trash")

        # The second press is the answer, as it is for Delete permanently.
        own.drive("key ctrl+shift+delete\nkey ctrl+shift+delete\n")
        until(own, erasing="0", trash_held="0")
        if not files.is_dir():
            raise Failure("emptying took the directory a restore's undo writes into")
        if any(files.iterdir()):
            raise Failure(f"the Trash still holds {sorted(p.name for p in files.iterdir())}")

        own.drive("key ctrl+z\nsleep 600\nkey f12\nsleep 200\n")
        said = settled(own).get("notice", "")
        if "emptied" not in said:
            raise Failure(f"Ctrl+Z after an empty said {said!r}")
        if doomed.exists():
            raise Failure("an emptied file came back")
    finally:
        own.close()


