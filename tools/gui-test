def point_at(run: Run, row: int) -> dict[str, str]:
    """Puts the pointer on a display row and returns the state it produced.

    Asserted through `hover` rather than trusted: the pointer's coordinates are
    over the *output* and the window's are over the window, and under a nested
    compositor those differ by whatever the frame around it costs. Reading back
    what the program thinks it is pointing at removes the guess — and is the only
    honest way for a test to know it clicked what it meant to.

    **Through `aim`, which asks the server where the window is.** This used to
    treat a percentage of the window as a percentage of the output. Those are the
    same number only because Hyprland makes the window fill the screen, and under
    a bare `Xvfb` — where a 1100×720 window sits in a 1600×1000 root — every row
    was six rows out. The nudge could never recover it: the error is proportional,
    not an offset.
    """
    start = run.state()
    for attempt in range(6):
        # Half a row per attempt, alternating up and down, for the sub-pixel
        # disagreement that remains once the geometry is right.
        nudge = 0.0 if attempt == 0 else float(start["row_h"]) / 2 * attempt
        offset = nudge * (1 if attempt % 2 else -1)
        x, y = aim(run, start, name_x(start), row_y(start, row) + offset)
        run.drive(f"move {x:.1f} {y:.1f}\nsleep 120\nkey f12\nsleep 120\n")
        state = run.state()
        if state["hover"] == str(row):
            return state
    raise Failure(
        f"could not put the pointer on row {row}; it landed on {run.state()['hover']}"
    )


def point_at_the_check_box(run: Run, row: int) -> dict[str, str]:
    """Puts the pointer on `row`'s check box, and proves it is on it.

    Two moves, because the box only exists under the pointer: the first lands on
    the row, which is what makes the window draw a box and report where it is, and
    the second lands inside it. `check_aim` comes from `App::check_of` — the same
    function the drawing uses — so this cannot be a harness's private idea of where
    a sixteen-pixel square sits inside a row.
    """
    state = point_at(run, row)
    if state["check_aim"] == "none":
        raise Failure(f"row {row} is hovered and reports no check box")
    x, _, y = state["check_aim"].partition(":")
    at = aim(run, state, float(x), float(y))
    run.drive(f"move {at[0]:.2f} {at[1]:.2f}\nsleep 150\nkey f12\nsleep 150\n")
    moved = run.state()
    if moved["hover"] != str(row):
        raise Failure(f"moving into the box left the pointer on row {moved['hover']}")
    return moved


def headings_of(state: dict[str, str]) -> list[tuple[int, float, float, str]]:
    """The on-screen band headings the window reports: band, x, y, and shut or open.

    From `App::headings_state`, so the coordinates are the layout's own rather than
    a harness's second copy of it.
    """
    if state["headings"] == "none":
        return []
    found = []
    for entry in state["headings"].split(","):
        band, x, y, shut = entry.split(":")
        found.append((int(band), float(x), float(y), shut))
    return found


def aims_of(state: dict[str, str]) -> dict[object, str]:
    """The history strip's aims by key: `"header"`, and an int per drawn row."""
    if state["history_aim"] == "none":
        return {}
    found: dict[object, str] = {}
    for entry in state["history_aim"].split(","):
        name, _, point = entry.partition(":")
        found["header" if name == "header" else int(name)] = point
    return found


@scenario("the-history-lists-edits-and-travels-to-one", fresh=True)
def the_history_lists_edits_and_travels_to_one(run: Run, fixture: Path) -> None:
    """**[Rule 3](../docs/03-principles.md)'s other half.** `Ctrl+Z` walks back
    every mutation, which was done; this is the panel that says *what* it would
    walk back and lets a person land anywhere on the line rather than counting
    keystrokes.

    Four claims, and only a scenario reaches any of them — the panel is chrome whose
    height is a function of the undo stack, and every one of these is a press:

    * the strip is not there until something has been changed, and then it is;
    * its header collapses the list and expands it again;
    * a press on a row travels to the point **after** that edit, which is `n`
      undos — so the two folders made after it are gone and the first is still
      there;
    * and a press below the present travels forward again, because the entries a
      walk undid are still on the list and still clickable.
    """
    settled = listed(run)
    if settled["history"] != "0/0":
        raise Failure(f"a window that has changed nothing has a history: {settled['history']}")
    if settled["history_aim"] != "none":
        raise Failure("a window with no history drew history rows")

    # **Three renames of one file, and not three new folders.** A new folder is a
    # `Created` *and* a `Renamed` — two entries a person made with one gesture, both
    # of them undoable — so three of them are a history of six and which row is
    # "after the first folder" is arithmetic. A rename is exactly one entry, so the
    # timeline below is unambiguous and the file's name says which point we are at,
    # which is the whole claim the panel makes.
    run.drive("key home\nsleep 300\n")
    for name in ("step-one", "step-two", "step-three"):
        run.drive(f"key f2\nsleep 400\nkey ctrl+a\ntext {name}\nkey enter\nsleep 800\n")
        if run.answered(settle=300) is None:
            raise Failure(f"the window stopped answering while renaming to {name}")
    after = until(run, history="3/3")
    if not (fixture / "step-three").exists():
        raise Failure(f"the last rename did not land: {sorted(p.name for p in fixture.iterdir())}")

    # Collapsed by default: the header is drawn and the rows are not.
    if after["history_open"] != "false":
        raise Failure("the history opened itself")
    if any(key != "header" for key in aims_of(after)):
        raise Failure(f"a collapsed history drew rows: {after['history_aim']}")

    # `Ctrl+Shift+H` expands it, and now the rows are there.
    run.drive("key ctrl+shift+h\nsleep 400\n")
    opened = run.answered(settle=300)
    if opened is None or opened["history_open"] != "true":
        raise Failure(f"Ctrl+Shift+H left it {opened and opened['history_open']}")
    rows = aims_of(opened)
    if sorted(key for key in rows if key != "header") != [0, 1, 2]:
        raise Failure(f"the list drew rows {sorted(rows)}, not three")

    # **A press on the first row travels to the point *after* the first edit** —
    # two undos, run one at a time — so the file is called what the first rename
    # called it. Not what it was called before: after the edit, not before it.
    x, _, y = rows[0].partition(":")
    at = aim(run, opened, float(x), float(y))
    run.drive(f"move {at[0]:.2f} {at[1]:.2f}\nsleep 200\nclick\nsleep 200\n")
    until(run, history="1/3")
    if not (fixture / "step-one").exists():
        raise Failure(
            "travelling to the first edit did not leave the first rename applied: "
            f"{sorted(entry.name for entry in fixture.iterdir())}"
        )
    for name in ("step-two", "step-three"):
        if (fixture / name).exists():
            raise Failure(f"{name} is still there, so the walk stopped short")

    # And forward again, by pressing the row below the present.
    ahead = run.answered(settle=300)
    if ahead is None:
        raise Failure("the window stopped answering after the walk")
    rows = aims_of(ahead)
    x, _, y = rows[2].partition(":")
    at = aim(run, ahead, float(x), float(y))
    run.drive(f"move {at[0]:.2f} {at[1]:.2f}\nsleep 200\nclick\nsleep 200\n")
    until(run, history="3/3")
    if not (fixture / "step-three").exists():
        raise Failure("travelling forward did not put the last rename back")

    # **And the header collapses it**, which is the pointer surface `commands.rs`
    # claims for `edit.history` — so a person who never learns the chord can still
    # get the panel out of the way.
    back = run.answered(settle=300)
    if back is None:
        raise Failure("the window stopped answering before the header press")
    x, _, y = aims_of(back)["header"].partition(":")
    at = aim(run, back, float(x), float(y))
    run.drive(f"move {at[0]:.2f} {at[1]:.2f}\nsleep 200\nclick\nsleep 400\n")
    shut = run.answered(settle=300)
    if shut is None or shut["history_open"] != "false":
        raise Failure(f"the header left it {shut and shut['history_open']}")
    if shut["history_aim"] == "none":
        raise Failure("collapsing took the header away, so it cannot be reopened")


@scenario("space-looks-at-a-file-and-space-puts-it-away", fresh=True)
def space_looks_at_a_file_and_space_puts_it_away(run: Run, fixture: Path) -> None:
    """**Quick look, which no golden frame can open.** A frame is told what to
    draw; this is the key that decides, and the round trip to a sandboxed child
    that answers it.

    Four claims:

    * `Space` on a picture puts it on screen, which means a request went to
      `skerry-thumbnailer`, came back, and reached the atlas — the whole preview
      path end to end, in a real window;
    * `Space` again puts it away, because it is one key both ways;
    * `Escape` also puts it away, and closes the look rather than the selection
      behind it;
    * and `Space` on a file nothing can draw opens nothing at all, rather than a
      panel whose only content is an apology.

    The pictures are written here rather than taken from the shared fixture,
    whose `img2.png` is four kilobytes of `x`.
    """
    import struct
    import zlib

    def chunk(tag: bytes, body: bytes) -> bytes:
        return struct.pack(">I", len(body)) + tag + body + struct.pack(">I", zlib.crc32(tag + body))

    raw = b"".join(
        b"\x00" + bytes(v for x in range(48) for v in ((200, 40, 90) if x < 24 else (40, 160, 220)))
        for _ in range(48)
    )
    (fixture / "picture.png").write_bytes(
        b"\x89PNG\r\n\x1a\n"
        + chunk(b"IHDR", struct.pack(">IIBBBBB", 48, 48, 8, 2, 0, 0, 0))
        + chunk(b"IDAT", zlib.compress(raw))
        + chunk(b"IEND", b"")
    )
    (fixture / "notes.txt").write_text("first line\nsecond line\n")
    # A file the databases name and this program cannot draw: `application/zip` is
    # neither a picture, nor a PDF, nor text, which is the fourth claim's subject.
    (fixture / "bundle.zip").write_bytes(b"PK\x03\x04" + bytes(64))

    settled = listed(run)
    if settled["looking"] != "none":
        raise Failure(f"a window that has looked at nothing reports {settled['looking']}")

    # **A reload, because these two files were written after the window opened.**
    # `inotify` would bring them within a quarter of a second and a sleep long
    # enough for that on an idle machine is too short on a busy one; asking is
    # neither a guess nor a wait.
    before = int(settled["rows"])
    run.drive("key f5\nsleep 400\n")
    holds(run, lambda it: int(it["rows"]) >= before + 3, f"more than {before} rows")

    # **Onto the picture by name**, because the row it lands on depends on what
    # else the fixture holds and this scenario adds two files to it.
    run.drive("text picture\nsleep 400\n")
    until(run, cursor="picture.png")

    run.drive("key space\nsleep 600\n")
    until_looking(run, "picture.png", "picture")

    # The same key puts it away.
    run.drive("key space\nsleep 300\n")
    away = run.answered(settle=300)
    if away is None or away["looking"] != "none":
        raise Failure(f"the second Space left {away and away['looking']}")

    # And `Escape` does too — which must close the look rather than the selection
    # behind it, so the cursor is still there afterwards.
    run.drive("key space\nsleep 600\n")
    until_looking(run, "picture.png", "picture")
    run.drive("key escape\nsleep 300\n")
    escaped = run.answered(settle=300)
    if escaped is None or escaped["looking"] != "none":
        raise Failure(f"Escape left {escaped and escaped['looking']}")
    if escaped["cursor"] != "picture.png":
        raise Failure(f"Escape took the selection too: cursor is {escaped['cursor']!r}")

    # Text is the third kind and needs no child at all.
    run.drive("key escape\nsleep 200\ntext notes\nsleep 400\n")
    until(run, cursor="notes.txt")
    run.drive("key space\nsleep 500\n")
    until_looking(run, "notes.txt", "text")
    run.drive("key escape\nsleep 200\n")

    # And a file nothing can draw opens nothing: a panel saying "no preview" is a
    # panel whose only content is an apology, with the file still in the list
    # behind it.
    #
    # **Reached by a wait rather than a condition.** The first version of this
    # asked `run.state()` whether the cursor had arrived and skipped the check if
    # it had not — and the file it typed for was never in the fixture, so the
    # fourth claim in the docstring above was never once tested.
    run.drive("key escape\nsleep 200\ntext bundle\nsleep 400\n")
    until(run, cursor="bundle.zip")
    run.drive("key space\nsleep 400\n")
    nothing = run.answered(settle=300)
    if nothing is None or nothing["looking"] != "none":
        raise Failure(f"a file with no preview opened {nothing and nothing['looking']}")


@scenario("arrows-walk-the-look-and-a-pdfs-pages", fresh=True)
def arrows_walk_the_look_and_a_pdfs_pages(run: Run, fixture: Path) -> None:
    """**`←`/`→` between files and `↑`/`↓` between a document's pages.**

    Four claims:

    * `→` moves the look to the next file that *has* a preview, walking past the
      one that has none rather than closing on it;
    * `←` comes back, and the cursor came along — so closing the look leaves the
      selection where the panel was looking;
    * `↓` and `↑` turn a PDF's pages, and `↓` at the last page stays there rather
      than emptying the panel;
    * and the same four things answer a pointer, because the panel covers the list
      a pointer would otherwise use — [rule 5](../docs/03-principles.md).

    Skipped where no PDF renderer is installed, which is the one thing here that
    is the machine's business rather than the program's.
    """
    import shutil
    import struct
    import zlib

    if not (shutil.which("pdftoppm") or shutil.which("mutool")):
        raise Skipped("no pdftoppm or mutool, so a document has no pages to walk")

    def chunk(tag: bytes, body: bytes) -> bytes:
        return struct.pack(">I", len(body)) + tag + body + struct.pack(">I", zlib.crc32(tag + body))

    def png(name: str, red: int) -> None:
        raw = b"".join(
            b"\x00" + bytes(v for _ in range(32) for v in (red, 90, 200)) for _ in range(32)
        )
        (fixture / name).write_bytes(
            b"\x89PNG\r\n\x1a\n"
            + chunk(b"IHDR", struct.pack(">IIBBBBB", 32, 32, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(raw))
            + chunk(b"IEND", b"")
        )

    # Three pages, each with its own number on it, so a person debugging this can
    # see which page a frame is of.
    def three_page_pdf() -> bytes:
        bodies = [
            f"BT /F1 36 Tf 60 400 Td (Page {n} of three.) Tj ET".encode() for n in (1, 2, 3)
        ]
        objects = [
            b"<< /Type /Catalog /Pages 2 0 R >>",
            b"<< /Type /Pages /Kids [3 0 R 4 0 R 5 0 R] /Count 3 >>",
        ]
        for index, body in enumerate(bodies):
            objects.append(
                b"<< /Type /Page /Parent 2 0 R /MediaBox [0 0 420 595] "
                b"/Resources << /Font << /F1 9 0 R >> >> /Contents "
                + str(6 + index).encode()
                + b" 0 R >>"
            )
        for body in bodies:
            objects.append(
                b"<< /Length " + str(len(body)).encode() + b" >>\nstream\n" + body + b"\nendstream"
            )
        objects.append(b"<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>")
        out = bytearray(b"%PDF-1.4\n")
        offsets = []
        for number, obj in enumerate(objects, start=1):
            offsets.append(len(out))
            out += str(number).encode() + b" 0 obj\n" + obj + b"\nendobj\n"
        start = len(out)
        out += b"xref\n0 " + str(len(objects) + 1).encode() + b"\n0000000000 65535 f \n"
        for offset in offsets:
            out += f"{offset:010d} 00000 n \n".encode()
        out += (
            b"trailer\n<< /Size "
            + str(len(objects) + 1).encode()
            + b" /Root 1 0 R >>\nstartxref\n"
            + str(start).encode()
            + b"\n%%EOF\n"
        )
        return bytes(out)

    # Named so they sort next to each other with the unpreviewable one between:
    # `look-a.png`, `look-b.zip`, `look-c.png`.
    png("look-a.png", 220)
    (fixture / "look-b.zip").write_bytes(b"PK\x03\x04" + bytes(64))
    png("look-c.png", 40)
    (fixture / "look-d.pdf").write_bytes(three_page_pdf())

    settled = listed(run)
    before = int(settled["rows"])
    run.drive("key f5\nsleep 400\n")
    holds(run, lambda it: int(it["rows"]) >= before + 4, f"more than {before} rows")

    run.drive("text look-a\nsleep 400\n")
    until(run, cursor="look-a.png")
    run.drive("key space\nsleep 600\n")
    until_looking(run, "look-a.png", "picture")

    # **Past the zip, not onto it.** `→` walks to the next file that has a
    # preview, which is the third of the four and not the second.
    run.drive("key right\nsleep 700\n")
    until_looking(run, "look-c.png", "picture")
    moved = run.answered(settle=300)
    if moved is None or moved["cursor"] != "look-c.png":
        raise Failure(f"the cursor did not follow the look: {moved and moved['cursor']}")

    run.drive("key left\nsleep 700\n")
    until_looking(run, "look-a.png", "picture")

    # Then the document, and its pages.
    run.drive("key escape\nsleep 200\ntext look-d\nsleep 400\n")
    until(run, cursor="look-d.pdf")
    run.drive("key space\nsleep 900\n")
    until_looking(run, "look-d.pdf", "page")
    first = holds(run, lambda it: it["look_page"] == "1/3", "page 1 of 3")
    del first

    run.drive("key down\nsleep 900\n")
    holds(run, lambda it: it["look_page"] == "2/3", "page 2 of 3")
    run.drive("key down\nsleep 900\n")
    holds(run, lambda it: it["look_page"] == "3/3", "page 3 of 3")

    # **A `↓` at the end stays at the end**, with the page still on screen: the
    # one thing it must not do is empty the panel.
    run.drive("key down\nsleep 700\n")
    ended = run.answered(settle=300)
    if ended is None or ended["look_page"] != "3/3":
        raise Failure(f"a down at the last page went to {ended and ended['look_page']}")
    if ended["looking"] != "look-d.pdf:page":
        raise Failure(f"the last page went away: {ended['looking']}")

    run.drive("key up\nsleep 900\n")
    holds(run, lambda it: it["look_page"] == "2/3", "page 2 again")

    # And the pointer, on the same four controls.
    aimed = look_aim(run, "next_page")
    run.drive(f"move {aimed[0]:.2f} {aimed[1]:.2f}\nclick left\nsleep 900\n")
    holds(run, lambda it: it["look_page"] == "3/3", "page 3 by pointer")
    aimed = look_aim(run, "previous_page")
    run.drive(f"move {aimed[0]:.2f} {aimed[1]:.2f}\nclick left\nsleep 900\n")
    holds(run, lambda it: it["look_page"] == "2/3", "page 2 by pointer")
    aimed = look_aim(run, "previous_file")
    run.drive(f"move {aimed[0]:.2f} {aimed[1]:.2f}\nclick left\nsleep 900\n")
    until_looking(run, "look-c.png", "picture")
    aimed = look_aim(run, "next_file")
    run.drive(f"move {aimed[0]:.2f} {aimed[1]:.2f}\nclick left\nsleep 900\n")
    until_looking(run, "look-d.pdf", "page")


@scenario("a-text-preview-selects-and-copies", fresh=True)
def a_text_preview_selects_and_copies(run: Run, fixture: Path) -> None:
    """**Dragging across a text preview selects it, and `Ctrl+C` copies it.**

    Four claims:

    * a drag inside the panel selects from where it started to where it ended,
      which is asserted as a byte range rather than as pixels;
    * `Ctrl+C` puts exactly that on the clipboard, read by a *separate client* —
      the window's own report would pass with the selection never taken;
    * `Ctrl+A` inside the preview selects the text and not the files behind it,
      which is the whole reason [`sk_cmd::Scope::Look`] exists;
    * and the preview's own context menu offers both, because the panel covers
      the list a pointer would otherwise use — [rule 5](../docs/03-principles.md).
    """
    lines = ["alpha beta gamma", "second line here", "third and last"]
    (fixture / "notes.txt").write_text("\n".join(lines) + "\n")

    settled = listed(run)
    before = int(settled["rows"])
    run.drive("key f5\nsleep 400\n")
    holds(run, lambda it: int(it["rows"]) >= before + 1, f"more than {before} rows")
    run.drive("text notes\nsleep 400\n")
    until(run, cursor="notes.txt")
    run.drive("key space\nsleep 600\n")
    until_looking(run, "notes.txt", "text")

    # **`Ctrl+A` first, because it needs no arithmetic.** If the look scope were
    # not consulted this would select the files behind the panel instead, which
    # the second assertion below catches.
    picked = int(run.state()["selected"])
    run.drive("key ctrl+a\nsleep 300\n")
    whole = holds(run, lambda it: it["look_chosen"] != "none", "a selection")
    last = len(lines) - 1
    if whole["look_chosen"] != f"0:0-{last}:{len(lines[last])}":
        raise Failure(f"Ctrl+A selected {whole['look_chosen']!r}")
    if int(whole["selected"]) != picked:
        raise Failure("Ctrl+A in a preview changed the file selection behind it")

    run.drive("key ctrl+c\nsleep 400\n")
    held = clipboard(run)
    if held != "\n".join(lines):
        raise Failure(f"the clipboard holds {held!r}")

    # Then a drag, across the middle of the second line. The panel's own geometry
    # is not exposed, so this aims by the text's own metrics: the mono advance is
    # read off the window's `row_h` only for the vertical, and the horizontal is
    # deliberately generous — what is asserted is the *range*, which the window
    # reports, and not the pixel it came from.
    inner = [float(v) for v in whole["panel_area"].split(":")]
    top = inner[1] + 34.0
    row = float(whole["row_h"])
    from_at = aim(run, whole, inner[0] + 90.0, top + row * 1.5)
    to_at = aim(run, whole, inner[0] + 200.0, top + row * 1.5)
    run.drive(
        f"move {from_at[0]:.2f} {from_at[1]:.2f}\nsleep 150\n"
        f"press left\nsleep 150\n"
        f"move {to_at[0]:.2f} {to_at[1]:.2f}\nsleep 200\n"
        f"release left\nsleep 300\n"
    )
    dragged = holds(
        run,
        lambda it: it["look_chosen"] != "none" and it["look_chosen"] != whole["look_chosen"],
        "a selection the drag made",
    )
    start, _, end = dragged["look_chosen"].partition("-")
    if not start.startswith("1:") or not end.startswith("1:"):
        raise Failure(f"a drag across one line selected {dragged['look_chosen']!r}")
    if int(start.split(":")[1]) >= int(end.split(":")[1]):
        raise Failure(f"the drag selected nothing forward: {dragged['look_chosen']!r}")

    # And the pointer's way to both, which is the preview's own menu.
    run.drive("click right\nsleep 400\nkey f12\nsleep 150\n")
    opened = holds(run, lambda it: bool(it.get("menu_aim")), "a menu with drawn rows")
    for wanted in ("look.select_all", "look.copy"):
        if wanted not in opened["menu_aim"]:
            raise Failure(f"{wanted} is not on the preview's menu: {opened['menu_aim']!r}")
    aimed = menu_aim(run, opened, "look.copy")
    run.drive(f"move {aimed[0]:.2f} {aimed[1]:.2f}\nclick left\nsleep 400\n")
    if clipboard(run) == "\n".join(lines):
        raise Failure("the menu's Copy copied the whole file rather than the drag")


def look_aim(run: Run, control: str) -> tuple[float, float]:
    """Where to click one of the quick look's controls, by name.

    The window reports the middle of every control it drew, so a scenario names
    the thing rather than copying the strip's own constants — and a control that
    was not drawn is not in the list, which is how "no page arrows over a
    picture" is a failure here rather than a click into empty panel.
    """
    state = holds(run, lambda it: bool(it.get("look_aim")), "a look with controls")
    for entry in state["look_aim"].split(","):
        name, _, point = entry.partition("@")
        if name == control:
            x, _, y = point.partition(":")
            return aim(run, state, float(x), float(y))
    raise Failure(f"{control} is not among the look's controls: {state['look_aim']!r}")


def until_looking(run: Run, name: str, what: str) -> dict[str, str]:
    """Waits for the quick look to be of `name`, showing `what`.

    A poll rather than a sleep: a picture is a round trip to a child that spawns,
    sandboxes itself and decodes, and how long that takes is the machine's
    business. `waiting` is the state in between and is what this waits out.
    """
    deadline = time.time() + WAITING
    state: dict[str, str] = {}
    while time.time() < deadline:
        fresh = run.answered()
        if fresh is not None:
            state = fresh
            if state.get("looking") == f"{name}:{what}":
                return state
    raise Failure(f"the look never became {name}:{what} — it is {state.get('looking')}")


@scenario("a-hung-mount-never-blocks-the-frame-loop", fresh=True)
def a_hung_mount_never_blocks_the_frame_loop(run: Run, fixture: Path) -> None:
    """**Rule 1's canonical test, and until now the only one of the eight without
    one.** A filesystem that has stopped answering has to degrade to a row that
    never fills in, never to a window that stops drawing.

    `tools/hung-mount` is the mount: a FUSE server that holds `/dev/fuse` and reads
    nothing from it, so every `getdents64` and every `statx` under it queues and the
    caller blocks for as long as the mount stands. That is `sshfs` to a suspended
    host without the network, the key or the second machine — see that script for
    why it answers no request at all, `FUSE_INIT` included.

    **Every liveness check goes through `answered`, not `state`.** That is the whole
    difference between this test and a decoration: `state` returns the last line in
    the log, and `reports_reached` gives up quietly after a frame — so a frozen
    frame loop hands back the dump from *before* the question, which looks pristine.
    Measured here, not assumed: with a `read_dir` on the pane's path spliced into the
    frame path, the first draft failed on *"the pane went to <fixture> rather than
    the mount"* — a stale answer from before the navigation — rather than on the
    window having stopped. `answered` returns nothing when nothing fresh arrived,
    which is the only form of "it is still drawing" that can fail.

    Three claims, in order:

    * a read that never lands leaves the window drawing and answering keys;
    * navigating away lands a real listing — which is the **per-device queue** in
      `sk_util::Pool` doing its job, since one blocked device must not starve the
      pool that every other read shares. Spike B measured a hung-mount arm at
      28,000 ms, which is what that design is for;
    * and the pane says it is still loading rather than claiming the folder is
      empty, because "this folder is empty" over a mount that has gone away is the
      one answer that is worse than no answer.
    """
    import subprocess

    # **Outside the fixture, on purpose.** A hung mount is contagious: anything that
    # walks its parent blocks too, and the harness deletes the fixture at the end.
    where = run.work / "hung-mount"
    server = subprocess.Popen(
        ["python3", str(ROOT / "tools" / "hung-mount"), str(where)],
        stdout=subprocess.PIPE,
        text=True,
    )
    try:
        assert server.stdout is not None
        line = server.stdout.readline().strip()
        if not line.startswith("hung "):
            raise Skipped(f"no hung mount to test against: {line or 'the server said nothing'}")

        rows = listed(run)["rows"]

        # Into the mount. The read is issued and never lands.
        run.drive("key ctrl+l\nsleep 250\nkey ctrl+u\n")
        run.drive(f"text {where}\nkey enter\nsleep 900\n")
        hung = run.answered(settle=300)
        if hung is None:
            raise Failure("the window stopped answering when the pane reached a hung mount")
        if hung["path"] != str(where):
            raise Failure(f"the pane went to {hung['path']} rather than the mount")
        if hung["loading"] != "true":
            raise Failure(
                f"a read that cannot land reported loading={hung['loading']!r} and "
                f"rows={hung['rows']!r} — a mount that has gone away is not an empty folder"
            )

        # **Three fresh answers, with a keystroke between them.** Each one is a
        # frame the loop drew while a read of this pane's own directory was blocked
        # in the pool, which is rule 1 stated as an experiment.
        for attempt in range(3):
            run.drive("key down\nsleep 120\n")
            alive = run.answered(settle=200)
            if alive is None:
                raise Failure(f"the window stopped answering keys over a hung mount ({attempt})")
            if int(alive["frame_p99_us"]) > 8000:
                raise Failure(f"a frame took {alive['frame_p99_us']}us over a hung mount")

        # And out again, to a directory that answers. This is the pool's per-device
        # queue: the blocked read still holds a thread and this one has to land.
        run.drive("key ctrl+l\nsleep 250\nkey ctrl+u\n")
        run.drive(f"text {fixture}\nkey enter\nsleep 900\n")
        back = listed(run)
        if back["path"] != str(fixture):
            raise Failure(f"the pane could not leave the mount: {back['path']}")
        if back["rows"] != rows:
            raise Failure(f"the fixture read {back['rows']} rows, not the {rows} it began with")
        if int(back["frame_p99_us"]) > 8000:
            raise Failure(f"a frame took {back['frame_p99_us']}us after the hung mount")
    finally:
        # **Unmount before anything else.** It is what releases the read still
        # blocked in the pool; without it that thread sits in uninterruptible sleep
        # and the window cannot exit, which would hang the sweep rather than fail it.
        subprocess.run(
            ["python3", str(ROOT / "tools" / "hung-mount"), "--unmount", str(where)],
            check=False,
            capture_output=True,
            timeout=30,
        )
        server.terminate()
        try:
            server.wait(timeout=30)
        except subprocess.TimeoutExpired:
            server.kill()


@scenario("collapse-a-group", fresh=True)
def collapse_a_group(run: Run, fixture: Path) -> None:
    """A press on a band's heading hides that group's rows, and gives them back.

    **Filtering by group, which is what a heading is for.** Three things only a
    scenario reaches: that a press on a heading is taken by the heading rather than
    falling through to the list — where `index_at` answers `None` and the pane reads
    that as empty space and clears the selection — that the rows come back, and that
    `Ctrl+A` afterwards does not select what is behind a shut one.

    Grouped by *kind*, not by time: every file in a fresh fixture shares one
    modification time, so time is a single band and a scenario over it would pass
    without the feature existing.

    **`fresh`, and the reason is not the one in `scenario`'s docstring.** This
    changes nothing in the directory; it changes what `views` *remembers* about it,
    and `Ctrl+9` writes that to a file the whole sweep shares. Against the shared
    fixture it grouped every later scenario over that path — and every folder under
    it, through the ancestor inheritance — so `alpha` and `beta` grew a heading, and
    three scenarios that click a row by arithmetic over `row_h` clicked one row too
    far. `navigation-buttons` and `breadcrumb-navigation` both ended up in `beta`
    wanting `alpha`.
    """
    run.drive("sleep 400\nkey f12\nsleep 100\n")
    rows = int(run.state()["rows"])
    if rows < 4:
        raise Failure(f"the fixture read too little: {rows} rows")

    run.drive("key ctrl+9\nsleep 400\nkey f12\nsleep 200\n")
    grouped = run.state()
    if grouped["grouping"] != "by-kind":
        raise Failure(f"Ctrl+9 left the pane {grouped['grouping']!r}")
    bands = headings_of(grouped)
    if len(bands) < 2:
        raise Failure(f"grouping by kind gave {len(bands)} bands: {grouped['headings']}")
    if any(state == "shut" for _, _, _, state in bands):
        raise Failure(f"a band was already collapsed: {grouped['headings']}")
    if grouped["collapsed"] != "0":
        raise Failure(f"nothing is shut and {grouped['collapsed']} rows are hidden")

    # Something selected first, so a press that fell through to the list would be
    # visible as a selection that got cleared rather than as nothing at all.
    pointing = point_at(run, 0)
    run.drive("click\nsleep 250\nkey f12\nsleep 200\n")
    expect(run.state(), selected="1")

    # The second band's heading. Not the first, whose rows include the one just
    # selected — this has to hide rows without touching that selection.
    band, x, y, _ = headings_of(run.state())[1]
    at = aim(run, run.state(), x, y)
    run.drive(f"move {at[0]:.2f} {at[1]:.2f}\nsleep 150\nclick\nsleep 300\nkey f12\nsleep 200\n")
    shut = run.state()
    hidden = int(shut["collapsed"])
    if hidden == 0:
        raise Failure(f"the press hid nothing: {shut['headings']}")
    if not any(kind == band and state == "shut" for kind, _, _, state in headings_of(shut)):
        raise Failure(f"band {band} is not the one that shut: {shut['headings']}")
    if shut["selected"] != "1":
        raise Failure(f"the press cleared the selection: {shut['selected']} selected")
    if shut["rows"] != str(rows):
        raise Failure(f"the listing changed size: {shut['rows']} against {rows}")

    # **`Ctrl+A` selects what is shown.** A selection holding rows behind a shut
    # heading is one a later Delete acts on by surprise.
    run.drive("key ctrl+a\nsleep 300\nkey f12\nsleep 200\n")
    picked = run.state()
    if picked["selected"] != str(rows - hidden):
        raise Failure(
            f"Ctrl+A selected {picked['selected']} of {rows} with {hidden} hidden"
        )

    # A second press on the same heading gives the rows back.
    run.drive("click\nsleep 300\nkey f12\nsleep 200\n")
    reopened = run.state()
    if reopened["collapsed"] != "0":
        raise Failure(f"pressing again left {reopened['collapsed']} rows hidden")
    if any(state == "shut" for _, _, _, state in headings_of(reopened)):
        raise Failure(f"a band stayed shut: {reopened['headings']}")

    # **And the keyboard's half**, which rule 5 requires: Ctrl+G on the cursor's
    # band, Ctrl+Shift+G to open everything again.
    run.drive("key ctrl+g\nsleep 300\nkey f12\nsleep 200\n")
    by_key = run.state()
    if by_key["collapsed"] == "0":
        raise Failure(f"Ctrl+G hid nothing: {by_key['headings']}")
    run.drive("key ctrl+shift+g\nsleep 300\nkey f12\nsleep 200\n")
    if run.state()["collapsed"] != "0":
        raise Failure(f"Ctrl+Shift+G left {run.state()['collapsed']} rows hidden")

    # And a navigation clears it, because band four is a different set of files in
    # every folder.
    run.drive("key ctrl+g\nsleep 300\nkey f12\nsleep 200\n")
    if run.state()["collapsed"] == "0":
        raise Failure("Ctrl+G hid nothing the second time")
    run.drive("text alpha\nsleep 300\nkey enter\nsleep 700\nkey f12\nsleep 200\n")
    walked = run.state()
    if not walked["path"].rstrip('"').endswith("alpha"):
        raise Failure(f"the walk did not arrive: {walked['path']}")
    if walked["collapsed"] != "0":
        raise Failure(f"a collapsed band followed the navigation: {walked['headings']}")


@scenario("check-box-selects")
def check_box_selects(run: Run, fixture: Path) -> None:
    """A press on a check box adds a row to the selection, and takes it back out.

    **Which no unit test reaches, because the whole feature is a hit target.** The
    semantics are `Selection::toggle`, which `Ctrl`-click has always had; what is
    new is a square a hand can aim at without a keyboard, and whether a press lands
    on it is a question about geometry, a pointer and a compositor.

    Three claims: an ordinary press replaces a selection and a press in the box
    does not, a second press in the same box removes what the first added, and
    neither one opens anything or starts a drag — the box is a toggle and nothing
    else.
    """
    run.drive("sleep 400\nkey f12\nsleep 100\n")
    here = run.state()["path"]

    # An ordinary press on row 1, to have something for the box to add *to*.
    pointing = point_at(run, 1)
    first = pointing["hover_name"]
    run.drive("click\nsleep 250\nkey f12\nsleep 200\n")
    expect(run.state(), cursor=first, selected="1")

    # Now the box on row 3. Two selected, and the first one is still in.
    box = point_at_the_check_box(run, 3)
    third = box["hover_name"]
    run.drive("click\nsleep 250\nkey f12\nsleep 200\n")
    added = run.state()
    if added["selected"] != "2":
        raise Failure(f"a press in the box left {added['selected']} selected, not 2")
    if added["cursor"] != third:
        raise Failure(f"the cursor is on {added['cursor']!r}, not {third!r}")
    if added["path"] != here:
        raise Failure(f"the press opened something: {added['path']}")

    # And again: back to one, which is the half a plain click cannot do at all.
    run.drive("click\nsleep 250\nkey f12\nsleep 200\n")
    removed = run.state()
    if removed["selected"] != "1":
        raise Failure(f"a second press left {removed['selected']} selected, not 1")
    if removed["path"] != here:
        raise Failure(f"the second press opened something: {removed['path']}")

    # **The keyboard's half of the same action**, which rule 5 requires and which
    # `Ctrl`-click never had: `Ctrl+Space` on the cursor row.
    run.drive("key ctrl+space\nsleep 250\nkey f12\nsleep 200\n")
    if run.state()["selected"] != "2":
        raise Failure(f"Ctrl+Space left {run.state()['selected']} selected, not 2")
    run.drive("key ctrl+space\nsleep 250\nkey f12\nsleep 200\n")
    if run.state()["selected"] != "1":
        raise Failure(f"Ctrl+Space did not take it back out: {run.state()['selected']}")


