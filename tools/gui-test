class Server:
    """A display server to run the window on, and the questions a scenario asks it.

    Two implementations, because the product has two backends and a scenario that
    only ever ran on one of them has measured one of them. Everything a scenario
    needs that is *about the server* rather than about the window is behind this:
    where the window is, how big the output is, what scale it claims, and how to
    photograph it.
    """

    display = ""

    def start(self, work: Path, scale: str) -> None:
        raise NotImplementedError

    def stop(self) -> None:
        raise NotImplementedError

    def environment(self) -> dict:
        raise NotImplementedError

    def window_box(self) -> tuple[int, int, int, int]:
        """Where the window is, in **logical** pixels — the space the program
        reports its own size in."""
        return self.box_of("dev.skerry.Skerry")

    def box_of(self, app_id: str) -> tuple[int, int, int, int]:
        """The same for any window, by the identity it gives the display server.

        Needed by the interop scenarios, which have a second application on the
        display and have to aim at it: an `app_id` on Wayland and the instance
        half of `WM_CLASS` on X11, which are the same string for a GTK program.
        """
        raise NotImplementedError

    def output_size(self) -> tuple[int, int]:
        """How big the output is, in **logical** pixels.

        The same space as [`window_box`], and that is the whole point: `aim`
        divides one by the other, so a mismatch is invisible at 100% and wrong by
        exactly the scale at any other. It was wrong — `hyprctl clients` reports
        logical and `hyprctl monitors` reports device — and twelve scenarios
        failed at 125% for as long as anyone had been running them there.
        """
        raise NotImplementedError

    def output_scale(self) -> float:
        raise NotImplementedError

    def grab(self, box: tuple[int, int, int, int], into: Path) -> None:
        raise NotImplementedError

    def driver_flag(self) -> str:
        raise NotImplementedError

    def paste_command(self, mime: str) -> list[str] | None:
        raise NotImplementedError

    def copy_command(self, mime: str) -> list[str] | None:
        """A **third party** that will own the clipboard, or nothing.

        The other direction from `paste_command`, and it has the same rule: what
        a scenario needs here is somebody else's implementation, because a window
        asked what it thinks it published has tested nothing. `None` where this
        display server has no such program on the machine.
        """
        raise NotImplementedError

    def ask_to_close(self) -> None:
        raise NotImplementedError

    def resize(self, width: int, height: int) -> None:
        """Resizes the window from outside, the way a person dragging an edge does."""
        raise NotImplementedError

    def make_floating(self) -> None:
        """Takes the window out of any tiling layout. Not every server has one."""

    def focus(self, app_id: str) -> None:
        """Gives that window the keyboard.

        Needed once a scenario has a second application on the display: a
        compositor focuses what it has just mapped, so every key after that goes
        to the peer.
        """


class WaylandServer(Server):
    """A nested Hyprland, for the virtual-input protocols."""

    def __init__(self):
        self.process = None
        self.instance = ""
        self.work = Path(".")

    def start(self, work: Path, scale: str) -> None:
        self.work = work
        self.process, self.display, self.instance = start_compositor(work, scale)

    def stop(self) -> None:
        stop_compositor(self.process, self.work / "hypr.conf")

    def environment(self) -> dict:
        return {"WAYLAND_DISPLAY": self.display, "DISPLAY": ""}

    def driver_flag(self) -> str:
        return "--wayland"

    def paste_command(self, mime: str) -> list[str] | None:
        if not shutil.which("wl-paste"):
            return None
        return ["wl-paste", "--no-newline", "--type", mime]

    def copy_command(self, mime: str) -> list[str] | None:
        if not shutil.which("wl-copy"):
            return None
        # `--foreground` so the process can be ended: without it `wl-copy` forks,
        # the parent exits, and the selection is held by a child nothing has the
        # pid of — for the rest of the sweep, in front of every scenario after
        # this one that asserts about a clipboard.
        return ["wl-copy", "--foreground", "--type", mime]

    def ask_to_close(self) -> None:
        if not self.instance:
            raise Failure("no compositor instance to ask")
        subprocess.run(
            ["hyprctl", "dispatch", "closewindow", "class:dev.skerry.Skerry"],
            env=dict(os.environ, HYPRLAND_INSTANCE_SIGNATURE=self.instance),
            capture_output=True,
            timeout=PATIENCE,
        )

    def resize(self, width: int, height: int) -> None:
        subprocess.run(
            [
                "hyprctl",
                "dispatch",
                "resizewindowpixel",
                f"exact {width} {height},class:dev.skerry.Skerry",
            ],
            env=dict(os.environ, HYPRLAND_INSTANCE_SIGNATURE=self.instance),
            capture_output=True,
            timeout=PATIENCE,
        )

    def focus(self, app_id: str) -> None:
        subprocess.run(
            ["hyprctl", "dispatch", "focuswindow", f"class:{app_id}"],
            env=dict(os.environ, HYPRLAND_INSTANCE_SIGNATURE=self.instance),
            capture_output=True,
            timeout=PATIENCE,
        )
        time.sleep(0.3)

    def make_floating(self) -> None:
        """Hyprland tiles by default and reports a tiled window as `maximized`,
        which is honest — a tiled window has no free edges and nothing to
        maximise. A window that can be resized needs to have them.
        """
        subprocess.run(
            ["hyprctl", "dispatch", "setfloating", "class:dev.skerry.Skerry"],
            env=dict(os.environ, HYPRLAND_INSTANCE_SIGNATURE=self.instance),
            capture_output=True,
            timeout=PATIENCE,
        )
        time.sleep(0.4)

    def _hypr(self, what: str):
        done = subprocess.run(
            ["hyprctl", "-j", what],
            env=dict(os.environ, HYPRLAND_INSTANCE_SIGNATURE=self.instance),
            capture_output=True,
            text=True,
            timeout=PATIENCE,
        )
        return json.loads(done.stdout)

    def box_of(self, app_id: str) -> tuple[int, int, int, int]:
        window = next((c for c in self._hypr("clients") if c.get("class") == app_id), None)
        if window is None:
            raise Failure(f"the compositor does not know about a {app_id} window")
        # Already logical: Hyprland's window geometry is in the same units the
        # program reports, measured — a 870x1078 window reads as 870x1078 at a
        # scale of 1.25.
        (left, top), (width, height) = window["at"], window["size"]
        return left, top, width, height

    def output_size(self) -> tuple[int, int]:
        # Device, and divided: `hyprctl monitors` reports the mode's pixels where
        # `hyprctl clients` reports logical ones.
        first = self._hypr("monitors")[0]
        scale = float(first["scale"])
        return round(first["width"] / scale), round(first["height"] / scale)

    def output_scale(self) -> float:
        return float(self._hypr("monitors")[0]["scale"])

    def grab(self, box: tuple[int, int, int, int], into: Path) -> None:
        left, top, width, height = box
        subprocess.run(
            ["grim", "-g", f"{left},{top} {width}x{height}", str(into)],
            env=dict(os.environ, WAYLAND_DISPLAY=self.display),
            capture_output=True,
            check=True,
            timeout=PATIENCE,
        )


class SwayServer(WaylandServer):
    """A private headless wlroots compositor for seatless Wayland validation."""

    def start(self, work: Path, scale: str) -> None:
        self.work = work
        self.runtime = work / "runtime"
        self.runtime.mkdir(mode=0o700)
        config = work / "sway.conf"
        config.write_text(
            "xwayland disable\nfont pango:Noto Sans 10\ndefault_border none\n"
            "focus_follows_mouse no\nseat seat0 fallback true\n"
            f"output HEADLESS-1 mode 1600x1000 scale {float(scale)}\n"
        )
        self.log = (work / "sway.log").open("w")
        self.process = subprocess.Popen(
            ["sway", "--config", str(config)], stdout=self.log, stderr=self.log,
            env={**os.environ, "XDG_RUNTIME_DIR": str(self.runtime),
                 "WLR_BACKENDS": "headless", "WLR_LIBINPUT_NO_DEVICES": "1",
                 "WLR_RENDERER": "pixman", "DISPLAY": "", "WAYLAND_DISPLAY": ""},
        )
        until = time.monotonic() + PATIENCE
        while time.monotonic() < until:
            sockets = list(self.runtime.glob("sway-ipc.*.sock"))
            displays = [path for path in self.runtime.glob("wayland-*") if path.is_socket()]
            if sockets and displays:
                self.socket = str(sockets[0])
                self.display = str(displays[0])
                # Keep seat capabilities across short-lived driver connections.
                self.device = subprocess.Popen(
                    [str(DRIVE), "--wayland", "--display", self.display, "--stream"],
                    stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=self.log, text=True,
                )
                self.send_script("")
                return
            if self.process.poll() is not None:
                raise Failure(f"Sway exited: {(work / 'sway.log').read_text()[-1200:]}")
            time.sleep(0.05)
        raise Failure("headless Sway never came up")

    def stop(self) -> None:
        if hasattr(self, "device") and self.device.poll() is None:
            self.device.terminate()
            self.device.wait(timeout=PATIENCE)
        if self.process and self.process.poll() is None:
            self.process.terminate()
            self.process.wait(timeout=PATIENCE)
        if hasattr(self, "log"):
            self.log.close()

    def send_script(self, script: str) -> None:
        self.device.stdin.write(script + "\nsync\n")
        self.device.stdin.flush()
        if not select.select([self.device.stdout], [], [], PATIENCE)[0]:
            raise Failure("persistent input driver did not acknowledge its batch")
        if self.device.stdout.readline().strip() != "skerry-drive: synced":
            raise Failure("persistent input driver stopped")

    def _sway(self, kind: str, command: str | None = None):
        args = ["swaymsg", "-s", self.socket, "-r", "-t", kind]
        if command is not None:
            args.append(command)
        return json.loads(subprocess.check_output(args, text=True, timeout=PATIENCE))

    def _command(self, action: str, app_id: str = "dev.skerry.Skerry") -> None:
        self._sway("command", f'[app_id="^{re.escape(app_id)}$"] {action}')

    def _window(self, app_id: str):
        pending = [self._sway("get_tree")]
        while pending:
            node = pending.pop()
            if node.get("app_id") == app_id:
                return node
            pending.extend(node.get("nodes", []) + node.get("floating_nodes", []))
        raise Failure(f"Sway does not know about {app_id}")

    def box_of(self, app_id: str) -> tuple[int, int, int, int]:
        node = self._window(app_id)
        rect, content = node["rect"], node["window_rect"]
        return rect["x"] + content["x"], rect["y"] + content["y"], content["width"], content["height"]

    def output_size(self) -> tuple[int, int]:
        rect = self._sway("get_outputs")[0]["rect"]
        return rect["width"], rect["height"]

    def output_scale(self) -> float:
        return float(self._sway("get_outputs")[0]["scale"])

    def ask_to_close(self) -> None:
        self._command("kill")

    def resize(self, width: int, height: int) -> None:
        self._command(f"resize set width {width} px height {height} px")

    def make_floating(self) -> None:
        self._command("floating enable")

    def focus(self, app_id: str) -> None:
        self._command("focus", app_id)


class X11Server(Server):
    """A private Xvfb, driven through XTEST.

    **No seat and no compositor**, which is the point: the Wayland fixture needs
    virtual-input protocols that a compositor only offers to a real session, and
    that is why the scenarios are not in CI. XTEST needs neither.
    """

    def __init__(self):
        self.process = None
        self.number = 0

    def start(self, work: Path, scale: str) -> None:
        # A display number nothing else is using. `/tmp/.X11-unix` is the only
        # authority on that, and racing another `Xvfb` for one produces an error
        # that reads like a broken test.
        taken = {int(name[1:]) for name in os.listdir("/tmp/.X11-unix") if name[1:].isdigit()}
        self.number = next(n for n in range(80, 200) if n not in taken)
        self.display = f":{self.number}"
        self.process = subprocess.Popen(
            ["Xvfb", self.display, "-screen", "0", "1600x1000x24"],
            stdout=(work / "xvfb.log").open("w"),
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
        deadline = time.time() + PATIENCE
        while time.time() < deadline:
            probe = subprocess.run(
                ["xdpyinfo", "-display", self.display], capture_output=True,
                timeout=PATIENCE,
            )
            if probe.returncode == 0:
                break
            if self.process.poll() is not None:
                raise Failure(f"Xvfb exited: {(work / 'xvfb.log').read_text()[:400]}")
            time.sleep(0.1)
        else:
            raise Failure("Xvfb never came up")

        # **The scale goes into the resource database, not onto the command
        # line.** `Xft.dpi` is where every X11 desktop states a scale and where
        # the backend reads it; forcing it with `--scale` instead would test the
        # override and leave the mechanism a person actually meets untested.
        #
        # Written by the driver rather than by `xrdb`: on this machine
        # `xrdb -merge` and `xrdb -load` both exit 0 against an `Xvfb` and create
        # no `RESOURCE_MANAGER` at all, so this set nothing and every scale
        # assertion compared a default with a default.
        dpi = round(96.0 * float(scale))
        subprocess.run(
            [str(DRIVE), "--x11", "--xft-dpi", str(dpi)],
            env=dict(os.environ, DISPLAY=self.display),
            capture_output=True,
            check=True,
            timeout=PATIENCE,
        )

    def stop(self) -> None:
        if self.process is None:
            return
        self.process.terminate()
        try:
            self.process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            self.process.kill()

    # Mesa's software Vulkan, under either name the packaging has used.
    LAVAPIPE = [
        "/usr/share/vulkan/icd.d/lvp_icd.json",
        "/usr/share/vulkan/icd.d/lvp_icd.x86_64.json",
    ]

    def environment(self) -> dict:
        # `WAYLAND_DISPLAY` is cleared as well as `SKERRY_BACKEND` set: the outer
        # session has one, and a test that only worked because of an environment
        # variable's precedence is a test of that precedence.
        environment = {"DISPLAY": self.display, "SKERRY_BACKEND": "x11", "WAYLAND_DISPLAY": ""}

        # **Software Vulkan, deliberately.** `Xvfb` has no DRI3, so a proprietary
        # driver cannot present through it and falls back to copying frames on a
        # thread of its own — measured at 1 to 2 ticks of CPU per three seconds
        # with the window doing nothing, which fails `no-cpu-when-idle` for a
        # reason that is the fixture's and not the program's. The frame loop makes
        # **zero** syscalls across that window either way.
        #
        # It is also faster here — 13.0 s against 16.3 s over three scenarios —
        # and it is what a runner has and what the golden frames already render
        # with, for the same reason: the answer should not depend on whose GPU
        # produced it. The Wayland half still exercises a real one.
        for icd in self.LAVAPIPE:
            if os.path.exists(icd):
                environment["VK_ICD_FILENAMES"] = icd
                break
        return environment

    def driver_flag(self) -> str:
        return "--x11"

    def paste_command(self, mime: str) -> list[str] | None:
        return [str(DRIVE), "--x11", "--paste", mime]

    def copy_command(self, mime: str) -> list[str] | None:
        if shutil.which("xclip") is None:
            return None
        return ["xclip", "-selection", "clipboard", "-in", "-target", mime, "-quiet"]

    def ask_to_close(self) -> None:
        subprocess.run([str(DRIVE), "--x11", "--close"], env=with_server(), capture_output=True, timeout=PATIENCE)

    def focus(self, app_id: str) -> None:
        """Focus the requested peer explicitly on a server with no window manager."""
        import ctypes
        tree = subprocess.check_output(["xwininfo", "-display", self.display, "-root", "-tree"], text=True)
        instance = app_id.rsplit(".", 1)[-1].lower()
        found = re.search(rf'(0x[0-9a-f]+).*\("{re.escape(instance)}" "[^"]*"\)', tree)
        if not found:
            raise Failure(f"no X11 window to focus: {app_id}")
        xlib = ctypes.CDLL("libX11.so.6")
        xlib.XOpenDisplay.argtypes = [ctypes.c_char_p]
        xlib.XOpenDisplay.restype = ctypes.c_void_p
        xlib.XSetInputFocus.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_int, ctypes.c_ulong]
        xlib.XSync.argtypes = [ctypes.c_void_p, ctypes.c_int]
        xlib.XCloseDisplay.argtypes = [ctypes.c_void_p]
        display = xlib.XOpenDisplay(self.display.encode())
        if not display:
            raise Failure("cannot connect to Xvfb to focus the peer")
        try:
            xlib.XSetInputFocus(display, int(found[1], 16), 1, 0)
            xlib.XSync(display, 0)
        finally:
            xlib.XCloseDisplay(display)

    def resize(self, width: int, height: int) -> None:
        subprocess.run(
            [str(DRIVE), "--x11", "--resize", f"{width}x{height}"],
            env=with_server(),
            capture_output=True,
            timeout=PATIENCE,
        )

    def box_of(self, app_id: str) -> tuple[int, int, int, int]:
        tree = subprocess.run(
            ["xwininfo", "-display", self.display, "-root", "-tree"],
            capture_output=True,
            text=True,
            timeout=PATIENCE,
        ).stdout
        # `0x200000 "Skerry": ("skerry" "Skerry")  1100x720+0+0  +0+0` — the
        # instance half of `WM_CLASS`, which is the app id lowercased.
        instance = app_id.rsplit(".", 1)[-1].lower()
        found = re.search(
            rf'\("{re.escape(instance)}" "[^"]*"\)\s+(\d+)x(\d+)\+(-?\d+)\+(-?\d+)', tree
        )
        if not found:
            raise Failure(f"the X server does not know about a {app_id} window")
        width, height, left, top = (int(value) for value in found.groups())
        # X11 speaks device pixels throughout, so this is the one place it is
        # divided — the same conversion `sk-plat`'s X11 backend does, for the same
        # reason and in the same direction.
        scale = self.output_scale()
        return (
            round(left / scale),
            round(top / scale),
            round(width / scale),
            round(height / scale),
        )

    def output_size(self) -> tuple[int, int]:
        info = subprocess.run(
            ["xdpyinfo", "-display", self.display], capture_output=True, text=True,
            timeout=PATIENCE,
        ).stdout
        found = re.search(r"dimensions:\s+(\d+)x(\d+) pixels", info)
        if not found:
            raise Failure("the X server reported no screen dimensions")
        scale = self.output_scale()
        return round(int(found.group(1)) / scale), round(int(found.group(2)) / scale)

    def output_scale(self) -> float:
        """What the server says, read back rather than remembered.

        Asked the same way the product asks it, so the assertion is about the two
        agreeing and not about a number written into a test.
        """
        # Asked through the driver, not `xprop`: `xprop -root RESOURCE_MANAGER`
        # reports `not found` against an `Xvfb` whose root demonstrably holds the
        # property, so a scale read that way was always 1.0 and every assertion
        # about scale on X11 compared a default with a default.
        shown = subprocess.run(
            [str(DRIVE), "--x11", "--query-dpi"],
            env=dict(os.environ, DISPLAY=self.display),
            capture_output=True,
            text=True,
            timeout=PATIENCE,
        ).stdout
        return float(shown.strip() or 96.0) / 96.0

    def grab(self, box: tuple[int, int, int, int], into: Path) -> None:
        from PIL import Image

        whole = into.parent / f"{into.stem}-root.png"
        subprocess.run(
            ["import", "-display", self.display, "-window", "root", str(whole)],
            capture_output=True,
            check=True,
            timeout=PATIENCE,
        )
        left, top, width, height = box
        Image.open(whole).crop((left, top, left + width, top + height)).save(into)


SERVER: Server = WaylandServer()


# Where a window under test keeps its session, set once the work directory
# exists.
#
# **Every child, not only the scenarios that care.** The window writes its layout
# on a two-second floor whether anybody asked it to or not, so without this the
# suite overwrites the developer's own `~/.local/state/skerry/session` with a
# fixture path in `/tmp` — measured, and the file was there. A test that changes
# the machine it runs on is a test nobody should run twice.
STATE = ""
# The index's home, kept inside the suite's own directory.
#
# **Not the runner's `~/.cache`.** A scenario that builds an index writes fifty
# bytes an entry somewhere, and a harness that writes into the machine it is
# testing on is one whose failures outlive it.
CACHE = ""


def build_binaries() -> str:
    """Builds what the scenarios drive. The error, if it would not build.

    **The harness builds rather than guessing whether it needs to.** It used to
    only check that `target/release/skerry` *existed*, which is not the same as
    it being current: a source edit that had not been rebuilt was tested as
    though it were never made. Measured, that cost an afternoon — two new chords
    resolved correctly in the registry's own unit test and did nothing in the
    window, through four rounds of diagnosis, because the binary predated the
    fix.

    The first attempt at a fix compared mtimes, and mtimes are the wrong
    instrument: `cargo` fingerprints content, so a manifest touched by a
    formatter is newer than a binary that is perfectly current, and the guard
    condemned a tree it should have passed. `cargo build` already knows the
    answer and a no-op one costs about a fifth of a second, so ask it.
    """
    done = subprocess.run(
        ["cargo", "build", "--release", "--bin", "skerry", "--bin", "skerry-drive"],
        cwd=ROOT,
        capture_output=True,
        text=True,
        timeout=600,
    )
    return "" if done.returncode == 0 else done.stderr.strip()[-2000:]


class PrivateBus:
    """A `dbus-daemon` of this scenario's own, and the address it answers on.

    One per scenario that asks, so a window that takes `dev.skerry.Skerry` takes
    it on a bus nobody else is on: the name is the single-instance mechanism, and
    two scenarios sharing a bus would make the second window hand its arguments
    to the first and exit.

    `environment` is the daemon's own, which is **what a service it activates
    inherits** — so a scenario about activation puts the display server and its
    XDG directories here rather than on the window it never launches.

    `output` sends the daemon's two streams to files instead of to nowhere, and
    an activated child inherits those descriptors: measured against dbus-daemon
    1.16, a service the bus started writes its stdout there. That is the only way
    a scenario reads the state of a window it did not start itself.
    """

    def __init__(
        self, work: Path, environment: dict | None = None, output: Path | None = None
    ) -> None:
        self.socket = work / "bus"
        self.out = output
        self.err = None if output is None else output.with_name(output.name + ".err")
        streams: dict = {"stdout": subprocess.DEVNULL, "stderr": subprocess.DEVNULL}
        if output is not None and self.err is not None:
            streams = {"stdout": output.open("w"), "stderr": self.err.open("w")}
        self.process = subprocess.Popen(
            [
                "dbus-daemon",
                "--session",
                "--nofork",
                "--nopidfile",
                f"--address=unix:path={self.socket}",
            ],
            env=environment,
            **streams,
        )
        deadline = time.time() + 5.0
        while time.time() < deadline:
            if self.socket.exists():
                return
            if self.process.poll() is not None:
                raise Failure("dbus-daemon exited before it listened")
            time.sleep(0.02)
        raise Failure("dbus-daemon never listened")

    @property
    def address(self) -> str:
        return f"unix:path={self.socket}"

    def stop(self) -> None:
        self.process.terminate()
        try:
            self.process.wait(timeout=2)
        except subprocess.TimeoutExpired:
            self.process.kill()


def with_server(extra: dict | None = None) -> dict:
    """The environment for a child, with the current server's variables in it.

    An empty value means *unset*, not "set to nothing": the outer session has a
    `WAYLAND_DISPLAY` and leaving it visible to a child that should be speaking
    X11 is how a test passes because of a variable's precedence rather than
    because the code works.
    """
    # **No session bus unless a scenario asks for one.** The suite's windows
    # would otherwise connect to the bus of the person running it and request
    # `org.freedesktop.FileManager1` — which, on a desktop where nothing holds
    # it, they would get, and every "show in folder" on that machine would then
    # open a fixture window that is about to be killed. An empty value is an
    # unset here, and `bus=True` puts a private one back.
    ours = {"DBUS_SESSION_BUS_ADDRESS": ""}
    if STATE:
        ours["XDG_STATE_HOME"] = STATE
    if CACHE:
        ours["XDG_CACHE_HOME"] = CACHE
    # Merged with a literal, not `dict(**a, **b)`: that form *raises* on a key
    # given twice rather than letting the later one win, and the session scenario
    # passes an `XDG_STATE_HOME` of its own over the default above.
    environment = {**os.environ, **ours, **SERVER.environment(), **(extra or {})}
    return {name: value for name, value in environment.items() if value != ""}


def send(script: str) -> None:
    """Puts a script through the display server, to whatever has the focus.

    Separate from [`Run.drive`] because input goes to the *focused* window and
    not to a process: a scenario about a window the bus started has one to drive
    and no `Run` to drive it through.
    """
    if isinstance(SERVER, SwayServer):
        SERVER.send_script(script)
        return
    done = subprocess.run(
        [str(DRIVE), SERVER.driver_flag()],
        input=script,
        text=True,
        env=with_server(),
        capture_output=True,
        timeout=PATIENCE,
    )
    if done.returncode != 0:
        raise Failure(f"the driver refused the script: {done.stderr.strip()}")


def states_in(log: str) -> list[dict[str, str]]:
    """Every state a log holds, as `name -> value`.

    Its own function because a window the harness did not start writes its log
    somewhere else — an activated one writes to the bus daemon's stdout — and a
    second copy of this parsing would be a second answer to *what does a second
    `cursor=` on the line mean*.
    """
    found = []
    for line in log.splitlines():
        if not line.startswith("skerry-state "):
            continue
        pairs = re.findall(r'(\w+)=("(?:[^"\\]|\\.)*"|\S+)', line)
        # **Unique keys, checked here.** A second `cursor=` on the line — one
        # the listing writes and one the chrome writes — is silently the last
        # one to a dict, and every scenario asserting about the first then
        # fails with a value from somewhere else entirely.
        names = [name for name, _ in pairs]
        repeated = sorted({name for name in names if names.count(name) > 1})
        if repeated:
            raise Failure(f"the diagnostic line reports {', '.join(repeated)} twice")
        found.append({k: v.strip('"') for k, v in pairs})
    return found


class Run:
    """A window, and the state it reported."""

    def __init__(
        self,
        display: str,
        work: Path,
        path: Path | None,
        arguments: list[str],
        instance: str = "",
        environment: dict | None = None,
        wrap: list[str] | None = None,
    ):
        self.instance = instance
        self.work = work
        # How many `F12` answers have been asked for. `state` waits for them.
        self.owed = 0
        self.log = work / "app.log"
        self.err = work / "app.err"
        # Kept, because a scenario that starts a second process — or calls the
        # window over a bus — needs the *same* environment this window has, and
        # rebuilding it from `with_server` loses whatever the scenario added.
        self.environment = with_server(environment or {})
        environment = self.environment
        # **No path means the saved session decides**, which is the only way to
        # reach that half of the program: a named directory is an explicit
        # request for one directory and turns restoring off.
        named = [str(path)] if path is not None else []
        self.process = subprocess.Popen(
            [*(wrap or []), str(SKERRY), *arguments, *named],
            stdout=self.log.open("w"),
            stderr=self.err.open("w"),
            env=environment,
            start_new_session=True,
        )
        self.display = display
        # Wait for the first frame, which the program announces.
        deadline = time.time() + PATIENCE
        while time.time() < deadline:
            if "first frame" in self.err.read_text():
                return
            if self.process.poll() is not None:
                raise Failure(f"the window exited: {self.err.read_text()[:400]}")
            time.sleep(0.1)
        raise Failure("the window never drew a first frame")

    def drive(self, script: str, answering: bool = True) -> None:
        """Sends a script, and counts the answers it asked for.

        `answering=False` where a *silent* window is the expected outcome —
        `Peer.yield_focus` drives an `F12` precisely to find out whether the
        keyboard came back, so an answer that never comes is one of the results
        there rather than a failure.
        """
        wanted = max(self.owed, self.reported()) + script.count("key f12")
        send(script)
        if answering:
            # **Recorded, not waited on here.** A ceiling short enough to be worth
            # having is one a cold window misses — the first drive of a scenario
            # asks while the compositor is still mapping — and a `drive` that
            # raised on it failed six scenarios that had never once been wrong.
            # `state` is where the answer is *used*, so that is where the wait
            # belongs, and there it costs time rather than a verdict.
            self.owed = wanted

    def reported(self) -> int:
        """How many state lines the window has printed so far.

        Counted the same way `states` parses them. Counting `"\nskerry-state "`
        instead misses a first line that *is* one, and a count permanently one
        short is a `state` that waits out its patience on every call.
        """
        return sum(
            1 for line in self.log.read_text().splitlines()
            if line.startswith("skerry-state ")
        )

    def reports_reached(self, wanted: int, patience: float = A_FRAME) -> bool:
        """Waits for the window to answer every `F12` asked for. Whether it did.

        **The sleep after an `F12` is a guess and this is the fact.** A script
        ends `key f12\nsleep 200` because the answer is printed a frame later,
        and 200 ms is enough on an idle machine — but under a full sweep the
        window can still be reading, and then the driver returns, the log has no
        new line in it, and the scenario fails as *the window reported no state
        at all* three lines further on. Measured: that is what
        `dragging-files-into-another-pane` did on X11, and it passed alone.

        The sleeps stay, because they are also what gives a *pointer* motion
        time to be drawn. This only stops them being the whole guarantee.

        **A frame, not a job**, which is what `A_FRAME` is and what `PATIENCE` is
        not. Waiting the long patience here made every drive that was *meant* to
        go unanswered cost twenty seconds — `yield_focus` asks ten times — and
        turned a nine-minute sweep into a thirty-minute one. The waiting for a
        directory read or a copy belongs in `listed`, `until` and `settled`, which
        poll: they can ask again, and this can only sit still.
        """
        deadline = time.time() + patience
        while self.reported() < wanted and time.time() < deadline:
            if self.process.poll() is not None:
                return self.reported() >= wanted
            time.sleep(0.05)
        return self.reported() >= wanted

    def answered(self, settle: int = 120) -> dict[str, str] | None:
        """Drives one `F12` and returns the answer **to that `F12`**, or nothing.

        **A stale line reads exactly like a fresh one.** `reports_reached` waits
        a frame and then gives up quietly — deliberately, because a drive that is
        meant to go unanswered must not cost the long patience — so a poller that
        called `state()` next was handed the line from before its own question.
        Nothing distinguishes the two, and the pollers all ask about values that
        were *already* what they wanted before the keys landed: `busy` and
        `loading` are false on an idle window, so `settled` returned **at once**
        with a state from before the keystrokes it existed to wait for.

        Measured: that is what `a-permanent-delete-asks-in-a-panel` did on X11
        under twelve spinning processes, once in about ten runs, and it read as
        the window ignoring two keystrokes — with a state dump that looked
        pristine because it *was* the dump from before them.
        """
        before = self.reported()
        # `answering=False`, so this `F12` is never added to what `state` waits
        # for: a poller is the one caller that must be *able* to be told no,
        # because asking again is exactly what it does.
        self.drive(f"key f12\nsleep {settle}\n", answering=False)
        self.reports_reached(before + 1)
        return self.state() if self.reported() > before else None

    def states(self) -> list[dict[str, str]]:
        """Every state the window has reported, once it has answered everything
        asked for.

        **The wait is here and not only in `state`.** Nine scenarios read this
        list directly — four of them unpack it by position — and it used to be a
        wait-free read of the log, so a window still drawing produced three
        answers where the script had asked for four and the failure read as
        `ValueError: not enough values to unpack`. Measured: `hidden-and-sort`
        did exactly that in a full Wayland sweep and passed on its own. A wait in
        one accessor and not in its sibling is a wait that covers whichever
        scenario happened to use the right one.
        """
        if not self.reports_reached(self.owed, patience=PATIENCE):
            raise Failure(
                f"the window answered {self.reported()} of {self.owed} F12s in {PATIENCE}s; exit={self.process.poll()}"
            )
        return states_in(self.log.read_text())

    def state(self, index: int = -1) -> dict[str, str]:
        """The state the window reported, once it has answered everything asked.

        **The wait is here because this is where a stale line does harm.** Every
        `F12` in every script `drive` was given is counted; this blocks until that
        many answers are in the log. Without it the last line was whatever the
        window had said *previously*, which is indistinguishable from a fresh one
        and is wrong in exactly the way that matters — it describes the window
        before the keys under test.
        """
        found = self.states()
        if not found:
            raise Failure("the window reported no state at all")
        return found[index]

    def ended(self, patience: float = 10.0) -> bool:
        """Whether the window has exited — **waited for, not slept at**.

        A window closing is a frame, an unmap, a destructor chain and a process
        exit, and `sleep 700` is a guess at all four. Measured: that guess ran out
        on the Wayland half with twelve other things on the machine, and the
        failure read as *a double click on the last tab left the window open*.
        """
        try:
            self.process.wait(timeout=patience)
            return True
        except subprocess.TimeoutExpired:
            return False

    def make_floating(self) -> None:
        """Take the window out of whatever layout the server has it in."""
        SERVER.make_floating()

    def ask_to_close(self) -> int:
        """Has the display server ask the window to close, the way a person would.

        Not a signal. A signal skips every destructor, and the one time this ran
        for real it turned up a segmentation fault on the way out that a week of
        signal-killed tests had hidden.
        """
        SERVER.ask_to_close()
        try:
            return self.process.wait(timeout=10)
        except subprocess.TimeoutExpired:
            raise Failure("the window ignored a close request") from None

    def close(self) -> None:
        if self.process.poll() is None:
            os.killpg(os.getpgid(self.process.pid), signal.SIGTERM)
            try:
                self.process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                os.killpg(os.getpgid(self.process.pid), signal.SIGKILL)

    def kill(self) -> None:
        """`kill -9`, which is the signal rule 6 names.

        No handler runs, no destructor runs, and nothing is flushed. Whatever is
        on disk afterwards is whatever was written before the moment it died.
        """
        if self.process.poll() is None:
            with contextlib.suppress(ProcessLookupError):
                os.killpg(os.getpgid(self.process.pid), signal.SIGKILL)
        self.process.wait(timeout=5)


def row_y(state: dict[str, str], row: int) -> float:
    """The vertical centre of a display row, in window logical pixels."""
    top = float(state["body_top"]) + float(state["row_h"]) * row + float(state["row_h"]) / 2
    return top - float(state["scroll"])


def name_x(state: dict[str, str]) -> float:
    """A horizontal position inside the name column, in window logical pixels."""
    return float(state["name_x"]) + 30.0


def window_box(run: Run) -> tuple[int, int, int, int]:
    """Where the window is on the output, from the display server itself."""
    del run
    return SERVER.window_box()


def output_size(run: Run) -> tuple[int, int]:
    del run
    return SERVER.output_size()


def output_scale(run: Run) -> float:
    """What the display server says its scale is.

    Asked rather than assumed, so the assertion is about the program agreeing
    with the server and not about a number written into a test. On Wayland that
    is the compositor's `scale`; on X11 it is `Xft.dpi` over 96, which is where
    every X11 desktop states one.
    """
    del run
    return SERVER.output_scale()


def aim(run: Run, state: dict[str, str], x: float, y: float) -> tuple[float, float]:
    """A point inside the window, as the percentages the driver takes.

    The driver moves a *virtual pointer*, which is in output coordinates; every
    coordinate the program reports is in window coordinates. Asking the
    compositor where the window is turns the guess into arithmetic — `point_at`
    still nudges, because a row is a target with a known name to check against
    and a title bar is not.
    """
    left, top, width, height = window_box(run)
    logical = [float(value) for value in state["logical"].split("x")]
    across, down = output_size(run)
    scale = (width / logical[0], height / logical[1])
    return (
        (left + x * scale[0]) / across * 100.0,
        (top + y * scale[1]) / down * 100.0,
    )


def photograph(run: Run, state: dict[str, str], into: Path, cell: str = "") -> "object":
    """What the compositor has, cropped to the list body or to one column of it.

    Everything else on the window changes between two otherwise identical
    frames — the status line carries frame timings — so the crop is the part
    that is supposed to be a function of the directory and nothing else. Pass
    `cell="size"` for the size column of the first row alone.
    """
    from PIL import Image

    box = SERVER.window_box()
    shot = into.parent / f"{into.stem}-full.png"
    SERVER.grab(box, shot)
    image = Image.open(shot).convert("RGB")
    # A grab is in device pixels and the state line is in logical ones.
    scale = image.width / float(state["logical"].split("x")[0])
    body_top = float(state["body_top"]) * scale
    if cell == "size":
        crop = (
            round(float(state["size_x"]) * scale),
            round(body_top),
            round((float(state["size_x"]) + float(state["size_w"])) * scale),
            round(body_top + float(state["row_h"]) * scale),
        )
    else:
        crop = (0, round(body_top), image.width, round(body_top + float(state["body_height"]) * scale))
    part = image.crop(crop)
    part.save(into)
    return part


def ink(image: "object") -> int:
    """How many pixels are not the background colour.

    A dash is one short stroke and a size is six glyphs, so this separates them
    by an order of magnitude without knowing anything about either.
    """
    background = image.getpixel((0, 0))
    return sum(1 for pixel in image.convert("RGB").getdata() if pixel != background)


def differing_pixels(left: "object", right: "object") -> int:
    from PIL import ImageChops

    if left.size != right.size:
        raise Failure(f"the window changed size: {left.size} then {right.size}")
    difference = ImageChops.difference(left, right)
    if difference.getbbox() is None:
        return 0
    return sum(sum(band.histogram()[1:]) for band in difference.split())


def listed(run: Run) -> dict[str, str]:
    """Waits for a directory read to land, and returns the state once it has.

    **A `sleep` before the first key is a guess about how long a read takes**,
    and one that is right on an idle machine is wrong on a busy one: a `Down`
    pressed before the rows exist moves a cursor that is not there, and the
    failure reads as `cursor is ''` two assertions later. Polling the state the
    window already reports costs nothing and cannot be wrong.
    """
    deadline = time.time() + WAITING
    while time.time() < deadline:
        state = run.answered()
        if state and state.get("loading") == "false" and int(state.get("rows", "0")) > 0:
            return state
    raise Failure(f"the listing never arrived in {WAITING}s")


def settled(run: Run) -> dict[str, str]:
    """Waits until the window has finished what it was last asked to do.

    **`busy` is the operation queue and `loading` is the read**, and every
    assertion about what is on the disk or in the listing is really an assertion
    about one of those having finished. A scenario that sleeps instead is stating
    how long an operation takes on the machine it was written on: measured,
    `keyboard-new-folder` failed a full X11 sweep with `busy: true` and seven
    jobs outstanding, nine hundred milliseconds after asking for a folder.
    """
    state: dict[str, str] = {}
    deadline = time.time() + WORKING
    while time.time() < deadline:
        fresh = run.answered(settle=60)
        if fresh is not None:
            state = fresh
            if state.get("busy") == "false" and state.get("loading") == "false":
                return state
    raise Failure(
        f"the window never went quiet in {WORKING}s: "
        f"busy={state.get('busy')} queue={state.get('queue')}"
    )


def until(run: Run, **wanted) -> dict[str, str]:
    """Waits for the window to report what is wanted, and returns that state.

    **A `sleep` long enough on an idle machine is too short on a busy one**, and
    the failure reads as an assertion about a value rather than as a wait that ran
    out: `keyboard-navigate` failed with `cursor is ''` in a full sweep and passed
    on its own, because coming out of a folder re-reads the parent and the cursor
    is restored when the *names* land — which took longer than the 600 ms that
    test had guessed. Polling the state the window already reports costs nothing
    and cannot be wrong. The generalisation of `listed`.
    """
    state: dict[str, str] = {}
    deadline = time.time() + WAITING
    while time.time() < deadline:
        fresh = run.answered()
        if fresh is not None:
            state = fresh
            if all(str(state.get(key)) == str(value) for key, value in wanted.items()):
                return state
    missed = {key: (value, state.get(key)) for key, value in wanted.items()
              if str(state.get(key)) != str(value)}
    raise Failure(f"never reached {missed} (wanted, then last seen)")


def holds(run: Run, check, what: str) -> dict[str, str]:
    """Waits until the window reports a state `check` accepts.

    [`until`] compares fields to values, which cannot say *more than zero* — and
    a wait for `indexing=0` is satisfied before the build it is waiting for has
    started, which is a wait that always passes and never waits.
    """
    state: dict[str, str] = {}
    deadline = time.time() + WAITING
    while time.time() < deadline:
        fresh = run.answered()
        if fresh is not None:
            state = fresh
            if check(state):
                return state
    raise Failure(f"never {what}; last seen {state}")


def expect(state: dict[str, str], **wanted) -> None:
    for key, value in wanted.items():
        actual = state.get(key)
        if str(actual) != str(value):
            raise Failure(f"{key} is {actual!r}, wanted {value!r}")


