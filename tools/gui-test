@scenario("a-tab-answers-a-click-a-double-click-and-its-cross")
def tab_pointer(run: Run, fixture: Path) -> None:
    """Every tab action is reachable with a pointer alone.

    A click picks the tab, a double click closes it, and so does the cross —
    which are three gestures and, through the registry, one action.
    """
    run.drive("sleep 500\nkey ctrl+t\nsleep 600\nkey f12\nsleep 200\n")
    state = run.state()
    expect(state, tabs="2", tab="1")

    first = tab_aim(run, state, 0)
    run.drive(f"move {first[0]:.1f} {first[1]:.1f}\nsleep 200\nclick\nsleep 400\nkey f12\nsleep 200\n")
    expect(run.state(), tab="0", tabs="2")

    state = run.state()
    crosses = [it for it in state.get("tab_cross", "").split(",") if it]
    if len(crosses) != 2:
        raise Failure(f"the tabs drew {len(crosses)} crosses, wanted two")
    x, _, y = crosses[0].partition(":")
    cross = aim(run, state, float(x), float(y))
    run.drive(f"move {cross[0]:.1f} {cross[1]:.1f}\nsleep 200\nclick\nsleep 500\nkey f12\nsleep 200\n")
    expect(run.state(), tabs="1")

    # A double click anywhere on a tab closes it too — on the *body* of the tab
    # rather than its cross, which the click before this one already covered.
    run.drive("key ctrl+t\nsleep 600\nkey f12\nsleep 200\n")
    two = run.state()
    expect(two, tabs="2")
    body = tab_aim(run, two, 0)
    run.drive(f"move {body[0]:.1f} {body[1]:.1f}\nsleep 250\ndouble\nsleep 600\nkey f12\nsleep 300\n")
    expect(run.state(), tabs="1")

    # And the last tab of the last pane closes the window, which is what
    # `Ctrl+W` does and what a person who has used a browser expects.
    last = tab_aim(run, run.state(), 0)
    run.drive(f"move {last[0]:.1f} {last[1]:.1f}\nsleep 250\ndouble\n")
    if not run.ended():
        raise Failure("a double click on the last tab left the window open")


def plus_aim(run: Run, state: dict[str, str]) -> tuple[float, float]:
    """Where to click the `+` at the end of the focused pane's tabs."""
    x, _, y = state.get("plus_aim", "").partition(":")
    if not x:
        raise Failure("the window reported no plus")
    return aim(run, state, float(x), float(y))


@scenario("the-plus-opens-a-tab")
def plus(run: Run, fixture: Path) -> None:
    """The one control that opens a tab, reachable before there are any.

    A strip that appeared with the second tab hid it until somebody had already
