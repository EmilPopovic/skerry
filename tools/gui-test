@scenario("a-field-edits-text-by-word", fresh=True)
def word_editing(run: Run, fixture: Path) -> None:
    """Ctrl+Backspace, Ctrl+Shift+arrows and the field's own undo.

    A word here is a **part of a name**: `file-1.txt` is three of them, because the
    parts are what a person editing a filename edits. Going left skips the
    separators and then the word, so from the end of `file-1.` the word behind the
    caret is `1.` and not `.` — which is what GTK does and what makes a second
    press remove `file-`'s last part rather than one character of punctuation.
    """
    run.drive("sleep 700\ntext file-1.txt\nsleep 500\nkey f2\nsleep 300\n")
    run.drive("key end\nsleep 150\nkey ctrl+backspace\nsleep 250\nkey f12\nsleep 150\n")
    expect(run.state(), naming="file-1.")

    # The separators and then the word.
    run.drive("key ctrl+shift+left\nsleep 250\nkey f12\nsleep 150\n")
    expect(run.state(), naming_selected="1.")

    # And a Backspace over a selection takes all of it.
    run.drive("key ctrl+backspace\nsleep 250\ntext two\nsleep 300\nkey f12\nsleep 150\n")
    expect(run.state(), naming="file-two")

    # The field's own undo takes back the run of typing, and leaves the file undo
    # stack alone — `undo=false` is the whole point, because there has been no
    # operation on disk to take back.
    run.drive("key ctrl+z\nsleep 250\nkey f12\nsleep 150\n")
    undone = run.state()
    expect(undone, naming="file-", undo="false")

    # Ctrl+Y puts it back.
    run.drive("key ctrl+y\nsleep 250\nkey f12\nsleep 150\n")
    expect(run.state(), naming="file-two")
    run.drive("key escape\nsleep 250\n")


@scenario("clicking-beside-the-breadcrumbs-opens-the-path")
def click_the_path_strip(run: Run, fixture: Path) -> None:
    """The empty part of the path bar opens the path for typing.

    The breadcrumbs were already clickable and the space around them did nothing
    at all — which is a strip of chrome that looks like an address bar and is not
    one. Where the window draws its own frame that same strip is the drag region,
    so the press waits to see whether the pointer moves; here the compositor draws
    the frame and there is nothing else the press could mean.
    """
