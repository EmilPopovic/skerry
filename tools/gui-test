def menu_aim(run: Run, state: dict[str, str], command: str) -> tuple[float, float]:
    """Where to move the pointer to click one menu row, as the driver's percentages.

    The window reports the middle of every open row, so a test aims by command
    identifier and never by arithmetic over the menu's own constants — which it
    would have to copy, and which would then be a second copy to keep right.

    **Scrolls to it if it is not drawn.** The background menu is taller than a
    720-pixel window and scrolls, and only the drawn rows report a rectangle. A
    helper that gave up on the first look made every menu scenario depend on the
    menu's *length*: adding two commands pushed the palette below the fold and
    `palette-by-pointer` failed — on X11, where the window is 720 tall, and not on
    Wayland, where it is not. Scrolling here is also the only thing that covers a
    scrolled menu being clickable at all.
    """
    # **Wait for a drawn menu before reading one.** The aim points come from the
    # hit rectangles a *frame* fills, so a dump taken between the click and the
    # next frame reports every row as dimmed-or-not and none of them as anywhere.
    # Under a full sweep that is what arrives, and the reads below then take an
    # empty string apart — a crash rather than a failure, which is the same defect
    # `keyboard-cursor` records at the top of this file.
    if not state.get("menu_aim"):
        state = holds(run, lambda it: bool(it.get("menu_aim")), "a menu with drawn rows")
    for attempt in range(8):
        for entry in state.get("menu_aim", "").split(","):
            name, _, point = entry.partition("@")
            if name == command:
                x, _, y = point.partition(":")
                return aim(run, state, float(x), float(y))
        if attempt == 0:
            # The pointer has to be over the menu for the wheel to reach it.
            first = state.get("menu_aim", "").split(",")[0]
            _, _, point = first.partition("@")
            x, _, y = point.partition(":")
            if not x:
                break
            over = aim(run, state, float(x), float(y))
            run.drive(f"move {over[0]:.1f} {over[1]:.1f}\nsleep 120\n")
        # Down the menu, which is a positive delta — the same direction that
        # scrolls a list. It used to be `-3` here, against a `Menu::wheel` whose
        # two arms were swapped: the harness and the defect agreed with each other
        # and neither agreed with the pane.
        run.drive("scroll 3\nsleep 150\nkey f12\nsleep 150\n")
        state = run.state()
    raise Failure(f"{command} is not on the open menu: {state.get('menu_aim')!r}")


def palette_aim(run: Run, state: dict[str, str], command: str) -> tuple[float, float]:
    """Where to click one palette result, as the driver's percentages.

    The same trade `menu_aim` makes: the window reports the middle of every drawn
    row, so a test aims by command identifier rather than by arithmetic over the
    palette's own constants.
    """
    for entry in state.get("palette_aim", "").split(","):
        name, _, point = entry.partition("@")
        if name == command:
            x, _, y = point.partition(":")
            return aim(run, state, float(x), float(y))
    raise Failure(f"{command} is not on the open palette: {state.get('palette_aim')!r}")


