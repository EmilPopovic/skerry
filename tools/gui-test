@scenario("a-failed-operation-owes-nothing", fresh=True)
def a_failed_operation_owes_nothing(run: Run, fixture: Path) -> None:
    """A creation that fails must not leave a rename field owed.

    New folder and naming it are two steps with a directory read between them, so
    the second is remembered until the listing lands. It used to be remembered as
    a bare flag and applied to *the cursor*, so a creation that failed left the
    debt outstanding and the next listing to land anywhere at all opened a rename
    field over a file nobody had chosen — with Enter renaming it.
    """
    locked = fixture / "locked"
    locked.mkdir(exist_ok=True)
    locked.chmod(0o500)
    try:
        run.drive("sleep 500\nkey ctrl+l\nkey ctrl+u\n")
        run.drive(f"text {locked}\nkey enter\nsleep 800\nkey f12\nsleep 200\n")
        expect(run.state(), path=str(locked), rows="0")

        run.drive("key ctrl+shift+n\nsleep 900\nkey f12\nsleep 200\n")
        refused = run.state()
        if not refused["notice"]:
            raise Failure("a folder was made in a directory with no write permission")
        expect(refused, naming="", rows="0", undo="false")

        # And the debt did not follow us out, nor attach itself to the next
        # operation that *does* succeed — which is where an uncleared flag lands
        # now that the name comes from the outcome rather than from the cursor.
        run.drive("key alt+up\nsleep 900\nkey f12\nsleep 300\n")
        expect(run.state(), path=str(fixture), naming="")
        run.drive("key end\nkey f2\nsleep 300\nkey home\ntext ok-\nsleep 150\n")
        run.drive("key enter\nsleep 900\nkey f12\nsleep 300\n")
        renamed = run.state()
        expect(renamed, undo="true")
        if renamed["naming"]:
            raise Failure(f"a field opened over the rename's own subject: {renamed['naming']!r}")
    finally:
        locked.chmod(0o700)


@scenario("a-field-follows-its-own-row", fresh=True)
def a_field_follows_its_own_row(run: Run, fixture: Path) -> None:
    """A file landing above an open rename field must not move it onto another row.

    The field knows its subject by path and its position by row index, and the
    listing is re-read underneath it four times a second while a directory is
    being written into. Nothing reconciled the two: a name that sorts above it
    renumbered every row below, and the field was left drawn over a different
    file while Enter renamed the original.
    """
    run.drive("sleep 500\nkey end\nkey f2\nsleep 300\nkey f12\nsleep 150\n")
    naming = run.state()
    subject = naming["naming"]
    row = int(naming["naming_row"])
    if not subject or row < 0:
        raise Failure(f"F2 opened no field: {naming}")

    # Two names that sort above every existing one, so every row moves down.
    for name in ("000-first.txt", "001-second.txt"):
        (fixture / name).write_text("x")
    run.drive("sleep 900\nkey f12\nsleep 200\n")
    moved = run.state()
    expect(moved, naming=subject, rows="11")
    if int(moved["naming_row"]) != row + 2:
        raise Failure(
            f"the field stayed on row {moved['naming_row']} while its file moved to {row + 2}"
        )

    # And Enter still renames the file the field was opened on.
    run.drive("key home\ntext kept-\nsleep 200\nkey enter\nsleep 900\nkey f12\nsleep 200\n")
    expect(run.state(), naming="", undo="true")
    if not (fixture / f"kept-{subject}").exists():
        raise Failure(f"kept-{subject} is not on the disk")

    # A subject that vanishes takes the field with it, rather than capturing the
    # keyboard while being drawn nowhere.
    run.drive("key end\nkey f2\nsleep 300\nkey f12\nsleep 150\n")
    doomed = run.state()["naming"]
    if not doomed:
        raise Failure("F2 opened no field the second time")
    (fixture / doomed).unlink()
    run.drive("sleep 900\nkey f12\nsleep 200\n")
    expect(run.state(), naming="")


@scenario("trash-a-whole-selection", fresh=True)
def trash_a_whole_selection(run: Run, fixture: Path) -> None:
    """Three files selected, one Delete, three undo entries.

    It used to trash the first of the selection and say "One of 3. A queue for
    the rest is not built yet." — while Copy on the same selection, reached from
    the same menu, took all three. One at a time is still what the engine does;
    the difference is that it now does all of them, counts them as it goes, and
    each is its own entry on the one undo stack.
    """
    run.drive("sleep 500\nkey end\nkey shift+up\nkey shift+up\nsleep 250\nkey f12\nsleep 150\n")
    chosen = run.state()
    expect(chosen, selected="3", rows="9")

    run.drive("key delete\nsleep 2000\nkey f12\nsleep 300\n")
    gone = run.state()
    expect(gone, rows="6", undo="true", busy="false", queue="0/0")
    if "3 of 3" not in gone["notice"]:
        raise Failure(f"the notice did not count them: {gone['notice']!r}")
    trash = run.log.parent / "data" / "trash-a-whole-selection" / "Trash" / "files"
    if not trash.is_dir() or len(list(trash.iterdir())) != 3:
        found = sorted(p.name for p in trash.iterdir()) if trash.is_dir() else "no Trash at all"
        raise Failure(f"the Trash holds {found}")

    # The cursor is on something that survived, so a second Delete has a subject.
    if not gone["cursor"]:
        raise Failure("nothing is focused, so the next Delete would do nothing")

    # Three entries, so three undos — and the directory comes back whole.
    for _ in range(3):
        run.drive("key ctrl+z\nsleep 900\n")
    run.drive("key f12\nsleep 300\n")
    back = run.state()
    expect(back, rows="9", undo="false", redo="true")
    if trash.is_dir() and list(trash.iterdir()):
