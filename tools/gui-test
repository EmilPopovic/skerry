@scenario("a-big-copy-shows-progress-and-stops-when-told", fresh=True)
def progress_and_cancel(run: Run, fixture: Path) -> None:
    """A copy long enough to watch, a status line that counts, and Ctrl+. stops it.

    **Two things make this deterministic rather than a race**, and the first
    version had neither — it passed while the machine was at a load average of 5
    and failed three for three once it was idle, which is
    docs/12-measurement.md's load contamination arriving as a flaky test.

    *The queue, not one folder.* Ten folders pasted at once is a ten-entry queue
    run one at a time, so stopping it drops the nine that have not started. A
    single folder is a race against one copy finishing, and on tmpfs thirty
    thousand small files finish in about half a second.

    *One driver script.* Every `drive` call is a fresh process, so a cancel in its
    own call lands whenever that process starts. Paste, look and stop go in one
    script, where the gap is a `sleep` this test chose.

    Bytes are the wrong lever throughout: 240 MB of tmpfs copies through
    `copy_file_range` faster than one frame. What costs is syscalls per file.
    """
    big = fixture / "big"
    for bucket in range(10):
        (big / f"bucket-{bucket}").mkdir(parents=True)
        for index in range(3000):
            (big / f"bucket-{bucket}" / f"part-{index:04}.bin").write_bytes(b"x" * 128)
    (fixture / "target").mkdir()

    # Into `big`, select its ten folders, copy them.
    run.drive("sleep 700\ntext big\nsleep 400\nkey enter\nsleep 900\nkey f12\nsleep 150\n")
    inside = run.state()
    expect(inside, rows="10")
    run.drive("key ctrl+a\nsleep 250\nkey ctrl+c\nsleep 400\nkey f12\nsleep 150\n")
    expect(run.state(), selected="10")

    # Out to the fixture, into `target`, and paste all ten.
    run.drive("key backspace\nsleep 900\nsleep 700\ntext target\nsleep 400\nkey enter\nsleep 900\n")
    # One script, with the stop asked for early and then repeatedly. **A single
    # keystroke at a chosen moment is a bet on how long the copy takes**, and the
    # bet was lost twice: 30,000 files on tmpfs take about 350 ms on an idle
    # machine and three times that on a loaded one, so a stop at 400 ms missed the
    # end of it. The first one here lands around 240 ms and the rest follow every
    # 60 ms; `edit.cancel` is disabled when nothing is running, so the ones that
    # fall outside the window do nothing at all.
    #
    # **Sampled throughout rather than once.** One `f12` at a chosen moment is
    # the same bet as one `ctrl+.` at a chosen moment, and it was lost the same
    # way: on a loaded machine the earlier steps ran late and the single sample
    # landed after the copy had finished, reporting an empty progress line and
    # `Copied 10 items`. Looking and stopping alternate, so both cover the whole
    # window instead of one instant in it.
    watch = "".join("key f12\nsleep 30\nkey ctrl+.\nsleep 40\n" for _ in range(8))
    run.drive(f"key ctrl+v\nsleep 120\n{watch}sleep 1500\nkey f12\nsleep 200\n")
    during = next((it for it in run.states() if "opying" in it.get("progress", "")), None)
    stopped = run.state()
    if during is None:
        raise Failure(
            "no sample caught the copy running; the last says the progress line is "
            f"{stopped['progress']!r} and the notice is {stopped['notice']!r}"
        )
    if "Stopped" not in stopped["notice"]:
        raise Failure(f"after stopping, the status line says {stopped['notice']!r}")
    expect(stopped, undo="true")

    # What it wrote is still there, and it is not all of it. Counted in files
    # rather than folders: the stop can land while the tenth folder is being
    # copied, so all ten names can exist with the last one part-filled — and
    # "not everything arrived" is the claim, not "fewer than ten folders did".
    arrived = sum(1 for _ in (fixture / "target").rglob("*.bin"))
    if arrived == 0:
        raise Failure("a stopped copy left nothing at all, so there is nothing to undo")
    if arrived >= 30_000:
        raise Failure(f"all {arrived} files arrived, so nothing was stopped")

    # The undo takes back the entry that was in flight, which is the only one the
    # stack has — the ones that never started need nothing taken back.
    #
    # **Counted in entries, not in files.** The entry that was in flight can have
    # been stopped after its folder was made and before anything went into it, so
    # undoing it removes a directory and no files at all — which a `*.bin` count
    # reads as "the undo removed nothing".
    before = sum(1 for _ in (fixture / "target").rglob("*"))
    run.drive("key ctrl+z\nsleep 2000\nkey f12\nsleep 200\n")
    after = sum(1 for _ in (fixture / "target").rglob("*"))
    if after >= before:
        raise Failure(f"the undo removed nothing: {before} entries, then {after}")


@scenario("a-stopped-copy-is-picked-up-where-it-left-off", fresh=True)
def resume_a_copy(run: Run, fixture: Path) -> None:
    """Rule 7's third word: a long operation is visible, cancellable and resumable.

    Built like `a-big-copy-shows-progress-and-stops-when-told`, for the same two
    reasons: a ten-entry queue rather than one folder, and one driver script so
    the stop lands where this test chose rather than where a process happened to
    start.

    What is asserted beyond that scenario: the strip keeps saying what is owed
    after the notice has expired, the button picks it up, and what arrives is the
    *whole* tree — which is the claim `Conflict::Resume` exists for, because a
    resume that started the interrupted folder again would land it beside itself
    as `bucket-3 (copy)`.
    """
    big = fixture / "big"
    for bucket in range(10):
        (big / f"bucket-{bucket}").mkdir(parents=True)
        for index in range(1500):
            (big / f"bucket-{bucket}" / f"part-{index:04}.bin").write_bytes(b"x" * 64)
    (fixture / "target").mkdir()
    whole = sum(1 for _ in big.rglob("*.bin"))

    run.drive("sleep 700\ntext big\nsleep 400\nkey enter\nsleep 900\nkey f12\nsleep 150\n")
    expect(run.state(), rows="10")
    run.drive("key ctrl+a\nsleep 250\nkey ctrl+c\nsleep 400\nkey f12\nsleep 150\n")
    expect(run.state(), selected="10")
    run.drive("key backspace\nsleep 900\nsleep 700\ntext target\nsleep 400\nkey enter\nsleep 900\n")

    watch = "".join("key f12\nsleep 30\nkey ctrl+.\nsleep 40\n" for _ in range(8))
    run.drive(f"key ctrl+v\nsleep 120\n{watch}sleep 1500\nkey f12\nsleep 200\n")
    stopped = holds(
        run,
        lambda it: it["busy"] == "false" and it["owed"] != "0/0",
        "a stopped queue that says what it owes",
    )
    left, of = (int(part) for part in stopped["owed"].split("/"))
    if of != 10 or not 0 < left <= 10:
        raise Failure(f"the queue owes {stopped['owed']}, of a paste of ten")
    # **The strip says so after the notice would have gone.** `notice` is the
    # four-second message that reports the stop; `progress` is the line that
    # stands until the operation is picked up or replaced, and it is the one rule
    # 7 means by "stays visible".
    if "stopped" not in stopped["progress"]:
        raise Failure(f"the strip's line is {stopped['progress']!r}")
    arrived = sum(1 for _ in (fixture / "target").rglob("*.bin"))
    if not 0 < arrived < whole:
        raise Failure(f"{arrived} of {whole} arrived, so nothing was stopped part way")

    # Picked up by the button on the strip, which is the pointer's way to it.
    aim_at = stopped["pick_up_aim"]
    if not aim_at:
        raise Failure("the strip drew no Pick up button")
    across, down = (float(value) for value in aim_at.split(":"))
    at = aim(run, stopped, across, down)
    run.drive(f"move {at[0]:.2f} {at[1]:.2f}\nsleep 200\nclick left\nsleep 400\nkey f12\nsleep 200\n")
    holds(run, lambda it: it["busy"] == "true" or it["owed"] == "0/0", "a queue picked up")

    deadline = time.time() + WAITING
    while time.time() < deadline:
        if sum(1 for _ in (fixture / "target").rglob("*.bin")) == whole:
            break
        time.sleep(0.2)
    else:
        got = sum(1 for _ in (fixture / "target").rglob("*.bin"))
        raise Failure(f"the resume finished with {got} of {whole} files")

    # **And nothing landed twice.** A resume that started the interrupted folder
    # again would put it beside itself under a free name, which is what
    # `Conflict::Resume` exists to prevent.
    names = sorted(path.name for path in (fixture / "target").iterdir())
    if names != [f"bucket-{bucket}" for bucket in range(10)]:
        raise Failure(f"the target holds {names}")
    settled = holds(run, lambda it: it["owed"] == "0/0", "an offer that was taken")
    expect(settled, busy="false")


@scenario("a-copy-pauses-where-it-is-and-carries-on", fresh=True)
def pause_and_resume(run: Run, fixture: Path) -> None:
    """A running copy is held still, and the disk stops changing while it is.

    **What makes this a pause rather than a stop and a restart**: the job stands
    on a latch holding what it has open, so nothing is redone when it goes on.
    The claim the assertions make is the observable half of that — the file count
    does not move while it is held, and the copy finishes without the queue
    starting over.

    Also the ETA, which is the other half of rule 7 and was owed. It appears only
    once the walk running beside the copy has reached the last file, so the
    diagnostic line's `total_done` is what this waits for rather than a `sleep`.
    """
    big = fixture / "big"
    # Twenty entries, so the queue is long enough that a pause asked for in the
    # second `drive` call lands while it is still running. `a-big-copy` explains
    # why syscalls per file rather than bytes is the lever.
    for bucket in range(30):
        (big / f"bucket-{bucket}").mkdir(parents=True)
        for index in range(2500):
            (big / f"bucket-{bucket}" / f"part-{index:04}.bin").write_bytes(b"x" * 128)
    (fixture / "target").mkdir()

    run.drive("sleep 700\ntext big\nsleep 400\nkey enter\nsleep 900\nkey f12\nsleep 150\n")
    expect(run.state(), rows="30")
    run.drive("key ctrl+a\nsleep 250\nkey ctrl+c\nsleep 400\nkey f12\nsleep 150\n")
    expect(run.state(), selected="30")
    run.drive("key backspace\nsleep 900\nsleep 700\ntext target\nsleep 400\nkey enter\nsleep 900\n")

    # Sampled throughout rather than at a chosen moment, for the reason
    # `a-big-copy` gives: one `f12` at one instant is a bet on how long a copy
    # takes, and this one has to catch the window where the rate is known and the
    # queue is still running.
    run.drive("key ctrl+v\nsleep 200\n" + "key f12\nsleep 70\n" * 3)
    expect(run.state(), busy="true", paused="false")
    run.drive("key pause\nsleep 400\nkey f12\nsleep 150\n")
    held = run.state()
    if held["busy"] != "true":
        raise Failure("the copy finished before the pause could land; it needs to be longer")
    expect(held, paused="true")
    if "aused" not in held["progress"]:
        raise Failure(f"the line does not say it is paused: {held['progress']!r}")

    # **The disk stops changing.** A pause that only changed a word in the status
    # line would pass every assertion above this one.
    settled = sum(1 for _ in (fixture / "target").rglob("*.bin"))
    run.drive("sleep 1200\nkey f12\nsleep 150\n")
    still = sum(1 for _ in (fixture / "target").rglob("*.bin"))
    expect(run.state(), paused="true", busy="true")
    if still != settled:
        raise Failure(f"{still - settled} more files arrived while the copy was paused")
    if still == 0:
        raise Failure("nothing had been copied before the pause, so nothing was held")

    # The count beside the copy has reached the end by now, which is the whole
    # condition on there being a time left to show.
    if run.state()["total_done"] != "true":
        raise Failure("the walk beside the copy never finished counting")

    run.drive("key pause\nsleep 120\n" + "key f12\nsleep 70\n" * 6)
    running = next((it for it in run.states() if "left" in it.get("progress", "")), None)
    if running is None:
        seen = {it.get("progress", "") for it in run.states()}
        raise Failure(f"no sample showed a time left; the lines seen were {sorted(seen)}")

    for _ in range(60):
        run.drive("sleep 500\nkey f12\nsleep 100\n")
        if run.state()["busy"] == "false":
            break
    expect(run.state(), busy="false", paused="false")
    arrived = sum(1 for _ in (fixture / "target").rglob("*.bin"))
    if arrived != 75_000:
        raise Failure(f"{arrived} of 75,000 files arrived after the pause was let go")


