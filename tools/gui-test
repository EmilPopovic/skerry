def copy_the_text_inside(run: Run, fixture: Path) -> None:
    """A text file's contents on the clipboard, without opening it.

    Read back with `wl-paste`, which is another Wayland client: the point of the
    feature is that something else can paste it, and asking the window what it
    thinks it offered would pass with the data source never bound at all.
    """
    content = 'fn main() {\n    println!("caf\u00e9 \u2014 hello");\n}\n'
    (fixture / "main.rs").write_text(content)
    (fixture / "photo.png").write_bytes(bytes(range(256)) * 8)

    run.drive("sleep 700\nkey f12\nsleep 150\n")
    if run.state()["rows"] != "11":
        raise Failure(f"the fixture has {run.state()['rows']} rows, wanted 11")

    # By name, because the row a file lands on depends on the sort.
    run.drive("text main.rs\nsleep 400\nkey f12\nsleep 150\n")
    expect(run.state(), cursor="main.rs")
    run.drive("key ctrl+alt+c\nsleep 900\nkey f12\nsleep 200\n")
    copied = run.state()
    if "main.rs" not in copied.get("notice", ""):
        raise Failure(f"copying said {copied.get('notice')!r}")
    # Verbatim, trailing newline included: a file's text is its bytes, and a
    # copy that trims them is a copy of something else.
    held = clipboard(run)
    if held != content:
        raise Failure(f"the clipboard holds {held!r}, wanted {content!r}")


@scenario("copy-the-text-inside-by-pointer", fresh=True)
def copy_the_text_inside_by_pointer(run: Run, fixture: Path) -> None:
    """The same action from the row menu, and dimmed where it cannot work.

    A `.png` is a type shared-mime-info knows and knows is not text, so the row
    is drawn and dimmed rather than left out — rule 4 — and clicking it does
    nothing, which is what a dimmed row means everywhere else.
    """
    (fixture / "notes.txt").write_text("one\ntwo\n")
    (fixture / "photo.png").write_bytes(bytes(range(256)) * 8)
    run.drive("sleep 700\ntext notes.txt\nsleep 400\nkey f12\nsleep 150\n")
    at_text = run.state()
    expect(at_text, cursor="notes.txt")

    point_at(run, int(at_text["cursor_row"]))
    run.drive("click right\nsleep 400\nkey f12\nsleep 150\n")
    opened = run.state()
    if "file.copy_content" not in opened["menu_aim"]:
        raise Failure(f"the row menu has no copy-content: {opened['menu_aim']}")
    if "file.copy_content" in opened["menu_dim"]:
        raise Failure("copy-content is dimmed on a text file")
    aimed = menu_aim(run, opened, "file.copy_content")
    run.drive(
        f"move {aimed[0]:.1f} {aimed[1]:.1f}\nsleep 200\nclick\nsleep 900\nkey f12\nsleep 200\n"
    )
    expect(run.state(), menu="0")
    if clipboard(run) != "one\ntwo\n":
        raise Failure(f"the clipboard holds {clipboard(run)!r}")

    # And on a picture the row is there, dimmed, and does nothing.
    run.drive("text photo.png\nsleep 400\nkey f12\nsleep 150\n")
    at_image = run.state()
    expect(at_image, cursor="photo.png")
    point_at(run, int(at_image["cursor_row"]))
    run.drive("click right\nsleep 400\nkey f12\nsleep 150\n")
    over_image = run.state()
    if "file.copy_content" not in over_image["menu_dim"]:
        raise Failure(f"copy-content is not dimmed on a .png: {over_image['menu_dim']!r}")
    aimed = menu_aim(run, over_image, "file.copy_content")
    run.drive(
        f"move {aimed[0]:.1f} {aimed[1]:.1f}\nsleep 200\nclick\nsleep 700\nkey f12\nsleep 200\n"
    )
    expect(run.state(), menu="0")
    if clipboard(run) != "one\ntwo\n":
        raise Failure("clicking a dimmed row changed the clipboard")


@scenario("filter-narrows-the-list")
def filter_narrows_the_list(run: Run, fixture: Path) -> None:
    """`/` opens the filter, typing narrows, Escape puts everything back.

    The keyboard belongs to the field while it is open — a filter you cannot type
    `h` into because `Ctrl+H` is bound is not a filter — but the arrows do not,
    so a narrowed list can still be moved through and acted on.
    """
    run.drive("sleep 400\nkey f12\nsleep 200\n")
    everything = int(run.state()["rows"])
    if everything < 9:
        raise Failure(f"the fixture has only {everything} rows")

    run.drive("key /\nsleep 200\nkey f12\nsleep 150\n")
    expect(run.state(), filtering="true", filter="")

    # `alpha` is the only name with a `p` in it that is not a `file-N.txt`.
    run.drive("key f\nkey i\nkey l\nsleep 300\nkey f12\nsleep 200\n")
    state = run.state()
    expect(state, filtering="true", filter="fil")
    narrowed = int(state["rows"])
    if narrowed != 6:
        raise Failure(f"{narrowed} rows match 'fil', wanted the six file-N.txt")

    # The arrows still reach the list while the field is open.
    run.drive("key down\nsleep 200\nkey f12\nsleep 150\n")
    if not run.state()["cursor"].startswith("file-"):
        raise Failure(f"the cursor landed on {run.state()['cursor']!r}, not a match")

    # Backspace narrows back out, one character at a time.
    run.drive("key backspace\nsleep 300\nkey f12\nsleep 200\n")
    expect(run.state(), filter="fi")

    # A space belongs in a field: `VirtualBox VMs` and `My Documents` are
    # filenames, and a filter that cannot reach one is not a filter.
    run.drive("key space\nsleep 250\nkey f12\nsleep 150\n")
    expect(run.state(), filter="fi ")

    run.drive("key backspace\nkey escape\nsleep 300\nkey f12\nsleep 200\n")
    state = run.state()
    expect(state, filtering="false", filter="")
    if int(state["rows"]) != everything:
        raise Failure(f"{state['rows']} rows after clearing, wanted {everything}")


@scenario("a-filter-outlives-the-field-that-typed-it", fresh=True)
def a_filter_outlives_the_field_that_typed_it(run: Run, fixture: Path) -> None:
    """Renaming a row you searched for renames it where you found it.

    **Its own fixture, long enough that the unfiltered row is off screen.** The
    defect this exists for needs the two to be screens apart: `F2` used to clear
    the filter as it took the keyboard, so the row being renamed went back to
    wherever it sits among all the others, and the field opened there — a couple
    of screens below the one match a person had just narrowed the list down to.

    Having the keyboard and being applied were one flag. They are two now: the
    box stops taking keys, the rows it hid stay hidden.
    """
    run.drive("sleep 400\nkey f12\nsleep 100\n")
    for index in range(200):
        (fixture / f"filler-{index:03}.txt").write_text("x")
    (fixture / "zebra-target.txt").write_text("x")
    for _ in range(40):
        run.drive("sleep 150\nkey f12\nsleep 50\n")
        filled = run.state()
        if int(filled["rows"]) > 200:
            break
    else:
        raise Failure(f"the filler files never arrived: {filled['rows']} rows")
    everything = int(filled["rows"])
    on_screen = float(filled["body_height"]) / float(filled["row_h"])
    if everything - on_screen < on_screen:
        raise Failure(f"{everything} rows over {on_screen:.0f} on screen is not two screens")

    # One match, and the cursor goes to it: a filter that leaves the focus on a
    # row it just hid is a filter you cannot press F2 in.
    run.drive("key ctrl+f\ntext zebra\nsleep 500\nkey f12\nsleep 200\n")
    found = run.state()
    expect(found, filtering="true", filter="zebra", rows="1", cursor_row="0")
    if found["cursor"] != "zebra-target.txt":
        raise Failure(f"the filter left the cursor on {found['cursor']!r}")

    # The whole point. The field opens on row 0, where the match is — not on row
    # 200, where the file is when nothing is filtered.
    run.drive("key f2\nsleep 400\nkey f12\nsleep 200\n")
    naming = run.state()
    expect(
        naming,
        filtering="false",
        filter="zebra",
        rows="1",
        naming_row="0",
        naming="zebra-target.txt",
        naming_selected="zebra-target",
    )
    if float(naming["scroll"]) != float(found["scroll"]):
        raise Failure(f"the list scrolled from {found['scroll']} to {naming['scroll']}")

    # And it renames the file it was aimed at.
    run.drive("text zebra-renamed\nkey enter\nsleep 600\nkey f12\nsleep 200\n")
    done = run.state()
    expect(done, naming="", filter="zebra", rows="1")
    if not (fixture / "zebra-renamed.txt").exists():
        raise Failure("the rename did not land")

    # Escape is what drops a filter, and the field committed on Enter has already
    # gone — so this one reaches the list, where Escape means never mind.
    run.drive("key escape\nsleep 400\nkey f12\nsleep 200\n")
    expect(run.state(), filter="", rows=str(everything))


@scenario("a-resize-relays-out-at-the-new-size", fresh=True)
def a_resize_relays_out(run: Run, fixture: Path) -> None:
    """The window is resized from outside, and everything follows.

    Nothing covered this on either display server before there were two of them.
    Under Hyprland the window is sized once at map time and never again; under a
    bare `Xvfb` there is no window manager to size it at all — so the whole
    relayout path was reached only by starting a window at a given size, which is
    not the same code.

    The assertion is the conversion rather than the pixels: **logical times scale
    is what the server says the window is**. That is the one arithmetic
    docs/03-principles.md says must live in exactly one place, and the two
    backends derive it in opposite directions — Wayland is told the logical size
    and computes the device one, X11 is told the device size and computes the
    logical one.
    """
    # A tiled window has no free edges and cannot be resized; a bare X server has
    # no tiling and this does nothing there.
    run.make_floating()
    run.drive("sleep 600\nkey f12\nsleep 150\n")
    before = run.state()

    # A fixed size rather than a fraction of the current one. Floating a tiled
    # window drops it to its 320x240 minimum, and 70% of that is below the
    # minimum — which the compositor refuses, so nothing moves and the scenario
    # reports a resize that never happened rather than one that was declined.
    target = (900, 600)
    if before["logical"] == f"{target[0]}x{target[1]}":
        raise Failure("the window is already the size this resizes it to")
    SERVER.resize(*target)
    for _ in range(30):
        run.drive("sleep 150\nkey f12\nsleep 100\n")
        after = run.state()
        if after["logical"] != before["logical"]:
            break
    else:
        raise Failure(f"the window never resized: still {before['logical']}")

    logical = [float(value) for value in after["logical"].split("x")]

    # What the program laid out is what the server says the window is. Both in
    # logical pixels, with one of slack for the rounding — a `div_ceil` on both.
    left, top, width, height = SERVER.window_box()
    del left, top
    for got, want, axis in [(logical[0], width, "width"), (logical[1], height, "height")]:
        if abs(got - want) > 1.0:
            raise Failure(f"the server says the {axis} is {want} and the window laid out {got}")

    # And the list still fits inside it, which is what a relayout is for.
    if float(after["body_top"]) + float(after["body_height"]) > logical[1]:
        raise Failure(
            f"the body runs {float(after['body_top']) + float(after['body_height'])} "
            f"past a window {logical[1]} tall"
        )


@scenario("a-cut-says-cut-to-another-application", fresh=True)
def a_cut_says_cut(run: Run, fixture: Path) -> None:
    """A cut here pastes as a move in Nautilus, and a copy does not.

    **Read by a separate client**, which is the whole point: the mark that says
    "these were cut" is not a property of the paths, it is a second MIME type,
    and until it was published a cut in this window arrived everywhere else as a
    copy — the files landed, the originals stayed, and nobody was told why.

    `x-special/gnome-copied-files` is undocumented by any standard and read by
    GTK, Qt and every file manager that interoperates with them. Its first line
    is the verb.
    """
    run.drive("sleep 600\ntext file-1.txt\nsleep 400\nkey ctrl+c\nsleep 500\n")
    copied = clipboard(run, "x-special/gnome-copied-files")
    lines = copied.split("\n")
    if lines[0] != "copy":
        raise Failure(f"a copy published {copied!r}")
    if not lines[1].endswith("/file-1.txt"):
        raise Failure(f"the copy names {lines[1]!r}")

    run.drive("key ctrl+x\nsleep 600\n")
    cut = clipboard(run, "x-special/gnome-copied-files")
    if cut.split("\n")[0] != "cut":
        raise Failure(f"a cut published {cut!r}")
    # The same files either way: the verb is the only difference, and a uri-list
    # that changed with it would mean the two types disagreed about what was cut.
    if cut.split("\n")[1:] != lines[1:]:
        raise Failure(f"the cut names {cut.split(chr(10))[1:]}, the copy named {lines[1:]}")

    # And it still round-trips here: pasting our own cut moves rather than copies.
    (fixture / "target").mkdir()
    run.drive("sleep 1200\ntext target\nsleep 400\nkey enter\nsleep 900\nkey ctrl+v\n")
    run.drive("sleep 900\nkey f12\nsleep 200\n")
    if not (fixture / "target" / "file-1.txt").is_file():
        raise Failure("the cut did not land in the folder")
    if (fixture / "file-1.txt").exists():
        raise Failure("the original is still there, so the cut pasted as a copy")


@scenario("dragging-files-onto-a-folder-moves-them", fresh=True)
def dragging_files_onto_a_folder(run: Run, fixture: Path) -> None:
    """Pick two files up, drop them on a folder, and `Ctrl+Z` takes it back.

    **A press on an already-selected row does not collapse the selection.** That
    is the whole reason the selection change is deferred to the release: a plain
    press on one of several chosen files means either "just this one" or "pick
    all of them up", and which it was is not known until the pointer moves or
    does not. Deciding on the press is what makes dragging three files drag one.

    Move, and `Ctrl` copies — every folder reachable by dragging inside one pane
    is on the filesystem that pane is showing, so the "same device means move"
    rule other desktops decide per drop is always move here.
    """
    run.drive("sleep 600\nkey f12\nsleep 150\n")
    # Two files, chosen with the keyboard so the pointer has touched nothing.
    run.drive("text file-1.txt\nsleep 400\nkey shift+down\nsleep 250\nkey f12\nsleep 150\n")
    chosen = run.state()
    if chosen["selected"] != "2":
        raise Failure(f"{chosen['selected']} rows selected, wanted 2")

    held = point_at(run, int(chosen["cursor_row"]) - 1)
    if held["hover_name"] != "file-1.txt":
        raise Failure(f"the pointer is over {held['hover_name']!r}, wanted file-1.txt")
    onto = point_at(run, 0)
    if onto["hover_name"] != "alpha":
        raise Failure(f"row 0 is {onto['hover_name']!r}, wanted the alpha folder")

    from_point = aim(run, held, name_x(held), row_y(held, int(chosen["cursor_row"]) - 1))
    to_point = aim(run, held, name_x(held), row_y(held, 0))
    run.drive(
        f"move {from_point[0]:.1f} {from_point[1]:.1f}\nsleep 200\n"
        f"drag {from_point[0]:.1f} {from_point[1]:.1f} {to_point[0]:.1f} {to_point[1]:.1f}\n"
        "sleep 1000\nkey f12\nsleep 300\n"
    )
    landed = sorted(path.name for path in (fixture / "alpha").iterdir())
    for name in ("file-1.txt", "file-2.txt"):
        if name not in landed:
            raise Failure(f"{name} did not land in alpha: {landed}")
        if (fixture / name).exists():
            raise Failure(f"{name} is still where it was, so the drag copied rather than moved")
    # Nothing is left in flight on either side: the app has let go of what it
    # was carrying, and so has the display server.
    expect(run.state(), undo="true", dragging="false", drop_row="-1", drag_in="false", drag_out="false")

    # **One gesture, one undo.** This used to take back the last file and leave
    # the other, because a queue of N recorded N entries.
    run.drive("key ctrl+z\nsleep 1500\nkey f12\nsleep 400\n")
    expect(run.state(), undo="false")
    for name in ("file-1.txt", "file-2.txt"):
        if not (fixture / name).is_file():
            raise Failure(f"undo did not bring {name} back")


@scenario("dragging-files-into-another-pane", fresh=True)
def dragging_between_panes(run: Run, fixture: Path) -> None:
    """Pick a file up on the left, drop it on the right pane's empty space.

    The gesture a split exists for. Inside one pane a drop still needs a folder
    to aim at — dropping files back where they came from would be a move to
    where they already are — so what makes this work is that the *other* pane's
    list is itself a target, marked with a ring rather than a row highlight.
    """
    listed(run)
    # The right pane, showing `alpha`, opened from the row itself so the two
    # panes are showing different directories without a path being typed.
    run.drive("text alpha\n")
    until(run, cursor="alpha")
    run.drive("key shift+enter\n")
    split = until(run, panes="2", pane_focus="0")
    if split["pane_paths"] != f"{Path(split['path']).name},alpha":
        raise Failure(f"the panes are showing {split['pane_paths']!r}")

    # One file, chosen with the keyboard, in the pane that still has it. The
    # sleep is the type-ahead window: a second `text` inside a second of the
    # first extends the buffer rather than starting a new jump.
    run.drive("sleep 1100\ntext file-1.txt\n")
    chosen = until(run, selected="1", cursor="file-1.txt")
    held = point_at(run, int(chosen["cursor_row"]))
    if held["hover_name"] != "file-1.txt":
        raise Failure(f"the pointer is over {held['hover_name']!r}, wanted file-1.txt")

    # Low in the right pane's list, which is empty space: `alpha` holds two
    # entries and they are drawn at the top.
    x, y, width, height = (float(part) for part in held["pane_body"].split(",")[1].split(":"))
    from_point = aim(run, held, name_x(held), row_y(held, int(chosen["cursor_row"])))
    to_point = aim(run, held, x + width / 2.0, y + height - 24.0)
    run.drive(
        f"move {from_point[0]:.1f} {from_point[1]:.1f}\nsleep 200\n"
        f"drag {from_point[0]:.1f} {from_point[1]:.1f} {to_point[0]:.1f} {to_point[1]:.1f}\n"
    )
    until(run, undo="true", dragging="false")
    if not (fixture / "alpha" / "file-1.txt").is_file():
        landed = sorted(path.name for path in (fixture / "alpha").iterdir())
        raise Failure(f"file-1.txt did not land in alpha: {landed}")
    if (fixture / "file-1.txt").exists():
        raise Failure("file-1.txt is still where it was, so the drop copied rather than moved")
    expect(run.state(), drag_in="false", drag_out="false")

    run.drive("key ctrl+z\n")
    until(run, undo="false")
    settled(run)
    if not (fixture / "file-1.txt").is_file():
        raise Failure("undo did not bring file-1.txt back")


@scenario("an-alt-drag-asks-where-it-lands", fresh=True)
def an_alt_drag_asks(run: Run, fixture: Path) -> None:
    """`Alt` held across a drag opens a menu at the drop instead of moving.

    **A modifier, not the other button.** GTK's convention: plain moves, `Ctrl`
    copies, `Alt` asks. The answer here is Link, the one verb no modifier gives,
    chosen with the pointer — and the original stays where it was, because a
    link consumes nothing, and `Ctrl+Z` takes the link back.
    """
    listed(run)
    run.drive("text alpha\n")
    until(run, cursor="alpha")
    run.drive("key shift+enter\n")
    until(run, panes="2", pane_focus="0")
    run.drive("sleep 1100\ntext file-1.txt\n")
    chosen = until(run, selected="1", cursor="file-1.txt")
    held = point_at(run, int(chosen["cursor_row"]))
    x, y, width, height = (float(part) for part in held["pane_body"].split(",")[1].split(":"))
    from_point = aim(run, held, name_x(held), row_y(held, int(chosen["cursor_row"])))
    to_point = aim(run, held, x + width / 2.0, y + height - 24.0)
    run.drive(
        f"move {from_point[0]:.1f} {from_point[1]:.1f}\nsleep 200\nhold alt\nsleep 100\n"
        f"drag {from_point[0]:.1f} {from_point[1]:.1f} {to_point[0]:.1f} {to_point[1]:.1f}\n"
        "sleep 100\nlet-go alt\n"
    )
    asked = holds(run, lambda it: bool(it.get("menu_aim")), "the question a drop asks")
    for wanted in ("drop.move", "drop.copy", "drop.link", "drop.cancel"):
        if wanted not in asked["menu_aim"]:
            raise Failure(f"{wanted} is not on the drop's menu: {asked['menu_aim']!r}")
    expect(asked, undo="false", dragging="false")
    if (fixture / "alpha" / "file-1.txt").exists(follow_symlinks=False):
        raise Failure("the drop did something before it was answered")

    aimed = menu_aim(run, asked, "drop.link")
    run.drive(f"move {aimed[0]:.2f} {aimed[1]:.2f}\nclick left\n")
    until(run, undo="true", menu="0")
    link = fixture / "alpha" / "file-1.txt"
    if not link.is_symlink() or link.resolve() != (fixture / "file-1.txt").resolve():
        raise Failure(f"alpha/file-1.txt is not a link to the original: {link.exists()=}")
    if not (fixture / "file-1.txt").is_file():
        raise Failure("the original went, so the drop moved rather than linked")

    run.drive("key ctrl+z\n")
    until(run, undo="false")
    settled(run)
    if link.exists(follow_symlinks=False):
        raise Failure("undo left the link behind")


def creep(frm: tuple[float, float], to: tuple[float, float], steps: int = 8) -> str:
    """Driver lines that walk the pointer from one point to another.

    **A drag is a sequence of motions, not a jump.** `skerry-drive`'s own `drag`
    sends eight for the same reason: once a drag has begun the compositor owns
    the pointer, and a single warp to the far side arrives as nothing at all —
    which reads as a target that never updated rather than as a motion that was
    never sent.
    """
    lines = []
    for step in range(1, steps + 1):
        at = step / steps
        lines.append(f"move {frm[0] + (to[0] - frm[0]) * at:.1f} {frm[1] + (to[1] - frm[1]) * at:.1f}")
        lines.append("sleep 40")
    return "\n".join(lines) + "\n"


@scenario("a-pane-under-a-drag-is-ringed-and-its-own-pane-is-not", fresh=True)
def the_drop_ring(run: Run, fixture: Path) -> None:
    """What the frame promises before the button comes up, in both panes.

    The ring is the only thing that says a drop into empty space will do
    anything, and the pane the drag started in must not draw one — there it
    would promise a move to where the files already are.
    """
    listed(run)
    run.drive("text alpha\nsleep 500\nkey f12\nsleep 200\n")
    expect(run.state(), cursor="alpha")
    run.drive("key shift+enter\nsleep 900\nkey f12\nsleep 300\n")
    expect(run.state(), panes="2", pane_focus="0")
    run.drive("text file-1.txt\nsleep 400\nkey f12\nsleep 200\n")
    chosen = run.state()
    held = point_at(run, int(chosen["cursor_row"]))
    left = [float(part) for part in held["pane_body"].split(",")[0].split(":")]
    right = [float(part) for part in held["pane_body"].split(",")[1].split(":")]

    from_point = aim(run, held, name_x(held), row_y(held, int(chosen["cursor_row"])))
    over_right = aim(run, held, right[0] + right[2] / 2.0, right[1] + right[3] - 24.0)
    over_left = aim(run, held, left[0] + left[2] / 2.0, left[1] + left[3] - 24.0)
    run.drive(
        f"move {from_point[0]:.1f} {from_point[1]:.1f}\nsleep 200\npress\nsleep 150\n"
        + creep(from_point, over_right)
        + "sleep 350\nkey f12\nsleep 250\n"
    )
    expect(run.state(), dragging="true", drop_whole="1", drop_leaf="1", drop_row="-1")
    run.drive(creep(over_right, over_left) + "sleep 350\nkey f12\nsleep 250\n")
    over_its_own = run.state()
    expect(over_its_own, dragging="true", drop_whole="0", drop_leaf="-1")
    run.drive("release\nsleep 600\nkey f12\nsleep 250\n")
    expect(run.state(), dragging="false")
    if (fixture / "alpha" / "file-1.txt").exists():
