#!/usr/bin/env python3
"""End-to-end tests that drive the real window with real input.

Every other test in this repository stops at the edge of `sk-plat`. These press
keys and move a pointer through a compositor, so what they cover is the whole
path: `wl_keyboard`, `xkbcommon`, the click counter, the scroll coalescer, the
command registry, hit-testing, and the frame loop that has to wake up for any of
it to be seen.

    tools/gui-test                 # run every scenario
    tools/gui-test --keep          # leave the fixture and the log behind
    tools/gui-test --scale=1.25    # nest the compositor at a fractional scale
    tools/gui-test selection       # run the scenarios whose name matches

**It needs a nested compositor and refuses to run without one.** Synthetic input
goes wherever the focus is, so pointing this at a live session would type into
whatever window a person had open. It starts its own Hyprland — the only
compositor on this machine that advertises `zwp_virtual_keyboard_manager_v1` and
`zwlr_virtual_pointer_manager_v1`; KWin advertises neither, which is why the
portability answer for KWin still has to come from running the product there by
hand.

Assertions read the `skerry-state` line that `F12` prints, which carries the
layout geometry so a scenario can click an exact row rather than agreeing with a
copy of the metrics it is testing.
"""

from __future__ import annotations

import contextlib
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SKERRY = ROOT / "target" / "release" / "skerry"
DRIVE = ROOT / "target" / "release" / "skerry-drive"

# How long to wait for a socket, a window, or a directory read.
PATIENCE = 20.0


class Failure(Exception):
    pass


class Skipped(Exception):
    """The scenario needs something this machine does not have."""


# --------------------------------------------------------------------------
# The nested compositor
# --------------------------------------------------------------------------


def sockets() -> set[str]:
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", "/run/user/1000"))
    return {p.name for p in runtime.glob("wayland-*") if p.name.count("-") == 1}


def instances() -> set[str]:
    """The Hyprland instances that exist, by signature.

    A nested compositor gets its own, and `hyprctl` needs it to talk to that one
    rather than to the session the tests must not touch.
    """
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", "/run/user/1000")) / "hypr"
    return {p.name for p in runtime.glob("*")} if runtime.is_dir() else set()


def start_compositor(work: Path, scale: str = "1") -> tuple[subprocess.Popen, str, str]:
    config = work / "hypr.conf"
    config.write_text(
        # No bars, no animations, no rounding: the window under test should be
        # the only thing on this output, and a frame should be what it drew.
        #
        # The scale is an argument because `--scale` exists: a fractional one is
        # the only way to tell whether the program reads the compositor's scale
        # or assumes 100%, and at 1 that assertion cannot fail.
        f"monitor = , 1600x1000@60, 0x0, {scale}\n"
        "animations { enabled = false }\n"
        "decoration { blur { enabled = false } rounding = 0 shadow { enabled = false } }\n"
        "general { border_size = 0, gaps_in = 0, gaps_out = 0 }\n"
        "misc {\n"
        "    disable_hyprland_logo = true\n"
        "    disable_splash_rendering = true\n"
        "    force_default_wallpaper = 0\n"
        "    middle_click_paste = true\n"
        "}\n"
    )
    # Leaks are cumulative and silent until the inotify limit is reached, so a
    # run that starts with a crowd says so rather than adding to it. Counted by
    # *process*: an instance directory outlives the compositor that made it, so
    # counting those reports a crowd of ghosts.
    already = subprocess.run(
        ["pgrep", "-c", "-x", "Hyprland"], capture_output=True, text=True
    ).stdout.strip()
    if already.isdigit() and int(already) > 3:
        print(f"  warn  {already} Hyprland processes are running; something is leaking them")
    before, before_instances = sockets(), instances()
    process = subprocess.Popen(
        ["Hyprland", "--config", str(config)],
        stdout=(work / "compositor.log").open("w"),
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    deadline = time.time() + PATIENCE
    while time.time() < deadline:
        new = sockets() - before
        if new:
            time.sleep(1.5)
            fresh = instances() - before_instances
            return process, sorted(new)[0], (sorted(fresh)[0] if fresh else "")
        if process.poll() is not None:
            raise Failure("the nested compositor exited; see compositor.log")
        time.sleep(0.2)
    raise Failure("the nested compositor never created a socket")


def stop_compositor(process: subprocess.Popen | None, config: Path) -> None:
    """Ends the nested compositor, and **waits to see that it ended**.

    A `SIGTERM` and no wait is what left seventy-eight of these running over one
    night's work. Each holds inotify instances, and the per-user limit is 128 —
    so the thing that broke first was not the compositor, it was `sk-fs`'s own
    unit tests failing with `Too many open files` in a suite that had not
    changed. The group is signalled, waited for, and killed outright if it is
    still there.
    """
    if process is not None and process.poll() is None:
        group = os.getpgid(process.pid)
        os.killpg(group, signal.SIGTERM)
        try:
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            os.killpg(group, signal.SIGKILL)
            try:
                process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                pass

    # **And then by config path.** Hyprland re-executes itself into a new session
    # of its own, so the process this started is a launcher that exits and the
    # compositor is re-parented to init with a process group `killpg` cannot
    # reach. The config path names *this* run's compositor and no other, which is
    # what makes it safe to signal by pattern — the session's own Hyprland has no
    # `--config` under a temporary directory.
    for _ in range(20):
        found = subprocess.run(
            ["pgrep", "-f", f"Hyprland --config {config}"], capture_output=True, text=True
        ).stdout.split()
        if not found:
            return
        for pid in found:
            with contextlib.suppress(ProcessLookupError, ValueError):
                os.kill(int(pid), signal.SIGKILL)
        time.sleep(0.1)
    print("  warn  the nested compositor would not die; kill it by hand")


# --------------------------------------------------------------------------
# One scenario
# --------------------------------------------------------------------------


class Run:
    """A window, and the state it reported."""

    def __init__(
        self,
        display: str,
        work: Path,
        path: Path,
        arguments: list[str],
        instance: str = "",
        environment: dict | None = None,
        wrap: list[str] | None = None,
    ):
        self.instance = instance
        self.log = work / "app.log"
        self.err = work / "app.err"
        environment = dict(os.environ, **(environment or {}), WAYLAND_DISPLAY=display)
        self.process = subprocess.Popen(
            [*(wrap or []), str(SKERRY), *arguments, str(path)],
            stdout=self.log.open("w"),
            stderr=self.err.open("w"),
            env=environment,
            start_new_session=True,
        )
        self.display = display
        # Wait for the first frame, which the program announces.
        deadline = time.time() + PATIENCE
        while time.time() < deadline:
            if "first frame" in self.err.read_text():
                return
            if self.process.poll() is not None:
                raise Failure(f"the window exited: {self.err.read_text()[:400]}")
            time.sleep(0.1)
        raise Failure("the window never drew a first frame")

    def drive(self, script: str) -> None:
        environment = dict(os.environ, WAYLAND_DISPLAY=self.display)
        done = subprocess.run(
            [str(DRIVE)], input=script, text=True, env=environment, capture_output=True
        )
        if done.returncode != 0:
            raise Failure(f"the driver refused the script: {done.stderr.strip()}")

    def states(self) -> list[dict[str, str]]:
        found = []
        for line in self.log.read_text().splitlines():
            if not line.startswith("skerry-state "):
                continue
            pairs = re.findall(r'(\w+)=("(?:[^"\\]|\\.)*"|\S+)', line)
            # **Unique keys, checked here.** A second `cursor=` on the line — one
            # the listing writes and one the chrome writes — is silently the last
            # one to a dict, and every scenario asserting about the first then
            # fails with a value from somewhere else entirely.
            names = [name for name, _ in pairs]
            repeated = sorted({name for name in names if names.count(name) > 1})
            if repeated:
                raise Failure(f"the diagnostic line reports {', '.join(repeated)} twice")
            found.append({k: v.strip('"') for k, v in pairs})
        return found

    def state(self, index: int = -1) -> dict[str, str]:
        found = self.states()
        if not found:
            raise Failure("the window reported no state at all")
        return found[index]

    def make_floating(self) -> None:
        """Take the window out of the tiling layout.

        Hyprland tiles by default and reports a tiled window as `maximized`,
        which is honest — a tiled window has no free edges and nothing to
        maximise. The frame scenarios need a window that does.
        """
        subprocess.run(
            ["hyprctl", "dispatch", "setfloating", "class:dev.skerry.Skerry"],
            env=dict(os.environ, HYPRLAND_INSTANCE_SIGNATURE=self.instance),
            capture_output=True,
        )
        time.sleep(0.4)

    def ask_to_close(self) -> int:
        """Has the compositor ask the window to close, the way a person would.

        Not a signal. A signal skips every destructor, and the one time this ran
        for real it turned up a segmentation fault on the way out that a week of
        signal-killed tests had hidden.
        """
        if not self.instance:
            raise Failure("no compositor instance to ask")
        subprocess.run(
            ["hyprctl", "dispatch", "closewindow", "class:dev.skerry.Skerry"],
            env=dict(os.environ, HYPRLAND_INSTANCE_SIGNATURE=self.instance),
            capture_output=True,
        )
        try:
            return self.process.wait(timeout=10)
        except subprocess.TimeoutExpired:
            raise Failure("the window ignored a close request") from None

    def close(self) -> None:
        if self.process.poll() is None:
            os.killpg(os.getpgid(self.process.pid), signal.SIGTERM)
            try:
                self.process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                os.killpg(os.getpgid(self.process.pid), signal.SIGKILL)


def row_y(state: dict[str, str], row: int) -> float:
    """The vertical centre of a display row, as a percentage of the window."""
    top = float(state["body_top"]) + float(state["row_h"]) * row + float(state["row_h"]) / 2
    top -= float(state["scroll"])
    height = float(state["logical"].split("x")[1])
    return top / height * 100.0


def name_x(state: dict[str, str]) -> float:
    """A horizontal position inside the name column."""
    width = float(state["logical"].split("x")[0])
    return (float(state["name_x"]) + 30.0) / width * 100.0


def window_box(run: Run) -> tuple[int, int, int, int]:
    """Where the window is on the output, from the compositor itself."""
    clients = subprocess.run(
        ["hyprctl", "-j", "clients"],
        env=dict(os.environ, HYPRLAND_INSTANCE_SIGNATURE=run.instance),
        capture_output=True,
        text=True,
    )
    window = next(
        (c for c in json.loads(clients.stdout) if c.get("class") == "dev.skerry.Skerry"),
        None,
    )
    if window is None:
        raise Failure("the compositor does not know about the window")
    (left, top), (width, height) = window["at"], window["size"]
    return left, top, width, height


def output_size(run: Run) -> tuple[int, int]:
    monitors = subprocess.run(
        ["hyprctl", "-j", "monitors"],
        env=dict(os.environ, HYPRLAND_INSTANCE_SIGNATURE=run.instance),
        capture_output=True,
        text=True,
    )
    first = json.loads(monitors.stdout)[0]
    return first["width"], first["height"]


def output_scale(run: Run) -> float:
    """What the compositor says its scale is.

    Asked rather than assumed, so the assertion is about the program agreeing
    with the compositor and not about a number written into a test.
    """
    monitors = subprocess.run(
        ["hyprctl", "-j", "monitors"],
        env=dict(os.environ, HYPRLAND_INSTANCE_SIGNATURE=run.instance),
        capture_output=True,
        text=True,
    )
    return float(json.loads(monitors.stdout)[0]["scale"])


def aim(run: Run, state: dict[str, str], x: float, y: float) -> tuple[float, float]:
    """A point inside the window, as the percentages the driver takes.

    The driver moves a *virtual pointer*, which is in output coordinates; every
    coordinate the program reports is in window coordinates. Asking the
    compositor where the window is turns the guess into arithmetic — `point_at`
    still nudges, because a row is a target with a known name to check against
    and a title bar is not.
    """
    left, top, width, height = window_box(run)
    logical = [float(value) for value in state["logical"].split("x")]
    across, down = output_size(run)
    scale = (width / logical[0], height / logical[1])
    return (
        (left + x * scale[0]) / across * 100.0,
        (top + y * scale[1]) / down * 100.0,
    )


def photograph(run: Run, state: dict[str, str], into: Path, cell: str = "") -> "object":
    """What the compositor has, cropped to the list body or to one column of it.

    Everything else on the window changes between two otherwise identical
    frames — the status line carries frame timings — so the crop is the part
    that is supposed to be a function of the directory and nothing else. Pass
    `cell="size"` for the size column of the first row alone.
    """
    from PIL import Image

    clients = subprocess.run(
        ["hyprctl", "-j", "clients"],
        env=dict(os.environ, HYPRLAND_INSTANCE_SIGNATURE=run.instance),
        capture_output=True,
        text=True,
    )
    window = next(
        (c for c in json.loads(clients.stdout) if c.get("class") == "dev.skerry.Skerry"),
        None,
    )
    if window is None:
        raise Failure("the compositor does not know about the window")
    (left, top), (width, height) = window["at"], window["size"]
    shot = into.parent / f"{into.stem}-full.png"
    subprocess.run(
        ["grim", "-g", f"{left},{top} {width}x{height}", str(shot)],
        env=dict(os.environ, WAYLAND_DISPLAY=run.display),
        capture_output=True,
        check=True,
    )
    image = Image.open(shot).convert("RGB")
    # `grim` writes device pixels and the state line is in logical ones.
    scale = image.width / float(state["logical"].split("x")[0])
    body_top = float(state["body_top"]) * scale
    if cell == "size":
        crop = (
            round(float(state["size_x"]) * scale),
            round(body_top),
            round((float(state["size_x"]) + float(state["size_w"])) * scale),
            round(body_top + float(state["row_h"]) * scale),
        )
    else:
        crop = (0, round(body_top), image.width, round(body_top + float(state["body_height"]) * scale))
    part = image.crop(crop)
    part.save(into)
    return part


def ink(image: "object") -> int:
    """How many pixels are not the background colour.

    A dash is one short stroke and a size is six glyphs, so this separates them
    by an order of magnitude without knowing anything about either.
    """
    background = image.getpixel((0, 0))
    return sum(1 for pixel in image.convert("RGB").getdata() if pixel != background)


def differing_pixels(left: "object", right: "object") -> int:
    from PIL import ImageChops

    if left.size != right.size:
        raise Failure(f"the window changed size: {left.size} then {right.size}")
    difference = ImageChops.difference(left, right)
    if difference.getbbox() is None:
        return 0
    return sum(sum(band.histogram()[1:]) for band in difference.split())


def expect(state: dict[str, str], **wanted) -> None:
    for key, value in wanted.items():
        actual = state.get(key)
        if str(actual) != str(value):
            raise Failure(f"{key} is {actual!r}, wanted {value!r}")


# --------------------------------------------------------------------------
# The scenarios
# --------------------------------------------------------------------------


def clipboard(run: Run, mime: str = "text/plain;charset=utf-8") -> str:
    """What the compositor's clipboard holds, read by a real Wayland client.

    `wl-paste` rather than the window's own report: the point of a clipboard is
    that another application can read it, and a scenario that asked the window
    what it thinks it offered would pass with the data source never bound.
    """
    if not shutil.which("wl-paste"):
        raise Skipped("wl-clipboard is not installed")
    done = subprocess.run(
        ["wl-paste", "--no-newline", "--type", mime],
        env=dict(os.environ, WAYLAND_DISPLAY=run.display),
        capture_output=True,
        text=True,
        timeout=10,
    )
    if done.returncode != 0:
        raise Failure(f"wl-paste refused: {done.stderr.strip()}")
    return done.stdout


def make_fixture(root: Path, name: str = "fixture") -> Path:
    fixture = root / name
    shutil.rmtree(fixture, ignore_errors=True)
    for folder in ("alpha", "beta", "gamma"):
        (fixture / folder).mkdir(parents=True)
        (fixture / folder / "inner.txt").write_text("x" * 10)
    (fixture / "alpha" / "nested").mkdir()
    (fixture / "alpha" / "nested" / "deep.txt").write_text("y" * 20)
    for index in range(1, 7):
        (fixture / f"file-{index}.txt").write_text("z" * (index * 100))
    (fixture / ".hidden").write_text("secret")
    return fixture


SCENARIOS = {}


def scenario(name, fresh: bool = False):
    """Registers a scenario.

    `fresh` gives it a fixture of its own and an `XDG_DATA_HOME` of its own —
    both required of anything that changes the directory it is looking at, since
    every other scenario counts the rows in the shared one, and since the Trash
    a test fills must not be the Trash the person running it has.
    """

    def register(function):
        function.fresh = fresh
        SCENARIOS[name] = function
        return function

    return register


@scenario("keyboard-cursor")
def keyboard_cursor(run: Run, fixture: Path) -> None:
    run.drive("sleep 400\nkey f12\nkey down\nkey down\nkey f12\nkey up\nkey f12\nsleep 300\n")
    first, second, third = run.states()[:3]
    expect(first, rows="9", cursor="", selected="0")
    expect(second, cursor="beta", selected="1")
    expect(third, cursor="alpha", selected="1")


@scenario("keyboard-navigate")
def keyboard_navigate(run: Run, fixture: Path) -> None:
    run.drive(
        "sleep 400\n"
        "key down\n"          # alpha
        "key enter\n"         # into it
        "sleep 600\n"
        "key f12\n"
        "key backspace\n"     # and back out
        "sleep 600\n"
        "key f12\n"
        "sleep 200\n"
    )
    inside, outside = run.states()[:2]
    expect(inside, path=str(fixture / "alpha"), rows="2")
    expect(outside, path=str(fixture), cursor="alpha")


@scenario("keyboard-back-forward")
def keyboard_back_forward(run: Run, fixture: Path) -> None:
    run.drive(
        "sleep 400\nkey down\nkey enter\nsleep 500\n"
        "key alt+left\nsleep 500\nkey f12\n"
        "key alt+right\nsleep 500\nkey f12\nsleep 200\n"
    )
    back, forward = run.states()[:2]
    expect(back, path=str(fixture))
    expect(forward, path=str(fixture / "alpha"))


@scenario("keyboard-extend-selection")
def keyboard_extend_selection(run: Run, fixture: Path) -> None:
    """Shift and an arrow, which is the only Shift chord the program binds.

    Its own scenario because nothing else here holds a modifier that the
    *compositor* has to report rather than the key event carrying: a driver whose
    Shift never arrives would pass every other scenario in this file.
    """
    run.drive(
        "sleep 500\nkey down\nkey shift+down\nkey shift+down\nsleep 250\nkey f12\nsleep 200\n"
    )
    expect(run.state(), selected="3", cursor="gamma")


@scenario("hidden-and-sort")
def hidden_and_sort(run: Run, fixture: Path) -> None:
    run.drive(
        "sleep 400\nkey f12\n"
        "key ctrl+h\nsleep 200\nkey f12\n"
        "key alt+2\nsleep 300\nkey f12\n"
        "key alt+2\nsleep 300\nkey f12\nsleep 200\n"
    )
    plain, hidden, by_size, reversed_ = run.states()[:4]
    expect(plain, rows="9", hidden="false", sort="Name", descending="false")
    expect(hidden, rows="10", hidden="true")
    expect(by_size, sort="Size", descending="false")
    expect(reversed_, sort="Size", descending="true")


def point_at(run: Run, row: int) -> dict[str, str]:
    """Puts the pointer on a display row and returns the state it produced.

    Asserted through `hover` rather than trusted: the pointer's coordinates are
    over the *output* and the window's are over the window, and under a nested
    compositor those differ by whatever the frame around it costs. Reading back
    what the program thinks it is pointing at removes the guess — and is the only
    honest way for a test to know it clicked what it meant to.
    """
    start = run.state()
    x = name_x(start)
    for attempt in range(6):
        # Correct for the offset between the output and the window by nudging
        # half a row per attempt until `hover` agrees.
        nudge = 0.0 if attempt == 0 else float(start["row_h"]) / 2 * attempt
        height = float(start["logical"].split("x")[1])
        y = row_y(start, row) + (nudge / height * 100.0) * (1 if attempt % 2 else -1)
        run.drive(f"move {x:.1f} {y:.1f}\nsleep 120\nkey f12\nsleep 120\n")
        state = run.state()
        if state["hover"] == str(row):
            return state
    raise Failure(
        f"could not put the pointer on row {row}; it landed on {run.state()['hover']}"
    )


@scenario("pointer-click")
def pointer_click(run: Run, fixture: Path) -> None:
    run.drive("sleep 400\nkey f12\nsleep 100\n")
    pointing = point_at(run, 2)
    wanted = pointing["hover_name"]
    run.drive("click\nsleep 250\nkey f12\nsleep 200\n")
    expect(run.state(), cursor=wanted, selected="1")


@scenario("pointer-double-click")
def pointer_double_click(run: Run, fixture: Path) -> None:
    run.drive("sleep 400\nkey f12\nsleep 100\n")
    pointing = point_at(run, 0)
    folder = pointing["hover_name"]
    run.drive("double\nsleep 800\nkey f12\nsleep 200\n")
    expect(run.state(), path=str(fixture / folder))


@scenario("double-click-a-file")
def double_click_a_file(run: Run, fixture: Path) -> None:
    """A double click on a document has to reach the launcher.

    It used to be guarded on `Flags::DIR` and to call the pane's `open_focused`,
    which enters directories and returns false for everything else — so double
    clicking a `.txt` did nothing at all, with no notice and no error, while
    `Enter` on the same row opened it. The window here is started with the XDG
    data directories pointed at nothing, so the launcher finds no handler and
    says so instead of starting a text editor inside the test compositor.
    """
    run.close()
    empty = run.log.parent / "no-handlers"
    empty.mkdir(exist_ok=True)
    own = Run(
        run.display,
        run.log.parent,
        fixture,
        [],
        run.instance,
        {"XDG_DATA_HOME": str(empty), "XDG_DATA_DIRS": str(empty)},
    )
    try:
        own.drive("sleep 400\nkey f12\nsleep 100\n")
        pointing = point_at(own, 3)
        if not pointing["hover_name"].endswith(".txt"):
            raise Failure(f"row 3 is {pointing['hover_name']!r}, which is not a document")
        own.drive("double\nsleep 600\nkey f12\nsleep 200\n")
        state = own.state()
        if not state.get("notice"):
            raise Failure("double clicking a document did nothing and said nothing")
        expect(state, path=str(fixture))
    finally:
        own.close()


@scenario("pointer-rubber-band")
def pointer_rubber_band(run: Run, fixture: Path) -> None:
    run.drive("sleep 400\nkey f12\nsleep 100\n")
    # Calibrate on a real row, then band upward from the empty space below the
    # last one.
    pointing = point_at(run, 1)
    top = float(pointing["body_top"])
    height = float(pointing["logical"].split("x")[1])
    row_h = float(pointing["row_h"])
    rows = int(pointing["rows"])
    empty = (top + row_h * (rows + 1)) / height * 100.0
    across = (top + row_h * 1.5) / height * 100.0
    if empty >= 99.0:
        raise Failure("the window has no empty space below the last row to band from")
    run.drive(f"drag 60 {empty:.1f} 60 {across:.1f}\nsleep 400\nkey f12\nsleep 200\n")
    banded = run.state()
    if int(banded["selected"]) < 2:
        raise Failure(f"a rubber band across several rows selected {banded['selected']}")


@scenario("pointer-scroll", fresh=True)
def pointer_scroll(run: Run, fixture: Path) -> None:
    """A wheel notch scrolls the list.

    **Its own fixture, filled until there is somewhere to scroll to.** This used
    to run against the shared nine-row fixture and return early because the
    content was shorter than the window — so it passed without asserting
    anything, for as long as it existed, while `skerry-drive` sent a scroll the
    compositor translated to a delta of zero. A test that can only pass has
    measured nothing; see docs/12-measurement.md.
    """
    run.drive("sleep 400\nkey f12\nsleep 100\n")
    start = run.state()
    for index in range(200):
        (fixture / f"filler-{index:03}.txt").write_text("x")
    # inotify, rather than a reload: the rows have to arrive by themselves for
    # the assertion below to be about scrolling and not about `F5`.
    for _ in range(40):
        run.drive("sleep 150\nkey f12\nsleep 50\n")
        filled = run.state()
        if int(filled["rows"]) > 200:
            break
    else:
        raise Failure(f"the filler files never arrived: {filled['rows']} rows")
    content = int(filled["rows"]) * float(filled["row_h"])
    if content <= float(filled["body_height"]):
        raise Failure(f"{filled['rows']} rows still fit in {filled['body_height']}")

    run.drive("move 50 50\nsleep 150\nscroll 5\nsleep 400\nkey f12\nsleep 200\n")
    after = run.state()
    if float(after["scroll"]) <= float(start["scroll"]):
        raise Failure(f"a wheel scroll moved nothing: {after['scroll']}")
    # And back up again, because a scroll that only goes one way is half tested.
    run.drive("move 50 50\nsleep 150\nscroll -5\nsleep 400\nkey f12\nsleep 200\n")
    if float(run.state()["scroll"]) >= float(after["scroll"]):
        raise Failure("scrolling up moved nothing")


