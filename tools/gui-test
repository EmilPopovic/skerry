@scenario("cursor-shapes")
def cursor_shapes(run: Run, fixture: Path) -> None:
    """Sweeps the pointer over every region that names a cursor shape.

    **The shape itself cannot be read back** — no compositor exposes it, and
    Hyprland does not even validate the serial, so an invalid request is not
    observable from here either. What this covers is the half that is: the sweep
    runs the same `cursor_at` hit-testing the shapes come from, the window
    survives it, and the two regions that *do* report — a breadcrumb and a window
    button — report the right thing at the coordinates the shape logic used.

    It needs a floating window, because a tiled one has no resize edges and the
    corner shapes are the interesting half.
    """
    run.close()
    own = Run(run.display, run.log.parent, fixture, ["--own-frame"], run.instance)
    try:
        own.make_floating()
        own.drive("sleep 400\nkey f12\nsleep 200\n")
        state = own.state()
        width, height = (float(v) for v in state["logical"].split("x"))
        if "cursor-shape" not in own.err.read_text():
            raise Failure("the compositor does not name cursor shapes; nothing to test")

        places = [
            (1.0, 1.0),                                  # top left corner
            (width - 1.0, 1.0),                          # top right corner
            (width / 2.0, 1.0),                          # top edge
            (1.0, height / 2.0),                         # left edge
            (width - 1.0, height - 1.0),                 # bottom right corner
            (float(state["parent_crumb_x"]), float(state["parent_crumb_y"])),
            (float(state["close_x"]), float(state["title_h"]) / 2.0),
            (float(state["size_x"]) + 4.0, float(state["body_top"]) - 8.0),
            (width / 2.0, float(state["body_top"]) + float(state["row_h"]) * 2.0),
        ]
        for logical_x, logical_y in places:
            x, y = aim(own, state, logical_x, logical_y)
            own.drive(f"move {x:.2f} {y:.2f}\nsleep 90\n")
        own.drive("sleep 300\nkey f12\nsleep 200\n")

        if own.process.poll() is not None:
            raise Failure(f"a cursor request killed the window: {own.err.read_text()[-300:]}")
        expect(own.state(), frame="own")

        # The one place the hit-testing behind the shapes is observable at this
        # size — a floating window here is 320x240, which is the toplevel's own
        # minimum, and its bar is too narrow for a breadcrumb to be a reliable
        # target. `breadcrumb-navigation` covers that one at full size.
        x, y = aim(own, state, float(state["close_x"]), float(state["title_h"]) / 2.0)
        own.drive(f"move {x:.2f} {y:.2f}\nsleep 200\nkey f12\nsleep 150\n")
        expect(own.state(), frame_hover="close")
        if "went away" in own.err.read_text():
            raise Failure(f"the connection died: {own.err.read_text()[-300:]}")
    finally:
        own.close()


@scenario("cursor-says-what-is-clickable", fresh=True)
def cursor_says_what_is_clickable(run: Run, fixture: Path) -> None:
    """A hand where a click does something, and an arrow where it does not.

    The shape itself cannot be read back from any compositor, so what is asserted
    is what the program asked for — which is the half that decides whether the
    interface agrees with itself. Two places got it wrong, and both are ones a
    person meets in the first minute: Back is dimmed until there is somewhere to
    go back to, and "Copy the text inside" is dimmed on a picture.
