@scenario("folder-sizes")
def folder_sizes(run: Run, fixture: Path) -> None:
    run.drive("sleep 1200\nkey f12\nsleep 200\n")
    state = run.state()
    known, running = state["sizes"].split("/")
    if int(known) < 3:
        raise Failure(f"only {known} of three folders were measured")
