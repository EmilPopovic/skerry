@scenario("folder-size-without-a-refresh")
def folder_size_without_a_refresh(run: Run, fixture: Path) -> None:
    """What is on screen once the walks land must equal what `F5` shows.

    The reported defect, and the only test here that looks at pixels. The size
    column is the one cell whose text changes underneath a fixed row of a fixed
    listing, and the layout cache used to key a shaped run by the row alone — so
    a folder drew the dash it was given before the walk reported and kept it.
    Refreshing was the workaround, because a new listing is a new set of keys,
    which is exactly the shape of the report: *it does not display the size
    until a refresh*.

    **It needs a subtree big enough to outlive the metadata.** The shared fixture
    does not reproduce it: three folders holding two files each are walked before
    the first `statx` batch comes back, so the size column's first draw already
    has a total in it and the dash is never shaped. Twenty thousand files take
    long enough that the dash is drawn, which is the whole bug.
    """
    if shutil.which("grim") is None:
        raise Skipped("grim is not installed")
    try:
        import PIL  # noqa: F401
    except ImportError:
        raise Skipped("Pillow is not installed") from None

    work = run.log.parent
    run.close()
    heavy = work / "heavy"
    if not heavy.is_dir():
        for bucket in range(20):
            folder = heavy / "subtree" / f"bucket-{bucket:02d}"
            folder.mkdir(parents=True)
            for index in range(1000):
                (folder / f"item-{index:04d}").write_bytes(b"." * (index % 16))

    own = Run(run.display, work, heavy, [], run.instance)
    try:
        own.drive("sleep 4000\nkey f12\nsleep 200\n")
        settled = own.state()
        known, running = settled["sizes"].split("/")
        if running != "0" or int(known) < 1:
            raise Failure(f"the walk never finished: {known} known, {running} running")

        # The model says it measured the subtree. The question this scenario
        # exists to ask is whether the window drew what the model knows, so the
        # answer has to come from the pixels: a dash is one short stroke and
        # "20.5 MB" is six glyphs.
        marks = ink(photograph(own, settled, work / "size-cell.png", cell="size"))
        if marks < 60:
            raise Failure(
                f"the size cell holds {marks} marks of ink, which is a dash — the total "
                "the walk reported was never drawn"
            )
    finally:
        own.close()



# --------------------------------------------------------------------------
# Making, naming and removing things — with the keyboard alone, then with the
# pointer alone. Both halves, because both were promised.
