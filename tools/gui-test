@scenario("everything-in-an-awkward-order", fresh=True)
def everything_in_an_awkward_order(run: Run, fixture: Path) -> None:
    """Every new surface, opened over every other one, and nothing may die.

    Not an assertion about behaviour — the scenarios above make those. This is
    the pass that says the combinations nobody designed for do not crash, hang
    or leave two fields with a caret in them, which is the class of defect a
    person finds in the first ten minutes and a per-feature test never does.
    """
    run.drive(
        "sleep 500\n"
        "key ctrl+l\nkey shift+f10\nsleep 200\n"      # menu over the path field
        "key escape\nkey escape\nsleep 150\n"
        "key ctrl+f\ntext al\nkey shift+f10\nsleep 200\n"   # menu over the filter
        "key escape\nkey escape\nsleep 150\n"
        "key ctrl+shift+n\nsleep 700\n"                # a folder, then abandon the name
        "key escape\nsleep 200\n"
        "key f2\nkey ctrl+l\nsleep 500\n"             # rename, then the path bar
        "key escape\nsleep 200\n"
        "key ctrl+z\nsleep 700\n"                      # take the folder back
        "key f1\nkey shift+f10\nsleep 200\n"          # a menu over the keyboard list
        "key escape\nkey f1\nsleep 150\n"
        "key end\nkey delete\nsleep 700\n"            # trash and redo
        "key ctrl+z\nsleep 700\nkey ctrl+shift+z\nsleep 700\n"
