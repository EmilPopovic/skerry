def sweep_stale_work() -> None:
    """Removes work directories a killed run left behind.

    **Because the limit that runs out is inodes, not bytes.** A run that is
    interrupted — a timeout, a `Ctrl+C`, a crash — never reaches the `finally` that
    removes its directory, and each one holds a fixture per scenario. A hundred and
    fourteen of them accumulated here and took 727,000 of `/tmp`'s million inodes;
    the next run failed with `No space left on device` on a tmpfs with twenty-six
    gigabytes free, which reads as a full disk and is not one.

    An hour old, so a run in progress in another terminal is never touched.
    """
    cutoff = time.time() - 3600
    gone = 0
    for stale in Path(tempfile.gettempdir()).glob("skerry-gui-*"):
        try:
            if stale.is_dir() and stale.stat().st_mtime < cutoff:
                shutil.rmtree(stale, ignore_errors=True)
                gone += 1
        except OSError:
            continue
    if gone:
        print(f"swept {gone} work director{'y' if gone == 1 else 'ies'} a killed run left behind")


@scenario("release-trash-restores-after-a-process-restart", fresh=True)
def release_trash_restore(run: Run, fixture: Path) -> None:
    listed(run)
    original = fixture / "file-1.txt"
    contents = original.read_bytes()
    run.drive("text file-1\nsleep 300\nkey delete\nsleep 300\n")
    settled(run)
    if original.exists():
        raise Failure("Move to Trash did not remove the original")
    trash = Path(run.environment["XDG_DATA_HOME"]) / "Trash" / "files"
    stored = next(trash.iterdir())
    run.close()
    run.__init__(run.display, run.work, trash, [], run.instance, run.environment)
    listed(run)
    run.drive("key home\nkey ctrl+alt+r\nsleep 300\n")
    settled(run)
    if not original.exists() or original.read_bytes() != contents or stored.exists():
        raise Failure("persistent Restore did not recover the original bytes")
    run.drive("key ctrl+z\nsleep 300\n")
    settled(run)
    if original.exists() or not stored.exists():
        raise Failure("undo of Restore did not return the item to Trash")


@scenario("release-qt-cut-clipboard-works-in-both-directions", fresh=True)
def release_qt_clipboard(run: Run, fixture: Path) -> None:
    listed(run)
    source = fixture / "qt source.txt"
    source.write_text("Qt cut payload")
    log = run.work / "qt-peer.log"
    process = subprocess.Popen([str(ROOT / "tools/qt-clipboard-peer"), str(source)],
        env={**run.environment, "QT_QPA_PLATFORM": "xcb" if isinstance(SERVER, X11Server) else "wayland"},
        stdout=log.open("w"), stderr=subprocess.STDOUT)
    def wait(word):
        until = time.monotonic() + 15
        while time.monotonic() < until:
            output = log.read_text()
            if word in output:
                return output
            if process.poll() is not None:
                raise Failure(f"Qt peer exited: {output}")
            time.sleep(0.1)
        raise Failure(f"Qt peer did not say {word}: {log.read_text()}")
    try:
        wait("ready")
        SERVER.focus("skerry-qt-peer")
        run.drive("sleep 300\nkey ctrl+x\nsleep 300\n", answering=False)
        wait("published")
        SERVER.focus("dev.skerry.Skerry")
        run.drive("sleep 300\nkey ctrl+l\nkey ctrl+u\n")
        run.drive(f"text {fixture / 'alpha'}\nkey enter\nsleep 300\n")
        listed(run)
        run.drive("key ctrl+v\nsleep 300\n")
        deadline = time.monotonic() + 15
        while time.monotonic() < deadline and source.exists():
            run.answered(settle=100)
        target = fixture / "alpha" / source.name
        if source.exists() or not target.exists() or target.read_text() != "Qt cut payload":
            raise Failure("KDE marker + Qt URI list did not paste as a move")
        run.drive("text qt source\nsleep 300\nkey ctrl+x\nsleep 300\n")
        SERVER.focus("skerry-qt-peer")
        run.drive("sleep 300\nkey ctrl+v\nsleep 300\n", answering=False)
        result = wait("received ")
        received = json.loads(next(line[9:] for line in result.splitlines() if line.startswith("received ")))
        if received != {"cut": "1", "paths": [str(target)]}:
            raise Failure(f"Qt decoded the wrong Skerry cut offer: {received}")
    finally:
        process.terminate()
        process.wait(timeout=5)
        SERVER.focus("dev.skerry.Skerry")


def main(argv: list[str]) -> int:
    wanted = [a for a in argv[1:] if not a.startswith("--")]
    keep = "--keep" in argv
    x11 = "--x11" in argv
    scale = "1"
    # Both ceilings are arguments so a person chasing a slow scenario can lower
    # them rather than sit through one, and so a runner with a tighter job limit
    # than this file assumes can say so.
    global SCENARIO_BUDGET, SUITE_BUDGET
    for argument in argv[1:]:
        if argument.startswith("--scale="):
            scale = argument.removeprefix("--scale=")
        elif argument.startswith("--scenario-timeout="):
            SCENARIO_BUDGET = float(argument.removeprefix("--scenario-timeout="))
        elif argument.startswith("--suite-timeout="):
            SUITE_BUDGET = float(argument.removeprefix("--suite-timeout="))

    # Built here, not assumed. See `build_binaries` for the afternoon this cost.
    if "--prebuilt" not in argv and (broken := build_binaries()):
        print(f"the workspace would not build:\n{broken}")
        return 2
    for binary in (SKERRY, DRIVE):
        if not binary.is_file():
            print(f"missing {binary}; run `cargo build --release` first")
            return 2


    # A needle that names nothing used to select nothing and exit 0, so a renamed
    # scenario left every invocation that asked for it by name green while running
    # none of it. It cost me ten minutes believing a filter test had passed.
    if unmatched := [n for n in wanted if not any(n in name for name in SCENARIOS)]:
        print(f"no scenario matches {', '.join(repr(n) for n in unmatched)}")
        return 2

    if len(SCENARIOS) < FEWEST_SCENARIOS:
        print(
            f"{len(SCENARIOS)} scenarios registered, against {FEWEST_SCENARIOS} recorded. "
            "One has been deleted; lower FEWEST_SCENARIOS if that was deliberate."
        )
        return 2

    sweep_stale_work()
    work = Path(tempfile.mkdtemp(prefix="skerry-gui-"))
    passed, failed = 0, []
    global SERVER
    SERVER = X11Server() if x11 else SwayServer() if "--sway" in argv else WaylandServer()
    try:
        SERVER.start(work, scale)
        display = SERVER.display
        instance = getattr(SERVER, "instance", "")
        kind = "Xvfb" if x11 else "nested compositor"
        print(f"{kind} on {display} at scale {scale}")
        fixture = make_fixture(work)
        global STATE, CACHE
        STATE = str(work / "state")
        CACHE = str(work / "cache")

        started = time.time()
        for name, function in SCENARIOS.items():
            if wanted and not any(needle in name for needle in wanted):
                continue
            left = SUITE_BUDGET - (time.time() - started)
            if left <= 0:
                print(f"  over  {name}: the sweep ran out of its {SUITE_BUDGET:.0f}s budget")
                failed.append(name)
                continue
            run, bus = None, None
            began = time.time()
            announce(name)
            try:
                own = getattr(function, "fresh", False)
                if isinstance(SERVER, SwayServer) and name in {
                    "a-pane-under-a-drag-is-ringed-and-its-own-pane-is-not",
                    "a-drag-held-over-a-folder-opens-it",
                    "passing-over-a-folder-does-not-open-it",
                    "a-drag-held-on-a-tab-switches-to-it",
                    "the-carried-card-follows-the-pointer",
                }:
                    raise Skipped("Sway's drag keyboard grab suppresses the in-progress F12 observation; covered on X11")
                path = make_fixture(work, f"fixture-{name}") if own else fixture
                data = work / "data" / name
                # See `STATE`: one session file per scenario, always, because the
                # settings in it are keyed by nothing a fixture isolates.
                STATE = str(work / "state" / name)
                environment = {"XDG_DATA_HOME": str(data)} if own else None
                if getattr(function, "bus", False):
                    if not shutil.which("dbus-daemon"):
                        raise Skipped("no dbus-daemon on this machine")
                    home = work / f"bus-{name}"
                    home.mkdir(parents=True, exist_ok=True)
                    bus = PrivateBus(home)
                    # **And the accessibility bus is the same one.** A real
                    # desktop has two daemons and the window finds the second
                    # through the first; a scenario has one, and the window takes
                    # `AT_SPI_BUS_ADDRESS` over asking — which is the variable
                    # at-spi itself defines for exactly this. ADR 0026.
                    environment = {
                        **(environment or {}),
                        "DBUS_SESSION_BUS_ADDRESS": bus.address,
                        "AT_SPI_BUS_ADDRESS": bus.address,
                    }
                with a_budget(min(SCENARIO_BUDGET, left)):
                    run = Run(display, work, path, [], instance, environment)
                    function(run, path)
                verdict(f"  ok    {name}", began)
                passed += 1
            except Skipped as why:
                verdict(f"  skip  {name}: {why}", began)
            except OutOfTime as overran:
                verdict(f"  FAIL  {name}: {overran}", began)
                failed.append(name)
            except Failure as problem:
                verdict(f"  FAIL  {name}: {problem}", began)
                failed.append(name)
            except Exception as crash:  # noqa: BLE001
                # **One scenario's crash is not the sweep's.** A `TimeoutExpired`
                # from a bounded subprocess, or a typo in a scenario, used to end
                # the run at whatever scenario it happened in and report nothing
                # about the ninety after it.
                # **With the line it happened on**, which a bare message does
                # not give: `could not convert string to float: ''` names neither
                # the field that was empty nor the read that assumed it was not,
                # and a scenario has a dozen of both.
                where = traceback.extract_tb(crash.__traceback__)[-1]
                verdict(
                    f"  FAIL  {name}: {type(crash).__name__}: {crash} "
                    f"(line {where.lineno}: {where.line})",
                    began,
                )
                failed.append(name)
            finally:
                if run is not None:
                    run.close()
                if bus is not None:
                    bus.stop()
                    bus = None
                # **A failure rebuilds the shared fixture.** A scenario that dies
                # between its mutation and its undo leaves the directory every
                # later scenario counts rows in one file short, and the sweep then
                # reports a dozen failures for one cause: a `grim` that timed out
                # once produced fourteen, of which one was real. Rebuilding costs
                # a few milliseconds and only on the way out of a failure.
                if name in failed:
                    evidence = work / "failures" / name
                    evidence.mkdir(parents=True, exist_ok=True)
                    for log in ("app.log", "app.err"):
                        if (work / log).exists():
                            shutil.copyfile(work / log, evidence / log)
                if name in failed and not own:
                    fixture = make_fixture(work)
    except Failure as problem:
        print(f"fixture: {problem}")
        return 1
    finally:
        SERVER.stop()
        if keep:
            print(f"left behind: {work}")
        else:
            shutil.rmtree(work, ignore_errors=True)

    print(f"\n{passed} passed, {len(failed)} failed")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
