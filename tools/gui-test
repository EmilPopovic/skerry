@scenario("a-double-click-in-a-preview-takes-a-word", fresh=True)
def double_click_in_a_preview(run: Run, fixture: Path) -> None:
    """**In a text preview too, and the third click takes the whole line.**

    The same two gestures a page's words already answered — so the claim here is
    that a file's own text answers them as well, and with the same rule: a word
    is the run of letters, digits and underscores under the pointer.

    **The line is one long word and a short one**, so the assertion is exact
    without measuring a font: wherever inside the first twenty characters the
    pointer landed, the run under it is the same word, and the line is longer
    than the word — which is what tells a double click from a triple.
    """
    lines = ["first line", "supercalifragilistic tail", "third and last"]
    (fixture / "notes.txt").write_text("\n".join(lines) + "\n")

    settled = listed(run)
    before = int(settled["rows"])
    run.drive("key f5\nsleep 400\n")
    holds(run, lambda it: int(it["rows"]) >= before + 1, f"more than {before} rows")
    run.drive("text notes\nsleep 400\n")
    until(run, cursor="notes.txt")
    run.drive("key space\nsleep 600\n")
    state = until_looking(run, "notes.txt", "text")

    # The middle of the second drawn line, left of its twentieth character at any
    # size this draws at — the same arithmetic the drag scenario aims by.
    inner = [float(v) for v in state["panel_area"].split(":")]
    row = float(state["row_h"])
    at = aim(run, state, inner[0] + 90.0, inner[1] + 34.0 + row * 1.5)

    run.drive(f"move {at[0]:.2f} {at[1]:.2f}\nsleep 250\ndouble\nsleep 400\nkey f12\nsleep 150\n")
    took = holds(run, lambda it: it["look_chosen"] != "none", "a selection")
    if took["look_chosen"] != "1:0-1:20":
        raise Failure(
            f"a double click on {lines[1]!r} selected {took['look_chosen']!r}, "
            "where the word ends at the space"
        )

    run.drive(f"move {at[0]:.2f} {at[1]:.2f}\nsleep 300\ntriple\nsleep 400\nkey f12\nsleep 150\n")
    # A selection that is not the double click's, and *then* the exact one — a
    # wait for the answer itself reports "it never happened" where an assertion
    # reports what happened instead, and the second is the useful failure.
    whole = holds(
        run,
        lambda it: it["look_chosen"] not in ("none", took["look_chosen"]),
        "a third selection",
    )
    if whole["look_chosen"] != f"1:0-1:{len(lines[1])}":
        raise Failure(f"a triple click selected {whole['look_chosen']!r}, where the line is 0-25")

    # And it is a real selection: `Ctrl+C` copies the line and nothing else.
    run.drive("key ctrl+c\nsleep 400\n")
    held = clipboard(run)
    if held != lines[1]:
        raise Failure(f"the clipboard holds {held!r} rather than the line")


@scenario("a-page-turn-does-not-move-the-picture", fresh=True)
def a_page_turn_does_not_move_the_picture(run: Run, fixture: Path) -> None:
    """**The draft and the finished render occupy the same rectangle.**

    A page is drafted at a third of the panel and then rendered at full size, and
    the draft is drawn scaled up to stand in for it — so the two agreeing to
    within a pixel is the whole of what makes a page turn look still rather than
    like something rescaling. Nothing had ever asserted it, and the report of it
    was that the placeholder is small and grows.

    `look_page_box` is where the page was *actually* drawn, reported by the frame
    that drew it, which is the only number that can answer this: the harness
    recomputing `fitted_box` would be a second copy of the arithmetic under test.
    """
    pages = 6
    (fixture / "book.pdf").write_bytes(many_page_pdf(pages))
    settled = listed(run)
    before = int(settled["rows"])
    run.drive("key f5\nsleep 400\n")
    holds(run, lambda it: int(it["rows"]) >= before + 1, f"more than {before} rows")
    run.drive("text book\nsleep 400\n")
    until(run, cursor="book.pdf")
    run.drive("key space\nsleep 200\n")

    finished = holds(
        run,
        lambda it: drawn_in_full(it) and it.get("look_page_box", "") != "",
        "the full render",
    )

    # **The render fits the box and touches one side of it.** `-scale-to` sets a
    # *page's* long edge, so a portrait page asked for a landscape box came back
    # 709×1004 for a box of 1004×590 — 2.9× the pixels, downscaled again on the
    # way to the screen, and on a panel past the child's ceiling it came back
    # *smaller* than the box, which is a page drawn at one to one inside a panel
    # it does not fill. Both are this one assertion.
    asked, got = shot_of(finished)
    if got[0] > asked[0] + 1 or got[1] > asked[1] + 1:
        raise Failure(f"the render {got} does not fit the box {asked} it was asked for")
    if got[0] < asked[0] - 1 and got[1] < asked[1] - 1:
        raise Failure(f"the render {got} touches neither side of {asked}: the panel has a margin")

    box = [float(it) for it in finished["look_page_box"].split(":")]

    # **And a turn does not move it.** Every page of this document is the same
    # size, so the rectangle after the turn is the rectangle before it — a page
    # that arrived at a different size would be the picture rescaling under
    # somebody reading it.
    run.drive("key down\nsleep 700\n")
    # **And its box, which is a third thing that lands.** The picture, the words
    # and the rectangle arrive on their own jobs; `look_page_box` is empty until
    # the *words* are in, so a wait for the picture alone read a state with no
    # box in it — and the box has to be there to be compared with.
    turned = holds(
        run,
        lambda it: it.get("look_page") == f"2/{pages}"
        and drawn_in_full(it)
        and it.get("look_page_box", "") != "",
        "page two, fully rendered, with its box",
    )
    after = [float(it) for it in turned["look_page_box"].split(":")]
    moved = max(abs(a - b) for a, b in zip(box, after))
    if moved > 2.0:
        raise Failure(
            f"turning the page moved the picture {moved:.1f} logical pixels: "
            f"{finished['look_page_box']} then {turned['look_page_box']}"
        )


@scenario("a-pdf-keeps-its-neighbours-and-its-place", fresh=True)
def a_pdf_keeps_its_neighbours_and_its_place(run: Run, fixture: Path) -> None:
    """**Three things a person reading a document notices, and one they should
    not.**

    * The page either side of this one is already rendered, so `↑` costs what `↓`
      costs. The prefetch used to look only forward, which is a preview that is
      quick in the direction nobody notices.
    * Holding a page key does not queue a render per press. It did, at sixty
      milliseconds each, and the panel then showed the page from two seconds ago
      until the queue drained — the reported freeze.
    * A document reopens where it was left, rather than at page one.
    """
    pages = 8
    (fixture / "book.pdf").write_bytes(many_page_pdf(pages))
    settled = listed(run)
    before = int(settled["rows"])
    run.drive("key f5\nsleep 400\n")
    holds(run, lambda it: int(it["rows"]) >= before + 1, f"more than {before} rows")
    run.drive("text book\nsleep 400\n")
    until(run, cursor="book.pdf")
    run.drive("key space\nsleep 200\n")
    until_looking(run, "book.pdf", "page")

    # Forward twice, so there is a page on either side to have.
    run.drive("key down\nsleep 600\nkey down\nsleep 900\n")
    ready = holds(
        run,
        lambda it: it.get("look_page") == f"3/{pages}" and int(it.get("look_held", "0")) >= 3,
        "page three with its neighbours held",
    )

    del ready

    # **Holding the key does not build a backlog.** Eight presses with no pause,
    # then one report: what is queued is bounded by the pages still wanted, not by
    # how fast the keys arrived.
    run.drive("key down\n" * 8 + "sleep 900\n")
    settled_again = holds(
        run,
        lambda it: drawn_in_full(it),
        "a page fully rendered after the burst",
    )
    landed = int(settled_again["look_page"].split("/")[0])
    if landed < 3:
        raise Failure(f"eight presses from page two ended on page {landed}")

    # And the place is kept: close the panel, open it again, same page.
    run.drive("key escape\nsleep 300\nkey space\nsleep 700\n")
    reopened = holds(
        run,
        lambda it: it.get("looking") == "book.pdf:page" and it.get("look_page", "").endswith(f"/{pages}"),
        "the panel open again",
    )
    if reopened["look_page"] != f"{landed}/{pages}":
        raise Failure(
            f"it reopened on {reopened['look_page']} rather than page {landed}, where it was left"
        )

    # **And now the page *behind* this one, which nobody has visited.** Reopening
    # threw every rendered page away, so what is held here was prefetched — and
    # the prefetch used to look only forward, which made `↑` a wait every time.
    # This is the assertion that fails without it: turning back to a page that has
    # never been on screen must not show a draft.
    holds(
        run,
        lambda it: int(it.get("look_held", "0")) >= 2 and drawn_in_full(it),
        "the reopened page and a neighbour",
    )
    run.drive("key up\nsleep 250\n")
    back = holds(run, lambda it: it.get("look_page") == f"{landed - 1}/{pages}", "the page before")
    if not drawn_in_full(back):
        raise Failure(
            f"turning back to page {landed - 1} showed a draft: only the pages ahead were fetched"
        )


@scenario("markdown-renders-and-toggles-to-its-source", fresh=True)
def markdown_renders_and_toggles(run: Run, fixture: Path) -> None:
    """**A README opens rendered, toggles to its source, and back.**

    [ADR 0029](../docs/adr/0029-markdown-renders-from-our-own-parser-and-unknown-syntax-is-its-own-text.md).
    Four claims a golden frame cannot make, because each is about what the window
    *does* rather than what one frame looks like:

    * a markdown file opens rendered, without being asked;
    * `Ctrl+M` swaps to the source and back, and the strip's button does the same
      thing for a pointer — rule 5;
    * text can be selected in the rendered view and `Ctrl+C` puts it on the
      clipboard, read back by a separate client;
    * and `Ctrl+E` edits the *source*, then comes back to the rendering — because
      the thing a person was reading is the thing they should get back.
    """
    (fixture / "notes.md").write_text(
        "# The title\n\nA paragraph with **strong** words in it.\n\n"
        "- one item\n- two item\n\n```\nfenced code\n```\n"
    )
    settled = listed(run)
    before = int(settled["rows"])
    run.drive("key f5\nsleep 400\n")
    holds(run, lambda it: int(it["rows"]) >= before + 1, f"more than {before} rows")
    run.drive("text notes\nsleep 400\n")
    until(run, cursor="notes.md")
    run.drive("key space\nsleep 700\n")

    # Rendered without being asked, which is the default the ADR chose.
    opened = holds(run, lambda it: it.get("look_mode") == "rendered", "a rendered preview")
    if opened["looking"] != "notes.md:text":
        raise Failure(f"the look is {opened['looking']!r}")

    # `Ctrl+M` to the source and back.
    run.drive("key ctrl+m\nsleep 300\n")
    holds(run, lambda it: it.get("look_mode") == "source", "the source")
    run.drive("key ctrl+m\nsleep 300\n")
    holds(run, lambda it: it.get("look_mode") == "rendered", "the rendering again")

    # And the pointer's way to the same thing, which is the strip's own button.
    at = look_aim(run, "source")
    run.drive(f"move {at[0]:.2f} {at[1]:.2f}\nsleep 200\nclick\nsleep 400\n")
    holds(run, lambda it: it.get("look_mode") == "source", "the source, from the button")
    run.drive("key ctrl+m\nsleep 300\n")
    holds(run, lambda it: it.get("look_mode") == "rendered", "rendered once more")

    # **Selection over the rendered words.** `Ctrl+A` then `Ctrl+C`, read back by
    # a separate client: what a person copies is the text as it is laid out, so
    # the markup is not in it and the words are.
    run.drive("key ctrl+a\nsleep 300\nkey ctrl+c\nsleep 500\n")
    held = clipboard(run)
    if "The title" not in held or "strong" not in held:
        raise Failure(f"the clipboard holds {held!r}")
    if "**" in held or held.startswith("#"):
        raise Failure(f"the clipboard holds the markup rather than the words: {held!r}")

    # **`Ctrl+E` edits the source and comes back to the rendering.** A person
    # reading a document who fixes a typo is still reading a document — and what
    # comes back is the *edited* document, not the one that was parsed when the
    # panel opened.
    run.drive("key ctrl+e\nsleep 400\n")
    holds(run, lambda it: it.get("look_mode") == "editing", "the editor")
    run.drive("text ZZ\nsleep 300\nkey ctrl+e\nsleep 700\n")
    holds(run, lambda it: it.get("look_mode") == "rendered", "the rendering after the edit")
    if "ZZ" not in (fixture / "notes.md").read_text():
        raise Failure("the edit did not reach the file")
    run.drive("key ctrl+a\nsleep 300\nkey ctrl+c\nsleep 500\n")
    if "ZZ" not in clipboard(run):
        raise Failure("the rendering came back showing the document from before the edit")

    # A file that is not markdown has none of this: the toggle is not drawn and
    # the mode says so.
    run.drive("key escape\nsleep 300\ntext file-1.txt\nsleep 400\n")
    until(run, cursor="file-1.txt")
    run.drive("key space\nsleep 600\n")
    plain = holds(run, lambda it: it.get("looking") == "file-1.txt:text", "a plain text preview")
    if plain["look_mode"] != "none":
        raise Failure(f"a text file reports look_mode={plain['look_mode']!r}")
    if "source" in plain.get("look_aim", ""):
        raise Failure("the rendering toggle is drawn over a file that does not render")


def drawn_in_full(state: dict[str, str]) -> bool:
    """Whether what is on screen is the finished render rather than a draft.

    **`drafted`, not `coarse`.** The two mean different things — one is what is on
    screen and the other is what will be asked for next — and a substring test for
    `coarse=false` matches `coarse=false,drafted=true`, which is a draft. That is
    what this asserted about on the display server whose panel is big enough for
    the full render to be slower than the report.
    """
    return "drafted=false" in state.get("look_shot", "")


def shot_of(state: dict[str, str]) -> tuple[tuple[int, int], tuple[int, int]]:
    """The box the child was asked for and the pixels it answered with."""
    fields = dict(pair.split("=", 1) for pair in state["look_shot"].split(",") if "=" in pair)
    def pair(name: str) -> tuple[int, int]:
        across, _, down = fields.get(name, "0x0").partition("x")
        return (int(across), int(down))
    return pair("asked"), pair("got")


def many_page_pdf(pages: int) -> bytes:
    """A PDF of `pages` A5 pages, each with its number on it.

    Written out rather than committed, for the reason the three-page one inside
    `arrows-walk-the-look-and-a-pdfs-pages` is: a fixture nobody can read is a
    fixture nobody can change.
    """
    font = 3 + pages * 2
    bodies = [f"BT /F1 36 Tf 60 400 Td (Page {n} of {pages}.) Tj ET".encode() for n in range(1, pages + 1)]
    kids = " ".join(f"{3 + i} 0 R" for i in range(pages))
    objects = [
        b"<< /Type /Catalog /Pages 2 0 R >>",
        f"<< /Type /Pages /Kids [{kids}] /Count {pages} >>".encode(),
    ]
    for index in range(pages):
        objects.append(
            b"<< /Type /Page /Parent 2 0 R /MediaBox [0 0 420 595] /Resources << /Font << /F1 "
            + str(font).encode()
            + b" 0 R >> >> /Contents "
            + str(3 + pages + index).encode()
            + b" 0 R >>"
        )
    for body in bodies:
        objects.append(
            b"<< /Length " + str(len(body)).encode() + b" >>\nstream\n" + body + b"\nendstream"
        )
    objects.append(b"<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>")
    out = bytearray(b"%PDF-1.4\n")
    offsets = []
    for number, obj in enumerate(objects, start=1):
        offsets.append(len(out))
        out += str(number).encode() + b" 0 obj\n" + obj + b"\nendobj\n"
    start = len(out)
    out += b"xref\n0 " + str(len(objects) + 1).encode() + b"\n0000000000 65535 f \n"
    for offset in offsets:
        out += f"{offset:010d} 00000 n \n".encode()
    out += (
        b"trailer\n<< /Size "
        + str(len(objects) + 1).encode()
        + b" /Root 1 0 R >>\nstartxref\n"
        + str(start).encode()
        + b"\n%%EOF\n"
    )
    return bytes(out)


def look_aim(run: Run, control: str) -> tuple[float, float]:
    """Where to click one of the quick look's controls, by name.

    The window reports the middle of every control it drew, so a scenario names
    the thing rather than copying the strip's own constants — and a control that
    was not drawn is not in the list, which is how "no page arrows over a
    picture" is a failure here rather than a click into empty panel.
    """
    state = holds(run, lambda it: bool(it.get("look_aim")), "a look with controls")
    for entry in state["look_aim"].split(","):
        name, _, point = entry.partition("@")
        if name == control:
            x, _, y = point.partition(":")
            return aim(run, state, float(x), float(y))
    raise Failure(f"{control} is not among the look's controls: {state['look_aim']!r}")


def until_looking(run: Run, name: str, what: str) -> dict[str, str]:
    """Waits for the quick look to be of `name`, showing `what`.

    A poll rather than a sleep: a picture is a round trip to a child that spawns,
    sandboxes itself and decodes, and how long that takes is the machine's
    business. `waiting` is the state in between and is what this waits out.
    """
    deadline = time.time() + WAITING
    state: dict[str, str] = {}
    while time.time() < deadline:
        fresh = run.answered()
        if fresh is not None:
            state = fresh
            if state.get("looking") == f"{name}:{what}":
                return state
    raise Failure(f"the look never became {name}:{what} — it is {state.get('looking')}")


@scenario("a-hung-mount-never-blocks-the-frame-loop", fresh=True)
def a_hung_mount_never_blocks_the_frame_loop(run: Run, fixture: Path) -> None:
    """**Rule 1's canonical test, and until now the only one of the eight without
    one.** A filesystem that has stopped answering has to degrade to a row that
    never fills in, never to a window that stops drawing.

    `tools/hung-mount` is the mount: a FUSE server that holds `/dev/fuse` and reads
    nothing from it, so every `getdents64` and every `statx` under it queues and the
    caller blocks for as long as the mount stands. That is `sshfs` to a suspended
    host without the network, the key or the second machine — see that script for
    why it answers no request at all, `FUSE_INIT` included.

    **Every liveness check goes through `answered`, not `state`.** That is the whole
    difference between this test and a decoration: `state` returns the last line in
    the log, and `reports_reached` gives up quietly after a frame — so a frozen
    frame loop hands back the dump from *before* the question, which looks pristine.
    Measured here, not assumed: with a `read_dir` on the pane's path spliced into the
    frame path, the first draft failed on *"the pane went to <fixture> rather than
    the mount"* — a stale answer from before the navigation — rather than on the
    window having stopped. `answered` returns nothing when nothing fresh arrived,
    which is the only form of "it is still drawing" that can fail.

    Three claims, in order:

    * a read that never lands leaves the window drawing and answering keys;
    * navigating away lands a real listing — which is the **per-device queue** in
      `sk_util::Pool` doing its job, since one blocked device must not starve the
      pool that every other read shares. Spike B measured a hung-mount arm at
      28,000 ms, which is what that design is for;
    * and the pane says it is still loading rather than claiming the folder is
      empty, because "this folder is empty" over a mount that has gone away is the
      one answer that is worse than no answer.
    """
    import subprocess

    # **Outside the fixture, on purpose.** A hung mount is contagious: anything that
    # walks its parent blocks too, and the harness deletes the fixture at the end.
    where = run.work / "hung-mount"
    server = subprocess.Popen(
        ["python3", str(ROOT / "tools" / "hung-mount"), str(where)],
        stdout=subprocess.PIPE,
        text=True,
    )
    try:
        assert server.stdout is not None
        line = server.stdout.readline().strip()
        if not line.startswith("hung "):
            error = Failure if os.environ.get("SKERRY_REQUIRE_HUNG_MOUNT") == "1" else Skipped
            raise error(f"no hung mount to test against: {line or 'the server said nothing'}")

        # **The baseline, taken before the mount is reached.** Every assertion
        # below is a *delta* on `over` — the count of frames that missed the 8 ms
        # budget — and never a percentile, because this window has drawn 10–16
        # frames of the 480 `sk_app::frames` keeps and a nearest-rank p99 over an
        # unfilled ring is the worst frame *since start-up*. Cold pipeline
        # compilation and first-glyph rasterisation are in that number, so the
        # assertion that read it was failing on how fast the window opened while
        # claiming to be about a blocked `statx`. A delta from here forward covers
        # exactly the frames drawn with a read stuck in the pool, which is what
        # rule 1 claims and all it claims.
        opening = listed(run)
        rows = opening["rows"]
        missed = int(opening["over"])

        def still_inside_the_budget(answer: dict[str, str], when: str) -> None:
            if os.environ.get("SKERRY_HUNG_LIVENESS_ONLY") == "1":
                return
            if int(answer["over"]) > missed:
                raise Failure(
                    f"{int(answer['over']) - missed} frame(s) of "
                    f"{int(answer['frames']) - int(opening['frames'])} drawn {when} "
                    f"missed the 8 ms budget (p99 {answer['frame_p99_us']}us)"
                )

        # Into the mount. The read is issued and never lands.
        run.drive("key ctrl+l\nsleep 250\nkey ctrl+u\n")
        run.drive(f"text {where}\nkey enter\nsleep 900\n")
        hung = run.answered(settle=300)
        if hung is None:
            raise Failure("the window stopped answering when the pane reached a hung mount")
        if hung["path"] != str(where):
            raise Failure(f"the pane went to {hung['path']} rather than the mount")
        if hung["loading"] != "true":
            raise Failure(
                f"a read that cannot land reported loading={hung['loading']!r} and "
                f"rows={hung['rows']!r} — a mount that has gone away is not an empty folder"
            )
        still_inside_the_budget(hung, "navigating into the mount")

        # **Three fresh answers, with a keystroke between them.** Each one is a
        # frame the loop drew while a read of this pane's own directory was blocked
        # in the pool, which is rule 1 stated as an experiment.
        for attempt in range(3):
            run.drive("key down\nsleep 120\n")
            alive = run.answered(settle=200)
            if alive is None:
                raise Failure(f"the window stopped answering keys over a hung mount ({attempt})")
            still_inside_the_budget(alive, "answering keys over a hung mount")

        # And out again, to a directory that answers. This is the pool's per-device
        # queue: the blocked read still holds a thread and this one has to land.
        run.drive("key ctrl+l\nsleep 250\nkey ctrl+u\n")
        run.drive(f"text {fixture}\nkey enter\nsleep 900\n")
        back = listed(run)
        if back["path"] != str(fixture):
            raise Failure(f"the pane could not leave the mount: {back['path']}")
        if back["rows"] != rows:
            raise Failure(f"the fixture read {back['rows']} rows, not the {rows} it began with")
        still_inside_the_budget(back, "leaving the mount for a folder that answers")
    finally:
        # **Unmount before anything else.** It is what releases the read still
        # blocked in the pool; without it that thread sits in uninterruptible sleep
        # and the window cannot exit, which would hang the sweep rather than fail it.
        subprocess.run(
            ["python3", str(ROOT / "tools" / "hung-mount"), "--unmount", str(where)],
            check=False,
            capture_output=True,
            timeout=30,
        )
        server.terminate()
        try:
            server.wait(timeout=30)
        except subprocess.TimeoutExpired:
            server.kill()


@scenario("collapse-a-group", fresh=True)
def collapse_a_group(run: Run, fixture: Path) -> None:
    """A press on a band's heading hides that group's rows, and gives them back.

    **Filtering by group, which is what a heading is for.** Three things only a
    scenario reaches: that a press on a heading is taken by the heading rather than
    falling through to the list — where `index_at` answers `None` and the pane reads
    that as empty space and clears the selection — that the rows come back, and that
    `Ctrl+A` afterwards does not select what is behind a shut one.

    Grouped by *kind*, not by time: every file in a fresh fixture shares one
    modification time, so time is a single band and a scenario over it would pass
    without the feature existing.

    **`fresh`, and the reason is not the one in `scenario`'s docstring.** This
    changes nothing in the directory; it changes what `views` *remembers* about it,
    and `Ctrl+9` writes that to a file the whole sweep shares. Against the shared
    fixture it grouped every later scenario over that path — and every folder under
    it, through the ancestor inheritance — so `alpha` and `beta` grew a heading, and
    three scenarios that click a row by arithmetic over `row_h` clicked one row too
    far. `navigation-buttons` and `breadcrumb-navigation` both ended up in `beta`
    wanting `alpha`.
    """
    run.drive("sleep 400\nkey f12\nsleep 100\n")
    rows = int(run.state()["rows"])
    if rows < 4:
        raise Failure(f"the fixture read too little: {rows} rows")

    run.drive("key ctrl+9\nsleep 400\nkey f12\nsleep 200\n")
    grouped = run.state()
    if grouped["grouping"] != "by-kind":
        raise Failure(f"Ctrl+9 left the pane {grouped['grouping']!r}")
    bands = headings_of(grouped)
    if len(bands) < 2:
        raise Failure(f"grouping by kind gave {len(bands)} bands: {grouped['headings']}")
    if any(state == "shut" for _, _, _, state in bands):
        raise Failure(f"a band was already collapsed: {grouped['headings']}")
    if grouped["collapsed"] != "0":
        raise Failure(f"nothing is shut and {grouped['collapsed']} rows are hidden")

    # Something selected first, so a press that fell through to the list would be
    # visible as a selection that got cleared rather than as nothing at all.
    pointing = point_at(run, 0)
    run.drive("click\nsleep 250\nkey f12\nsleep 200\n")
    expect(run.state(), selected="1")

    # The second band's heading. Not the first, whose rows include the one just
    # selected — this has to hide rows without touching that selection.
    band, x, y, _ = headings_of(run.state())[1]
    at = aim(run, run.state(), x, y)
    run.drive(f"move {at[0]:.2f} {at[1]:.2f}\nsleep 150\nclick\nsleep 300\nkey f12\nsleep 200\n")
    shut = run.state()
    hidden = int(shut["collapsed"])
    if hidden == 0:
        raise Failure(f"the press hid nothing: {shut['headings']}")
    if not any(kind == band and state == "shut" for kind, _, _, state in headings_of(shut)):
        raise Failure(f"band {band} is not the one that shut: {shut['headings']}")
    if shut["selected"] != "1":
        raise Failure(f"the press cleared the selection: {shut['selected']} selected")
    if shut["rows"] != str(rows):
        raise Failure(f"the listing changed size: {shut['rows']} against {rows}")

    # **`Ctrl+A` selects what is shown.** A selection holding rows behind a shut
    # heading is one a later Delete acts on by surprise.
    run.drive("key ctrl+a\nsleep 300\nkey f12\nsleep 200\n")
    picked = run.state()
    if picked["selected"] != str(rows - hidden):
        raise Failure(
            f"Ctrl+A selected {picked['selected']} of {rows} with {hidden} hidden"
        )

    # A second press on the same heading gives the rows back.
    run.drive("click\nsleep 300\nkey f12\nsleep 200\n")
    reopened = run.state()
    if reopened["collapsed"] != "0":
        raise Failure(f"pressing again left {reopened['collapsed']} rows hidden")
    if any(state == "shut" for _, _, _, state in headings_of(reopened)):
        raise Failure(f"a band stayed shut: {reopened['headings']}")

    # **And the keyboard's half**, which rule 5 requires: Ctrl+G on the cursor's
    # band, Ctrl+Shift+G to open everything again.
    run.drive("key ctrl+g\nsleep 300\nkey f12\nsleep 200\n")
    by_key = run.state()
    if by_key["collapsed"] == "0":
        raise Failure(f"Ctrl+G hid nothing: {by_key['headings']}")
    run.drive("key ctrl+shift+g\nsleep 300\nkey f12\nsleep 200\n")
    if run.state()["collapsed"] != "0":
        raise Failure(f"Ctrl+Shift+G left {run.state()['collapsed']} rows hidden")

    # And a navigation clears it, because band four is a different set of files in
    # every folder.
    run.drive("key ctrl+g\nsleep 300\nkey f12\nsleep 200\n")
    if run.state()["collapsed"] == "0":
        raise Failure("Ctrl+G hid nothing the second time")
    run.drive("text alpha\nsleep 300\nkey enter\nsleep 700\nkey f12\nsleep 200\n")
    walked = run.state()
    if not walked["path"].rstrip('"').endswith("alpha"):
        raise Failure(f"the walk did not arrive: {walked['path']}")
    if walked["collapsed"] != "0":
        raise Failure(f"a collapsed band followed the navigation: {walked['headings']}")


@scenario("check-box-selects")
def check_box_selects(run: Run, fixture: Path) -> None:
    """A press on a check box adds a row to the selection, and takes it back out.

    **Which no unit test reaches, because the whole feature is a hit target.** The
    semantics are `Selection::toggle`, which `Ctrl`-click has always had; what is
    new is a square a hand can aim at without a keyboard, and whether a press lands
    on it is a question about geometry, a pointer and a compositor.

    Three claims: an ordinary press replaces a selection and a press in the box
    does not, a second press in the same box removes what the first added, and
    neither one opens anything or starts a drag — the box is a toggle and nothing
    else.
    """
    run.drive("sleep 400\nkey f12\nsleep 100\n")
    here = run.state()["path"]

    # An ordinary press on row 1, to have something for the box to add *to*.
    pointing = point_at(run, 1)
    first = pointing["hover_name"]
    run.drive("click\nsleep 250\nkey f12\nsleep 200\n")
    expect(run.state(), cursor=first, selected="1")

    # Now the box on row 3. Two selected, and the first one is still in.
    box = point_at_the_check_box(run, 3)
    third = box["hover_name"]
    run.drive("click\nsleep 250\nkey f12\nsleep 200\n")
    added = run.state()
    if added["selected"] != "2":
        raise Failure(f"a press in the box left {added['selected']} selected, not 2")
    if added["cursor"] != third:
        raise Failure(f"the cursor is on {added['cursor']!r}, not {third!r}")
    if added["path"] != here:
        raise Failure(f"the press opened something: {added['path']}")

    # And again: back to one, which is the half a plain click cannot do at all.
    run.drive("click\nsleep 250\nkey f12\nsleep 200\n")
    removed = run.state()
    if removed["selected"] != "1":
        raise Failure(f"a second press left {removed['selected']} selected, not 1")
    if removed["path"] != here:
        raise Failure(f"the second press opened something: {removed['path']}")

    # **The keyboard's half of the same action**, which rule 5 requires and which
    # `Ctrl`-click never had: `Ctrl+Space` on the cursor row.
    run.drive("key ctrl+space\nsleep 250\nkey f12\nsleep 200\n")
    if run.state()["selected"] != "2":
        raise Failure(f"Ctrl+Space left {run.state()['selected']} selected, not 2")
    run.drive("key ctrl+space\nsleep 250\nkey f12\nsleep 200\n")
    if run.state()["selected"] != "1":
        raise Failure(f"Ctrl+Space did not take it back out: {run.state()['selected']}")


