def fill_until_scrollable(run: Run, fixture: Path) -> dict:
    """Puts two hundred files in `fixture` and waits for the rows to arrive.

    **A scroll test whose content fits the window asserts nothing.** The wheel
    scenario used to run against the shared nine-row fixture and return early for
    exactly that reason, so it passed for as long as it existed while
    `skerry-drive` sent a scroll the compositor translated to a delta of zero.
    See docs/12-measurement.md.
    """
    for index in range(200):
        (fixture / f"filler-{index:03}.txt").write_text("x")
    # inotify, rather than a reload: the rows have to arrive by themselves for
    # what follows to be about scrolling and not about `F5`.
    for _ in range(40):
        run.drive("sleep 150\nkey f12\nsleep 50\n")
        filled = run.state()
        if int(filled["rows"]) > 200:
            break
    else:
        raise Failure(f"the filler files never arrived: {filled['rows']} rows")
    if int(filled["rows"]) * float(filled["row_h"]) <= float(filled["body_height"]):
        raise Failure(f"{filled['rows']} rows still fit in {filled['body_height']}")
    return filled


@scenario("pointer-scroll", fresh=True)
def pointer_scroll(run: Run, fixture: Path) -> None:
    """One wheel notch travels four rows or more, and the list comes back up.

    **A distance, not a direction.** This asserted only that the offset had grown,
    which passed for a notch of three rows, for a notch that jumped its whole
    distance with no easing, and for a fling that coasted three per cent and
    stopped. A notch is `WHEEL_NOTCH` times `sk_ui::SCROLL_GAIN` — 132 logical
    pixels, a little over five rows at the default height — and the notch count
    wins over any distance the compositor also sends, so the number is this code's
    rather than the nested compositor's. Four rows is the floor because the value
    before the sensitivity moved was three. See docs/12-measurement.md.
    """
    run.drive("sleep 400\nkey f12\nsleep 100\n")
    filled = fill_until_scrollable(run, fixture)
    row = float(filled["row_h"])

    run.drive("key home\nsleep 250\nkey f12\nsleep 150\n")
    start = float(run.state()["scroll"])
    run.drive("move 50 50\nsleep 150\nscroll 1\nsleep 400\nkey f12\nsleep 200\n")
    one = float(run.state()["scroll"]) - start
    if one < row * 4.0:
        raise Failure(f"one notch travelled {one:.1f}, under four {row:.1f} rows")

    run.drive("move 50 50\nsleep 150\nscroll 5\nsleep 500\nkey f12\nsleep 200\n")
    after = float(run.state()["scroll"])
    if after <= start + one:
        raise Failure(f"five more notches moved nothing: {after}")
    # And back up again, because a scroll that only goes one way is half tested.
    run.drive("move 50 50\nsleep 150\nscroll -5\nsleep 500\nkey f12\nsleep 200\n")
    if float(run.state()["scroll"]) >= after:
        raise Failure("scrolling up moved nothing")


@scenario("column-view", fresh=True)
def column_view(run: Run, fixture: Path) -> None:
    """`Ctrl+3` lays the pane out as columns, and the trail follows the path.

    **The trail is a function of the path**, so what this checks is that every
    kind of navigation moves it: descending adds a column, going up removes one,
    and the levels above are kept rather than re-read — which the unit tests prove
    by generation and this proves by the count surviving a round trip.

    Then the pointer half, which is the thing no unit test can reach: a press in an
    ancestor column has to be *handled*. Without `App::column_press` it falls
    through to "empty space" and clears the selection, and the mode looks as though
    it works right up until you click in it.
    """
    (fixture / "one").mkdir()
    (fixture / "two").mkdir()
    for _ in range(40):
        run.drive("sleep 150\nkey f12\nsleep 50\n")
        if int(run.state()["rows"]) >= 11:
            break
    else:
        raise Failure(f"the two folders never arrived: {run.state()['rows']} rows")

    run.drive("key ctrl+3\nsleep 500\nkey f12\nsleep 200\n")
    state = run.state()
    if state["mode"] != "columns":
        raise Failure(f"Ctrl+3 left the pane in {state['mode']!r}")
    shallow = int(state["trail"])
    if shallow < 1:
        raise Failure(f"a fixture under /tmp has ancestors, and the trail has {shallow}")

    # Down into `one`: a column appears and the path is inside it.
    run.drive("text one\nsleep 300\nkey enter\nsleep 600\nkey f12\nsleep 200\n")
    deeper = run.state()
    if not deeper["path"].endswith("one\"") and not deeper["path"].endswith("one"):
        raise Failure(f"Enter on a folder left the pane at {deeper['path']}")
    if int(deeper["trail"]) != shallow + 1:
        raise Failure(f"descending took the trail from {shallow} to {deeper['trail']}")

    # A press on the chosen row of the deepest ancestor column, which is `one`
    # itself: nothing moves, and the selection it would have cleared is still
    # there. Waits for the column's listing, because the aim comes from it.
    for _ in range(40):
        if run.state().get("column_aim", "none") != "none":
            break
        run.drive("sleep 150\nkey f12\nsleep 50\n")
    else:
        raise Failure("the ancestor column never reported a chosen row")
    # **Proved to be in the column before the press**, not aimed at and hoped for:
    # a move to where the pointer already is sends no event, and a press that
    # landed on the sidebar instead would leave the path and the trail alone too —
    # which is what this asserts, so it would have passed for the wrong reason.
    inside = point_at_column(run, run.state(), int(run.state()["trail"]) - 1)
    run.drive("click\nsleep 400\nkey f12\nsleep 200\n")
    pressed = run.state()
    if pressed["path"] != inside["path"]:
        raise Failure(f"pressing the chosen folder moved to {pressed['path']}")
    if int(pressed["trail"]) != int(inside["trail"]):
        raise Failure("pressing the chosen folder changed the trail")

    # And back up: the column goes and the ones above it stay.
    run.drive("key alt+up\nsleep 600\nkey f12\nsleep 200\n")
    back = run.state()
    if int(back["trail"]) != shallow:
        raise Failure(f"going up took the trail to {back['trail']}, not {shallow}")
    if back["mode"] != "columns":
        raise Failure("the mode did not survive a navigation")


def point_at_column(run: Run, state: dict[str, str], depth: int) -> dict[str, str]:
    """Puts the pointer inside ancestor column `depth`, and proves it landed there.

    **A synthetic move to where the pointer already is produces no event**, and
    that is not a corner case: one scenario leaves the pointer where the next one
    wants it, the new window maps under it, and this compositor sends no `enter`
    for a pointer that has not moved. So the window went on believing the pointer
    was at `0.0:0.0` — the position it starts at, which is a real one — and every
    aim in the scenario landed on the sidebar. Alone it passed, in a sweep it did
    not, and the symptom was a wheel that scrolled nothing.

    So: nudge, and read `column_over` back. The same shape `point_at` has for a
    row, for the same reason — the only honest way for a test to know it pointed at
    what it meant to is to ask the program.
    """
    for attempt in range(6):
        x, _, y = state["column_aim"].partition(":")
        step = float(state["row_h"]) / 3.0 * attempt
        at = aim(run, state, float(x), float(y) + (step if attempt % 2 else -step))
        run.drive(f"move {at[0]:.2f} {at[1]:.2f}\nsleep 150\nkey f12\nsleep 150\n")
        got = run.state()
        if got["column_over"] == str(depth):
            return got
    last = run.state()
    raise Failure(
        f"could not put the pointer in column {depth}: it is over {last['column_over']} "
        f"at {last['pointer_at']}, aiming at {state['column_aim']}"
    )


@scenario("column-view-survives-a-remembered-view", fresh=True)
def column_view_survives_a_remembered_view(run: Run, fixture: Path) -> None:
    """Walking into a folder that remembers Details stays in columns.

    **The per-folder record is about arriving, and a trail is not arriving.** Set
    one folder to Details from inside it, come back out, switch the pane to
    columns, and walk back in: before this the pane flipped to Details at the
    doorstep, which for one person was Downloads two steps into a trail.

    The record has to be *set* rather than assumed, because `views` only writes a
    folder down when somebody chooses something for it — a fresh fixture remembers
    nothing, and a scenario over one would pass without the rule existing.
    """
    (fixture / "one").mkdir()
    for _ in range(40):
        run.drive("sleep 150\nkey f12\nsleep 50\n")
        if int(run.state()["rows"]) >= 10:
            break
    else:
        raise Failure(f"the folder never arrived: {run.state()['rows']} rows")

    # Into `one`, set it to a grid, and back out. Now `one` remembers a grid.
    run.drive("text one\nsleep 300\nkey enter\nsleep 600\nkey ctrl+2\nsleep 400\nkey f12\nsleep 200\n")
    inside = run.state()
    if inside["mode"] != "grid":
        raise Failure(f"Ctrl+2 left the pane in {inside['mode']!r}")
    run.drive("key alt+up\nsleep 600\nkey f12\nsleep 200\n")

    # A pane not in columns takes the record: back into `one` and it is a grid.
    run.drive("text one\nsleep 300\nkey enter\nsleep 700\nkey f12\nsleep 200\n")
    if run.state()["mode"] != "grid":
        raise Failure("the folder's remembered view was not applied at all")
    run.drive("key alt+up\nsleep 600\nkey ctrl+3\nsleep 500\nkey f12\nsleep 200\n")
    if run.state()["mode"] != "columns":
        raise Failure(f"Ctrl+3 left the pane in {run.state()['mode']!r}")

    # And a pane in columns does not: the same folder, the same record, no flip.
    run.drive("text one\nsleep 300\nkey enter\nsleep 700\nkey f12\nsleep 200\n")
    walked = run.state()
    if walked["mode"] != "columns":
        raise Failure(f"walking into a folder that remembers grid left the pane in {walked['mode']!r}")
    if not walked["path"].rstrip('"').endswith("one"):
        raise Failure(f"the walk did not arrive: {walked['path']}")

    # **And columns leaves nothing behind.** Choosing a details list here and
    # stepping out used to find the parent in columns — because switching *to*
    # columns had recorded it against whatever folder the pane was standing in, and
    # every directory beneath inherited it. Details here, and the parent is a
    # details list too, because nothing under it says otherwise any more.
    run.drive("key ctrl+1\nsleep 400\nkey f12\nsleep 200\n")
    if run.state()["mode"] != "details":
        raise Failure(f"Ctrl+1 left the pane in {run.state()['mode']!r}")
    run.drive("key alt+up\nsleep 700\nkey f12\nsleep 200\n")
    out = run.state()
    if out["mode"] != "details":
        raise Failure(f"stepping out of a folder set to details found {out['mode']!r}")


@scenario("grouping-survives-a-trail", fresh=True)
def grouping_survives_a_trail(run: Run, fixture: Path) -> None:
    """A folder grouped by time is still grouped after a trail walks through it.

    **The reported defect.** Downloads was grouped by time. Walking into it in a
    column view left the pane carrying the grouping of wherever it had come from,
    and pressing Details wrote *that* over the one Downloads had chosen — so the
    folder was un-grouped, permanently, by nothing more than being walked through.

    **Only a scenario reaches it, because the wrong state is not drawn.** A column
    is never banded, so between the walk and the press there is no heading on
    screen either way: the pane looks identical whether it is holding the folder's
    grouping or somebody else's. What tells them apart is what comes out the other
    side, which is two navigations and a mode switch away from the mistake.
    """
    (fixture / "one").mkdir()
    for _ in range(40):
        run.drive("sleep 150\nkey f12\nsleep 50\n")
        if int(run.state()["rows"]) >= 10:
            break
    else:
        raise Failure(f"the folder never arrived: {run.state()['rows']} rows")

    # Into `one`, group it by time, and out again: `one` now remembers by-time,
    # and the pane above it is flat — which is the grouping it will carry back in.
    run.drive("text one\nsleep 300\nkey enter\nsleep 600\nkey ctrl+7\nsleep 400\nkey f12\nsleep 200\n")
    if run.state()["grouping"] != "by-time":
        raise Failure(f"Ctrl+7 left the pane {run.state()['grouping']!r}")
    run.drive("key alt+up\nsleep 700\nkey f12\nsleep 200\n")
    above = run.state()
    if above["grouping"] != "flat":
        raise Failure(f"the parent is {above['grouping']!r}, so the pane carries nothing wrong")

    # Into columns, and walk in. Nothing on screen changes; the pane's grouping
    # has to change all the same, because it is what the next choice writes down.
    run.drive("key ctrl+3\nsleep 500\nkey f12\nsleep 200\n")
    if run.state()["mode"] != "columns":
        raise Failure(f"Ctrl+3 left the pane in {run.state()['mode']!r}")
    run.drive("text one\nsleep 300\nkey enter\nsleep 700\nkey f12\nsleep 200\n")
    walked = run.state()
    if not walked["path"].rstrip('"').endswith("one"):
        raise Failure(f"the walk did not arrive: {walked['path']}")
    if walked["grouping"] != "by-time":
        raise Failure(f"a trail arrived in a grouped folder holding {walked['grouping']!r}")

    # Out of columns: the heading appears, and it is the one the folder chose.
    run.drive("key ctrl+1\nsleep 500\nkey f12\nsleep 200\n")
    if run.state()["grouping"] != "by-time":
        raise Failure(f"leaving columns left the folder {run.state()['grouping']!r}")

    # And the record itself, which is the half that does not come back: out, in,
    # and it is still grouped.
    run.drive("key alt+up\nsleep 700\ntext one\nsleep 300\nkey enter\nsleep 700\nkey f12\nsleep 200\n")
    again = run.state()
    if again["grouping"] != "by-time":
        raise Failure(f"the folder's record was overwritten: it is {again['grouping']!r}")


@scenario("column-scroll", fresh=True)
def column_scroll(run: Run, fixture: Path) -> None:
    """The wheel scrolls the column under the pointer, and `Shift` goes sideways.

    Two things no unit test reaches, because both are about *routing*: which of
    several lists a delta arrives at, and which of two axes.

    The vertical half is aimed from `column_aim`, the middle of the chosen row in
    the deepest ancestor column — so the pointer is over that column by
    construction. `column_scroll` reports every ancestor's own offset in order, so
    the assertion is which one moved rather than that something did. Before this
    the delta always went to the pane's own column and an ancestor had no extent to
    move within anyway.

    The sideways half needs a run wider than the pane, which is why this descends:
    a fixture under `/tmp` is already several levels deep, and one more makes the
    trail long enough that the pane's own column is not the only one on screen.
    """
    # **The filler goes in the fixture, not in the folder below it.** The pointer
    # lands on the deepest *ancestor* column, which is this directory once the pane
    # has descended — and a column with fewer rows than the pane is tall has no
    # extent, so a wheel over it would move nothing however well it was routed.
    (fixture / "one").mkdir()
    for index in range(60):
        (fixture / f"filler-{index:02}.txt").write_text("x")
    for _ in range(40):
        run.drive("sleep 150\nkey f12\nsleep 50\n")
        if int(run.state()["rows"]) >= 60:
            break
    else:
        raise Failure(f"the filler never arrived: {run.state()['rows']} rows")

    run.drive("key ctrl+3\nsleep 500\ntext one\nsleep 300\nkey enter\nsleep 700\nkey f12\nsleep 200\n")
    for _ in range(40):
        state = run.state()
        if state.get("column_aim", "none") != "none" and int(state["trail"]) > 0:
            break
        run.drive("sleep 150\nkey f12\nsleep 50\n")
    else:
        raise Failure("the ancestor columns never arrived")

    deepest = int(state["trail"]) - 1
    pointing = point_at_column(run, state, deepest)
    before = pointing["column_scroll"].split(",")
    run.drive("scroll 4\nsleep 500\nkey f12\nsleep 200\n")
    landed = run.state()
    after = landed["column_scroll"].split(",")
    if after == before:
        raise Failure(
            f"the wheel over column {landed['column_over']} moved nothing: {before}; "
            f"the pointer is at {landed['pointer_at']}, across={landed['across']}, "
            f"trail={landed['trail']}, and the window saw {landed['scrolls']} scrolls"
        )
    moved = [index for index, (was, now) in enumerate(zip(before, after)) if was != now]
    if moved != [len(before) - 1]:
        raise Failure(f"the wheel moved columns {moved} of {len(before)}: {before} -> {after}")

    # And `Shift` moves along the run instead of down a column. The pointer is
    # already where it needs to be, inside the run.
    across = float(run.state()["across"])
    if across <= 0.0:
        raise Skipped(f"the run of columns fits the pane here, so there is no sideways: {across}")
    run.drive("scroll -4\nsleep 400\nkey f12\nsleep 200\n")
    if float(run.state()["across"]) != across:
        raise Failure("a bare wheel moved the run sideways")
    run.drive("scroll -4 shift\nsleep 500\nkey f12\nsleep 200\n")
    if float(run.state()["across"]) >= across:
        raise Failure(
            f"Shift and the wheel left the run at {run.state()['across']}, was {across}"
        )


@scenario("view-switcher")
def view_switcher(run: Run, fixture: Path) -> None:
    """The pane's own bar switches the view mode, without a menu.

    **Aimed from the switcher's own rectangle**, `modes_x` and `mode_w`, which is
    the rule docs/12-measurement.md records after a chrome aim taken from a
    neighbour moved without it. The order is `cells::Mode::ALL` — grid, then
    details — so the first button is the grid and the second is the list.

    The buttons run the same registry commands `Ctrl+1` and `Ctrl+2` do, which is
    what rule 2 asks for; what this covers is that the pointer reaches them at all,
    which no other scenario does — every other way into a mode is a chord or a
    menu row.
    """
    state = listed(run)
    width = float(state["mode_w"])
    if width <= 0.0:
        raise Skipped("the switcher is shed at this window size")
    left = float(state["modes_x"])
    middle = float(state["bar_y"]) + float(state["bar_h"]) / 2.0
    if state["mode"] != "details":
        raise Failure(f"expected to start in details, not {state['mode']!r}")

    def press(index: int) -> dict:
        at = aim(run, state, left + width * (index + 0.5), middle)
        run.drive(f"move {at[0]:.2f} {at[1]:.2f}\nsleep 200\nclick\nsleep 350\nkey f12\nsleep 200\n")
        return run.state()

    in_grid = press(0)
    if in_grid["mode"] != "grid":
        raise Failure(f"the first button left the pane in {in_grid['mode']!r}")
    # And the hover reports which button the pointer is on, which is what draws
    # the button that is not the current one.
    if in_grid["mode_hover"] != "grid":
        raise Failure(f"the pointer is on the grid button and reports {in_grid['mode_hover']!r}")

    back = press(1)
    if back["mode"] != "details":
        raise Failure(f"the second button left the pane in {back['mode']!r}")


@scenario("click-past-the-columns")
def click_past_the_columns(run: Run, fixture: Path) -> None:
    """The space past the last column is not part of the row.

    **The fill and the click are one value**, `PaneLayout::rows`, so this is that
    agreement end to end: a selected row is drawn to the table's right edge, and a
    press past it clears the selection the way a press below the last row does.
    Before the ceiling there was no space past the columns to press in.

    Skips rather than passes where the table reaches the pane's edge, which is
    every window narrower than the name column's ceiling — there is nothing there
    to click and a green result would mean nothing.
    """
    run.drive("key down\nsleep 250\nkey f12\nsleep 150\n")
    chosen = run.state()
    if chosen["selected"] == "0":
        raise Failure("the keyboard selected nothing to begin with")
    edge = float(chosen["rows_right"])
    pane = float(chosen["body_right"])
    if pane - edge < 24.0:
        raise Skipped(f"the table reaches the pane's edge here: {edge:.0f} of {pane:.0f}")

    y = float(chosen["body_top"]) + float(chosen["row_h"]) / 2.0
    at = aim(run, chosen, (edge + pane) / 2.0, y)
    run.drive(f"move {at[0]:.2f} {at[1]:.2f}\nsleep 200\nclick\nsleep 300\nkey f12\nsleep 200\n")
    after = run.state()
    if after["selected"] != "0":
        raise Failure(f"a click {pane - edge:.0f} px past the columns selected {after['selected']}")


@scenario("column-drag")
def column_drag(run: Run, fixture: Path) -> None:
    """A drag on the Name/Size boundary sets the name column's width.

    **The aim comes from the boundary itself.** `size_x` *is* the line between
    the two columns — the name's right edge and the size's left edge are one
    number — and `header_y` and `header_h` are the strip it runs down. Nothing
    here is a fraction of the window, which is the rule docs/12-measurement.md
    records after a chrome aim taken from a neighbour moved without it.

    Then `Ctrl+Shift+R`, because a boundary dragged to its floor leaves a
    four-pixel grab band as the only other way back and the reset is the command
    that exists for it.
    """
    state = listed(run)
    before = float(state["size_x"])
    middle = float(state["header_y"]) + float(state["header_h"]) / 2.0
    grab = aim(run, state, before, middle)
    drop = aim(run, state, before - 140.0, middle)
    run.drive(
        f"move {grab[0]:.2f} {grab[1]:.2f}\nsleep 200\npress\nsleep 120\n"
        f"move {drop[0]:.2f} {drop[1]:.2f}\nsleep 250\nrelease\nsleep 250\n"
        "key f12\nsleep 200\n"
    )
    after = float(run.state()["size_x"])
    if after > before - 100.0:
        raise Failure(f"a 140 px drag moved the boundary from {before} to {after}")

    run.drive("key ctrl+shift+r\nsleep 300\nkey f12\nsleep 200\n")
    back = float(run.state()["size_x"])
    if abs(back - before) > 1.0:
        raise Failure(f"the reset left the boundary at {back}, not {before}")


