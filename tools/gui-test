@scenario("nothing-reaches-the-listing-while-a-name-is-being-typed", fresh=True)
def a_field_rejects_the_rest(run: Run, fixture: Path) -> None:
    """The reported defect: the selection moved under the name being typed.

    Keys the field did not handle fell through to the registry and then to the
    type-ahead, so `Ctrl+Backspace` — which was not a text operation yet — jumped
    the cursor to another row. `Ctrl+Shift+N` made a folder, and `Ctrl+Z` walked
    back the last operation on disk.
    """
    run.drive("sleep 700\nkey f12\nsleep 150\n")
    before = run.state()
    rows = int(before["rows"])
    run.drive("text file-1.txt\nsleep 400\nkey f2\nsleep 300\nkey f12\nsleep 150\n")
    opened = run.state()
    expect(opened, cursor="file-1.txt", naming="file-1.txt", selected="1")

    # Every one of these used to reach the listing. None of them may now.
    for chord in ["ctrl+shift+n", "alt+left", "alt+up", "f5", "ctrl+h", "alt+2", "f9"]:
        run.drive(f"key {chord}\nsleep 200\nkey f12\nsleep 120\n")
        after = run.state()
        if not after["naming"]:
            raise Failure(f"{chord} closed the rename field")
