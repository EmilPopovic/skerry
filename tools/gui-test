    run.drive("key ctrl+a\nsleep 200\ntext /tmp\nsleep 300\nkey f12\nsleep 150\n")
    expect(run.state(), path_entry="/tmp")
    run.drive("key escape\nsleep 300\nkey f12\nsleep 150\n")
    expect(run.state(), path_entry="", path=start["path"])


@scenario("a-pointer-selects-text-in-the-path-field")
def drag_in_the_path_field(run: Run, fixture: Path) -> None:
    """Ctrl+L, then a drag across the path, and the span it covered is selected.

    The path bar and the rename field are the same one line of editable text, so a
    drag proved here is a drag proved in both — and this is the one a scenario can
    aim at, because the path field's box is reported and a row's is not.

    **Aimed in text widths, not in fractions of the box.** The box is 968 logical
    pixels wide and the path draws in about 220 of them, so a drag from a third to
    two thirds of the *box* starts and ends past the end of the text — where the
    caret correctly goes to the end and nothing is selected at all. That was the
    first version, and it read as a broken drag.
    """
    run.drive("sleep 700\nkey ctrl+l\nsleep 400\nkey f12\nsleep 150\n")
    opened = run.state()
    if not opened["path_entry"]:
        raise Failure("Ctrl+L opened no path field")
    left, top, width, height = (float(value) for value in opened["path_field"].split(","))
    middle = top + height / 2.0

    def at(x: float) -> tuple[float, float]:
        return aim(run, opened, x, middle)

    # From inside the left inset to well past the end of the text: whatever the
    # path is and whatever it measures, that is all of it.
    everything = f"drag {at(left + 4)[0]:.2f} {at(left + 4)[1]:.2f} " \
                 f"{at(left + width * 0.95)[0]:.2f} {at(left + width * 0.95)[1]:.2f}"
    run.drive(
        f"move {at(left + 4)[0]:.2f} {at(left + 4)[1]:.2f}\nsleep 200\n"
        f"{everything}\nsleep 300\nkey f12\nsleep 200\n"
    )
    dragged = run.state()
    if dragged["path_selected"] != opened["path_entry"]:
        raise Failure(
            f"a drag across the whole field selected {dragged['path_selected']!r} "
            f"of {opened['path_entry']!r}"
        )

    # And one keystroke replaces all of it, which is what a selection is for.
    run.drive("text Q\nsleep 300\nkey f12\nsleep 150\n")
    expect(run.state(), path_entry="Q")

    # A short drag selects a span rather than everything: about forty pixels of
    # text, which is a few characters at any size this draws at.
    run.drive("key escape\nsleep 300\nkey ctrl+l\nsleep 400\nkey f12\nsleep 150\n")
    reopened = run.state()
    span = f"drag {at(left + 4)[0]:.2f} {at(left + 4)[1]:.2f} " \
           f"{at(left + 44)[0]:.2f} {at(left + 44)[1]:.2f}"
    run.drive(f"{span}\nsleep 300\nkey f12\nsleep 200\n")
    part = run.state()["path_selected"]
    if not part:
        raise Failure("a short drag selected nothing")
    if part == reopened["path_entry"]:
        raise Failure(f"a short drag selected the whole path: {part!r}")
    if not reopened["path_entry"].startswith(part):
        raise Failure(f"the selection is not the start of the path: {part!r}")

    run.drive("key escape\nsleep 250\nkey f12\nsleep 150\n")
    expect(run.state(), path=opened["path"])


