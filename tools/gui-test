@scenario("nothing-reaches-the-listing-while-a-name-is-being-typed", fresh=True)
def a_field_rejects_the_rest(run: Run, fixture: Path) -> None:
    """The reported defect: the selection moved under the name being typed.

    Keys the field did not handle fell through to the registry and then to the
    type-ahead, so `Ctrl+Backspace` — which was not a text operation yet — jumped
    the cursor to another row. `Ctrl+Shift+N` made a folder, and `Ctrl+Z` walked
    back the last operation on disk.
    """
    run.drive("sleep 700\nkey f12\nsleep 150\n")
    before = run.state()
    rows = int(before["rows"])
    run.drive("text file-1.txt\nsleep 400\nkey f2\nsleep 300\nkey f12\nsleep 150\n")
    opened = run.state()
    expect(opened, cursor="file-1.txt", naming="file-1.txt", selected="1")

    # Every one of these used to reach the listing. None of them may now.
    for chord in ["ctrl+shift+n", "alt+left", "alt+up", "f5", "ctrl+h", "alt+2", "f9"]:
        run.drive(f"key {chord}\nsleep 200\nkey f12\nsleep 120\n")
        after = run.state()
        if not after["naming"]:
            raise Failure(f"{chord} closed the rename field")
        for key in ("cursor", "path", "rows", "hidden", "sort", "selected"):
            if after[key] != opened[key]:
                raise Failure(
                    f"{chord} changed {key}: {opened[key]!r} became {after[key]!r}"
                )

    # And the diagnostic still gets through, which is how this scenario can see
    # anything at all — plus the window's own commands, which is the other half of
    # the line.
    run.drive("key escape\nsleep 300\nkey f12\nsleep 150\n")
    ended = run.state()
    expect(ended, naming="", rows=str(rows))


@scenario("a-field-edits-text-by-word", fresh=True)
def word_editing(run: Run, fixture: Path) -> None:
    """Ctrl+Backspace, Ctrl+Shift+arrows and the field's own undo.

    A word here is a **part of a name**: `file-1.txt` is three of them, because the
    parts are what a person editing a filename edits. Going left skips the
    separators and then the word, so from the end of `file-1.` the word behind the
    caret is `1.` and not `.` — which is what GTK does and what makes a second
    press remove `file-`'s last part rather than one character of punctuation.
    """
    run.drive("sleep 700\ntext file-1.txt\nsleep 500\nkey f2\nsleep 300\n")
    run.drive("key end\nsleep 150\nkey ctrl+backspace\nsleep 250\nkey f12\nsleep 150\n")
    expect(run.state(), naming="file-1.")

    # The separators and then the word.
    run.drive("key ctrl+shift+left\nsleep 250\nkey f12\nsleep 150\n")
    expect(run.state(), naming_selected="1.")

    # And a Backspace over a selection takes all of it.
    run.drive("key ctrl+backspace\nsleep 250\ntext two\nsleep 300\nkey f12\nsleep 150\n")
    expect(run.state(), naming="file-two")

    # The field's own undo takes back the run of typing, and leaves the file undo
    # stack alone — `undo=false` is the whole point, because there has been no
    # operation on disk to take back.
    run.drive("key ctrl+z\nsleep 250\nkey f12\nsleep 150\n")
    undone = run.state()
    expect(undone, naming="file-", undo="false")

    # Ctrl+Y puts it back.
    run.drive("key ctrl+y\nsleep 250\nkey f12\nsleep 150\n")
    expect(run.state(), naming="file-two")
    run.drive("key escape\nsleep 250\n")


@scenario("clicking-beside-the-breadcrumbs-opens-the-path")
def click_the_path_strip(run: Run, fixture: Path) -> None:
    """The empty part of the path bar opens the path for typing.

    The breadcrumbs were already clickable and the space around them did nothing
    at all — which is a strip of chrome that looks like an address bar and is not
    one. Where the window draws its own frame that same strip is the drag region,
    so the press waits to see whether the pointer moves; here the compositor draws
    the frame and there is nothing else the press could mean.
    """
    run.drive("sleep 700\nkey f12\nsleep 150\n")
    start = run.state()
    expect(start, path_entry="")
    crumbs = int(start["crumbs"])
    if crumbs < 2:
        raise Failure("this fixture has no breadcrumbs to sit beside")

    # Well right of the last crumb and left of the hint, at the strip's height.
    left, top, width, height = (float(value) for value in start["path_field"].split(","))
    empty = aim(run, start, left + width * 0.75, top + height / 2.0)
    run.drive(f"move {empty[0]:.2f} {empty[1]:.2f}\nsleep 200\nclick\nsleep 400\n")
    run.drive("key f12\nsleep 150\n")
    opened = run.state()
    if opened["path_entry"] != opened["path"]:
        raise Failure(f"the click opened {opened['path_entry']!r} for {opened['path']!r}")

    # And it is a live field: typing goes into it, and Escape puts the crumbs back.
    run.drive("key ctrl+a\nsleep 200\ntext /tmp\nsleep 300\nkey f12\nsleep 150\n")
    expect(run.state(), path_entry="/tmp")
    run.drive("key escape\nsleep 300\nkey f12\nsleep 150\n")
    expect(run.state(), path_entry="", path=start["path"])


@scenario("a-pointer-selects-text-in-the-path-field")
def drag_in_the_path_field(run: Run, fixture: Path) -> None:
    """Ctrl+L, then a drag across the path, and the span it covered is selected.

    The path bar and the rename field are the same one line of editable text, so a
    drag proved here is a drag proved in both — and this is the one a scenario can
    aim at, because the path field's box is reported and a row's is not.

    **Aimed in text widths, not in fractions of the box.** The box is 968 logical
    pixels wide and the path draws in about 220 of them, so a drag from a third to
    two thirds of the *box* starts and ends past the end of the text — where the
    caret correctly goes to the end and nothing is selected at all. That was the
    first version, and it read as a broken drag.
    """
    run.drive("sleep 700\nkey ctrl+l\nsleep 400\nkey f12\nsleep 150\n")
    opened = run.state()
    if not opened["path_entry"]:
        raise Failure("Ctrl+L opened no path field")
    left, top, width, height = (float(value) for value in opened["path_field"].split(","))
    middle = top + height / 2.0

    def at(x: float) -> tuple[float, float]:
        return aim(run, opened, x, middle)

    # From inside the left inset to well past the end of the text: whatever the
    # path is and whatever it measures, that is all of it.
    everything = f"drag {at(left + 4)[0]:.2f} {at(left + 4)[1]:.2f} " \
                 f"{at(left + width * 0.95)[0]:.2f} {at(left + width * 0.95)[1]:.2f}"
    run.drive(
        f"move {at(left + 4)[0]:.2f} {at(left + 4)[1]:.2f}\nsleep 200\n"
        f"{everything}\nsleep 300\nkey f12\nsleep 200\n"
    )
    dragged = run.state()
    if dragged["path_selected"] != opened["path_entry"]:
        raise Failure(
            f"a drag across the whole field selected {dragged['path_selected']!r} "
            f"of {opened['path_entry']!r}"
        )

    # And one keystroke replaces all of it, which is what a selection is for.
    run.drive("text Q\nsleep 300\nkey f12\nsleep 150\n")
    expect(run.state(), path_entry="Q")

    # A short drag selects a span rather than everything: about forty pixels of
    # text, which is a few characters at any size this draws at.
    run.drive("key escape\nsleep 300\nkey ctrl+l\nsleep 400\nkey f12\nsleep 150\n")
    reopened = run.state()
    span = f"drag {at(left + 4)[0]:.2f} {at(left + 4)[1]:.2f} " \
           f"{at(left + 44)[0]:.2f} {at(left + 44)[1]:.2f}"
    run.drive(f"{span}\nsleep 300\nkey f12\nsleep 200\n")
    part = run.state()["path_selected"]
    if not part:
        raise Failure("a short drag selected nothing")
    if part == reopened["path_entry"]:
        raise Failure(f"a short drag selected the whole path: {part!r}")
    if not reopened["path_entry"].startswith(part):
        raise Failure(f"the selection is not the start of the path: {part!r}")

    run.drive("key escape\nsleep 250\nkey f12\nsleep 150\n")
    expect(run.state(), path=opened["path"])


