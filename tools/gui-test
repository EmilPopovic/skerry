    expect(done, asking="false")
    if (fixture / "beta" / "file-1.txt").read_text() != "the one arriving":
        raise Failure("Replace did not put the arriving file in place")

    # **The displaced file is in the Trash, not gone.** That is the whole reason
    # Replace is allowed to exist here at all.
    run.drive("key ctrl+z\nsleep 2000\nkey f12\nsleep 500\n")
    if (fixture / "beta" / "file-1.txt").read_text() != "the one there":
        raise Failure("undo did not bring back the file that Replace displaced")


