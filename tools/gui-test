@scenario("navigation-buttons")
def navigation_buttons(run: Run, fixture: Path) -> None:
    """Back, forward, parent and reload, clicked rather than pressed.

    Each dispatches the command its chord does, so what is checked is that the
    button and the key are the same action — and that a dimmed one does nothing,
    which is the half a `run` without an `enabled` check would get wrong.
    """
    run.drive("sleep 400\nkey f12\nsleep 200\n")
    state = run.state()
    width = float(state["tool_w"])
    if width <= 0.0:
        raise Failure("the navigation buttons were shed at this window size")
    middle = float(state["body_top"]) / 4.0
    at = {
        name: aim(run, state, width * index + width / 2.0, middle)
        for index, name in enumerate(("back", "forward", "parent", "reload"))
    }

    def point(name: str) -> dict[str, str]:
        x, y = at[name]
        run.drive(f"move {x:.2f} {y:.2f}\nsleep 180\nkey f12\nsleep 150\n")
        found = run.state()
        if found["tool_hover"] != name:
            raise Failure(f"aimed at {name} and hit {found['tool_hover']!r}")
        return found

    # Back has nowhere to go from the directory the window opened on, so a click
    # on it must do nothing at all.
    point("back")
    run.drive("click\nsleep 400\nkey f12\nsleep 200\n")
    expect(run.state(), path=str(fixture))

    # Into `alpha` with the keyboard, out with the Back button.
    run.drive("key down\nkey enter\nsleep 600\nkey f12\nsleep 200\n")
    expect(run.state(), path=str(fixture / "alpha"))
    point("back")
    run.drive("click\nsleep 600\nkey f12\nsleep 200\n")
    expect(run.state(), path=str(fixture))

    # Which is what makes Forward live. Going *up* would not: up is a fresh
    # navigation and ends the forward branch, the same as it does in a browser.
    point("forward")
    run.drive("click\nsleep 600\nkey f12\nsleep 200\n")
    expect(run.state(), path=str(fixture / "alpha"))

    # And the parent button climbs out again.
    point("parent")
    run.drive("click\nsleep 600\nkey f12\nsleep 200\n")
    expect(run.state(), path=str(fixture))

    # And reload re-reads without moving.
    point("reload")
    run.drive("click\nsleep 800\nkey f12\nsleep 200\n")
    state = run.state()
    expect(state, path=str(fixture), loading="false")
    if int(state["rows"]) != 9:
        raise Failure(f"{state['rows']} rows after a reload, wanted 9")


@scenario("breadcrumb-navigation")
def breadcrumb_navigation(run: Run, fixture: Path) -> None:
    """Clicking a path component goes there, and hovering says which.

    The regions come from the frame that drew them, because the width of a
    breadcrumb is the shaped width of a directory name and is known nowhere
    else. This walks two levels down and clicks its way back up one.
    """
    run.drive("sleep 400\nkey f12\nsleep 200\n")
    # Into `alpha`, then into `nested`, so there is a parent worth clicking.
    run.drive("key down\nkey enter\nsleep 500\nkey f12\nsleep 200\n")
    state = run.state()
    expect(state, path=str(fixture / "alpha"))
    deep = int(state["crumbs"])
    if deep < 3:
        raise Failure(f"only {deep} path components under {state['path']}")

    x, y = aim(run, state, float(state["parent_crumb_x"]), float(state["body_top"]) / 4.0)
    run.drive(f"move {x:.2f} {y:.2f}\nsleep 250\nkey f12\nsleep 200\n")
    hovered = run.state()["crumb_hover"]
    if hovered != str(deep - 2):
        raise Failure(f"the parent component reads as crumb {hovered}, wanted {deep - 2}")

    run.drive("click\nsleep 600\nkey f12\nsleep 200\n")
    expect(run.state(), path=str(fixture))


@scenario("own-frame-close-button")
def own_frame_close_button(run: Run, fixture: Path) -> None:
    """The close button in the frame this program draws has to close it.

    GNOME advertises no `zxdg_decoration_manager_v1` at all, so on the most
    common Linux desktop there is no title bar, no close button and no resize
    edges unless the window draws them. `--own-frame` asks for that everywhere,
    which is what makes it testable under a compositor that would otherwise
    decorate.
    """
    run.close()
    own = Run(run.display, run.log.parent, fixture, ["--own-frame"], run.instance)
    try:
        own.drive("sleep 400\nkey f12\nsleep 200\n")
        state = own.state()
        expect(state, frame="own", frame_hover="none")

        # The middle of the title strip: the path bar is the title bar here.
        x, y = aim(own, state, float(state["close_x"]), float(state["body_top"]) / 4.0)
        own.drive(f"move {x:.2f} {y:.2f}\nsleep 200\nkey f12\nsleep 200\n")
        if own.state()["frame_hover"] != "close":
            raise Failure(
                f"the pointer over the close button reads as {own.state()['frame_hover']!r}"
            )

        own.drive("click\nsleep 400\n")
        code = own.process.wait(timeout=10)
        if code < 0:
            raise Failure(f"the close button killed it with signal {-code}")
        if code != 0:
            raise Failure(f"the close button exited {code}: {own.err.read_text()[-300:]}")
    finally:
        own.close()


@scenario("cursor-shapes")
def cursor_shapes(run: Run, fixture: Path) -> None:
    """Sweeps the pointer over every region that names a cursor shape.

    **The shape itself cannot be read back** — no compositor exposes it, and
    Hyprland does not even validate the serial, so an invalid request is not
    observable from here either. What this covers is the half that is: the sweep
    runs the same `cursor_at` hit-testing the shapes come from, the window
    survives it, and the two regions that *do* report — a breadcrumb and a window
    button — report the right thing at the coordinates the shape logic used.

    It needs a floating window, because a tiled one has no resize edges and the
    corner shapes are the interesting half.
    """
    run.close()
    own = Run(run.display, run.log.parent, fixture, ["--own-frame"], run.instance)
    try:
        own.make_floating()
        own.drive("sleep 400\nkey f12\nsleep 200\n")
        state = own.state()
        width, height = (float(v) for v in state["logical"].split("x"))
        if "cursor-shape" not in own.err.read_text():
            raise Failure("the compositor does not name cursor shapes; nothing to test")

        places = [
            (1.0, 1.0),                                  # top left corner
            (width - 1.0, 1.0),                          # top right corner
            (width / 2.0, 1.0),                          # top edge
            (1.0, height / 2.0),                         # left edge
            (width - 1.0, height - 1.0),                 # bottom right corner
            (float(state["parent_crumb_x"]), float(state["body_top"]) / 4.0),
            (float(state["close_x"]), float(state["body_top"]) / 4.0),
            (float(state["size_x"]) + 4.0, float(state["body_top"]) - 8.0),
            (width / 2.0, float(state["body_top"]) + float(state["row_h"]) * 2.0),
        ]
        for logical_x, logical_y in places:
            x, y = aim(own, state, logical_x, logical_y)
            own.drive(f"move {x:.2f} {y:.2f}\nsleep 90\n")
        own.drive("sleep 300\nkey f12\nsleep 200\n")

        if own.process.poll() is not None:
            raise Failure(f"a cursor request killed the window: {own.err.read_text()[-300:]}")
        expect(own.state(), frame="own")

        # The one place the hit-testing behind the shapes is observable at this
        # size — a floating window here is 320x240, which is the toplevel's own
        # minimum, and its path bar is too narrow for a breadcrumb to be a
        # reliable target. `breadcrumb-navigation` covers that one at full size.
        x, y = aim(own, state, float(state["close_x"]), float(state["body_top"]) / 4.0)
        own.drive(f"move {x:.2f} {y:.2f}\nsleep 200\nkey f12\nsleep 150\n")
        expect(own.state(), frame_hover="close")
        if "went away" in own.err.read_text():
            raise Failure(f"the connection died: {own.err.read_text()[-300:]}")
    finally:
        own.close()


@scenario("cursor-says-what-is-clickable", fresh=True)
def cursor_says_what_is_clickable(run: Run, fixture: Path) -> None:
    """A hand where a click does something, and an arrow where it does not.

    The shape itself cannot be read back from any compositor, so what is asserted
    is what the program asked for — which is the half that decides whether the
    interface agrees with itself. Two places got it wrong, and both are ones a
    person meets in the first minute: Back is dimmed until there is somewhere to
    go back to, and "Copy the text inside" is dimmed on a picture.
    """
    (fixture / "photo.png").write_bytes(bytes(range(256)) * 8)
    run.drive("sleep 700\nkey f12\nsleep 150\n")
    state = run.state()
    step = float(state["tool_w"])
    if step <= 0.0:
        raise Skipped("this window is too narrow for the navigation buttons")
    middle = float(state["body_top"]) / 4.0

    # Back, which has nowhere to go, and Reload, which always does.
    for index, wanted, name in [(0, "arrow", "back"), (3, "hand", "reload")]:
        x, y = aim(run, state, step * (index + 0.5), middle)
        run.drive(f"move {x:.2f} {y:.2f}\nsleep 200\nkey f12\nsleep 150\n")
        over = run.state()
        expect(over, tool_hover=name)
        if over["pointer"] != wanted:
            raise Failure(f"over {name} the pointer is a {over['pointer']}, wanted a {wanted}")

    # Then a menu row that cannot run, and one that can.
    run.drive("text photo.png\nsleep 400\nkey f12\nsleep 150\n")
    at_image = run.state()
    expect(at_image, cursor="photo.png")
    point_at(run, int(at_image["cursor_row"]))
    run.drive("click right\nsleep 400\nkey f12\nsleep 150\n")
    opened = run.state()
    if "file.copy_content" not in opened["menu_dim"]:
        raise Failure(f"copy-content is not dimmed on a .png: {opened['menu_dim']!r}")
    for command, wanted in [("file.copy_content", "arrow"), ("file.copy", "hand")]:
