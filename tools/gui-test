def panel_facts(state: dict[str, str]) -> dict[str, str]:
    """The Properties panel's rows, as `{label: value}`."""
    return dict(pair.split("=", 1) for pair in state["facts"].split("|") if "=" in pair)


def a_box(state: dict[str, str], name: str) -> tuple[float, float]:
    """Where one permission box is, by the name the report gives it."""
    for entry in state.get("bits", "").split(","):
        which, _, point = entry.partition("@")
        if which == name:
            x, _, y = point.partition(":")
            return (float(x), float(y))
    raise Failure(f"no {name} box in {state.get('bits')!r}")


@scenario("properties-writes-the-nine-permission-bits", fresh=True)
def properties_writes_the_nine_permission_bits(run: Run, fixture: Path) -> None:
    """**A permission is a control, and `Ctrl+Z` walks it back.**

    Row 6 of [14-first-release.md](../docs/14-first-release.md): the nine bits,
    and nothing above them. Three claims, and the last is the one rule 3 is about:

    * the keyboard alone reaches a box and turns it — `→` walks the nine and
      `Space` answers, which is the settings panel's contract over a panel that
      used to take no key at all;
    * the pointer alone reaches the same box, by the name the report gives it;
    * and the mode on disk goes back to what it was when the change is undone,
      because the change carries both modes.

    The panel is still a statement to every *other* key, so `Escape` is what
    closes it before `Ctrl+Z` — a panel that swallowed the undo it is about would
    be a worse surprise than one press more.
    """
    room = fixture / "bits"
    room.mkdir()
    script = room / "script.sh"
    script.write_text("#!/bin/sh\n")
    script.chmod(0o644)

    run.drive("key ctrl+l\nsleep 250\nkey ctrl+u\n")
    run.drive(f"text {room}\nkey enter\nsleep 900\n")
    listed(run)
    run.drive("key down\nsleep 200\n")
    until(run, cursor="script.sh")

    run.drive("key ctrl+i\nsleep 800\n")
    opened = until_the_panel(run)
    if panel_facts(opened).get("Permissions") != "rw-r--r-- (0644)":
        raise Failure(f"the panel opened on {panel_facts(opened).get('Permissions')!r}")

    # Eight steps right is everyone else's write, counting from the owner's read.
    run.drive("key right\n" * 8 + "sleep 200\n")
    aimed = holds(run, lambda it: it.get("bit_aimed") == "7", "the keyboard on the eighth box")
    run.drive("key space\nsleep 700\n")
    written = holds(
        run,
        lambda it: panel_facts(it).get("Permissions") == "rw-r--rw- (0646)",
        "the panel to report the bit that was turned",
    )
    if script.stat().st_mode & 0o777 != 0o646:
        raise Failure(f"the file is {script.stat().st_mode & 0o777:04o}, not what the panel says")

    # **Out of the panel first**, because every key but its own dismisses it.
    run.drive("key escape\nsleep 200\nkey ctrl+z\nsleep 900\n")
    until(run, properties="")
    if script.stat().st_mode & 0o777 != 0o644:
        raise Failure(f"the undo left {script.stat().st_mode & 0o777:04o} behind")

    # And the same box with the pointer alone, by name rather than by arithmetic.
    run.drive("key ctrl+i\nsleep 800\n")
    drawn = holds(run, lambda it: bool(it.get("bits")), "a panel with drawn permission boxes")
    where = aim(run, drawn, *a_box(drawn, "others_x"))
    run.drive(f"move {where[0]:.2f} {where[1]:.2f}\nclick left\nsleep 700\n")
    holds(
        run,
        lambda it: panel_facts(it).get("Permissions") == "rw-r--r-x (0645)",
        "the box the pointer pressed to be turned",
    )
    if script.stat().st_mode & 0o777 != 0o645:
        raise Failure(f"a pointer left {script.stat().st_mode & 0o777:04o} on disk")
    expect(aimed, properties="script.sh")


@scenario("a-name-service-that-never-answers-costs-no-frame", fresh=True)
def a_name_service_that_never_answers_costs_no_frame(run: Run, fixture: Path) -> None:
    """**Rule 1, one layer out from the filesystem.** `getpwuid_r` consults
    whatever `nsswitch.conf` names, and on a machine joined to a directory one of
    those is a network — so the lookup behind *Owner* is a call that can take as
    long as a server that has gone away takes.

    `SKERRY_DISABLE=names` is that server, in the shape
    [`tools/hung-mount`](hung-mount) makes a filesystem: the facility does not
    refuse, it does not answer. Three claims:

    * the rest of the panel arrives anyway — the size, the mode and the dates are
      a `statx` on another job and must not wait behind a name;
    * the row falls back to the numbers rather than to nothing;
    * and no frame drawn while the lookup is parked misses the 8 ms budget.

    The budget claim is a **delta** on `over`, never a percentile, for the reason
    `a-hung-mount-never-blocks-the-frame-loop` gives at length: this window has
    drawn a dozen frames of the 480 the ring keeps, so a p99 over it is the worst
    frame since start-up and includes opening the window.
    """
    import re

    run.close()
    own = Run(run.display, run.log.parent, fixture, [], run.instance, {"SKERRY_DISABLE": "names"})
    try:
        opening = listed(own)
        missed = int(opening["over"])
        drawn = int(opening["frames"])

        def inside_the_budget(answer: dict[str, str], when: str) -> None:
            if int(answer["over"]) > missed:
                raise Failure(
                    f"{int(answer['over']) - missed} frame(s) of "
                    f"{int(answer['frames']) - drawn} drawn {when} missed the 8 ms budget "
                    f"(p99 {answer['frame_p99_us']}us)"
                )

        own.drive("key down\nsleep 200\nkey ctrl+i\nsleep 900\n")
        panel = until_the_panel(own)
        facts = panel_facts(panel)
        if facts.get("Kind") not in ("File", "Folder"):
            raise Failure(f"the panel says the kind is {facts.get('Kind')!r}")
        if "(0" not in facts.get("Permissions", ""):
            raise Failure(f"the permissions read {facts.get('Permissions')!r}")
        if not re.fullmatch(r"\d+:\d+", facts.get("Owner", "")):
            raise Failure(
                f"the owner reads {facts.get('Owner')!r} — a name service that never "
                "answered was answered"
            )
        inside_the_budget(panel, "with the name lookup parked")

        # Three fresh answers with the lookup still parked, which is the claim
        # stated as an experiment rather than as a structure.
        for attempt in range(3):
            alive = own.answered(settle=200)
            if alive is None:
                raise Failure(f"the window stopped answering while a name hung ({attempt})")
            inside_the_budget(alive, "while a name lookup hung")
        if not re.fullmatch(r"\d+:\d+", panel_facts(own.state()).get("Owner", "")):
            raise Failure("a name arrived after all")
    finally:
        own.close()


def until_the_panel(run: Run) -> dict[str, str]:
    """Waits for the Properties panel to be up, and returns that state."""
    deadline = time.time() + WAITING
    while time.time() < deadline:
        state = run.answered()
        if state and state.get("properties"):
            return state
    raise Failure("the panel never opened")


def on_the_bus(run: Run, arguments: list[str]) -> str:
    """Runs `dbus-send` against this scenario's own bus. Its reply, or a failure.

    A real client's marshaller against ours, which is the half of
    [ADR 0023](../docs/adr/0023-d-bus-is-a-socket-we-speak-ourselves.md) a unit
    test cannot reach: our own reader parsing bytes our own writer produced would
    agree with itself about a padding rule we had got wrong.
    """
    # **`--session`, never `--address`.** With `--address` libdbus opens the
    # socket and sends the call *without* `Hello`, and `dbus-daemon` disconnects
    # any client that speaks before it registers — which surfaces as an instant
    # `NoReply` naming four causes, none of them this one. Half an hour was spent
    # reading a reply path that was already correct.
    done = subprocess.run(
        [
            "dbus-send",
            "--session",
            "--print-reply",
            "--dest=dev.skerry.Skerry",
            "/org/freedesktop/FileManager1",
            *arguments,
        ],
        env=run.environment,
        capture_output=True,
        text=True,
        timeout=10,
        check=False,
    )
    if done.returncode != 0 or "Error" in done.stdout:
        raise Failure(f"dbus-send failed: {(done.stderr + done.stdout).strip()[:300]}")
    return done.stdout


@scenario("the-desktop-asks-for-a-file-and-the-window-shows-it", fresh=True, bus=True)
def file_manager_one(run: Run, fixture: Path) -> None:
    """`org.freedesktop.FileManager1`, called by `dbus-send` as a desktop calls it.

    Three methods, one window. `ShowItems` is what a browser's *Open containing
    folder* sends and it has to land on the file, not merely in the folder;
    `ShowFolders` is a navigation; `ShowItemProperties` opens a panel about a row
    that does not exist yet when the call is answered — the reply says the request
    arrived, and the panel waits for the read.
    """
    listed(run)
    inner = fixture / "alpha"
    target = inner / "inner.txt"
    if not target.is_file():
        raise Failure(f"the fixture has no {target}")

    # Introspection first: it is how a desktop finds out we answer at all, and a
    # reply that is not well-formed XML is one every caller gives up on.
    xml = on_the_bus(run, ["org.freedesktop.DBus.Introspectable.Introspect"])
    for member in ("ShowFolders", "ShowItems", "ShowItemProperties"):
        if member not in xml:
            raise Failure(f"the introspection does not name {member}")

    on_the_bus(run, [
        "org.freedesktop.FileManager1.ShowItems",
        f"array:string:file://{target}",
        "string:",
    ])
    until(run, path=str(inner), cursor="inner.txt")

    # **And the window asks to come forward.** *Show me this* is half-answered by
    # a window that navigates behind three others. The token is the caller's —
    # a desktop puts an activation token in `StartupId`, and on Wayland it is the
    # only thing that lets a client be raised at all. What is asserted is that the
    # window asked, and on this display server that it had a way to: whether the
    # compositor grants it is the compositor's business and not a claim this suite
    # can make.
    on_the_bus(run, [
        "org.freedesktop.FileManager1.ShowItems",
        f"array:string:file://{target}",
        "string:skerry-test-token",
    ])
    asked = holds(run, lambda it: it["raises"].split("/")[0] != "0", "a raise")
    tried, answered = (int(it) for it in asked["raises"].split("/"))
    if tried < 1:
        raise Failure("the window never asked to be raised")
    if isinstance(SERVER, X11Server) and answered < 1:
        raise Failure("X11 has _NET_ACTIVE_WINDOW and the window did not send it")

    on_the_bus(run, [
        "org.freedesktop.FileManager1.ShowFolders",
        f"array:string:file://{fixture}",
        "string:",
    ])
    until(run, path=str(fixture))

    on_the_bus(run, [
        "org.freedesktop.FileManager1.ShowItemProperties",
        f"array:string:file://{target}",
        "string:",
    ])
    # **Not `run.state()` straight after the navigation.** The panel is opened on
    # the pass that takes delivery of the listing, which is at least one after the
    # one the cursor lands on — asserting on the state that first reported the
    # cursor is asserting a frame too early, and it failed exactly that way.
    panel = until_the_panel(run)
    facts = dict(pair.split("=", 1) for pair in panel["facts"].split("|") if "=" in pair)
    if facts.get("Where") != str(inner):
        raise Failure(f"the panel is about something in {facts.get('Where')!r}")


@scenario("a-second-skerry-hands-its-folder-over-and-exits", fresh=True, bus=True)
def one_instance(run: Run, fixture: Path) -> None:
    """Rule 4's *one window* half: a second `skerry` is a request, not a window.

    Our own client against our own service, and the other direction from the
    `dbus-send` scenario above. The second process must exit **without drawing**
    — a window opened and closed again flashes one — so this asserts on its exit
    code and on the first window having moved, not on any state of its own.
    """
    listed(run)
    inner = fixture / "alpha"
    started = time.time()
    done = subprocess.run(
        [str(SKERRY), str(inner)],
        env=run.environment,
        capture_output=True,
        text=True,
        timeout=20,
        check=False,
    )
    if done.returncode != 0:
        raise Failure(f"the second instance exited {done.returncode}: {done.stderr[:300]}")
    if "first frame" in done.stderr:
        raise Failure("the second instance drew a window before handing over")
    # Half a millisecond of bus, measured in ADR 0023, against a cold start of
    # ninety: a second instance that took as long as a window would have opened
    # one somewhere.
    if (elapsed := time.time() - started) > 2.0:
        raise Failure(f"handing over took {elapsed:.1f}s")
    until(run, path=str(inner))


@scenario("a-second-skerry-naming-nothing-opens-a-window", fresh=True, bus=True)
def another_window(run: Run, fixture: Path) -> None:
    """A bare second `skerry` is a window of its own — ADR 0044.

    The launcher clicked a second time. Handing over asked the first window to
    come forward without a token, which Wayland refuses, so nothing was seen; it
    has to draw instead, and the first window must not have moved.
    """
    listed(run)
    before = run.state()["path"]
    second = subprocess.Popen(
        [str(SKERRY)],
        env=run.environment,
        stderr=subprocess.PIPE,
        stdout=subprocess.DEVNULL,
        text=True,
    )
    try:
        drawn, said = False, ""
        deadline = time.time() + PATIENCE
        while time.time() < deadline and not drawn:
            ready, _, _ = select.select([second.stderr], [], [], 0.2)
            if ready:
                line = second.stderr.readline()
                said += line
                drawn = "first frame" in line
            if second.poll() is not None and not drawn:
                raise Failure(f"the second instance exited {second.returncode}: {said[-300:]}")
        if not drawn:
            raise Failure(f"the second instance drew nothing: {said[-300:]}")
    finally:
        second.kill()
        second.wait(timeout=PATIENCE)
    expect(run.state(), path=before)


def started_by_the_bus(marker: str) -> list[int]:
    """The `skerry` processes running with `marker` in their environment.

    A service the bus activated is nobody's child here, so it cannot be waited
    on or killed through a handle — and a window left running after a scenario
    is a window in the session of whoever ran the suite. The marker is this
    scenario's own `XDG_STATE_HOME`, which nothing else on the machine has.
    """
    found = []
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        try:
            if entry.joinpath("exe").resolve() != SKERRY.resolve():
                continue
            if marker.encode() not in entry.joinpath("environ").read_bytes():
                continue
        except OSError:
            continue
        found.append(int(entry.name))
    return found


@scenario("the-desktop-starts-a-closed-skerry-and-it-shows-the-file", fresh=True)
def activation_file(run: Run, fixture: Path) -> None:
    """**`ShowItems` with no window open, which is a different question.**

    `org.freedesktop.FileManager1` is answered by a window that is *running*. A
    browser's *Open containing folder* with nothing running needs the bus to know
    what to **start**, and that is a `.service` file. The one under `/usr/share`
    belongs to whichever file manager the distribution packaged — Nautilus, on
    the machine this was written on — so Skerry writes its own into
    `$XDG_DATA_HOME`, which wins over it by order, from the settings row that is
    already the one decision about being the file manager. See
    `crates/sk-desktop/src/activation.rs`.

    Three processes over one bus: a window that turns the row on, then no window
    at all, then the window the **bus** starts — whose log is the daemon's own
    stdout, because a service the bus activated inherits its descriptors.

    `gdbus` rather than our own client, for the reason the accessibility scenario
    uses it: activation is glib's most travelled path into a bus, and a call made
    with the marshaller that answers it agrees with itself and with nobody else.
    """
    if not shutil.which("dbus-daemon"):
        raise Skipped("no dbus-daemon on this machine")
    if not shutil.which("gdbus"):
        raise Skipped("no gdbus to call the desktop's own method with")
    target = fixture / "alpha" / "inner.txt"
    if not target.is_file():
        raise Failure(f"the fixture has no {target}")
    run.close()

    home = run.log.parent / "activation"
    home.mkdir(parents=True, exist_ok=True)
    place = {
        "XDG_CONFIG_HOME": str(home / "config"),
        "XDG_STATE_HOME": str(home / "state"),
        "XDG_DATA_HOME": str(home / "data"),
    }
    # **The daemon's own environment, because that is what it hands anything it
    # starts.** The display server and these three directories go here rather
    # than on a window, since the window under test is the one this harness never
    # launches.
    bus = PrivateBus(home, environment=with_server(place), output=home / "activated.log")
    service = Path(place["XDG_DATA_HOME"], "dbus-1/services/org.freedesktop.FileManager1.service")
    speaking = {**place, "DBUS_SESSION_BUS_ADDRESS": bus.address}

    def ask(*arguments: str, patience: float = 60.0) -> str:
        done = subprocess.run(
            ["gdbus", *arguments],
            env=with_server(speaking),
            capture_output=True,
            text=True,
            timeout=patience,
            check=False,
        )
        if done.returncode != 0:
            said = (done.stderr + done.stdout).strip()[:300]
            raise Failure(f"gdbus {' '.join(arguments)}: {said}")
        return done.stdout.strip()

    try:
        own = Run(run.display, run.log.parent, fixture, [], run.instance, speaking)
        try:
            listed(own)
            state = settings_open(own)
            # The row's index comes from the panel rather than from a count kept
            # here: `settings::rows` decides the order and a seventh setting
            # would move it.
            order = list(settings_of(state))
            if "handler" not in order:
                raise Failure(f"the settings panel has no handler row: {order}")
            yes = a_control(own, state, order.index("handler"), "yes")
            own.drive(f"move {yes[0]:.2f} {yes[1]:.2f}\nclick left\nsleep 400\nkey f12\nsleep 200\n")
            holds(
                own,
                lambda it: settings_of(it).get("handler", ("",))[0] == "true",
                "the handler row to say yes",
            )
            deadline = time.time() + WAITING
            while time.time() < deadline and not service.is_file():
                time.sleep(0.1)
            if not service.is_file():
                raise Failure(f"the row wrote no {service}")
            written = service.read_text()
            if f"Exec='{SKERRY.resolve()}'" not in written:
                raise Failure(f"the service file does not start this binary:\n{written}")
        finally:
            own.close()

        # **The name has to be free first**, or the bus answers from the window
        # that is closing instead of starting one — which would pass while
        # testing nothing at all.
        deadline = time.time() + WAITING
        while time.time() < deadline:
            if "false" in ask(
                "call", "--session", "--dest", "org.freedesktop.DBus",
                "--object-path", "/org/freedesktop/DBus",
                "--method", "org.freedesktop.DBus.NameHasOwner",
                "org.freedesktop.FileManager1",
            ):
                break
            time.sleep(0.2)
        else:
            raise Failure("the closed window still owns org.freedesktop.FileManager1")

        # The call a browser makes. The bus starts the program the file names,
        # holds this message until it owns the name, and only then delivers it —
        # so a reply at all is the whole of `take_the_name` having run first.
        ask(
            "call", "--session", "--timeout", "45",
            "--dest", "org.freedesktop.FileManager1",
            "--object-path", "/org/freedesktop/FileManager1",
            "--method", "org.freedesktop.FileManager1.ShowItems",
            f"['file://{target}']", "''",
        )

        errors = home / "activated.log.err"
        deadline = time.time() + PATIENCE
        while time.time() < deadline and "first frame" not in errors.read_text():
            time.sleep(0.1)
        if "first frame" not in errors.read_text():
            raise Failure(f"the bus started no window: {errors.read_text()[-400:]}")

        # And it is showing the file, not merely the folder. Driven through the
        # display server because the focused window is the activated one, and
        # read out of the daemon's stdout because that is where its log went.
        inner, seen = fixture / "alpha", {}
        deadline = time.time() + WAITING
        while time.time() < deadline:
            send("key f12\nsleep 250\n")
            found = states_in((home / "activated.log").read_text())
            seen = found[-1] if found else {}
            if seen.get("path") == str(inner) and seen.get("cursor") == target.name:
                break
        else:
            raise Failure(f"the window the bus started is showing {seen.get('path')!r}")
    finally:
        for pid in started_by_the_bus(place["XDG_STATE_HOME"]):
            with contextlib.suppress(OSError):
                os.kill(pid, signal.SIGKILL)
        bus.stop()


@scenario("an-input-method-composes-into-a-field")
def input_method(run: Run, fixture: Path) -> None:
    """A real input method types into the rename field.

    **Wayland only.** `text-input-v3` is the protocol a Chinese, Japanese or
    Korean input method reaches a client through, and X11's equivalent is XIM,
    which is not written — the window reports the capability absent there.

    The peer is `skerry-drive --ime`, which speaks `zwp_input_method_v2`: it
    waits for the window to *enable* its text input, shows a preedit, holds it,
    then commits. Without a peer this whole path is a conversation with nobody,
    and a client that dropped every event would look exactly like one that works.
    """
    if SERVER.driver_flag() != "--wayland":
        raise Skipped("text-input-v3 is Wayland's; X11 reports the capability absent")

    run.drive("sleep 500\nkey down\nsleep 200\nkey f2\nsleep 500\nkey f12\nsleep 200\n")
    naming = run.state()
    if not naming["naming"]:
        raise Failure("the rename field did not open")

    # **Its output goes to a file, not a pipe.** A `peek` on a pipe blocks, and
    # the first version of this hung the whole suite for ten minutes reading the
    # peer's stderr to explain a failure.
    said = run.log.parent / "ime.err"
    with said.open("wb") as errors:
        peer = subprocess.Popen(
            [str(DRIVE), "--ime", "にほん", "日本", "900"],
            env=with_server(),
            stdout=subprocess.DEVNULL,
            stderr=errors,
        )
    try:
        # While the preedit is held: shown, and *not* part of the name.
        run.drive("sleep 500\nkey f12\nsleep 200\n")
        composing = run.state()
        if composing["composing"] != "にほん":
            raise Failure(f"composing is {composing['composing']!r}")
        if "にほん" in composing["naming"]:
            raise Failure("the preedit was typed into the name before it was committed")

        # **Resized while the method is composing.** The caret's rectangle
        # changes, so the window sends a new one and commits mid-conversation —
        # and what is asserted below is that the commit still lands. It does
        # *not* reach the serial-mismatch branch: that needs the compositor to
        # answer a stale commit, which nothing here can arrange, and the branch
        # follows the specification rather than a test.
        run.make_floating()
        SERVER.resize(900, 600)

        # And after the commit: in the name, and no longer composing.
        peer.wait(timeout=10)
        run.drive("sleep 400\nkey f12\nsleep 200\n")
        committed = run.state()
        expect(committed, composing="")
        if "日本" not in committed["naming"]:
            raise Failure(f"the name reads {committed['naming']!r}")
    finally:
        if peer.poll() is None:
            peer.kill()
        peer.wait(timeout=5)
        if peer.returncode not in (0, -9) and said.exists():
            raise Failure(f"the input method refused: {said.read_text().strip()[:200]}")


@scenario("a-permanent-delete-asks-in-a-panel", fresh=True)
def permanent_delete(run: Run, fixture: Path) -> None:
    """`Shift+Delete` asks a question, and only an answer deletes anything.

    Rule 3 calls permanent deletion "an explicit, differently-shaped action" and
    leaves it off the undo stack. The shape used to be a sentence in the status
    strip, in the same dim grey as the row count, armed for exactly as long as
    that sentence stayed up — so **anything else replacing the notice silently
    withdrew the offer**, which the old version of this scenario asserted as
    though it were the feature. The wait below is what that could not survive.
    """
    listed(run)
    run.drive("key end\n")
    chosen = until(run, selected="1")["cursor"]
    if not chosen:
        raise Failure("nothing is selected to delete")
    doomed = fixture / chosen

    run.drive("key shift+delete\n")
    asked = until(run, erasing="1")
    # Cancel is the one the keyboard starts on: the answer a hand arrives at by
    # reflex has to be the safe one.
    expect(asked, erasing_on="cancel")
    if not doomed.exists():
        raise Failure("asking deleted it")

    # **Six seconds**, which is half again the old notice window. The question is
    # still there, and still the same question.
    run.drive("sleep 6000\n")
    expect(until(run, erasing="1"), erasing_on="cancel")

    run.drive("key escape\n")
    until(run, erasing="0")
    if not doomed.exists():
        raise Failure("cancelling deleted it")

    # Twice in a row is the keyboard's fast path, and the second press is the
    # answer rather than a repeat of the question.
    run.drive("key shift+delete\nkey shift+delete\n")
    state = settled(run)
    if doomed.exists():
        raise Failure(
            f"answering left {doomed.name} behind: erasing={state.get('erasing')} "
            f"on={state.get('erasing_on')} busy={state.get('busy')} "
            f"queue={state.get('queue')} cursor={state.get('cursor')!r}"
        )
    expect(state, erasing="0")

    # And it is not on the undo stack: `Ctrl+Z` must not claim to bring it back.
    run.drive("key ctrl+z\n")
    settled(run)
    if doomed.exists():
        raise Failure("undo brought back a permanent delete")


@scenario("a-picture-that-will-not-decode-is-asked-for-once", fresh=True)
def a_picture_that_will_not_decode_is_asked_for_once(run: Run, fixture: Path) -> None:
    """One truncated PNG in view, and a window nobody touches stays still.

    **Measured before the fix: 535 ticks of CPU in five idle seconds**, more than
    a core, because a row the atlas does not hold is asked for on every frame and
    a refusal lands, marks the window dirty and is asked for again — so the
    helper decoded the same broken file for as long as it stayed on screen.

    **Frames as well as ticks**, and that is why the idle scenario did not catch
    it. That gate excuses CPU spent on drawing, because a stray event draws a
    frame and that is correct; this loop draws a frame every cycle, so it read as
    a busy window rather than an idle one. Here nothing should be drawn at all.
    """
    (fixture / "broken.png").write_bytes(b"\x89PNG\r\n\x1a\nnot a picture at all")
    run.drive("key f5\nsleep 900\n")
    listed(run)
    # Long enough for the one refusal to arrive and be drawn as a mark.
    run.drive("sleep 2000\nkey f12\nsleep 200\n")
    before = run.state()
    ticks = lambda: sum(
        int(value) for value in Path(f"/proc/{run.process.pid}/stat").read_text().split()[13:15]
    )
    start = ticks()
    time.sleep(3.0)
    spent = ticks() - start
    run.drive("key f12\nsleep 200\n")
    after = run.state()
    # One frame is the `F12` that reads the state.
    drawn = int(after["frames"]) - int(before["frames"]) - 1
    if drawn > 5 or spent > 30:
        raise Failure(
            f"an untouched window with one undecodable picture drew {drawn} frames and "
            f"spent {spent} ticks of CPU in three seconds — the refusal is being asked for again"
        )


@scenario("keyboard-new-file", fresh=True)
def keyboard_new_file(run: Run, fixture: Path) -> None:
    """`Ctrl+Alt+N` makes an empty file and names it — and `Ctrl+Z` will not take
    back one somebody has written in.

    The same two steps a new folder takes, made under its placeholder and then
    renamed, and one refusal a folder gets from `rmdir` for free: once the file
    holds anything, its undo stops, because an undo that deleted what somebody
    typed would not be one.
    """
    expect(listed(run), rows="9", undo="false")

    # Made and abandoned under its placeholder, then undone: an empty file goes.
    run.drive("key ctrl+alt+n\n")
    expect(until(run, naming="New file"), rows="10")
    run.drive("key escape\n")
    until(run, naming="", undo="true")
    if not (fixture / "New file").is_file():
        raise Failure("the new file is not on the disk")
    run.drive("key ctrl+z\n")
    expect(until(run, rows="9", redo="true"), undo="false")
    if (fixture / "New file").exists():
        raise Failure("undo left an empty new file behind")

    # Made, named, and written in by somebody else before the undo.
    run.drive("key ctrl+alt+n\n")
    until(run, naming="New file")
    run.drive("key ctrl+u\ntext notes.txt\nsleep 200\nkey enter\n")
    expect(until(run, naming="", undo="true"), rows="10")
    made = fixture / "notes.txt"
    if not made.is_file() or made.stat().st_size != 0:
        raise Failure("notes.txt is not an empty file on the disk")
    made.write_text("a line somebody typed")
    run.drive("key ctrl+z\n")
    until(run, cursor="New file", redo="true")
    run.drive("key ctrl+z\nsleep 600\nkey f12\nsleep 200\n")
    said = settled(run)
    kept = fixture / "New file"
    if not kept.is_file() or kept.read_text() != "a line somebody typed":
        raise Failure(f"undo removed a file somebody had written in: {said.get('notice')!r}")
    if not said.get("notice"):
        raise Failure("the refused undo said nothing")


