    run.drive(
        f"move {from_point[0]:.1f} {from_point[1]:.1f}\nsleep 200\npress\nsleep 150\n"
        + creep(from_point, onto)
        + "sleep 300\nkey f12\nsleep 200\n"
    )
    over = run.state()
    # The tab is the target *before* it is the one showing, which is what makes
    # the mark on it honest — and three hundred milliseconds is not a rest, so
    # the strip has not moved yet.
    expect(over, dragging="true", carrying="file-1.txt", drop_tab="1", tab="0")

    run.drive("sleep 1200\nkey f12\nsleep 250\n")
    sprung = run.state()
