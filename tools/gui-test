@scenario("a-tab-answers-a-click-a-double-click-and-its-cross")
def tab_pointer(run: Run, fixture: Path) -> None:
    """Every tab action is reachable with a pointer alone.

    A click picks the tab, a double click closes it, and so does the cross —
    which are three gestures and, through the registry, one action.
    """
    run.drive("sleep 500\nkey ctrl+t\nsleep 600\nkey f12\nsleep 200\n")
    state = run.state()
    expect(state, tabs="2", tab="1")

    first = tab_aim(run, state, 0)
    run.drive(f"move {first[0]:.1f} {first[1]:.1f}\nsleep 200\nclick\nsleep 400\nkey f12\nsleep 200\n")
    expect(run.state(), tab="0", tabs="2")

    state = run.state()
    crosses = [it for it in state.get("tab_cross", "").split(",") if it]
    if len(crosses) != 2:
        raise Failure(f"the tabs drew {len(crosses)} crosses, wanted two")
    x, _, y = crosses[0].partition(":")
    cross = aim(run, state, float(x), float(y))
    run.drive(f"move {cross[0]:.1f} {cross[1]:.1f}\nsleep 200\nclick\nsleep 500\nkey f12\nsleep 200\n")
    expect(run.state(), tabs="1")

    # A double click anywhere on a tab closes it too — on the *body* of the tab
    # rather than its cross, which the click before this one already covered.
    run.drive("key ctrl+t\nsleep 600\nkey f12\nsleep 200\n")
    two = run.state()
    expect(two, tabs="2")
    body = tab_aim(run, two, 0)
    run.drive(f"move {body[0]:.1f} {body[1]:.1f}\nsleep 250\ndouble\nsleep 600\nkey f12\nsleep 300\n")
    expect(run.state(), tabs="1")

    # And the last tab of the last pane closes the window, which is what
    # `Ctrl+W` does and what a person who has used a browser expects.
    last = tab_aim(run, run.state(), 0)
    run.drive(f"move {last[0]:.1f} {last[1]:.1f}\nsleep 250\ndouble\n")
    if not run.ended():
        raise Failure("a double click on the last tab left the window open")


def plus_aim(run: Run, state: dict[str, str]) -> tuple[float, float]:
    """Where to click the `+` at the end of the focused pane's tabs."""
    x, _, y = state.get("plus_aim", "").partition(":")
    if not x:
        raise Failure("the window reported no plus")
    return aim(run, state, float(x), float(y))


@scenario("the-plus-opens-a-tab")
def plus(run: Run, fixture: Path) -> None:
    """The one control that opens a tab, reachable before there are any.

    A strip that appeared with the second tab hid it until somebody had already
    opened one by other means, which is why the strip is always there.
    """
    run.drive("sleep 500\nkey f12\nsleep 200\n")
    start = run.state()
    expect(start, tabs="1")
    where = plus_aim(run, start)
    run.drive(f"move {where[0]:.1f} {where[1]:.1f}\nsleep 250\nclick\nsleep 700\nkey f12\nsleep 300\n")
    after = run.state()
    expect(after, tabs="2", path=start["path"])
    # And it follows the tabs rather than the window's edge, so it is still
    # beside the last one.
    if float(after["plus_aim"].split(":")[0]) <= float(start["plus_aim"].split(":")[0]):
        raise Failure("the plus did not move along with the tabs")


@scenario("dragging-a-tab-splits-the-window")
def drag_a_tab(run: Run, fixture: Path) -> None:
    """A tab dragged to the edge of a pane splits it; dragged back, it rejoins.

    The five zones are unit-tested in `panes.rs`; what this covers is the whole
    gesture — the press that becomes a drag, the overlay, and a drop that moves
    the pane rather than the tab it came from.
    """
    run.drive("sleep 500\nkey ctrl+t\nsleep 700\nkey f12\nsleep 300\n")
    two = run.state()
    expect(two, tabs="2", panes="1")

    # The second tab, dragged to the right edge of the pane it is in.
    tab = tab_aim(run, two, 1)
    body_top = float(two["body_top"])
    height = float(two["logical"].split("x")[1])
    width = float(two["logical"].split("x")[0])
    edge = aim(run, two, width * 0.95, body_top + (height - body_top) * 0.5)
    run.drive(
        f"move {tab[0]:.1f} {tab[1]:.1f}\nsleep 200\npress\nsleep 150\n"
        f"move {edge[0]:.1f} {edge[1]:.1f}\nsleep 350\nkey f12\nsleep 200\n"
    )
    # The overlay says where it would land before the button comes up.
    if run.state()["tab_drop"] != "split":
        raise Failure(f"the overlay says {run.state()['tab_drop']!r}")
    run.drive("release\nsleep 800\nkey f12\nsleep 400\n")

    split = run.state()
    expect(split, panes="2", tabs="1")
    sizes = [float(size.split("x")[0]) for size in split["pane_sizes"].split(",")]
    if abs(sizes[0] - sizes[1]) > 2.0:
        raise Failure(f"the halves are {sizes}")
    if split["pane_focus"] != "1":
        raise Failure("the keyboard did not follow the tab into its new pane")

    # Dragged back into the other pane's strip, the split collapses again.
    back = run.state()
    tab = tab_aim(run, back, 0)
    strips = [it for it in back["strip_aim"].split(",") if it]
    x, _, y = strips[0].partition(":")
    into = aim(run, back, float(x) + 30.0, float(y))
    run.drive(
        f"move {tab[0]:.1f} {tab[1]:.1f}\nsleep 200\npress\nsleep 150\n"
        f"move {into[0]:.1f} {into[1]:.1f}\nsleep 300\nrelease\nsleep 900\nkey f12\nsleep 400\n"
    )
    joined = run.state()
    expect(joined, panes="1", tabs="2")


@scenario("a-tab-dropped-on-another-pane-joins-it")
def drop_a_tab_on_a_pane(run: Run, fixture: Path) -> None:
    """A tab let go over the middle of the other half lands in that half's strip.

    **The middle of a pane, not its strip.** The edges split and the strip
    inserts, and both are aimed at; the middle is where a hand lets go when it
    means "over there", and the overlay has to say so where the hand is.
    """
    run.drive("sleep 500\nkey f3\nsleep 800\nkey ctrl+t\nsleep 700\nkey f12\nsleep 300\n")
