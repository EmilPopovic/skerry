@scenario("the-layout-survives-kill-9", fresh=True)
def the_session_survives(run: Run, fixture: Path) -> None:
    """Rule 6, at the signal it names.

    Build a layout — a split, two tabs, the light palette, hidden files, a zoom
    step — then `kill -9` and start again with no path, and it is all there.
    `kill -9` rather than a clean exit on purpose: the clean exit writes the file
    on its way out, so a test that used one would pass with no periodic save at
    all, and rule 6's stated failure is losing state to a hard kill.
    """
    run.close()
    state = run.log.parent / "state" / "kill-9"
    home = run.log.parent / "home-kill-9"
    home.mkdir(parents=True, exist_ok=True)
    place = {"XDG_STATE_HOME": str(state), "HOME": str(home)}

    built = Run(run.display, run.log.parent, fixture, [], run.instance, place)
    try:
        listed(built)
        # A split whose halves show different directories, a second tab in the
        # first of them, and three settings that are not the defaults.
        built.drive("text alpha\nsleep 500\nkey shift+enter\nsleep 900\n")
        listed(built)
        built.drive("key ctrl+t\nsleep 700\nkey ctrl+h\nsleep 300\n")
        built.drive("key ctrl+shift+d\nsleep 300\nkey ctrl+=\nsleep 300\nkey f12\nsleep 250\n")
        before = built.state()
        # Asserted as the values they are, not just carried: a scenario that only
        # compared before with after would pass with nothing restored and nothing
        # changed either.
        expect(before, panes="2", tabs="2", theme="light", hidden="true", zoom="3")
        wanted = (before["pane_paths"], before["theme"], before["hidden"], before["zoom"])

        # Long enough for the two-second floor to have let a write through, and
        # then killed outright.
        built.drive("sleep 2500\nkey f12\nsleep 200\n")
        saved = state / "skerry" / "session"
        if not saved.is_file():
            raise Failure(f"nothing was written to {saved}")
        text = saved.read_text()
        if not text.startswith("skerry 1\n"):
            raise Failure(f"the file does not start with a version line: {text[:40]!r}")
        built.kill()
    finally:
        built.close()

    back = Run(run.display, run.log.parent, None, [], run.instance, place)
    try:
        listed(back)
        back.drive("sleep 400\nkey f12\nsleep 200\n")
        after = back.state()
        got = (after["pane_paths"], after["theme"], after["hidden"], after["zoom"])
        if got != wanted:
            raise Failure(f"came back as {got}, was {wanted}")
        expect(after, panes="2", tabs="2")
    finally:
        back.close()

    # And a path named on the command line is an explicit request, so the saved
    # layout stays saved rather than being opened over the top of it.
    named = Run(run.display, run.log.parent, fixture, [], run.instance, place)
    try:
        listed(named)
        expect(named.state(), panes="1", tabs="1")
    finally:
        named.close()


@scenario("a-search-finds-a-file-three-folders-down", fresh=True)
def subtree_search(run: Run, fixture: Path) -> None:
    """`Ctrl+Shift+F`, type, and results arrive from folders that are not open.

    The find popup narrows the listing already on screen; this walks the tree
    under it. What the assertions cover is the difference: a file in
    `alpha/nested`, which no listing in this window has ever held, and `Enter`
    landing the pane on it.
    """
    (fixture / "alpha" / "nested" / "buried-treasure.txt").write_text("here")
    (fixture / "beta" / "treasure-map.txt").write_text("there")
    listed(run)
    here = run.state()

    run.drive("key ctrl+shift+f\nsleep 400\nkey f12\nsleep 200\n")
    expect(run.state(), searching="true", search_hits="0")
    # Typed a character at a time, which is what restarts the walk each time.
    run.drive("text treasure\nsleep 250\n")
    found = None
    for _ in range(40):
        run.drive("key f12\nsleep 120\n")
        state = run.state()
        if state["searching"] == "true" and state["search_done"] == "true":
            found = state
            break
    if found is None:
        raise Failure("the walk never finished")
    expect(found, search_query="treasure", search_hits="2")

    # The list is in walk order, so which one is first is not a promise. Both are
    # reachable, and one of them is three folders down.
    run.drive("key down\nsleep 150\nkey f12\nsleep 150\n")
    second = run.state()["search_active"]
    run.drive("key up\nsleep 150\nkey f12\nsleep 150\n")
    first = run.state()["search_active"]
    if {first, second} != {"buried-treasure.txt", "treasure-map.txt"}:
        raise Failure(f"the results are {first!r} and {second!r}")

    # Onto the buried one, and Enter goes to the folder holding it.
    if first != "buried-treasure.txt":
        run.drive("key down\nsleep 150\n")
    run.drive("key enter\nsleep 1200\n")
    landed = listed(run)
    expect(landed, searching="false", cursor="buried-treasure.txt")
    if landed["path"] != str(fixture / "alpha" / "nested"):
        raise Failure(f"Enter landed on {landed['path']!r}")

    # A query that matches nothing says so rather than showing the last answer.
    run.drive("key ctrl+shift+f\nsleep 400\ntext zzzznothing\nsleep 250\n")
    for _ in range(40):
        run.drive("key f12\nsleep 120\n")
        if run.state()["search_done"] == "true":
            break
    expect(run.state(), searching="true", search_hits="0", search_active="")
    run.drive("key escape\nsleep 300\nkey f12\nsleep 200\n")
    expect(run.state(), searching="false")

    # And it searches from where the pane is, not from where the window started:
    # back at the fixture root, the buried file is under it and findable again.
    run.drive("key alt+left\nsleep 900\n")
    listed(run)
    if run.state()["path"] != here["path"]:
        raise Failure("Back did not return to the folder the search started from")


@scenario("a-drag-held-over-a-folder-opens-it", fresh=True)
def spring_loaded(run: Run, fixture: Path) -> None:
    """Rest a drag on a folder and the pane goes into it, so the drop can be deep.

    The gesture this exists for cannot let go on the way: dropping a file three
    folders down otherwise means opening two of them first, which means putting
    the file down and picking it up again. What is asserted is the whole of it —
    the folder opens *while the button is still down*, and the drop then lands in
    the folder that opened.
    """
    listed(run)
    # `alpha` holds `nested`, so there is somewhere to spring *to*.
    run.drive("text file-1.txt\nsleep 400\nkey f12\nsleep 200\n")
    chosen = run.state()
    expect(chosen, cursor="file-1.txt")
    held = point_at(run, int(chosen["cursor_row"]))
    onto = point_at(run, 0)
    if onto["hover_name"] != "alpha":
        raise Failure(f"row 0 is {onto['hover_name']!r}, wanted the alpha folder")

    from_point = aim(run, held, name_x(held), row_y(held, int(chosen["cursor_row"])))
    over_alpha = aim(run, held, name_x(held), row_y(held, 0))
    # Pressed, walked onto the folder, and then held still — the holding is the
    # thing under test, so it is a sleep on purpose rather than a poll.
    run.drive(
        f"move {from_point[0]:.1f} {from_point[1]:.1f}\nsleep 200\npress\nsleep 150\n"
        + creep(from_point, over_alpha)
        + "sleep 300\nkey f12\nsleep 200\n"
    )
    carrying = run.state()
    expect(carrying, dragging="true", carrying="file-1.txt")
    if carrying["path"] != str(fixture):
        raise Failure("the pane sprang before the drag had rested at all")

    # Past the nine hundred milliseconds, without moving.
    run.drive("sleep 1200\nkey f12\nsleep 250\n")
    sprung = run.state()
    if sprung["path"] != str(fixture / "alpha"):
        raise Failure(f"resting on the folder did not open it: {sprung['path']!r}")
    expect(sprung, dragging="true", carrying="file-1.txt")

    # And the drop lands where the spring went, not where the drag started.
    run.drive("release\nsleep 1500\nkey f12\nsleep 300\n")
    if not (fixture / "alpha" / "file-1.txt").is_file():
        raise Failure("the drop did not land in the folder that opened")
    if (fixture / "file-1.txt").exists():
        raise Failure("the original is still there, so the drop copied rather than moved")
    expect(run.state(), dragging="false", carrying="")


@scenario("passing-over-a-folder-does-not-open-it", fresh=True)
def no_spring_in_passing(run: Run, fixture: Path) -> None:
    """The other half of the rule, and the dangerous direction.

    A folder that opened while the pointer was merely crossing it would move the
    target out from under a gesture already in flight, and the drop would land
    somewhere nobody chose. The timer restarts every time the target changes.
    """
    listed(run)
    run.drive("text file-1.txt\nsleep 400\nkey f12\nsleep 200\n")
    chosen = run.state()
    held = point_at(run, int(chosen["cursor_row"]))
    start = aim(run, held, name_x(held), row_y(held, int(chosen["cursor_row"])))
    over = [aim(run, held, name_x(held), row_y(held, row)) for row in (0, 1, 2)]

    # Three folders crossed, each for well under the nine hundred milliseconds,
    # and back again — total time over folders far more than the threshold.
    script = f"move {start[0]:.1f} {start[1]:.1f}\nsleep 200\npress\nsleep 150\n"
    walk = [start, *over, *reversed(over)]
    for a, b in zip(walk, walk[1:]):
        script += creep(a, b, steps=3) + "sleep 120\n"
    run.drive(script + "key f12\nsleep 200\n")
    passing = run.state()
    expect(passing, dragging="true")
    if passing["path"] != str(fixture):
        raise Failure(f"a folder opened while the pointer was crossing it: {passing['path']!r}")
    run.drive("release\nsleep 800\n")


@scenario("an-index-answers-what-the-walk-answers", fresh=True)
def index_and_walk_agree(run: Run, fixture: Path) -> None:
    """The same search, walked and indexed, gives the same rows.

    **This is [ADR 0008](../docs/adr/0008-persistent-index-is-required.md)'s
    third constraint as a test.** The index is an accelerator for a walk that
    still works, and a missing one is a performance event rather than a
    correctness one — so the interesting assertion is not that the index is fast,
    which no scenario on a fixture this size could show, but that the two paths
    are *indistinguishable in their answer*. If they ever disagree, the one a
    person gets depends on whether they happened to build an index.

    It also covers the freshness policy [ADR
    0012](../docs/adr/0012-a-flat-index-file-per-root-rebuilt-whole.md) chose: a
    file deleted after the build must not come back as a result, because every
    hit is `statx`ed between the scan and the screen.
    """
    (fixture / "alpha" / "nested" / "buried-treasure.txt").write_text("here")
    (fixture / "beta" / "treasure-map.txt").write_text("there")
    listed(run)

    def hunt(word: str) -> dict[str, str]:
        run.drive(f"key ctrl+shift+f\nsleep 200\ntext {word}\n")
        state = until(run, searching="true", search_done="true")
        run.drive("key escape\n")
        until(run, searching="false")
        return state

    # No index yet, so this is the walk. `index=-1` is *no index loaded*, which
    # is what the fresh fixture must start as — a stale one from another scenario
    # would make the comparison below a comparison of an index with itself.
    expect(run.state(), index="-1")
    walked = hunt("treasure")
    expect(walked, search_hits="2", search_indexed="false")

    # Build one, and the search over the same folder is now over the index.
    run.drive("key ctrl+shift+i\n")
    holds(run, lambda it: int(it["index"]) > 0, "built an index")
    indexed = hunt("treasure")
    expect(indexed, search_hits=walked["search_hits"], search_indexed="true")

    # A file deleted since the build is verified away rather than reported.
    (fixture / "beta" / "treasure-map.txt").unlink()
    after = hunt("treasure")
    expect(after, search_hits="1", search_indexed="true")

    # And the index can be deleted, which ADR 0008 requires because the file is a
    # list of everything a person has.
    run.drive("key ctrl+alt+i\n")
    expect(until(run, index="-1"), index="-1")
    # Back to the walk, and back to finding what is actually there.
    expect(hunt("treasure"), search_hits="1", search_indexed="false")


@scenario("search-results-are-rows-that-can-be-acted-on", fresh=True)
def flattened_results(run: Run, fixture: Path) -> None:
    """`Ctrl+Enter` puts the results in the pane, and then they are just rows.

    **This is [rule 8] with something behind it.** Results used to be navigable
    and nothing else: to trash a file the search found, a person went to its
    folder and started again. Once the results *are* the listing, every command
    in the registry works on them with no second implementation — and the proof
    is doing something destructive to one and finding it gone from the folder it
    actually lived in, which is not the folder the pane is showing.

    Two files of the same name in different folders is the case a list of names
    could not represent at all, so both are here.

    [rule 8]: docs/03-principles.md
    """
    (fixture / "alpha" / "needle.txt").write_text("in alpha")
    (fixture / "beta" / "needle.txt").write_text("in beta")
    listed(run)
    root = run.state()["path"]

    run.drive("key ctrl+shift+f\n")
    until(run, searching="true")
    run.drive("text needle\n")
    found = until(run, search_hits="2", search_done="true")
    expect(found, results="")

    run.drive("key ctrl+enter\n")
    flat = until(run, results="needle", searching="false")
    # The pane is showing two files from two different folders while its own path
    # is still the root, which is the whole shape of a flattened view.
    expect(flat, rows="2", path=root)

    # Trash the first one. Which folder it was in is the listing's business, not
    # the pane's, and getting that wrong would delete the wrong file — or nothing.
    run.drive("key home\n")
    on_first = until(run, cursor="needle.txt", selected="1")
    del on_first
    run.drive("key delete\n")
    settled(run)
    gone = [p for p in (fixture / "alpha", fixture / "beta") if not (p / "needle.txt").exists()]
    if len(gone) != 1:
        raise Failure(f"trashing one result removed {len(gone)} of the two files")

    # And `Ctrl+Z` puts it back where it came from, not where the pane is.
    run.drive("key ctrl+z\n")
    settled(run)
    for folder in ("alpha", "beta"):
        if not (fixture / folder / "needle.txt").is_file():
            raise Failure(f"undo did not restore {folder}/needle.txt")
    if (fixture / "needle.txt").exists():
        raise Failure("undo put the file in the pane's directory instead of its own")


