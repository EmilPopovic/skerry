    start = aim(run, deep, name_x(deep), row_y(deep, int(picked["cursor_row"])))
    first = tab_aim(run, deep, 0)
    run.drive(
        f"move {start[0]:.1f} {start[1]:.1f}\nsleep 200\npress\nsleep 150\n"
        + creep(start, first)
        + "sleep 250\nrelease\nsleep 1500\nkey f12\nsleep 300\n"
    )
    if not (fixture / "deep.txt").is_file():
        raise Failure("a drop on a tab did not land in the directory that tab holds")
    expect(run.state(), tab="1", dragging="false")


@scenario("the-carried-card-follows-the-pointer", fresh=True)
def the_card_follows(run: Run, fixture: Path) -> None:
    """Every motion redraws while files are carried, not only a target change.

    The card is drawn at the pointer, so a frame marked dirty only when the
    *target* changes is a card that jumps from one folder row to the next
    instead of following the hand — which is what it did.

    **Counted in frames, because that is the difference.** Nothing else can see
    it: the pointer's position is reported whether a frame was drawn or not, and
    a golden frame cannot hold motion. So this moves over ground whose target
    never changes, with no `F12` inside the burst to draw frames of its own, and
    counts what the window drew.
    """
    del fixture
    listed(run)
    run.drive("text file-1.txt\nsleep 400\nkey f12\nsleep 200\n")
    chosen = run.state()
    held = point_at(run, int(chosen["cursor_row"]))
    from_point = aim(run, held, name_x(held), row_y(held, int(chosen["cursor_row"])))
    # Empty space low in the pane the drag started in: no folder row under it,
    # and its own pane takes no drop — so nothing about the target changes as the
    # pointer moves around down there.
    body = [float(part) for part in held["pane_body"].split(",")[0].split(":")]
    low = aim(run, held, body[0] + body[2] / 2.0, body[1] + body[3] - 30.0)
    lower = aim(run, held, body[0] + body[2] / 2.0 - 60.0, body[1] + body[3] - 12.0)

    run.drive(
        f"move {from_point[0]:.1f} {from_point[1]:.1f}\nsleep 200\npress\nsleep 150\n"
        + creep(from_point, low)
        + "sleep 300\nkey f12\nsleep 200\n"
    )
    before = run.state()
    expect(before, dragging="true", carrying="file-1.txt", drop_row="-1", drop_whole="0")
    drawn = int(before["frames"])

    run.drive(creep(low, lower, steps=8) + creep(lower, low, steps=8) + "key f12\nsleep 250\n")
    after = run.state()
    # The target is the same as it was, which is what makes the count mean
    # something: no frame here was asked for by anything changing.
    expect(after, dragging="true", drop_row="-1", drop_whole="0")
    moved = int(after["frames"]) - drawn
    # Sixteen motions. Half of that is well clear of the one or two frames the
    # `F12` itself draws, which is all this counted before the card followed.
    if moved < 8:
        raise Failure(f"sixteen motions drew {moved} frames, so the card is not following")
    run.drive("release\nsleep 600\n")


PEER = ROOT / "tools" / "gtk-drag-peer"


class Peer:
    """A GTK application on the same display, for the interop scenarios.

    **Somebody else's toolkit, in another process.** GTK is a banned dependency
    (rule 9) and stays banned — but what is under test here *is* interop with
    GTK, and a peer that can be driven from a script is worth more than one that
    has to be clicked. Spike D made the same trade for the clipboard.

    Not Nautilus, for a reason Spike D recorded: driving a file manager's own
    view means guessing where it drew an icon, and its X11 half failed exactly
    there. This peer is one big target at a known place, so a failure is about
    the protocol and not about somebody else's layout.
    """

    def __init__(self, work: Path, *arguments: str):
        if not PEER.is_file():
            raise Skipped("tools/gtk-drag-peer is missing")
        self.log = work / f"peer-{arguments[0]}.log"
        backend = "x11" if isinstance(SERVER, X11Server) else "wayland"
        # Placed away from the window under test where nothing else will place
        # it. A bare X server has no window manager, so two windows would both
        # map at the origin and the drag would begin and end in the same one.
        at = ["--at", "1150,120"] if backend == "x11" else []
        self.process = subprocess.Popen(
            [str(PEER), arguments[0], *at, *arguments[1:]],
            env=dict(with_server(), GDK_BACKEND=backend),
            stdout=self.log.open("w"),
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
        deadline = time.time() + PATIENCE
        while time.time() < deadline:
            if self.said("ready"):
                return
            if self.process.poll() is not None:
                raise Skipped(f"the GTK peer would not start: {self.output()[:200]}")
            time.sleep(0.1)
        raise Failure("the GTK peer never became ready")

    def yield_focus(self, run: Run) -> None:
        """Gives the keyboard back to the window under test, and checks it took.

        A compositor focuses what it has just mapped, so without this every key a
        scenario sends after starting a peer goes to the peer. Asked and then
        **verified**, because a focus request is asynchronous and a scenario that
        assumed it had landed failed later, on a state dump that never arrived,
        with a message about the window rather than about the focus.

        **The verification has to be of a *new* answer.** It used to be
        `run.state()` under a `suppress`, which reads the last line in the log —
        a line every scenario already has by the time it starts a peer. It could
        not raise, so it returned on the first attempt with the keyboard still on
        the peer, and this loop had never once gone round twice.
        """
        for _ in range(10):
            SERVER.focus("dev.skerry.Skerry")
            run.drive("sleep 200\n", answering=False)
            if run.answered(settle=200) is not None:
                return
        raise Failure("the window under test would not take the keyboard back")

    def output(self) -> str:
        return self.log.read_text() if self.log.exists() else ""

    def said(self, word: str) -> bool:
        return any(line.startswith(word) for line in self.output().splitlines())

    def wait_for(self, word: str, seconds: float = 6.0) -> str:
        """Waits for a line, and returns everything the peer has said."""
        deadline = time.time() + seconds
        while time.time() < deadline:
            if self.said(word):
                return self.output()
            time.sleep(0.15)
        raise Failure(f"the peer never said {word!r}; it said {self.output()!r}")

    def box(self) -> tuple[int, int, int, int]:
        return SERVER.box_of("gtk-drag-peer")

    def close(self) -> None:
        if self.process.poll() is None:
            with contextlib.suppress(ProcessLookupError):
                os.killpg(os.getpgid(self.process.pid), signal.SIGTERM)


def drag_between(
    run: Run,
    start: tuple[float, float],
    end: tuple[float, float],
    steps: int = 8,
    pace: int = 150,
) -> None:
    """A drag from one window to another, **paced**.

    `skerry-drive`'s own `drag` sends press, eight motions and release with
    nothing between them, which is right for a rubber band inside one window and
    wrong across two: the peer answers every position, and a gesture that outruns
    its replies is released before it has been accepted. Measured — the first
    attempt at this produced two `motion` lines from GTK and no drop at all.
    """
    script = [f"move {start[0]:.1f} {start[1]:.1f}", "sleep 300", "press", "sleep 200"]
    for step in range(1, steps + 1):
        across = start[0] + (end[0] - start[0]) * step / steps
        down = start[1] + (end[1] - start[1]) * step / steps
        script += [f"move {across:.1f} {down:.1f}", f"sleep {pace}"]
    script += ["sleep 500", "release", "sleep 1500"]
    run.drive("\n".join(script) + "\n")


def middle_of(run: Run, box: tuple[int, int, int, int]) -> tuple[float, float]:
    """The centre of a window, as the percentages the driver takes."""
    left, top, width, height = box
    across, down = SERVER.output_size()
    return ((left + width / 2) / across * 100.0, (top + height / 2) / down * 100.0)


@scenario("a-paste-takes-what-another-application-copied", fresh=True)
def paste_from_a_peer(run: Run, fixture: Path) -> None:
    """`x-special/gnome-copied-files` from somebody else, copy verb and cut verb.

    **The cut half is the one worth having.** Every other clipboard type names
    files and nothing else, so a cut that arrives as one of those is pasted as a
    copy and quietly leaves the original where it was — half of what was asked,
    with nothing to say so. This type is the only one carrying the verb, and the
    rule is that a peer's verb beats our own idea of what is on the clipboard.

    **`wl-copy` owns the selection, not this window**, because a window asked
    what it thinks it published is a test of nothing. That is the same bargain
    `clipboard()` makes in the other direction, and it is why this skips where
    `wl-copy` is absent — which is the X11 half, where no third-party clipboard
    writer is a given on a machine.

    What this does *not* verify is Nautilus's own bytes: the format below is the
    documented one, composed here. PyGObject cannot offer custom clipboard
    targets at all — `Gtk.Clipboard.set_with_data` and `set_with_owner` are both
    unbound — so the GTK peer that covers drag-and-drop cannot cover this, and
    the round trip against a real GNOME application stays owed.
    """
    owning = SERVER.copy_command("x-special/gnome-copied-files")
    if owning is None:
        raise Skipped("no third-party clipboard writer for this display server")

    # **Waited for, because the window is already listing this directory.** The
    # folder arrives by inotify rather than in the first read, and type-ahead
    # cannot match a row that has not been delivered yet. This used to work by
    # accident: `listed` stalled five seconds on a miscounted report, which was
    # long enough for the watch to fire, and the scenario failed the moment that
    # stall was fixed.
    rows = int(listed(run)["rows"])
    (fixture / "target").mkdir()
    until(run, rows=str(rows + 1))
    run.drive("text target\nkey enter\n")
    until(run, path=str(fixture / "target"), loading="false")

    for verb, name, moves in (("copy", "file-1.txt", False), ("cut", "file-2.txt", True)):
        source = fixture / name
        offered = f"{verb}\nfile://{source}".encode()
        owner = subprocess.Popen(
            owning,
            stdin=subprocess.PIPE,
            env=with_server(),
            start_new_session=True,
        )
        try:
            owner.stdin.write(offered)
            owner.stdin.close()
            # The offer has to be up before the paste asks for it, and `wl-copy`
            # takes the selection a moment after it is spawned.
            until(run, path=str(fixture / "target"))
            run.drive("key ctrl+v\n")
            settled(run)
            if not (fixture / "target" / name).is_file():
                raise Failure(f"a {verb} from another application did not paste {name}")
            if source.exists() is moves:
                raise Failure(
                    f"a {verb} left the original "
                    + ("behind" if moves else "nowhere")
                    + f": {name}"
                )
        finally:
            owner.terminate()
            with contextlib.suppress(subprocess.TimeoutExpired):
                owner.wait(timeout=5)

    # And `Ctrl+Z` walks back the one that moved, which is the half that would
    # otherwise be a peer's cut turning into a deletion nothing can undo.
    run.drive("key ctrl+z\n")
    settled(run)
    if not (fixture / "file-2.txt").is_file():
        raise Failure("undo did not bring back what a peer's cut moved")


@scenario("a-drag-out-lands-in-another-application", fresh=True)
def a_drag_out_lands(run: Run, fixture: Path) -> None:
    """A file dragged out of this window arrives in a GTK application.

    The whole outgoing path, against somebody else's implementation: the source
    is claimed, the types are offered, the peer asks for `text/uri-list` and the
    bytes travel through the selection machinery — `INCR` and all — before the
    peer reports what it received. "The peer read the data" is Spike D's
    criterion and it is the right one: whether the peer then does something
    useful with a `.txt` is the peer's business.
    """
    peer = Peer(run.work, "target")
    try:
        peer.yield_focus(run)
        run.drive("sleep 600\ntext file-1.txt\nsleep 400\nkey f12\nsleep 200\n")
        chosen = run.state()
        if chosen["cursor"] != "file-1.txt":
            raise Failure(f"the cursor is on {chosen['cursor']!r}")
        row = int(chosen["cursor_row"])
        held = point_at(run, row)
        from_point = aim(run, held, name_x(held), row_y(held, row))
        drag_between(run, from_point, middle_of(run, peer.box()))

        said = peer.wait_for("dropped")
        if "file-1.txt" not in said:
            raise Failure(f"the peer received {said!r}")
    finally:
        peer.close()


@scenario("a-drag-in-from-another-application-lands", fresh=True)
def a_drag_in_lands(run: Run, fixture: Path) -> None:
    """A file dragged in from a GTK application arrives in this folder.

    **A copy, always.** A peer that asked for a move removes its own original;
    doing it here would delete somebody else's file on a confirmation this
    program cannot get — Spike D measured the negotiated action reported zero
    times across every pairing.
    """
    outside = run.work / "outside"
    outside.mkdir(exist_ok=True)
    carried = outside / "from-the-peer.txt"
    carried.write_text("dragged in")

    peer = Peer(run.work, "source", f"file://{carried}")
    try:
        peer.yield_focus(run)
        run.drive("sleep 600\nkey f12\nsleep 200\n")
        before = run.state()
        # **The empty space below the last row**, which is the case the folder
        # under the pointer does not cover: files from elsewhere belong in the
        # directory being shown, and requiring a folder would refuse most of the
        # window. Dropping *on* a folder puts them in it, which the assertion
        # below would not be able to tell from this one.
        empty = float(before["body_top"]) + float(before["row_h"]) * (int(before["rows"]) + 1)
        if empty >= float(before["body_top"]) + float(before["body_height"]):
            raise Failure("no empty space below the last row to drop into")
        into = aim(run, before, name_x(before), empty)
        drag_between(run, middle_of(run, peer.box()), into, steps=14, pace=220)

        # **The file first, then the protocol's courtesy.** `XdndFinished` is sent
        # after the drop has been *acted* on, so waiting for it before waiting for
        # the file was waiting for the second half of a job with a six-second
        # budget. Measured: **two failures in eight runs** before this, on this
        # commit and on the one before it — so the sweeps had been passing on luck
        # — and **one in sixteen** after, which is not the same defect. What is
        # left fails with "nothing landed": the synthetic drag itself is not
        # delivered, which is XTEST and pacing rather than a wait in the wrong
        # place, and is owed.
        peer.wait_for("asked for text/uri-list")
        for _ in range(40):
            if (fixture / carried.name).is_file():
                break
            run.drive("sleep 200\n")
        else:
            raise Failure(f"nothing landed: {sorted(p.name for p in fixture.iterdir())}")
        peer.wait_for("drag ended")
        # The peer's original stays: a drag in is a copy.
        if not carried.is_file():
            raise Failure("the drag deleted the peer's original")
    finally:
        peer.close()


def row_under_point(state: dict[str, str], percent_y: float, run: Run) -> int | None:
    """Which list row is under a point given as the driver's percentage.

    So a scenario can check that the thing it is covering is really there: an
    assertion about what does *not* light up is worth nothing if nothing was
    going to.
    """
    _, top, _, height = SERVER.window_box()
    _, down = SERVER.output_size()
    del run
    logical_y = percent_y / 100.0 * down - top
    body_top, row_h = float(state["body_top"]), float(state["row_h"])
    if logical_y < body_top:
        return None
    row = int((logical_y - body_top) // row_h)
    return row if row < int(state["rows"]) else None


def crumb_row_aim(run: Run, state: dict[str, str], name: str) -> tuple[float, float]:
    """Where to click a row of the open sibling menu, by the directory it names."""
    for entry in state.get("crumb_menu_aim", "").split(","):
        row, _, point = entry.partition("@")
        if row == name:
            x, _, y = point.partition(":")
            return aim(run, state, float(x), float(y))
    raise Failure(f"no menu row called {name!r}: {state.get('crumb_menu_aim')!r}")


def tool_aim(run: Run, state: dict[str, str], index: int) -> tuple[float, float]:
    """The middle of one of the four navigation buttons, in the focused pane's bar.

    **Not an offset into the window any more.** The buttons moved into the pane,
    under its tab strip, so both coordinates come from where the frame put that
    pane's bar rather than from the window's top-left corner.
    """
    width = float(state["tool_w"])
    if width <= 0.0:
        raise Failure("the navigation buttons were shed at this window size")
    x = float(state["tools_x"]) + width * (index + 0.5)
    y = float(state["bar_y"]) + float(state["bar_h"]) / 2.0
    return aim(run, state, x, y)


def separator_aim(run: Run, state: dict[str, str], depth: int) -> tuple[float, float]:
    """Where to click the breadcrumb separator after component `depth`.

    The window reports the middle of every drawn one, so a scenario aims by depth
    and never by arithmetic over the path bar's own constants — which it would
    have to copy, and which would then be a second copy to keep right.
    """
    for entry in state.get("separator_aim", "").split(","):
        name, _, point = entry.partition("@")
        if name == str(depth):
            x, _, y = point.partition(":")
            return aim(run, state, float(x), float(y))
    raise Failure(f"no separator at depth {depth}: {state.get('separator_aim')!r}")


@scenario("a-separator-lists-the-siblings-beside-it", fresh=True)
def a_separator_lists_siblings(run: Run, fixture: Path) -> None:
    """The chevron between two components opens what is between them.

    **The whole point of a Windows 11 path bar.** A separator sits between two
    components, so the directories inside the one on its left are the *siblings*
    of the one on its right — which is the list a person wants when they are
    three levels deep and meant to be in the folder next door. It turns "up, up,
    down, down" into one press and one click, at any depth.

    The listing happens on a job: rule 1 gives the UI thread no filesystem
    syscalls, and a separator over a hung mount is the case that rule is for. So
    the menu is asked for and opens when the answer lands, which is why this
    waits for it rather than asserting on the next frame.
    """
    (fixture / "alpha" / "sideways").mkdir()
    run.drive("sleep 500\ntext alpha\nsleep 400\nkey enter\nsleep 700\nkey f12\nsleep 200\n")
    inside = run.state()
    if not inside["path"].endswith("/alpha"):
        raise Failure(f"did not get into alpha: {inside['path']}")
    deep = int(inside["crumbs"])

    # The separator *before* the leaf: its left neighbour is the fixture, so its
    # list is the leaf's own siblings.
    where = separator_aim(run, inside, deep - 2)
    run.drive(f"move {where[0]:.1f} {where[1]:.1f}\nsleep 200\nclick\nsleep 900\nkey f12\nsleep 300\n")
    opened = run.state()
    if int(opened["crumb_menu"]) < 3:
        raise Failure(f"the menu holds {opened['crumb_menu']} rows, wanted the fixture's folders")
    expect(opened, crumb_menu_depth=str(deep - 2))
    # It opens on the component the path already goes through, so the keyboard
    # starts from where the person is rather than from the top of an alphabet.
    expect(opened, crumb_menu_active="alpha")

    # And down to a sibling, then Enter, and that is where we are. One key per
    # drive: two sent together race the frame that processes the first.
    run.drive("key down\nsleep 300\nkey f12\nsleep 300\n")
    moved = run.state()
    if moved["crumb_menu_active"] == "alpha":
        raise Failure("Down did not move off the current component")
    chosen = moved["crumb_menu_active"]
    run.drive("key enter\nsleep 900\nkey f12\nsleep 300\n")
    landed = run.state()
    if landed["path"] != str(fixture / chosen):
        raise Failure(f"chose {chosen!r} and landed in {landed['path']}")
    expect(landed, crumb_menu="-1")


@scenario("the-last-separator-lists-what-is-inside-here", fresh=True)
def the_last_separator_lists_children(run: Run, fixture: Path) -> None:
    """The chevron after the last component lists the children of here.

    It has no right-hand neighbour, so its list is what is inside the current
    directory — a way into a subdirectory without leaving, and the one that saves
    the most steps.
    """
    run.drive("sleep 500\nkey f12\nsleep 200\n")
    start = run.state()
    deep = int(start["crumbs"])

    # Over a breadcrumb first, so something *is* lit when the menu opens — the
    # pointer reaches a chevron by crossing the component beside it, and a
    # component left lit under the panel is the same false promise as a row.
    crumb = aim(run, start, float(start["parent_crumb_x"]), float(start["parent_crumb_y"]))
    run.drive(f"move {crumb[0]:.1f} {crumb[1]:.1f}\nsleep 250\nkey f12\nsleep 200\n")
    if run.state()["crumb_hover"] == "-1":
        raise Failure("the breadcrumb did not light, so nothing is being covered")

    where = separator_aim(run, start, deep - 1)
    run.drive(f"move {where[0]:.1f} {where[1]:.1f}\nsleep 200\nclick\nsleep 900\nkey f12\nsleep 300\n")
    opened = run.state()
    expect(opened, crumb_menu_depth=str(deep - 1))
    if int(opened["crumb_menu"]) != 3:
        raise Failure(f"the menu holds {opened['crumb_menu']} rows, wanted the three folders")
    # Nothing below the last component is on the path, so nothing is marked and
    # nothing is selected until a key or the pointer says so.
    expect(opened, crumb_menu_active="")

    # One key per drive, and asserted between: a `Down` and an `Enter` sent
    # together race the frame that processes the first, and an `Enter` that
    # arrives with nothing highlighted does nothing at all.
    # **Nothing under the panel lights up.** The menu hangs over the list, and a
    # row lighting up behind it reads as a click that will land there — which it
    # will not: a press outside this menu closes it and does nothing else.
    #
    # `gamma` and not `alpha`: the first menu row sits above the list's first,
    # so hovering it would prove nothing whichever way the code went. The row
    # chosen here is checked below to be over a real one.
    over = crumb_row_aim(run, opened, "gamma")
    covered = row_under_point(opened, over[1], run)
    if covered is None:
        raise Failure("the menu row chosen does not cover a list row, so this proves nothing")
    run.drive(f"move {over[0]:.1f} {over[1]:.1f}\nsleep 300\nkey f12\nsleep 250\n")
    expect(run.state(), crumb_menu_active="gamma", hover="-1", hover_name="", crumb_hover="-1")

    run.drive("key down\nsleep 300\nkey f12\nsleep 300\n")
    chosen = run.state()["crumb_menu_active"]
    if not chosen:
        raise Failure("Down highlighted nothing")
    run.drive("key enter\nsleep 900\nkey f12\nsleep 300\n")
    landed = run.state()
    if landed["path"] != str(fixture / chosen):
        raise Failure(f"chose {chosen!r} and landed in {landed['path']}")
    if Path(landed["path"]).parent != fixture:
        raise Failure(f"landed in {landed['path']}, wanted a child of the fixture")

    # Escape closes it without going anywhere.
    where = separator_aim(run, landed, int(landed["crumbs"]) - 1)
    run.drive(f"move {where[0]:.1f} {where[1]:.1f}\nsleep 200\nclick\nsleep 900\nkey escape\nsleep 300\nkey f12\nsleep 200\n")
    expect(run.state(), crumb_menu="-1", path=landed["path"])


def scan_sidebar(run: Run, state: dict[str, str], label: str) -> tuple[float, float]:
    """Where the sidebar row called `label` is, found by hovering down it.

    A row's y depends on how many section headings came before it, which is known
    where it is drawn and nowhere else — so the harness looks rather than
    calculates, the same way `point_at` does for a list row.
    """
    width = float(state["sidebar_w"])
    if width <= 0.0:
        raise Failure("the sidebar is closed or was shed at this window size")
    step = 6.0
    logical_y = float(state["sidebar_top"]) + step
    height = float(state["logical"].split("x")[1])
    while logical_y < height:
        x, y = aim(run, state, width / 2.0, logical_y)
        run.drive(f"move {x:.2f} {y:.2f}\nsleep 70\nkey f12\nsleep 70\n")
        if run.state()["place_name"] == label:
            return x, y
        logical_y += step
    raise Failure(f"no sidebar row called {label!r}")


@scenario("path-entry")
def path_entry(run: Run, fixture: Path) -> None:
    """Ctrl+L, a path, Enter — and the pointer can reach it too.

    Three routes into one field: the chord, a click that places the caret, and
    the context menu, because the promise is that every command has both halves.
    """
    run.drive("sleep 500\nkey ctrl+l\nsleep 250\nkey f12\nsleep 150\n")
    opened = run.state()
    expect(opened, path_entry=str(fixture))

    # Ctrl+U clears it, and a relative name is taken from where you are.
    run.drive("key ctrl+u\ntext alpha\nsleep 200\nkey f12\nsleep 150\n")
    expect(run.state(), path_entry="alpha")
    run.drive("key enter\nsleep 800\nkey f12\nsleep 200\n")
    expect(run.state(), path="" + str(fixture / "alpha"), path_entry="")

    # Escape puts the breadcrumbs back and goes nowhere.
    run.drive("key ctrl+l\nsleep 200\nkey ctrl+u\ntext /etc\nsleep 150\nkey escape\nsleep 250\nkey f12\nsleep 200\n")
    expect(run.state(), path=str(fixture / "alpha"), path_entry="")

    # And `~` is this user's home, which is the one expansion the field does.
    run.drive("key ctrl+l\nsleep 200\nkey ctrl+u\ntext ~\nsleep 150\nkey f12\nsleep 150\n")
    typed = run.state()
    if typed["path_entry"] != "~":
        raise Skipped(f"this keymap cannot type a tilde: {typed['path_entry']!r}")
    run.drive("key enter\nsleep 900\nkey f12\nsleep 200\n")
    expect(run.state(), path=os.environ.get("HOME", ""))


@scenario("path-entry-by-pointer")
def path_entry_by_pointer(run: Run, fixture: Path) -> None:
    """The menu opens the field, and a click inside it moves the caret."""
    run.drive("sleep 500\nkey f12\nsleep 100\n")
    start = run.state()
    # The empty space below the last row, where the background menu lives.
    below = float(start["body_top"]) + float(start["row_h"]) * (int(start["rows"]) + 1)
    if below >= float(start["body_top"]) + float(start["body_height"]):
        raise Failure("no empty space below the last row to click in")
    where = aim(run, start, 300.0, below)
    run.drive(
        f"move {where[0]:.1f} {where[1]:.1f}\n"
        "sleep 150\nclick right\nsleep 400\nkey f12\nsleep 150\n"
    )
    opened = run.state()
    # **`menu_aim` scrolls to find it**, because the background menu is taller than
    # the window and has been since it was written — the `context-menu` golden
    # frame exists partly to show the arrow that says there is more. Every row
    # added to it pushes the tail further off, and this row is now past the end.
    aimed = menu_aim(run, opened, "view.path_entry")
    run.drive(f"move {aimed[0]:.1f} {aimed[1]:.1f}\nsleep 200\nclick\nsleep 400\nkey f12\nsleep 200\n")
    field = run.state()
    expect(field, menu="0", path_entry=str(fixture))

    # A click a third of the way along the text puts the caret there rather than
    # committing, and a click outside puts the breadcrumbs back.
    # Aimed at the box the window reports rather than at a number: 60 logical
    # pixels is left of the field's own left edge at 125, and it only ever worked
    # because a click there happened to land on nothing. Under a bare X server the
    # window draws its own frame, that same point is on the title bar, and the
    # press went to the frame instead.
    box = [float(value) for value in field["path_field"].split(",")]
    inside = aim(run, field, box[0] + box[2] / 3.0, box[1] + box[3] / 2.0)
    run.drive(f"move {inside[0]:.1f} {inside[1]:.1f}\nsleep 150\nclick\nsleep 250\nkey f12\nsleep 150\n")
    expect(run.state(), path_entry=str(fixture), path=str(fixture))
    run.drive("key ctrl+u\nsleep 150\nkey f12\nsleep 150\n")
    clipped = run.state()["path_entry"]
    if clipped == str(fixture) or not str(fixture).endswith(clipped):
        raise Failure(f"the click did not move the caret: cleared to {clipped!r}")

    away = aim(run, field, 300.0, float(field["body_top"]) + 40.0)
    run.drive(f"move {away[0]:.1f} {away[1]:.1f}\nsleep 150\nclick\nsleep 250\nkey f12\nsleep 150\n")
    expect(run.state(), path_entry="", path=str(fixture))


@scenario("two-fields-never-open-at-once", fresh=True)
def two_fields_never_open_at_once(run: Run, fixture: Path) -> None:
    """A caret in two places at once is a keyboard nobody can predict.

    **A field is left before another opens, and a keystroke cannot swap them.**
    That used to be the other way round: `Ctrl+L` inside a rename field committed
    the rename and opened the path bar, so a stray chord renamed a file to whatever
    had been typed so far. A field now rejects what does not apply to it, and the
    invariant holds because the second field never opens at all.

    The filter is the exception and stays one: it is a `String` with no caret, not
    a field, so a chord still reaches its command from inside it.
    """
    run.drive("sleep 500\nkey down\nkey f2\nsleep 300\nkey f12\nsleep 150\n")
    naming = run.state()
    original = naming["naming"]
    if not original:
        raise Failure("F2 opened no field")

    # A chord that would open another field does nothing at all, and — the part
    # that matters — does not rename anything on the way.
    run.drive("key home\ntext two-\nsleep 150\nkey ctrl+l\nsleep 800\nkey f12\nsleep 200\n")
    held = run.state()
    expect(held, naming=f"two-{original}", path_entry="")
    if (fixture / f"two-{original}").exists():
        raise Failure("Ctrl+L committed a half-typed rename as a side effect")

    # Leaving it first is what opens the other one.
    run.drive("key escape\nsleep 250\nkey ctrl+l\nsleep 400\nkey f12\nsleep 200\n")
    swapped = run.state()
    expect(swapped, naming="", path_entry=str(fixture))
    if (fixture / f"two-{original}").exists():
        raise Failure("Escape committed the rename rather than abandoning it")

    # And the same in the other direction: the path field rejects Ctrl+F.
    run.drive("key ctrl+f\nsleep 300\nkey f12\nsleep 150\n")
    expect(run.state(), filtering="false", path_entry=str(fixture))

    # A secondary click in the field leaves it open and opens no menu at all.
    field_box = [float(value) for value in swapped["path_field"].split(",")]
    inside = aim(run, swapped, field_box[0] + field_box[2] / 3.0, field_box[1] + field_box[3] / 2.0)
    run.drive(
        f"move {inside[0]:.1f} {inside[1]:.1f}\n"
        "sleep 150\nclick right\nsleep 400\nkey f12\nsleep 200\n"
    )
    expect(run.state(), menu="0", path_entry=str(fixture))

    # The filter is not a field, so a chord still reaches its command from inside
    # it — and opening a field takes the keyboard off the filter box without
    # putting back the rows it hid. See a-filter-outlives-the-field-that-typed-it.
    run.drive("key escape\nsleep 200\nkey ctrl+f\ntext al\nsleep 300\nkey f12\nsleep 150\n")
    expect(run.state(), filtering="true", path_entry="", filter="al")
    run.drive("key ctrl+l\nsleep 300\nkey f12\nsleep 150\n")
    expect(run.state(), filtering="false", filter="al", path_entry=str(fixture))

    # Escape leaves the path bar, and a second drops the filter it never touched.
    run.drive("key escape\nsleep 250\nkey escape\nsleep 300\nkey f12\nsleep 150\n")
    expect(run.state(), filter="", path_entry="")

    run.drive("key ctrl+f\nsleep 250\nkey f2\nsleep 300\nkey f12\n")
    run.drive("sleep 150\n")
