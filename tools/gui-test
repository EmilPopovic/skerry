def menu_aim(run: Run, state: dict[str, str], command: str) -> tuple[float, float]:
    """Where to move the pointer to click one menu row, as the driver's percentages.

    The window reports the middle of every open row, so a test aims by command
    identifier and never by arithmetic over the menu's own constants — which it
    would have to copy, and which would then be a second copy to keep right.

    **The menu's own rows only.** A command behind a row that opens is reached
    through `submenu_aim`, which names the row: depth is a property of the menu a
    scenario is asserting about, and a helper that quietly opened whichever
    submenu held the command would let a command move one press deeper without
    any scenario noticing.
    """
    return aim_in_panel(run, state, command, "menu")


def submenu_aim(run: Run, state: dict[str, str], owner: str, command: str) -> tuple[float, float]:
    """Where to click one row of the submenu `owner` opens onto, opening it first."""
    return aim_in_panel(run, open_submenu(run, state, owner), command, "submenu")


def open_submenu(run: Run, state: dict[str, str], owner: str) -> dict[str, str]:
    """Moves the pointer onto `owner` and returns the state once its submenu is drawn.

    By hand rather than by key, because that is how a pointer scenario reaches
    one: a submenu opens on hover, with no press.
    """
    over = menu_aim(run, state, owner)
    run.drive(f"move {over[0]:.2f} {over[1]:.2f}\nsleep 200\nkey f12\nsleep 150\n")
    return holds(
        run,
        lambda it: it.get("submenu_of") == owner and bool(it.get("submenu_aim")),
        f"the {owner} submenu to open with drawn rows",
    )


def aim_in_panel(run: Run, state: dict[str, str], command: str, panel: str) -> tuple[float, float]:
    """Where to click one row of `panel` — `menu` or `submenu` — by identifier.

    **Scrolls to it if it is not drawn.** The background menu is taller than a
    720-pixel window and scrolls, and only the drawn rows report a rectangle. A
    helper that gave up on the first look made every menu scenario depend on the
    menu's *length*: adding two commands pushed the palette below the fold and
    `palette-by-pointer` failed — on X11, where the window is 720 tall, and not on
    Wayland, where it is not. Scrolling here is also the only thing that covers a
    scrolled menu being clickable at all — and an Open with submenu on a machine
    with a dozen text editors is a panel that scrolls too.
    """
    aim_key, scroll_key, drawn_key = f"{panel}_aim", f"{panel}_scroll", f"{panel}_drawn"
    # **Wait for a drawn panel before reading one.** The aim points come from the
    # hit rectangles a *frame* fills, so a dump taken between the click and the
    # next frame reports every row as dimmed-or-not and none of them as anywhere.
    # Under a full sweep that is what arrives, and the reads below then take an
    # empty string apart — a crash rather than a failure, which is the same defect
    # `keyboard-cursor` records at the top of this file.
    if not state.get(aim_key):
        state = holds(run, lambda it: bool(it.get(aim_key)), f"a {panel} with drawn rows")
    for attempt in range(8):
        # F12 can observe the model after a wheel event but before its paint.
        # Aim only when the hit rectangles represent that same scroll position.
        if state.get(scroll_key) != state.get(drawn_key):
            state = holds(run, lambda it: it.get(scroll_key) == it.get(drawn_key),
                          f"the {panel}'s current scroll position to be painted")
        for entry in state.get(aim_key, "").split(","):
            name, _, point = entry.partition("@")
            if name == command:
                x, _, y = point.partition(":")
                return aim(run, state, float(x), float(y))
        if attempt == 0:
            # The pointer has to be over the panel for the wheel to reach it.
            first = state.get(aim_key, "").split(",")[0]
            _, _, point = first.partition("@")
            x, _, y = point.partition(":")
            if not x:
                break
            over = aim(run, state, float(x), float(y))
            run.drive(f"move {over[0]:.1f} {over[1]:.1f}\nsleep 120\n")
        # Down the menu, which is a positive delta — the same direction that
        # scrolls a list. It used to be `-3` here, against a `Menu::wheel` whose
        # two arms were swapped: the harness and the defect agreed with each other
        # and neither agreed with the pane.
        run.drive("scroll 3\nsleep 150\nkey f12\nsleep 150\n")
        state = run.state()
    raise Failure(f"{command} is not on the open {panel}: {state.get(aim_key)!r}")


def palette_aim(run: Run, state: dict[str, str], command: str) -> tuple[float, float]:
    """Where to click one palette result, as the driver's percentages.

    The same trade `menu_aim` makes: the window reports the middle of every drawn
    row, so a test aims by command identifier rather than by arithmetic over the
    palette's own constants.
    """
    for entry in state.get("palette_aim", "").split(","):
        name, _, point = entry.partition("@")
        if name == command:
            x, _, y = point.partition(":")
            return aim(run, state, float(x), float(y))
    raise Failure(f"{command} is not on the open palette: {state.get('palette_aim')!r}")


