@scenario("keyboard-new-folder", fresh=True)
def keyboard_new_folder(run: Run, fixture: Path) -> None:
    """Ctrl+Shift+N, a name, Enter — and Ctrl+Z takes it all back.

    Two operations in one scenario on purpose: the folder is made under its
    placeholder name and *then* renamed, so a passing rename here is also proof
    that the field opened on the row the reload brought in rather than on
    whatever row that index held before.
    """
    run.drive("sleep 500\nkey f12\nkey ctrl+shift+n\nsleep 900\nkey f12\nsleep 200\n")
    before, naming = run.states()[:2]
    expect(before, rows="9", undo="false")
    if not naming["naming"]:
        raise Failure(f"no name field opened: {naming}")
    expect(naming, rows="10", naming="New folder")

    # Ctrl+U clears the field, which is the whole reason it exists.
    run.drive(
        "key ctrl+u\ntext zeta\nsleep 200\nkey f12\nsleep 150\n"
        "key enter\nsleep 900\nkey f12\nsleep 200\n"
    )
    typed, committed = run.states()[-2:]
    expect(typed, naming="zeta")
    expect(committed, naming="", rows="10", undo="true")
    if not (fixture / "zeta").is_dir():
        raise Failure("the folder was named zeta and is not on the disk")

    # **Two operations, so two undos.** Making the folder and naming it are two
    # entries on one stack, and the first Ctrl+Z takes back the name rather than
    # the folder — which is the whole point of rule 3 being about mutations and
    # not about gestures.
    run.drive("key ctrl+z\nsleep 900\nkey f12\nsleep 200\n")
    unnamed = run.state()
    expect(unnamed, rows="10", undo="true", redo="true", cursor="New folder")
    if (fixture / "zeta").exists():
        raise Failure("undoing the rename left zeta behind")

    run.drive("key ctrl+z\nsleep 900\nkey f12\nsleep 200\n")
    undone = run.state()
    if (fixture / "New folder").exists():
        raise Failure("undo left the folder behind")
    expect(undone, rows="9", undo="false", redo="true")


