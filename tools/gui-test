def tab_aim(run: Run, state: dict[str, str], index: int) -> tuple[float, float]:
    """Where to click the `index`th tab of the focused pane."""
    entries = [it for it in state.get("tab_aim", "").split(",") if it]
    if index >= len(entries):
        raise Failure(f"no tab {index}: {state.get('tab_aim')!r}")
    x, _, y = entries[index].partition(":")
    return aim(run, state, float(x), float(y))


def divider_aim(run: Run, state: dict[str, str], index: int = 0) -> tuple[float, float]:
    """Where to grab the `index`th divider between panes."""
    entries = [it for it in state.get("divider_aim", "").split(",") if it]
    if index >= len(entries):
        raise Failure(f"no divider {index}: {state.get('divider_aim')!r}")
    x, _, y = entries[index].partition(":")
    return aim(run, state, float(x), float(y))


