@scenario("palette-by-pointer")
def palette_by_pointer(run: Run, fixture: Path) -> None:
    """Opened from the background menu, and a result clicked. No keys at all.

    Except `F12`, which is how a scenario reads any state, and the type-ahead the
    other palette scenario covers — the point here is that a pointer alone can
    reach a command that has no button.
    """
    run.drive("sleep 500\nkey f12\nsleep 100\n")
    start = run.state()
    # A secondary click on empty space below the rows opens the background menu.
    empty = aim(
        run,
        start,
        float(start["name_x"]) + 30.0,
        float(start["body_top"]) + float(start["body_height"]) - 20.0,
    )
    run.drive(
        f"move {empty[0]:.1f} {empty[1]:.1f}\nsleep 150\nclick right\nsleep 400\n"
        "key f12\nsleep 150\n"
    )
    menu = run.state()
    if int(menu["menu"]) < 9:
        raise Failure(f"the background menu opened {menu['menu']} rows")
    # **Not checked against the drawn rows first.** The background menu is taller
    # than this window and scrolls, so `menu_aim` is what knows how to reach a row
    # that is not drawn — and a pre-check here made this scenario fail whenever
    # the menu grew, which it did the day two commands were added to it.
    at = menu_aim(run, menu, "view.palette")
    run.drive(f"move {at[0]:.1f} {at[1]:.1f}\nsleep 150\nclick\nsleep 400\nkey f12\nsleep 150\n")
    opened = run.state()
    if int(opened["palette"]) < 20:
        raise Failure(f"clicking the menu row opened {opened['palette']} results")

    # A result past the eleventh, reached with the wheel — which is the whole of
    # why the palette takes the wheel: with fifty commands and eleven rows drawn,
    # a pointer with no keyboard could otherwise reach only the first eleven.
    #
    # The move and the scroll go in one script: each `drive` is a fresh process
    # with a fresh virtual pointer, and a pointer that has never moved has no
    # position for the compositor to route an axis event by.
    over = palette_aim(run, opened, "go.open")
    scrolled = opened
    for _ in range(8):
        if "view.hidden" in scrolled["palette_aim"]:
            break
        run.drive(
            f"move {over[0]:.1f} {over[1]:.1f}\nsleep 120\nscroll 5\nsleep 300\n"
            "key f12\nsleep 150\n"
        )
        moved = run.state()
        if moved["palette_scroll"] == scrolled["palette_scroll"]:
            raise Failure(f"the wheel stopped at {moved['palette_scroll']} of {moved['palette']}")
        scrolled = moved
    else:
        raise Failure(f"scrolling never reached it: {scrolled['palette_aim']}")
    target = palette_aim(run, scrolled, "view.hidden")
    run.drive(
        f"move {target[0]:.1f} {target[1]:.1f}\nsleep 200\nkey f12\nsleep 150\n"
    )
    hovering = run.state()
    expect(hovering, palette_id="view.hidden", pointer="hand")
    run.drive("click\nsleep 400\nkey f12\nsleep 150\n")
    expect(run.state(), palette="-1", hidden="true")


