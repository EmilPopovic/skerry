    settled = listed(run)
    before = int(settled["rows"])
    run.drive("key f5\nsleep 400\n")
    holds(run, lambda it: int(it["rows"]) >= before + 1, f"more than {before} rows")
    run.drive("text notes\nsleep 400\n")
    quiet = until(run, cursor="notes.txt")

    run.drive("key space\nsleep 900\n", answering=False)
    first = photograph(run, quiet, run.log.parent / "preview-before-input.png")
    run.drive("key f12\nsleep 200\n")
