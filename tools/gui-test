# SPDX-License-Identifier: Apache-2.0
"""End-to-end tests that drive the real window with real input.

Every other test in this repository stops at the edge of `sk-plat`. These press
keys and move a pointer through a compositor, so what they cover is the whole
path: `wl_keyboard`, `xkbcommon`, the click counter, the scroll coalescer, the
command registry, hit-testing, and the frame loop that has to wake up for any of
it to be seen.

    tools/gui-test                 # run every scenario
    tools/gui-test --keep          # leave the fixture and the log behind
    tools/gui-test --scale=1.25    # nest the compositor at a fractional scale
    tools/gui-test --scenario-timeout=30   # fail anything slower, to find one
    tools/gui-test --suite-timeout=600     # and a ceiling for the whole sweep
    tools/gui-test selection       # run the scenarios whose name matches

**It needs a nested compositor and refuses to run without one.** Synthetic input
goes wherever the focus is, so pointing this at a live session would type into
whatever window a person had open. It starts its own Hyprland — the only
compositor on this machine that advertises `zwp_virtual_keyboard_manager_v1` and
`zwlr_virtual_pointer_manager_v1`; KWin advertises neither, which is why the
portability answer for KWin still has to come from running the product there by
hand.

Assertions read the `skerry-state` line that `F12` prints, which carries the
layout geometry so a scenario can click an exact row rather than agreeing with a
copy of the metrics it is testing.
"""

from __future__ import annotations

import contextlib
import json
import os
import re
import select
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import time
import traceback
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SKERRY = ROOT / "target" / "release" / "skerry"
DRIVE = ROOT / "target" / "release" / "skerry-drive"

# How long to wait for a socket, a window, or a directory read.
PATIENCE = 20.0

# The longest a window may take to answer one `F12` before the wait gives up and
# lets the scenario's own assertion speak. A frame and a scheduler hiccup, not an
# operation: anything that waits on a *job* polls instead.
A_FRAME = 5.0

# How long a poller keeps asking before it calls the wait a failure.
#
# **A clock, not a count.** These loops used to run a fixed forty times, which
# was a duration only by accident: each try took as long as a `drive` took, so
# removing a five-second stall from every drive quietly cut the wait from minutes
# to six seconds and `a-paste-takes-what-another-application-copied` began
# failing at 5.8 s — an assertion that had never been given time to be true. A
# wait measured in tries changes length whenever anything under it gets faster.
WAITING = 30.0
# Operations get longer than reads do: a copy is bytes, and the ceiling has to
# clear the largest fixture rather than the median one.
WORKING = 90.0

# The longest one scenario may take, and the longest a whole sweep may take.
#
# **Both are ceilings rather than expectations.** A scenario that hangs used to
# hang the sweep, and a sweep with no bound is one that a runner kills at its own
# job timeout with no idea which scenario was to blame — which is the failure this
# harness was least able to report on and the one most likely to happen at night.
SCENARIO_BUDGET = 180.0
SUITE_BUDGET = 2400.0


class Failure(Exception):
    pass


class Skipped(Exception):
    """The scenario needs something this machine does not have."""


