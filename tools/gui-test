@scenario("touchpad-flick", fresh=True)
def touchpad_flick(run: Run, fixture: Path) -> None:
    """The fingers leave the pad at speed and the list keeps going.

    **Differential, because the distance is not ours to predict.** A compositor
    applies its own factor to a finger's scroll, so an absolute assertion here
    would be about Hyprland's configuration rather than about this code. The same
    twenty deltas are sent twice — once lifting the moment they stop, once resting
    300 ms first — and only the first should coast past where the finger left off.
    That is the whole of the feature: a lift at speed throws the list, a lift at
    rest does not.

    It also covers the thing that made a flick impossible before it existed. The
    frame loop requests no frame callbacks, so an animation only continues if
    `App::timeout` says a frame is owed; without that, a fling moved for one frame
    and then slept, which is a coast of about three per cent.
    """
    if isinstance(SERVER, X11Server):
        raise Skipped("X11 core events are wheel buttons: no finger source, no axis_stop")
    run.drive("sleep 400\nkey f12\nsleep 100\n")
    fill_until_scrollable(run, fixture)

    def travel(hold: int) -> float:
        # Home first, so each gesture starts from the top and neither of them
        # measures the tail of the other.
        run.drive("key home\nsleep 300\nkey f12\nsleep 150\n")
        before = float(run.state()["scroll"])
        run.drive(
            f"move 50 50\nsleep 150\nflick 16 20 {hold}\nsleep 800\nkey f12\nsleep 200\n"
        )
        return float(run.state()["scroll"]) - before

    at_rest = travel(300)
    resting = run.state()
    if at_rest <= 0.0:
        raise Failure(f"the gesture itself moved nothing: {at_rest}")
    thrown = travel(0)
    lifted = run.state()
    if thrown < at_rest * 1.25:
        raise Failure(
            f"a lift at speed travelled {thrown} against {at_rest} for one at rest; "
            f"the window saw {lifted['scrolls']} scrolls, {lifted['precise']} of them "
            f"from a finger, {lifted['lifts']} lifts, and a clock of "
            f"{lifted['scroll_time']} and {lifted['flings']} flings "
            f"({resting['scrolls']}/{resting['precise']}/{resting['lifts']} after the first)"
        )


