#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Every gate that can run without a display server, in the order that fails fastest.
# CI runs the same script. So does the /check skill.
set -u
cd "$(dirname "$0")/.." || exit 1

status=0
if command -v desktop-file-validate >/dev/null 2>&1; then
    desktop-file-validate packaging/dev.skerry.Skerry.desktop || status=1
else
    echo "  FAIL  desktop-file-validate missing: install desktop-file-utils"
    status=1
fi
python3 tools/test-package.py || status=1
python3 tools/notices.py --check || status=1
for check in check-links check-layering dep-budget check-invariants; do
    python3 "tools/$check.py" || status=1
done

# The supply chain: licences, wildcards and where a crate came from. Skipped
# rather than failed where the tool is absent, the same bargain `tools/golden`
# makes with Pillow — a gate a person cannot run is one they will stop running.
# `advisories` is deliberately not here: it fetches the RustSec database over
# the network, and the `supply` job in CI is where the network is a given.
if command -v cargo-deny >/dev/null 2>&1; then
    cargo deny --workspace check licenses bans sources || status=1
else
    echo "  skip  cargo-deny: not installed (cargo install cargo-deny)"
fi

if [ -f Cargo.toml ]; then
    cargo fmt --all --check || status=1
    cargo clippy --workspace --all-targets -- -D warnings || status=1
    cargo test --workspace || status=1
    cargo run --release --locked -p sk-util --example worker-panic || status=1
fi

# **Rule 1's test rig, checked rather than assumed.** `tools/hung-mount` is what
# `a-hung-mount-never-blocks-the-frame-loop` mounts, and a rig that stopped hanging
# would make that scenario pass over a filesystem that answers — which is the
# "gate nobody has watched fail" shape. Five seconds, and it skips where FUSE is
# not available to an unprivileged user rather than failing.
if command -v fusermount3 >/dev/null 2>&1 && [ -c /dev/fuse ]; then
    python3 tools/hung-mount --self-test || status=1
else
    echo "  skip  hung-mount: no fusermount3 or /dev/fuse for an unprivileged user"
fi

# Golden frames. Last because it needs a release binary and renders seven of
# them; it runs on lavapipe, so it needs no GPU and no display server, and it
# says so and passes where lavapipe or Pillow is missing.
if [ -x target/release/skerry ]; then
    python3 tools/golden || status=1
else
    echo "  skip  golden frames: no release build"
fi

[ "$status" -eq 0 ] && echo "\nall gates pass" || echo "\ngates failed"
exit "$status"
