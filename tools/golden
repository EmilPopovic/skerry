#!/usr/bin/env python3
"""Golden frames: render the interface and compare it to what it looked like.

    tools/golden              # compare against tests/golden
    tools/golden --bless      # accept what it renders now as the reference
    tools/golden path         # only the frames whose name matches

Every other test here asserts about a number the program reports. These assert
about the pixels, which is the only way to catch a glyph that moved half a pixel,
a colour that lost its alpha, a column that stopped shedding, or a row that draws
under the status bar at 200%.

**Rendered on lavapipe**, Mesa's software Vulkan, so the reference does not
depend on whose GPU produced it. Measured on this machine, the same frame differs
by at most **two channel levels of 255** between llvmpipe, RADV and the NVIDIA
proprietary driver — one level between the two hardware ones. Blending in an
sRGB target is not bit-exact across implementations, so the comparison has to
allow that much and nothing more.

**The comparison is a perceptual one**: CIE76 ΔE in CIELAB, failing above the
just-noticeable difference of 2.3. Two channel levels is at worst ΔE 1.7 — near
black, where the sRGB curve is steepest — so every driver difference measured
passes and nothing a person could see does. A channel threshold was the same
number everywhere, which is a different amount of visible difference in a dark
region than in a bright one, and it could not say *what* changed. This can: a
second pass over both images blurred by a pixel separates a glyph that moved from
one that blended differently, and the failure says which.

The fixture lives at a **fixed absolute path**, because the path bar is part of
the frame and `mkdtemp` would put a different string in every reference. Its
modification times are fixed in 2001 for the same reason: a date in a past year
renders as `3 Feb 2001` and stays that way, where a recent one becomes a clock
time and then a date the next day.

Two inputs to a frame come from the machine rather than from the repository, and
both are pinned here:

* **The timezone**, because the Modified column is `localtime_r` of a fixed
  epoch second, and west of UTC that second is the previous day.
* **The fonts**, which decide most of the pixels. The fixture holds Hebrew,
  Arabic and an emoji on purpose, so the whole fallback chain is in the image.
  `faces.txt` records the chain the references were blessed on **by the hash of
  each file**, and a run that would shape with anything else **refuses to
  compare** — rather than reporting a million differing samples and implicating
  the renderer. The hash and not the name: Ubuntu 24.04 ships NotoColorEmoji
  2.047 where 26.04 ships 2.051, both as `NotoColorEmoji.ttf`.
"""

from __future__ import annotations

import math
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SKERRY = ROOT / "target" / "release" / "skerry"
REFERENCES = ROOT / "tests" / "golden"
# The face chain the references were blessed with, written by --bless.
FACES = REFERENCES / "faces.txt"
FIXTURE = Path("/tmp/skerry-golden")

# How far a pixel may differ from the reference before it is a regression, as
# **CIE76 ΔE** — a distance in CIELAB, where 1.0 is about the smallest difference
# a person can see side by side and 2.3 is the textbook just-noticeable
# difference.
#
# This replaced "two channel levels of 255", which was a threshold rather than a
# metric: two levels is a different amount of visible difference in a dark region
# than in a bright one, and it says nothing about *what* changed. Measured on
# this machine, the same frame across llvmpipe, RADV and the NVIDIA proprietary
# driver moves at most two levels, which is ΔE 1.7 at its worst — near black,
# where the sRGB curve is steepest. So this bound admits every driver difference
# measured and nothing a person would see.
JND = 2.3

# Where a difference stops being blending and starts being geometry.
#
# Both images are blurred by one pixel and compared again. A glyph that *moved*
# displaces its whole edge, so the blurred difference is about as large as the
# sharp one; coverage noise is scattered single pixels, which a blur averages
# away almost entirely. Measured on this frame: a line of text nudged one pixel
# leaves 3,546 blurred pixels against 2,268 sharp ones, and 400 scattered pixels
# at ΔE 8.7 leave one.
#
# Reported rather than gated — the gate is JND above — because this is the number
# that says *which kind* of change it is, which a channel threshold could never
# answer.
STRUCTURAL = 2.3
GEOMETRY_RATIO = 0.5

# A fixed instant in a past year, so the Modified column renders as a date and
# not as a clock time that changes at midnight.
FIXED_MTIME = 981_158_400  # 2001-02-03T00:00:00Z

FRAMES = [
    ("scale-100", ["--size", "900x520", "--scale", "100"]),
    ("scale-125", ["--size", "900x520", "--scale", "125"]),
    ("scale-150", ["--size", "900x520", "--scale", "150"]),
    ("scale-200", ["--size", "760x440", "--scale", "200"]),
    ("light", ["--size", "900x520", "--scale", "125", "--light"]),
    ("keyboard-overlay", ["--size", "900x520", "--scale", "125", "--keys"]),
    # **Not the statistics overlay.** Its content is job counts and cache
    # hit rates, which differ between two runs of the same binary by design —
    # a golden frame of it would either be flaky or would have to mask the only
    # thing it shows. The keyboard overlay covers "an overlay draws correctly"
    # and its content comes from the command registry, which does not vary.
    # The context menu, which is the whole of the pointer's way into the command
    # registry: eleven rows, three of them dimmed, four dividers and a
    # highlight. Its width is the width of its widest shaped row, so this is
    # also the only frame that would catch that measurement drifting.
    ("context-menu", ["--size", "900x520", "--scale", "125", "--menu"]),
    # The path bar as a field, with the caret a third of the way along it —
    # which is the only frame that would catch the caret's position drifting
    # from the shaped width of the text before it.
    ("path-entry", ["--size", "900x520", "--scale", "125", "--path-entry"]),
    # The same field in a window too narrow for the path in it, which is where
    # the scroll that keeps the caret inside the box is the only thing drawing
    # anything legible at all.
    ("path-entry-narrow", ["--size", "280x300", "--scale", "125", "--path-entry"]),
    # The palette: a query narrowing the registry, with the ranking, a dimmed
    # row, the highlight and the count of what did not fit all in one frame.
    ("palette", ["--size", "900x520", "--scale", "125", "--palette"]),
    # The find popup: the field, its caret, the match count, and the two rows it
    # narrowed to — which is also the only frame that would catch the caret
    # growing back to the height of its box.
    ("find", ["--size", "900x520", "--scale", "125", "--filter"]),
    # A name being typed, with its stem selected and its extension not — and the
    # only frame that would catch the row's focus ring coming back around a field
    # that already draws its own box.
    ("rename", ["--size", "900x400", "--scale", "125", "--rename"]),
    # A rename started from a search: the popup dimmed and caretless because the
    # keyboard is on the name, the rows it hid still hidden, and the field over
    # the row where the search put it rather than where the file sorts.
    (
        "rename-while-filtered",
        ["--size", "900x400", "--scale", "125", "--filter", "--rename"],
    ),
    # A path-bar chevron's sibling menu: the list, the row the path goes through
    # marked, and the anchor under the separator it hangs from. The only frame
    # that would catch the menu drifting away from its chevron.
    ("crumb-menu", ["--size", "900x400", "--scale", "125", "--crumbs"]),
    # The same menu over a folder that holds no folders. A panel sized by its
    # rows alone has no rows here, and the frame is the only thing that would
    # catch the message hanging out of eight pixels of background.
    ("crumb-menu-empty", ["--size", "900x400", "--scale", "125", "--crumbs-empty"]),
    # The Properties panel: eight label-and-value rows, a title, and the only
    # frame that would catch a value column running under its own label.
    ("properties", ["--size", "900x520", "--scale", "125", "--properties"]),
    # Open With: a title, the type it resolved to under it, and three rows with
    # the first highlighted — the only frame that would catch the subtitle
    # drawing over the first row.
    ("open-with", ["--size", "900x520", "--scale", "125", "--open-with"]),
    ("narrow", ["--size", "340x300", "--scale", "125"]),
    # The frame GNOME requires. A capture has no compositor to ask, so
    # `--own-frame` tells it; without this the title bar, the three buttons and
    # the breadcrumb's right edge have no golden coverage at all.
    ("own-frame", ["--size", "900x520", "--scale", "125", "--own-frame"]),
]


class Failure(Exception):
    pass


def build_fixture() -> Path:
    """A directory whose contents are the same on every machine.

    The names are the adversarial set docs/09 asks a golden frame to cover:
    right-to-left script, combining marks, an emoji, a long name, and a name
    that is only punctuation. A name containing a newline is **not** here — it
    renders, but it also breaks every line-oriented tool that reads this
    harness's output, and what it would prove is a shaping question already
    covered by the sk-text suite.
    """
    directory = FIXTURE / "fixture"
    shutil.rmtree(FIXTURE, ignore_errors=True)
    for name in ("build", "documents", "مستندات"):
        (directory / name).mkdir(parents=True)
        (directory / name / "inner.bin").write_bytes(b"x" * 4096)
    entries = [
        ("report.pdf", 1_048_576),
        ("archive.tar.gz", 12_582_912),
        ("Makefile", 812),
        ("img2.png", 4_096),
        ("img10.png", 40_960),
        ("étude.txt", 300),          # combining acute, not precomposed
        ("שלום-עולם.md", 640),             # right to left
        ("holiday 🏖️.jpeg", 2_202_010),
        ("a-name-long-enough-to-be-elided-in-the-name-column-and-then-some.log", 77),
        ("...", 1),
        (".hidden-config", 55),
    ]
    for name, size in entries:
        (directory / name).write_bytes(b"\0" * min(size, 4096))
    # Fixed sizes without fixed bytes: the size column reads the size from
    # `statx`, and truncating to it costs nothing where writing it costs 2 MB.
    for name, size in entries:
        os.truncate(directory / name, size)
    for path in sorted(directory.rglob("*")) + [directory]:
        os.utime(path, (FIXED_MTIME, FIXED_MTIME))
    return directory


def render(name: str, arguments: list[str], into: Path) -> list[str]:
    """Renders one frame and returns the paths of the faces it shaped with."""
    raw = into.with_suffix(".raw.png")
    done = subprocess.run(
        [str(SKERRY), "--capture", str(raw), *arguments, str(FIXTURE / "fixture")],
        capture_output=True,
        text=True,
        env=dict(os.environ, VK_LOADER_DRIVERS_SELECT="lvp_icd.json", TZ="UTC"),
    )
    if done.returncode != 0:
        raise Failure(f"{name}: {done.stderr.strip()[:300]}")
    chain = [
        line.removeprefix("skerry: face ").strip()
        for line in done.stderr.splitlines()
        if line.startswith("skerry: face ")
    ]
    from PIL import Image

    # Re-encoded rather than kept: our own writer emits stored deflate blocks, so
    # a frame is 7 MB of it. What is compared is decoded pixels, so the reference
    # may be written by whatever compresses it.
    with Image.open(raw) as image:
        image.convert("RGB").save(into, optimize=True)
    raw.unlink()
    return chain


def fingerprint(chain: list[str]) -> list[tuple[str, str]]:
    """Each face as (twelve hex digits of its sha256, its file name).

    The bytes and not the name, because the name is the same on two machines
    whose font packages are not: Ubuntu 24.04 ships NotoColorEmoji 2.047 where
    26.04 ships 2.051, and the beach umbrella in the fixture is a different
    bitmap in each.
    """
    import hashlib

    out = []
    for path in chain:
        digest = hashlib.sha256(Path(path).read_bytes()).hexdigest()[:12]
        out.append((digest, Path(path).name))
    return out


def write_faces(marks: list[tuple[str, str]]) -> None:
    lines = [
        "# The fonts the references were rendered with, in chain order.",
        "# Written by tools/golden --bless. See the module docstring.",
    ]
    lines += [f"{digest}  {name}" for digest, name in marks]
    FACES.write_text("\n".join(lines) + "\n")


def read_faces() -> list[tuple[str, str]]:
    marks = []
    for line in FACES.read_text().splitlines():
        line = line.strip()
        if line and not line.startswith("#"):
            digest, name = line.split()
            marks.append((digest, name))
    return marks


def faces_differ(chain: list[str]) -> str | None:
    """Why this machine's fonts make a pixel comparison meaningless, or `None`.

    Checked once, before the first comparison. A font mismatch fails every frame
    at once with hundreds of thousands of differing samples, and the message that
    names the cause has to arrive before all of them.
    """
    if not FACES.is_file():
        return "no recorded font set — run tools/golden --bless"
    recorded, here = read_faces(), fingerprint(chain)
    if recorded == here:
        return None

    was, now = [name for _, name in recorded], [name for _, name in here]
    gone = [name for name in was if name not in now]
    extra = [name for name in now if name not in was]
    if gone or extra:
        detail = []
        if gone:
            detail.append(f"missing {' '.join(gone)}")
        if extra:
            detail.append(f"unexpected {' '.join(extra)}")
        return "fonts: a different chain — " + "; ".join(detail)

    if was != now:
        return f"fonts: the same faces in a different order — {' '.join(now)}"

    moved = [
        f"{name} is {mine}, blessed on {theirs}"
        for (theirs, name), (mine, _) in zip(recorded, here)
        if theirs != mine
    ]
    return (
        "fonts: the same faces, different files — a font package here is not the "
        "one the references were blessed on\n        " + "\n        ".join(moved)
    )


def delta_e_squared(a, b):
    """Per-pixel CIE76 ΔE², as an `F` image.

    Squared, because the comparison and the threshold can both be squared and
    `ImageMath` has no square root. Pillow's `LAB` mode puts L* in 0–255 and a*
    and b* in 0–255 around 128, so only L* needs rescaling to get real units.
    """
    from PIL import ImageMath

    def bands(image):
        return [band.convert("F") for band in image.convert("LAB").split()]

    (la, aa, ba), (lb, ab, bb) = bands(a), bands(b)
    return ImageMath.lambda_eval(
        lambda args: (
            ((args["la"] - args["lb"]) * (100.0 / 255.0)) ** 2
            + (args["aa"] - args["ab"]) ** 2
            + (args["ba"] - args["bb"]) ** 2
        ),
        la=la, lb=lb, aa=aa, ab=ab, ba=ba, bb=bb,
    )


def over(field, threshold: float):
    """How many pixels of a ΔE² field exceed `threshold`, and where they are."""
    from PIL import ImageMath

    limit = threshold * threshold
    mask = ImageMath.lambda_eval(
        lambda args: (args["field"] > args["limit"]) * 255, field=field, limit=limit
    ).convert("L")
    return sum(mask.histogram()[1:]), mask.getbbox()


def compare(name: str, fresh: Path, reference: Path) -> None:
    from PIL import Image, ImageFilter

    if not reference.is_file():
        raise Failure(f"{name}: no reference — run tools/golden --bless")
    with Image.open(fresh) as a, Image.open(reference) as b:
        a, b = a.convert("RGB"), b.convert("RGB")
        if a.size != b.size:
            raise Failure(f"{name}: {a.size} against a {b.size} reference")
        field = delta_e_squared(a, b)
        visible, box = over(field, JND)
        if visible == 0:
            return
        worst = math.sqrt(field.getextrema()[1])
        # Blurred by a pixel: what survives that is geometry, not coverage.
        blur = ImageFilter.GaussianBlur(1)
        moved, _ = over(delta_e_squared(a.filter(blur), b.filter(blur)), STRUCTURAL)
        kind = (
            f"{moved} survive a one-pixel blur, so something moved"
            if moved >= visible * GEOMETRY_RATIO
            else f"only {moved} survive a one-pixel blur, so this is blending rather "
            "than geometry — a driver, a colour, or an alpha"
        )
        raise Failure(
            f"{name}: {visible} pixels over ΔE {JND} (worst ΔE {worst:.1f}) "
            f"inside {box}; {kind}"
        )


def main(argv: list[str]) -> int:
    wanted = [a for a in argv[1:] if not a.startswith("--")]
    bless = "--bless" in argv

    if not SKERRY.is_file():
        print(f"missing {SKERRY}; run `cargo build --release` first")
        return 2
    try:
        import PIL  # noqa: F401
    except ImportError:
        print("  skip  golden frames: Pillow is not installed")
        return 0
    if not any(Path(d).joinpath("lvp_icd.x86_64.json").is_file() or
               Path(d).joinpath("lvp_icd.json").is_file()
               for d in ("/usr/share/vulkan/icd.d", "/usr/local/share/vulkan/icd.d")):
        print("  skip  golden frames: lavapipe is not installed")
        return 0

    build_fixture()
    REFERENCES.mkdir(parents=True, exist_ok=True)
    work = FIXTURE / "rendered"
    work.mkdir(parents=True, exist_ok=True)

    passed, failed = 0, []
    checked_faces = False
    for name, arguments in FRAMES:
        if wanted and not any(needle in name for needle in wanted):
            continue
        fresh = work / f"{name}.png"
        reference = REFERENCES / f"{name}.png"
        try:
            chain = render(name, arguments, fresh)
            if bless:
                write_faces(fingerprint(chain))
            elif not checked_faces:
                checked_faces = True
                if trouble := faces_differ(chain):
                    print(f"  FAIL  {trouble}")
                    return 1
            if bless:
                shutil.copyfile(fresh, reference)
                print(f"  bless {name}  {reference.stat().st_size // 1024} KiB")
            else:
                compare(name, fresh, reference)
                print(f"  ok    {name}")
            passed += 1
        except Failure as problem:
            print(f"  FAIL  {problem}")
            failed.append(name)

    print(f"\n{passed} passed, {len(failed)} failed")
    if failed:
        print(f"rendered frames left in {work} for a look")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
