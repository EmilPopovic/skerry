def build_fixture() -> Path:
    """A directory whose contents are the same on every machine.

    The names are the adversarial set docs/09 asks a golden frame to cover:
    right-to-left script, combining marks, an emoji, a long name, and a name
    that is only punctuation. A name containing a newline is **not** here — it
    renders, but it also breaks every line-oriented tool that reads this
    harness's output, and what it would prove is a shaping question already
    covered by the sk-text suite.
    """
    directory = FIXTURE / "fixture"
    shutil.rmtree(FIXTURE, ignore_errors=True)
    for name in ("build", "documents", "مستندات"):
        (directory / name).mkdir(parents=True)
        (directory / name / "inner.bin").write_bytes(b"x" * 4096)
    # One level deeper, so the column view has two ancestors *inside* the fixture
    # to draw. Invisible from the fixture root, so it changes no other frame.
    (directory / "documents" / "deeper").mkdir()
    (directory / "documents" / "deeper" / "leaf.txt").write_bytes(b"y" * 128)
    entries = [
        ("report.pdf", 1_048_576),
        ("archive.tar.gz", 12_582_912),
        ("Makefile", 812),
        ("img2.png", 4_096),
        ("img10.png", 40_960),
        ("étude.txt", 300),          # combining acute, not precomposed
        ("שלום-עולם.md", 640),             # right to left
        ("holiday 🏖️.jpeg", 2_202_010),
        ("a-name-long-enough-to-be-elided-in-the-name-column-and-then-some.log", 77),
        ("...", 1),
        (".hidden-config", 55),
    ]
    for name, size in entries:
        (directory / name).write_bytes(b"\0" * min(size, 4096))
    # Fixed sizes without fixed bytes: the size column reads the size from
    # `statx`, and truncating to it costs nothing where writing it costs 2 MB.
    for name, size in entries:
        os.truncate(directory / name, size)
    build_pictures()
    build_markdown()
    build_archives()
    for path in sorted(directory.rglob("*")) + [directory]:
        os.utime(path, (FIXED_MTIME, FIXED_MTIME))
    return directory


def three_page_pdf(rotate: int = 0) -> bytes:
    """A three-page PDF, valid enough for a renderer, with its pages numbered.

    **Hand-assembled with a real cross-reference table**, because the first version
    of this fixture had none and poppler answered `Syntax Warning: No valid XRef`
    — which it recovers from, and which makes a frame depend on a recovery path
    rather than on the file being right.

    **Three pages rather than one**, so the frame shows the page control saying
    `1 / 3` — a one-page document draws the same control saying `1 / 1`, which is
    indistinguishable from the shape it takes when the count is unknown.
    """
    # **Inside the MediaBox**, which the first draft was not: 680 on a page 595
    # tall put the line above the paper and the frame rendered a blank page, which
    # is exactly the "frame of the fallback" this file keeps warning about.
    first = (
        # 18pt, not 22: at 22 the line is about 396 points of Helvetica and the
        # MediaBox is 420 wide, so it ran off the right edge of its own paper.
        b"BT /F1 18 Tf 40 500 Td (A page, rendered by poppler or mupdf.) Tj ET\n"
        b"0.15 0.35 0.75 rg 40 380 340 90 re f\n"
        b"BT /F1 16 Tf 40 330 Td (Whatever is on PATH renders it, sandboxed.) Tj ET"
    )
    bodies = [
        first,
        b"BT /F1 24 Tf 40 500 Td (The second page.) Tj ET",
        b"BT /F1 24 Tf 40 500 Td (And the third.) Tj ET",
    ]
    # Objects 1 and 2 are the catalogue and the page tree; 3, 4 and 5 are the
    # pages; 6, 7 and 8 their contents; 9 the font.
    objects = [
        b"<< /Type /Catalog /Pages 2 0 R >>",
        b"<< /Type /Pages /Kids [3 0 R 4 0 R 5 0 R] /Count 3 >>",
    ]
    # `/Rotate` is a page attribute, and the one that makes poppler's two answers
    # about the same page disagree — see the `turned.pdf` fixture.
    turn = f" /Rotate {rotate}".encode() if rotate else b""
    objects.extend(
        b"<< /Type /Page /Parent 2 0 R /MediaBox [0 0 420 595]"
        + turn
        + b" /Resources << /Font << /F1 9 0 R >> >> /Contents "
        + str(6 + index).encode()
        + b" 0 R >>"
        for index in range(3)
    )
    objects.extend(
        b"<< /Length " + str(len(body)).encode() + b" >>\nstream\n" + body + b"\nendstream"
        for body in bodies
    )
    objects.append(b"<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>")
    out = bytearray(b"%PDF-1.4\n")
    offsets = []
    for number, obj in enumerate(objects, start=1):
        offsets.append(len(out))
        out += str(number).encode() + b" 0 obj\n" + obj + b"\nendobj\n"
    start = len(out)
    out += b"xref\n0 " + str(len(objects) + 1).encode() + b"\n0000000000 65535 f \n"
    for offset in offsets:
        out += f"{offset:010d} 00000 n \n".encode()
    out += (b"trailer\n<< /Size " + str(len(objects) + 1).encode()
            + b" /Root 1 0 R >>\nstartxref\n" + str(start).encode() + b"\n%%EOF\n")
    return bytes(out)


def build_markdown() -> None:
    """A fixture of one README, in a directory of its own.

    **Its own root, because a file added to a shared one moves nineteen frames.**
    The first version of this put the README beside the pictures, and the item
    count in the status line changed under every quick-look frame there is — a
    fixture is a premise, and changing one silently re-blesses everything that
    stood on it.
    """
    directory = FIXTURE / "markdown"
    directory.mkdir(parents=True, exist_ok=True)
    # **A README, which is the file the markdown renderer exists for.** One of
    # everything a real one has: two heading levels, emphasis, strong, code
    # inline and fenced, a link, a badge — a link around an image — a bullet list
    # with a nested item, a task list, a numbered list, a quote, a table, a rule,
    # and a line of raw HTML that has to render as its own characters.
    (directory / "README.md").write_text(
        "# Skerry\n"
        "\n"
        "A file manager for **Linux**, built on the premise that latency is a\n"
        "*feature*. See the [documentation](https://example.com/docs).\n"
        "\n"
        "[![build](https://img.example/badge.svg)](https://ci.example/skerry)\n"
        "\n"
        "## Getting started\n"
        "\n"
        "Run `make install`, then:\n"
        "\n"
        "```sh\n"
        "skerry ~/Downloads\n"
        "```\n"
        "\n"
        "- One bullet, with `code` in it\n"
        "- Another, which is long enough that it has to wrap somewhere inside the\n"
        "  panel and carry on under its own words rather than under the bullet\n"
        "  - A nested one\n"
        "- [x] Done\n"
        "- [ ] Owed\n"
        "\n"
        "1. First\n"
        "2. Second\n"
        "\n"
        "> A quote, which gets a bar down the left.\n"
        "\n"
        "| Column | What it is |\n"
        "| :----- | ---------: |\n"
        "| Name   | the file |\n"
        "| Size   | how big |\n"
        "\n"
        "---\n"
        "\n"
        "<div class=\"raw\">HTML renders as itself.</div>\n"
        "\n"
        "And ~~struck~~ text, plus ***both at once***.\n"
    )

    # **The table that was reported**, in a file of its own so it is the first
    # thing on screen. Four columns of very different widths, two of which have to
    # wrap: laid out a row at a time, every column got the same share, the long
    # one ran over the next, and the last left the panel.
    (directory / "table.md").write_text(
        "# Build variables\n"
        "\n"
        "| Variable | Default | Values | Notes |\n"
        "| -------- | ------- | ------ | ----- |\n"
        "| ARCH | x86_64 | x86_64, x86_32, riscv_64, riscv_32 | target architecture |\n"
        "| TOOLCHAIN | gnu | gnu, llvm | compiler/toolchain family |\n"
        "| IMAGE_FORMAT | img | img, iso | iso is for x86 images |\n"
        "| PROFILE | fast | fast, normal, small, debug, debug_extra | optimization and debug level |\n"
        "| RISCV_FRISC | false | true, false | build a FRISC FPGA image |\n"
        "| USERLAND | default | default, all, core, or names such as mbrose | select userland programs |\n"
        "| DOCKER_IMAGE | apheleia:latest | image tag | Docker image name |\n"
    )
    for path in sorted(directory.rglob("*")) + [directory]:
        os.utime(path, (FIXED_MTIME, FIXED_MTIME))


def build_archives() -> None:
    """One zip, in a directory of its own, written by Python's own `zipfile`.

    **Somebody else's encoder**, which is the same bargain the GIF fixture in
    `skerry-thumbnailer` makes with Pillow: an archive written by the code that
    reads it proves the two agree and nothing more. Its own root for the reason
    the markdown fixture has one — a file added to a shared directory re-blesses
    every frame that shows a listing.

    **No directory entries at all**, which is what most tools write and the case
    the panel derives its folders for: `deep/inner/note.md` is the only record
    that `deep` exists. Every timestamp is fixed, because a zip carries the
    modification date and a frame that showed today's would differ every day.
    """
    import zipfile

    directory = FIXTURE / "archives"
    directory.mkdir(parents=True, exist_ok=True)
    when = (2024, 3, 14, 9, 26, 54)
    entries = {
        "notes.txt": "Two lines of notes,\nand a second one.\n",
        "run.sh": "#!/bin/sh\necho hello\n",
        "deep/blob.bin": "x" * 20_000,
        "deep/inner/note.md": "# Nested\n\nA note inside a folder.\n",
        "deep/inner/table.csv": "one,two\n1,2\n",
        "pictures/circle.png": "not really a png, and nothing reads it\n",
    }
    archive = directory / "reports.zip"
    with zipfile.ZipFile(archive, "w", zipfile.ZIP_DEFLATED) as zip_file:
        for name, body in entries.items():
            record = zipfile.ZipInfo(name, date_time=when)
            # The execute bit on one of them, because the mode is what decides
            # whether an unpacked file is runnable and the panel shows the mark.
            record.external_attr = (0o755 if name.endswith(".sh") else 0o644) << 16
            zip_file.writestr(record, body)
    os.utime(archive, (1_710_400_000, 1_710_400_000))
    # A second archive nothing here decodes, so the frame beside it shows the
    # sentence that names the program which would.
    seven = directory / "backup.7z"
    seven.write_bytes(b"7z\xbc\xaf\x27\x1c\x00\x04" + b"\0" * 64)
    os.utime(seven, (1_710_400_000, 1_710_400_000))


def build_pictures() -> None:
    """A directory of real images, for the frames that draw thumbnails.

    **Generated rather than committed**, the same bargain the fixture above makes:
    a checked-in PNG is a binary a reviewer cannot read, and these are eleven lines
    of arithmetic whose output is identical on every machine. Every one is a shape
    a *decoder* has to get right and a scaler has to not ruin — a gradient, a fine
    checkerboard that point sampling turns into a solid colour, a circle whose edge
    is where aliasing shows, and vectors at three sizes including one far smaller
    than the slot it is drawn into.
    """
    import struct
    import zlib

    directory = FIXTURE / "pictures"
    directory.mkdir(parents=True, exist_ok=True)

    def png(name: str, width: int, height: int, pixel) -> None:
        def chunk(tag: bytes, body: bytes) -> bytes:
            return (struct.pack(">I", len(body)) + tag + body
                    + struct.pack(">I", zlib.crc32(tag + body)))
        raw = b"".join(
            b"\x00" + bytes(v for x in range(width) for v in pixel(x, y))
            for y in range(height)
        )
        (directory / name).write_bytes(
            b"\x89PNG\r\n\x1a\n"
            + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(raw))
            + chunk(b"IEND", b"")
        )

    png("gradient.png", 200, 140, lambda x, y: (250, 110 + y, 40 + x // 2))
    png("checks.png", 160, 160, lambda x, y: (30, 90, 200) if (x // 8 + y // 8) % 2 else (245, 245, 250))
    png("circle.png", 180, 180,
        lambda x, y: (30, 200, 130) if (x - 90) ** 2 + (y - 90) ** 2 < 70 ** 2 else (250, 250, 250))
    for name, side, colour in (("tiny.svg", 16, "#e0533c"), ("badge.svg", 64, "#3aa0e0"),
                               ("wide.svg", 128, "#f0c020")):
        (directory / name).write_text(
            f'<svg xmlns="http://www.w3.org/2000/svg" width="{side}" height="{side * 2 // 3}">'
            f'<rect x="1" y="1" width="{side - 2}" height="{side * 2 // 3 - 2}" rx="{side // 6}"'
            f' fill="{colour}"/></svg>'
        )
    # **An SVG with words in it, and one with a picture in it.** Both are shapes
    # plus something `resvg` has to be *configured* to draw: text needs the four
    # generic families resolved to fonts a Linux box has — its defaults are
    # Microsoft's names — and an `<image>` needs the `raster-images` feature,
    # without which every diagrams.net export drew as boxes with no labels. Two
    # frames rather than two assertions, because "the text is missing" is
    # invisible to every number a decoder can report about its own answer.
    (directory / "label.svg").write_text(
        '<svg xmlns="http://www.w3.org/2000/svg" width="128" height="96" '
        'viewBox="0 0 128 96">'
        '<rect width="128" height="96" rx="8" fill="#2d3550"/>'
        '<text x="12" y="34" font-family="sans-serif" font-size="20" fill="#e8ecf8">Sans</text>'
        '<text x="12" y="60" font-family="Helvetica" font-size="20" fill="#ffcc55">Named</text>'
        '<text x="12" y="86" font-size="20" fill="#88ddaa">Default</text>'
        "</svg>"
    )
    # A 2×2 white PNG, embedded — the same shape a diagrams.net label takes: a
    # `<switch>` whose `<foreignObject>` no renderer outside a browser draws, and
    # a raster beside it that every renderer with images enabled does.
    white = (
        "iVBORw0KGgoAAAANSUhEUgAAAAIAAAACCAYAAABytg0kAAAADklEQVR4nGP4DwUMMAYAj4IP"
        "8TylVlEAAAAASUVORK5CYII="
    )
    (directory / "embedded.svg").write_text(
        '<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" '
        'width="128" height="96" viewBox="0 0 128 96">'
        '<rect width="128" height="96" fill="#1d2b1d"/>'
        "<switch>"
        '<foreignObject width="100%" height="100%" '
        'requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility">'
        '<div xmlns="http://www.w3.org/1999/xhtml">a browser draws this</div></foreignObject>'
        f'<image x="24" y="16" width="80" height="64" xlink:href="data:image/png;base64,{white}"/>'
        "</switch></svg>"
    )

    # One file that is not a picture, so a frame shows the fallback mark beside
    # the thumbnails rather than only in another frame — and real lines, because it
    # is also what the text quick look draws.
    (directory / "readme.txt").write_text(
        "A quick look at a text file.\n"
        "\n"
        "Lines are drawn one per row, each cut into runs that carry a tone.\n"
        "There is one tone today and the highlighter is not written; what is\n"
        "written is everything around it, so adding one replaces a single\n"
        "function and nothing here.\n"
        "\n"
        "\tA tab, and a line long enough that it runs past the panel and wraps "
        "onto a second row, which is the row the gutter deliberately leaves "
        "unnumbered.\n"
        "  ¡Ünïcödé, שלום, 日本語!\n"
    )
    # **A real animated GIF, and Pillow's encoder rather than ours.** The decoder
    # in `skerry-thumbnailer` is hand-written — LZW, interlacing, disposal — and a
    # fixture written by the same hand tests the two halves of one mistake
    # together: the unit tests use a literal-only encoder that never fills the
    # dictionary, and dictionary codes are where the arithmetic is. Pillow is
    # already required for the comparison, so this costs nothing and is somebody
    # else's bit stream.
    from PIL import Image

    frames = []
    for step in range(4):
        frame = Image.new("P", (72, 72), 0)
        frame.putpalette([20, 22, 30, 240, 180, 40, 60, 200, 140, 250, 250, 250])
        pixels = frame.load()
        # A square that walks the diagonal, and a fixed bar so a frame that fails
        # to compose is visible as a missing bar rather than as a moved square.
        for y in range(72):
            for x in range(72):
                inside = step * 16 <= x < step * 16 + 24 and step * 16 <= y < step * 16 + 24
                if inside:
                    pixels[x, y] = 1
                elif 60 <= y < 68 and 4 <= x < 68:
                    pixels[x, y] = 2
                elif (x // 8 + y // 8) % 2 == 0:
                    pixels[x, y] = 3
        frames.append(frame)
    frames[0].save(
        directory / "spinner.gif",
        save_all=True,
        append_images=frames[1:],
        duration=120,
        loop=0,
    )

    # **A file of code, for the highlighter.** Four roles — a comment, a keyword,
    # a literal and a number — and the shapes that catch a scanner: a comment
    # marker inside a string, a lifetime that is not a string, a block comment
    # crossing lines, and a word that merely starts with a keyword.
    (directory / "sample.rs").write_text(
        "// What the four roles look like.\n"
        "use std::io::Read;\n"
        "\n"
        "/* a block comment\n"
        "   that crosses lines */\n"
        "pub fn main(count: usize) -> char {\n"
        '    let path = "a // b";  // not a comment in there\n'
        "    let letter = 'x';\n"
        "    let lifetimes: &'static str = path;\n"
        "    let numbers = [42, 0x1f, 1_000, 2.5e3];\n"
        # **The line that crashed the window.** `Ž` is two bytes and the scanner
        # walked one at a time, so the index after it landed inside the character
        # and the next slice panicked — on an ordinary file in a home directory.
        '    let name = "Žofia";  // Ž, é and 日本語 are all more than a byte\n'
        "    let_go(count, numbers, lifetimes);\n"
        "    letter\n"
        "}\n"
    )

    # **A page turned a quarter, which is where poppler disagrees with itself**:
    # its text layer reports the *unrotated* MediaBox as the page's size and the
    # word boxes in the *rotated* space, while its renderer draws the rotated
    # image. Every highlight landed a factor of 1.4 from its word until the child
    # started asking `pdfinfo` for the angle — and this is the frame that says so.
    (directory / "turned.pdf").write_bytes(three_page_pdf(rotate=90))

    # A one-page PDF, written by hand so it needs no tool to generate — and it is
    # the only fixture whose *rendering* is somebody else's, which is the point:
    # `skerry-preview-doc` drives whatever is on `PATH`.
    (directory / "paper.pdf").write_bytes(three_page_pdf())
    # **A file the databases call a PDF and the helper does not.** No `%PDF-`
    # header, so `skerry-preview-doc` answers `NotItsKind` — a refusal with no
    # sentence of its own, which is exactly the one that used to leave an open
    # panel blank with nothing in it but a title.
    (directory / "broken.pdf").write_bytes(b"not a document at all\n" * 8)
    for path in sorted(directory.rglob("*")) + [directory]:
        os.utime(path, (FIXED_MTIME, FIXED_MTIME))


def render(name: str, arguments: list[str], into: Path, root: str = "fixture") -> list[str]:
    """Renders one frame and returns the paths of the faces it shaped with.

    **`root` exists because a fixture is shared and a feature's files are not.**
    Every frame but a handful lists `fixture`, so a file added there changes all of
    them — and the pictures a thumbnail frame needs would have re-blessed forty
    references to show two. A frame that needs its own contents names its own
    directory instead, and the shared one is left alone.
    """
    raw = into.with_suffix(".raw.png")
    done = subprocess.run(
        [str(SKERRY), "--capture", str(raw), *arguments, str(FIXTURE / root)],
        capture_output=True,
        text=True,
        env=dict(os.environ, VK_LOADER_DRIVERS_SELECT="lvp_icd.json", TZ="UTC"),
    )
    if done.returncode != 0:
        raise Failure(f"{name}: {done.stderr.strip()[:300]}")
    chain = [
        line.removeprefix("skerry: face ").strip()
        for line in done.stderr.splitlines()
        if line.startswith("skerry: face ")
    ]
    from PIL import Image

    # Re-encoded rather than kept: our own writer emits stored deflate blocks, so
    # a frame is 7 MB of it. What is compared is decoded pixels, so the reference
    # may be written by whatever compresses it.
    with Image.open(raw) as image:
        image.convert("RGB").save(into, optimize=True)
    raw.unlink()
    # PDF Base-14 substitution is independent of the application's font chain.
    pdf_font = subprocess.check_output(["fc-match", "-f", "%{file}", "Helvetica"], text=True).strip()
    chain.append(pdf_font)
    return chain


def fingerprint(chain: list[str]) -> list[tuple[str, str]]:
    """Each face as (twelve hex digits of its sha256, its file name).

    The bytes and not the name, because the name is the same on two machines
    whose font packages are not: Ubuntu 24.04 ships NotoColorEmoji 2.047 where
    26.04 ships 2.051, and the beach umbrella in the fixture is a different
    bitmap in each.
    """
    import hashlib

    out = []
    for path in chain:
        digest = hashlib.sha256(Path(path).read_bytes()).hexdigest()[:12]
        out.append((digest, Path(path).name))
    return out


def write_faces(marks: list[tuple[str, str]]) -> None:
    lines = [
        "# The fonts the references were rendered with, in chain order.",
        "# Written by tools/golden --bless. See the module docstring.",
    ]
    lines += [f"{digest}  {name}" for digest, name in marks]
    FACES.write_text("\n".join(lines) + "\n")


def read_faces() -> list[tuple[str, str]]:
    marks = []
    for line in FACES.read_text().splitlines():
        line = line.strip()
        if line and not line.startswith("#"):
            digest, name = line.split()
            marks.append((digest, name))
    return marks


def faces_differ(chain: list[str]) -> str | None:
    """Why this machine's fonts make a pixel comparison meaningless, or `None`.

    Checked once, before the first comparison. A font mismatch fails every frame
    at once with hundreds of thousands of differing samples, and the message that
    names the cause has to arrive before all of them.
    """
    if not FACES.is_file():
        return "no recorded font set — run tools/golden --bless"
    recorded, here = read_faces(), fingerprint(chain)
    if recorded == here:
        return None

    was, now = [name for _, name in recorded], [name for _, name in here]
    gone = [name for name in was if name not in now]
    extra = [name for name in now if name not in was]
    if gone or extra:
        detail = []
        if gone:
            detail.append(f"missing {' '.join(gone)}")
        if extra:
            detail.append(f"unexpected {' '.join(extra)}")
        return "fonts: a different chain — " + "; ".join(detail)

    if was != now:
        return f"fonts: the same faces in a different order — {' '.join(now)}"

    moved = [
        f"{name} is {mine}, blessed on {theirs}"
        for (theirs, name), (mine, _) in zip(recorded, here)
        if theirs != mine
    ]
    return (
        "fonts: the same faces, different files — a font package here is not the "
        "one the references were blessed on\n        " + "\n        ".join(moved)
    )


def delta_e_squared(a, b):
    """Per-pixel CIE76 ΔE², as an `F` image.

    Squared, because the comparison and the threshold can both be squared and
    `ImageMath` has no square root. Pillow's `LAB` mode puts L* in 0–255 and a*
    and b* in 0–255 around 128, so only L* needs rescaling to get real units.
    """
    from PIL import ImageMath

    def bands(image):
        return [band.convert("F") for band in image.convert("LAB").split()]

    (la, aa, ba), (lb, ab, bb) = bands(a), bands(b)
    return ImageMath.lambda_eval(
        lambda args: (
            ((args["la"] - args["lb"]) * (100.0 / 255.0)) ** 2
            + (args["aa"] - args["ab"]) ** 2
            + (args["ba"] - args["bb"]) ** 2
        ),
        la=la, lb=lb, aa=aa, ab=ab, ba=ba, bb=bb,
    )


def over(field, threshold: float):
    """How many pixels of a ΔE² field exceed `threshold`, and where they are."""
    from PIL import ImageMath

    limit = threshold * threshold
    mask = ImageMath.lambda_eval(
        lambda args: (args["field"] > args["limit"]) * 255, field=field, limit=limit
    ).convert("L")
    return sum(mask.histogram()[1:]), mask.getbbox()


def compare(name: str, fresh: Path, reference: Path) -> None:
    from PIL import Image, ImageFilter

    if not reference.is_file():
        raise Failure(f"{name}: no reference — run tools/golden --bless")
    with Image.open(fresh) as a, Image.open(reference) as b:
        a, b = a.convert("RGB"), b.convert("RGB")
        if a.size != b.size:
            raise Failure(f"{name}: {a.size} against a {b.size} reference")
        field = delta_e_squared(a, b)
        visible, box = over(field, JND)
        if visible == 0:
            return
        worst = math.sqrt(field.getextrema()[1])
        # Blurred by a pixel: what survives that is geometry, not coverage.
        blur = ImageFilter.GaussianBlur(1)
        moved, _ = over(delta_e_squared(a.filter(blur), b.filter(blur)), STRUCTURAL)
        kind = (
            f"{moved} survive a one-pixel blur, so something moved"
            if moved >= visible * GEOMETRY_RATIO
            else f"only {moved} survive a one-pixel blur, so this is blending rather "
            "than geometry — a driver, a colour, or an alpha"
        )
        raise Failure(
            f"{name}: {visible} pixels over ΔE {JND} (worst ΔE {worst:.1f}) "
            f"inside {box}; {kind}"
        )


def main(argv: list[str]) -> int:
    wanted = [a for a in argv[1:] if not a.startswith("--")]
    bless = "--bless" in argv

    # **Built, not assumed.** This renders with `target/release/skerry` and used
    # only to check that the file existed, which is not the same as it being
    # current. Measured: a one-line catalogue edit was blessed into two reference
    # frames from a binary that predated it, and the gate went green on the old
    # string and red on the next run — a reference blessed from stale code is a
    # test that asserts the wrong thing for as long as nobody looks.
    # `tools/gui-test` had the same hole; see its `build_binaries`.
    # **And the helpers, which the same argument covers and the first version of
    # this did not build.** A thumbnail, a page and an archive listing each come
    # from a separate executable, so `--bin skerry` alone blesses a frame against
    # whatever helper happened to be left in `target/release` — which for a fresh
    # clone is nothing at all, and for a working tree is the one from before the
    # change under test. Found by adding a frame of a listing: it came out saying
    # "The archive helper stopped before it answered", which is exactly what a
    # missing helper looks like and exactly what a stale one would not.
    built = subprocess.run(
        ["cargo", "build", "--release", "--bin", "skerry", "--bin", "skerry-thumbnailer",
         "--bin", "skerry-preview-doc", "--bin", "skerry-archive"],
        cwd=ROOT, capture_output=True, text=True, timeout=900,
    )
    if built.returncode != 0:
        print(f"the workspace would not build:\n{built.stderr.strip()[-2000:]}")
        return 2
    if not SKERRY.is_file():
        print(f"missing {SKERRY}; run `cargo build --release` first")
        return 2
    try:
        from PIL import ImageMath
        if not hasattr(ImageMath, "lambda_eval"):
            print("  FAIL  golden frames need Pillow with ImageMath.lambda_eval (10.3 or newer)")
            return 1
    except ImportError:
        print("  skip  golden frames: Pillow is not installed")
        return 0
    if not any(Path(d).joinpath("lvp_icd.x86_64.json").is_file() or
               Path(d).joinpath("lvp_icd.json").is_file()
               for d in ("/usr/share/vulkan/icd.d", "/usr/local/share/vulkan/icd.d")):
        print("  skip  golden frames: lavapipe is not installed")
        return 0

    build_fixture()
    REFERENCES.mkdir(parents=True, exist_ok=True)
    work = FIXTURE / "rendered"
    work.mkdir(parents=True, exist_ok=True)

    passed, failed = 0, []
    checked_faces = False
    for name, arguments, *rest in FRAMES:
        if wanted and not any(needle in name for needle in wanted):
            continue
        root = rest[0] if rest else "fixture"
        fresh = work / f"{name}.png"
        reference = REFERENCES / f"{name}.png"
        try:
            chain = render(name, arguments, fresh, root)
            if bless:
                write_faces(fingerprint(chain))
            elif not checked_faces:
                checked_faces = True
                if trouble := faces_differ(chain):
                    print(f"  FAIL  {trouble}")
                    return 1
            if bless:
                shutil.copyfile(fresh, reference)
                print(f"  bless {name}  {reference.stat().st_size // 1024} KiB")
            else:
                compare(name, fresh, reference)
                print(f"  ok    {name}")
            passed += 1
        except Failure as problem:
            print(f"  FAIL  {problem}")
            failed.append(name)

    print(f"\n{passed} passed, {len(failed)} failed")
    if failed:
        print(f"rendered frames left in {work} for a look")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
