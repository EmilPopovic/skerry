[Desktop Entry]
Type=Application
Name=Skerry
GenericName=File Manager
Comment=Browse the filesystem
# `%U`, not `%f`: a desktop hands a file manager URIs, and `skerry` decodes a
# `file://` one into the path it names.
Exec=skerry %U
Icon=dev.skerry.Skerry
Terminal=false
Categories=System;FileTools;FileManager;
MimeType=inode/directory;
Keywords=files;folders;filesystem;browse;manager;
StartupNotify=true
# One identity in three places — the window's `app_id`, the bus name and this
# file's basename — because a desktop matches them to each other by string
# equality, and a mismatch is a window with no icon in the switcher.
StartupWMClass=dev.skerry.Skerry
Implements=org.freedesktop.FileManager1
# What a dock offers on a secondary click. A bare second launch opens a window
# too — ADR 0044 — and this is the same thing by name.
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=skerry --new-window
